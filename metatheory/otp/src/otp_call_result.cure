@group(:concurrency)
mod Std.Otp.CallResult
  ## DEPENDENT CALL RESULT (build-out map B3/G6, session ↔ OTP-call bridge, value level). A
  ## `gen_server:call` either returns a REPLY or FAILS (timeout / no process / server died). What
  ## makes this dependently typed is that a successful reply's VALUE TYPE is computed from the
  ## request: `RepVal(reply_for(req))` — a `RGet` yields a `Nat`, a `RPut` yields a `Bit`. This is
  ## the value-level face of `ReplyOf(req)` (the tag-level version lives in `Std.Otp.CallSession`).
  ## The two facts: the success payload really has the request-determined type, and a caller must
  ## handle BOTH outcomes — a consumer that ignores failure is rejected as non-total, so `call`
  ## failure can never be silently dropped.

  type Req = RGet | RPut
  type Rep = VNat | VBool
  ## A one-bit value type, standing in for a concrete non-Nat reply.
  type Bit = B0 | B1
  ## Large elimination: the Cure TYPE carrying a reply tag's values.
  fn RepVal(p: Rep) -> Type = match p
    VNat()  -> Nat
    VBool() -> Bit
  ## The dependent reply contract: which reply a request expects.
  fn reply_for(r: Req) -> Rep = match r
    RGet() -> VNat
    RPut() -> VBool

  ## Why a call can fail — the honest failure modes of `gen_server:call`.
  type CallError = Timeout | NoProc | ServerDied

  ## The result of a call for request `r`: either a reply whose value has the REQUEST-DETERMINED
  ## type `RepVal(reply_for(r))`, or a failure. `Ok`'s payload type depends on `r`.
  type CallResult indices (r: Req)
    Ok  : (r: Req) -> RepVal(reply_for(r)) -> CallResult(r)
    Err : (r: Req) -> CallError -> CallResult(r)

  type Status = Success | Failure

  ## **CALL-RESULT TOTALITY.** Consuming a call result must handle both a reply and a failure; the
  ## kernel's exhaustiveness check rejects a consumer that omits `Err`, so a failed call can never
  ## be silently ignored. (The dependent success payload `v` need not be inspected here.)
  fn describe({r: Req}, res: CallResult(r)) -> Status = match res
    Ok(rr, v)  -> Success()
    Err(rr, e) -> Failure()

  ## The success payload for a `RGet` call really is a `Nat`: this only type-checks because
  ## `RepVal(reply_for(RGet)) = RepVal(VNat) = Nat`. A witness that the dependent reply type
  ## computes to the request-determined value type.
  fn get_reply() -> CallResult(RGet()) = Ok(RGet(), S(Z()))
  ## …and for `RPut` it is a `Bit` — `RepVal(reply_for(RPut)) = RepVal(VBool) = Bit`.
  fn put_reply() -> CallResult(RPut()) = Ok(RPut(), B1())
end
