@group(:concurrency)
mod Std.Otp.SelectiveReceive
  ## ORDERED selective receive — a tractable slice of the mailbox-order frontier
  ## (build-out map G8).
  ##
  ## Mailbox-type systems (Special Delivery, de'Liguoro–Padovani) treat the mailbox as
  ## a COMMUTATIVE bag — order-insensitive — and both papers name recovering Erlang's
  ## ORDERED, position-scanning selective receive as future work. Erlang's `receive`
  ## scans the mailbox FRONT-to-back and consumes the FIRST message matching a pattern,
  ## leaving the earlier non-matching messages in place, in order.
  ##
  ## This module types exactly that scan. `SelRecv(before, x, after)` is EVIDENCE that
  ## selectively receiving tag `x` from mailbox `before` yields `after` — the FIRST `x`
  ## removed, the skipped prefix and the tail preserved IN ORDER. The two constructors
  ## are the scan itself: `SelHere` (the head is `x`, consume it) and `SelSkip` (the head
  ## is some other tag, keep it and recurse on the tail). So arrival order is not
  ## abstracted — it is the inductive structure of the receive.
  ##
  ## **Safety.** `preserves`: selective receive from a well-typed mailbox leaves a
  ## well-typed mailbox (the removed and the kept messages were all accepted).
  ## `received_accepted`: the received message is itself accepted — an ordered selective
  ## receive never returns an unhandled message. Both by induction on the scan.
  ##
  ## **Honest scope.** This is single-tag selective receive over the ordered mailbox: it
  ## recovers arrival order in the type and proves type-safety of the first-match scan.
  ## Full G8 — arbitrary pattern-directed selective receive with protocol-level ordering
  ## of a whole conversation, and mailbox-type INFERENCE (G9, the universally-named open
  ## problem) — remains open. This is the ordered-scan primitive those build on.

  type Tag = TInc | TDec | TQuery
  type TagList = TNil | TCons(Tag, TagList)

  type Accepted indices (t: Tag)
    AccInc   : Accepted(TInc)
    AccQuery : Accepted(TQuery)

  type AllAccepted indices (ts: TagList)
    AANil  : AllAccepted(TNil)
    AACons : Accepted(t) -> AllAccepted(rest) -> AllAccepted(TCons(t, rest))

  ## ORDERED selective receive of tag `x`: scan `before` from the FRONT (arrival order),
  ## skipping non-matching messages, consuming the FIRST `x`; `after` is the result.
  type SelRecv indices (before: TagList, x: Tag, after: TagList)
    SelHere : SelRecv(TCons(x, rest), x, rest)
    SelSkip : SelRecv(rest, x, rest2) -> SelRecv(TCons(y, rest), x, TCons(y, rest2))

  ## **SELECTIVE-RECEIVE PRESERVATION.** Receiving from a well-typed mailbox leaves a
  ## well-typed mailbox — the removed message and every kept message were accepted.
  ## Induction on the scan (`SelHere` drops the received witness; `SelSkip` keeps the
  ## skipped witness and recurses), so order is respected.
  fn preserves({x: Tag}, {before: TagList}, {after: TagList}, all: AllAccepted(before), s: SelRecv(before, x, after)) -> AllAccepted(after) = match s
    SelHere() -> match all
      AACons(accx, rest_acc) -> rest_acc
    SelSkip(s2) -> match all
      AACons(accy, rest_acc) -> AACons(accy, preserves(rest_acc, s2))

  ## **RECEIVED-ACCEPTED.** The received message is itself accepted — a selective receive
  ## from a well-typed mailbox never yields an unhandled message.
  fn received_accepted({x: Tag}, {before: TagList}, {after: TagList}, all: AllAccepted(before), s: SelRecv(before, x, after)) -> Accepted(x) = match s
    SelHere() -> match all
      AACons(accx, rest_acc) -> accx
    SelSkip(s2) -> match all
      AACons(accy, rest_acc) -> received_accepted(rest_acc, s2)

  ## Non-vacuity: selectively receive `TQuery`, skipping a leading `TInc` — the received
  ## message is later in the mailbox than a message left in place.
  fn example() -> SelRecv(TCons(TInc, TCons(TQuery, TNil)), TQuery, TCons(TInc, TNil)) =
    SelSkip(SelHere())
end
