@group(:concurrency)
mod Std.Otp.PQueue
  use Std.Equivalent
  use Std.Otp.KeyOrder
  ## A MIN PRIORITY QUEUE over the certified key order (`Std.Otp.KeyOrder`). Erlang has no built-in
  ## priority queue; they are built by hand (pairing heaps, `gb_sets` used as a sorted set, sorted
  ## lists). This models the simplest correct one — an unsorted bag of keys with `insert` in O(1) and
  ## the minimum computed by folding the certified meet `kmin`. The point is the CORRECTNESS
  ## theorem: the extracted `pq_min` really is a LOWER BOUND of everything in the queue, and the
  ## proof rests entirely on the order foundation — `le_refl`, `le_trans`, and `kmin_lower`. So this
  ## is the first structure whose safety proof CONSUMES the total-order/semilattice axioms rather
  ## than re-establishing them by hand.

  type PQ = PNil | PCons(OKey, PQ)

  ## The minimum of the queue, seeded with a default (so it is total on the empty queue). Folds the
  ## certified meet over every element.
  fn pq_min(seed: OKey, q: PQ) -> OKey = match q
    PNil()         -> seed
    PCons(k, rest) -> kmin(k, pq_min(seed, rest))

  ## O(1) insert — a min priority queue does the work at extraction, not insertion.
  fn insert(k: OKey, q: PQ) -> PQ = PCons(k, q)

  ## **THE EXTRACTED MINIMUM IS ≤ THE SEED.** `pq_min(seed, q) ≤ seed`. Induction on the queue: the
  ## empty queue's min IS the seed (`le_refl`); a `PCons(k, …)` takes `kmin(k, m)` which is `≤ m`
  ## (`kmin_lower_r`), and `m ≤ seed` by the induction hypothesis, so `≤ seed` by TRANSITIVITY. This
  ## is the proof that consumes `le_trans` from the order foundation.
  fn min_le_seed(seed: OKey, q: PQ) -> Equivalent(OBit, le(pq_min(seed, q), seed), OT()) = match q
    PNil()         -> le_refl(seed)
    PCons(k, rest) -> le_trans(kmin(k, pq_min(seed, rest)), pq_min(seed, rest), seed, kmin_lower_r(k, pq_min(seed, rest)), min_le_seed(seed, rest))

  ## **THE EXTRACTED MINIMUM IS ≤ THE HEAD ELEMENT.** `pq_min(seed, insert(k, q)) ≤ k` — after
  ## inserting `k`, the queue's minimum is no greater than `k` (directly, since `insert` puts `k` at
  ## the head and `pq_min` takes `kmin(k, …)`, which is `≤ k` by `kmin_lower_l`). Together with
  ## `min_le_seed` this shows `pq_min` returns a true lower bound of the queue's contents.
  fn insert_min(k: OKey, seed: OKey, q: PQ) -> Equivalent(OBit, le(pq_min(seed, insert(k, q)), k), OT()) =
    kmin_lower_l(k, pq_min(seed, q))
end
