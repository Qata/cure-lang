@group(:concurrency)
mod Std.Otp.Monitor
  ## TYPED MONITORS and the DOWN-as-message discipline (build-out map G3).
  ##
  ## In OTP, `monitor(pid)` establishes a monitor: when the monitored process dies, a
  ## `DOWN` message is delivered to the monitoring process's mailbox. The safety
  ## question no published type system answers over a real reduction: **what stops a
  ## process from receiving a `DOWN` it cannot handle?** NVLang (arXiv 2512.05224) has
  ## `MonitorRef` in the grammar only (§2.5, no rules or theorems); KWC (Erlang'23) has
  ## the *operational* monitor/signal model but untyped; Core Erlang omits monitors.
  ##
  ## **The typing rule (this module).** A monitor reference is EVIDENCE that its holder
  ## accepts `DOWN`: `MkMRef : Accepted(TDown) -> MRef`. You cannot hold a monitor
  ## without being able to receive its death signal — `monitor_accepts` reads that proof
  ## back out. So DOWN is just another message the monitor's clause-derived type must
  ## accept, exactly as in `Std.Otp.Preservation`.
  ##
  ## **The safety theorem.** The death step `SDown` delivers `DOWN` into the monitor's
  ## ether and REQUIRES an `MRef`. `preservation` then shows delivery preserves
  ## well-typedness — precisely because the `MRef` carries the `Accepted(TDown)` proof.
  ## Dually, a receiver whose message vocabulary excludes `DOWN` cannot form an `MRef`
  ## (`Accepted(TDown)` is uninhabited there), so it can never be monitored and never
  ## receives a `DOWN` it cannot handle: unmonitored processes are DOWN-safe by
  ## construction.
  ##
  ## **Honest scope.** Single monitor, `DOWN` as a bare tag (reason/ref payload
  ## abstracted). Composes with `Std.Otp.Safety`'s progress/preservation — `SDown` is
  ## one more typed delivery rule. Links (bidirectional, exit-signal) and `demonitor`
  ## are the next step.

  ## Message vocabulary INCLUDING the DOWN notification a monitor receives.
  type Tag = TInc | TQuery | TDown
  type TagList = TNil | TCons(Tag, TagList)

  ## The monitoring receiver's accepted set — a monitor MUST accept `TDown`.
  type Accepted indices (t: Tag)
    AccInc   : Accepted(TInc)
    AccQuery : Accepted(TQuery)
    AccDown  : Accepted(TDown)

  ## Every tag in a list is accepted.
  type AllAccepted indices (ts: TagList)
    AANil  : AllAccepted(TNil)
    AACons : Accepted(t) -> AllAccepted(rest) -> AllAccepted(TCons(t, rest))

  ## A configuration: ether (in-flight) and mailbox.
  type Config = MkConfig(TagList, TagList)

  ## WELL-TYPED: every in-flight and mailboxed message is accepted.
  type WT indices (c: Config)
    MkWT : AllAccepted(e) -> AllAccepted(m) -> WT(MkConfig(e, m))

  ## **THE MONITOR TYPING RULE.** A monitor reference is a proof that its holder
  ## accepts `DOWN`. `monitor(pid)` yields an `MRef` only for a process whose message
  ## type includes `DOWN` — the discipline that makes death-delivery safe.
  type MRef = MkMRef(Accepted(TDown))

  ## Holding a monitor PROVES you can receive its `DOWN` (reads the evidence back out).
  fn monitor_accepts(r: MRef) -> Accepted(TDown) = match r
    MkMRef(a) -> a

  ## The reduction: the monitored process DIES, delivering `DOWN` into the monitor's
  ## ether. Requires an `MRef` — so a `DOWN` is only ever delivered to a monitor.
  type Step indices (before: Config, after: Config)
    SDown : MRef -> Step(MkConfig(e, m), MkConfig(TCons(TDown, e), m))

  ## **PRESERVATION (DOWN-safety).** Delivering `DOWN` on death preserves
  ## well-typedness, precisely because the `MRef` carries the proof that `DOWN` is
  ## accepted. A monitor never receives a death signal it cannot handle.
  fn preservation({b: Config}, {a: Config}, wt: WT(b), s: Step(b, a)) -> WT(a) = match s
    SDown(mref) -> match mref
      MkMRef(accdown) -> match wt
        MkWT(ae, am) -> MkWT(AACons(accdown, ae), am)

  ## Non-vacuity: a monitor CAN be established for a `DOWN`-accepting receiver.
  fn establish() -> MRef = MkMRef(AccDown)
end
