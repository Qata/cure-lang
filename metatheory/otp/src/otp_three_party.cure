@group(:concurrency)
mod Std.Otp.ThreeParty
  ## THREE-ROLE SESSION PROJECTION (build-out map B3, multiparty extension). Real OTP protocols
  ## involve more than two processes. This module carries THREE roles (`RA`, `RB`, `RC`) and proves
  ## the two coherence facts that survive without the full branch-MERGE machinery a general N-role
  ## theory needs (that merge is what makes unrestricted multiparty coherence hard; deferred):
  ##
  ##  * BYSTANDER NON-PARTICIPATION — a role party to none of a protocol's messages projects to
  ##    `LEnd`: it neither sends nor receives, so it can be spawned or omitted freely.
  ##  * BILATERAL COHERENCE — a protocol whose every message is between two fixed roles projects
  ##    those two to DUAL endpoints (the two-party result, now inside a three-role world), while
  ##    the third role is a bystander.
  ##
  ## Together: adding a non-participating role to a two-party protocol keeps the participants'
  ## endpoints dual and gives the newcomer the empty session — projection is LOCAL.

  type Role = RA | RB | RC
  type Tag = TA | TB | TC
  type B = F | T
  fn role_eq(x: Role, y: Role) -> B = match x
    RA() -> match y
      RA() -> T
      RB() -> F
      RC() -> F
    RB() -> match y
      RA() -> F
      RB() -> T
      RC() -> F
    RC() -> match y
      RA() -> F
      RB() -> F
      RC() -> T

  type Global = GEnd | GMsg(Role, Role, Tag, Global)
  type Local = LEnd | LSend(Tag, Local) | LRecv(Tag, Local)

  fn dual(l: Local) -> Local = match l
    LEnd()      -> LEnd()
    LSend(t, k) -> LRecv(t, dual(k))
    LRecv(t, k) -> LSend(t, dual(k))

  ## Project a global protocol onto one role (identical to the two-party rule; now over 3 roles).
  fn project(g: Global, r: Role) -> Local = match g
    GEnd()              -> LEnd()
    GMsg(from, to, t, k) -> match role_eq(from, r)
      T() -> LSend(t, project(k, r))
      F() -> match role_eq(to, r)
        T() -> LRecv(t, project(k, r))
        F() -> project(k, r)

  fn lsend_cong(t: Tag, {a: Local}, {b: Local}, e: Equivalent(Local, a, b)) -> Equivalent(Local, LSend(t, a), LSend(t, b)) =
    rewrite e in reflexive(LSend(t, b))
  fn lrecv_cong(t: Tag, {a: Local}, {b: Local}, e: Equivalent(Local, a, b)) -> Equivalent(Local, LRecv(t, a), LRecv(t, b)) =
    rewrite e in reflexive(LRecv(t, b))

  ## A protocol whose every message is bilateral between `RA` and `RB`. `RC` never appears.
  type Bilateral indices (g: Global)
    BiEnd : Bilateral(GEnd)
    BiAB  : (t: Tag) -> Bilateral(k) -> Bilateral(GMsg(RA, RB, t, k))
    BiBA  : (t: Tag) -> Bilateral(k) -> Bilateral(GMsg(RB, RA, t, k))

  ## **BYSTANDER NON-PARTICIPATION.** In a bilateral `RA`/`RB` protocol the third role `RC`
  ## projects to `LEnd` — it neither sends nor receives, so it can be added to or removed from the
  ## protocol freely. Each message's sender and receiver (`RA`/`RB`) differ from `RC`, so the
  ## projection skips it; this discharges definitionally at the two concrete instantiations.
  fn bystander_ab({g: Global}, w: Bilateral(g)) -> Equivalent(Local, project(g, RC), LEnd()) = match w
    BiEnd()      -> reflexive(LEnd())
    BiAB(t, w2)  -> bystander_ab(w2)
    BiBA(t, w2)  -> bystander_ab(w2)

  ## **BILATERAL COHERENCE (in a three-role world).** A protocol all of whose messages are between
  ## `RA` and `RB` projects those two to DUAL endpoints — the two-party duality result, unaffected
  ## by the presence of the third role `RC`. Induction on the bilateral derivation.
  fn bilateral_duality({g: Global}, w: Bilateral(g)) -> Equivalent(Local, project(g, RA), dual(project(g, RB))) = match w
    BiEnd()      -> reflexive(LEnd())
    BiAB(t, w2)  -> lsend_cong(t, bilateral_duality(w2))
    BiBA(t, w2)  -> lrecv_cong(t, bilateral_duality(w2))
end
