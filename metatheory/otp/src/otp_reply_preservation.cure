@group(:concurrency)
mod Std.Otp.ReplyPreservation
  ## The COMPOSE of `Std.Otp.Proof` (obligation (1): per-request dependent `ReplyOf`)
  ## with `Std.Otp.Preservation` (subject reduction over the Core Erlang send/arrive/
  ## receive reduction): the **dependent reply typing is preserved through delivery**.
  ##
  ## `Std.Otp.Preservation` proved that message-TAG acceptance is preserved by the
  ## ether→mailbox reduction. This module strengthens the payload from a tag to a
  ## request-answering REPLY `(r, v)` and shows that the per-request reply typing —
  ## `v` is a valid `ReplyOf(r)` — is preserved by exactly the same reduction. So a
  ## well-typed configuration of replies in flight and in mailboxes stays well-typed:
  ## a reply to request `r` is, and remains, of type `ReplyOf(r)` through `send`,
  ## `arrive`, and `receive`.
  ##
  ## **The bridge to the dependent `ReplyOf`.** `HasReply(r, v)` is the *operational*
  ## reply typing (a raw wire value `v` is a valid answer to `r`); `ReplyOf : Req ->
  ## Type` is the *dependent* reply type (large elimination, as in `Std.Otp.Proof`).
  ## `reify` connects them: from `HasReply(r, v)` it produces a `ReplyOf(r)` inhabitant
  ## — so preserving `HasReply` IS preserving the `ReplyOf` typing. That is what makes
  ## this a compose and not merely `Std.Otp.Preservation` with reply-flavoured names.
  ##
  ## **Honest scope.** This carries the dependent reply TYPE through delivery. It does
  ## NOT yet carry the LINEAR reply CAPABILITY's "consumed exactly once" through the
  ## reduction — that is proven separately in `Std.Otp.Proof` via QTT grades, and
  ## modelling it operationally (a request-response conservation theorem over a config
  ## of outstanding reply capabilities) is the next step. Single receiver, order
  ## abstracted, as in `Std.Otp.Preservation`.

  ## The request vocabulary and the raw wire values a reply can carry.
  type Req = GetCount | Ping
  type Val = VInt | VAtom

  ## The operational per-request reply typing: `v` is a valid answer to `r`. `GetCount`
  ## answers an `Int` (`VInt`), `Ping` answers an `Atom` (`VAtom`). There is NO
  ## `HasReply(GetCount, VAtom)` — a wrong-typed reply is unrepresentable.
  type HasReply indices (r: Req, v: Val)
    HRGet  : HasReply(GetCount, VInt)
    HRPing : HasReply(Ping, VAtom)

  ## A reply message (which request it answers + the value), and lists of them.
  type Reply = MkReply(Req, Val)
  type Replies = RNil | RCons(Reply, Replies)

  ## Every reply in the list is well-typed for its request.
  type AllReplied indices (rs: Replies)
    ARNil  : AllReplied(RNil)
    ARCons : HasReply(r, v) -> AllReplied(rest) -> AllReplied(RCons(MkReply(r, v), rest))

  ## A configuration: replies in flight (ether) + delivered (mailbox).
  type Config = MkConfig(Replies, Replies)

  ## WELL-TYPED: every reply, in flight or delivered, is well-typed for its request.
  type WT indices (c: Config)
    MkWT : AllReplied(e) -> AllReplied(m) -> WT(MkConfig(e, m))

  ## The reduction (Core Erlang fragment, replies):
  ##   SReply  — a server emits a reply, which must be well-typed for its request.
  ##   SArrive — deliver a front-of-ether reply into the mailbox.
  ##   SRecv   — the client consumes a delivered reply.
  type Step indices (before: Config, after: Config)
    SReply  : HasReply(r, v) -> Step(MkConfig(e, m), MkConfig(RCons(MkReply(r, v), e), m))
    SArrive : Step(MkConfig(RCons(MkReply(r, v), e), m), MkConfig(e, RCons(MkReply(r, v), m)))
    SRecv   : Step(MkConfig(e, RCons(MkReply(r, v), m)), MkConfig(e, m))

  ## **PRESERVATION of the dependent reply typing.** Reducing a well-typed reply
  ## configuration yields a well-typed one — every reply stays typed at `ReplyOf(r)`.
  ## Proof by cases, moving the `HasReply` witnesses.
  fn preservation({b: Config}, {a: Config}, wt: WT(b), s: Step(b, a)) -> WT(a) = match s
    SReply(hr) -> match wt
      MkWT(ae, am) -> MkWT(ARCons(hr, ae), am)
    SArrive() -> match wt
      MkWT(ae, am) -> match ae
        ARCons(hr, ae2) -> MkWT(ae2, ARCons(hr, am))
    SRecv() -> match wt
      MkWT(ae, am) -> match am
        ARCons(hr, am2) -> MkWT(ae, am2)

  ## The dependent reply type (large elimination, mirroring `Std.Otp.Proof.ReplyOf`).
  type RInt  = RI
  type RAtom = RA
  fn ReplyOf(r: Req) -> Type = match r
    GetCount() -> RInt
    Ping()     -> RAtom

  ## THE BRIDGE: a well-typed operational reply yields a `ReplyOf(r)` inhabitant.
  ## Matching `HasReply` refines `r`, so `ReplyOf(r)` reduces to the branch's concrete
  ## reply type — so `HasReply` faithfully reflects the dependent `ReplyOf`.
  fn reify({r: Req}, {v: Val}, hr: HasReply(r, v)) -> ReplyOf(r) = match hr
    HRGet()  -> RI
    HRPing() -> RA

  ## Non-vacuity: a concrete well-typed config (a `GetCount->Int` reply in flight).
  fn example() -> WT(MkConfig(RCons(MkReply(GetCount, VInt), RNil), RNil)) =
    MkWT(ARCons(HRGet, ARNil), ARNil)

  ## The exclusion is REAL: a wrong-typed reply `HasReply(GetCount, VAtom)` is
  ## uninhabited, so no well-typed config can carry one and no `SReply` can emit one.
  type Void = |
  fn wrong_reply(p: HasReply(GetCount, VAtom)) -> Void = match p
end
