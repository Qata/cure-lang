@group(:concurrency)
mod Std.Otp.Timer
  ## TYPED TIMERS — `send_after` / `receive ... after` / `cancel_timer` (build-out map
  ## G4). **No paper types this:** KWC (Erlang'23) *explicitly excludes* timers, Core
  ## Erlang omits them, and the mailbox-types line lists timeouts as future work. So this
  ## is discharged against the OTP semantics directly.
  ##
  ## A timer scheduled by `send_after(delay, pid, msg)` delivers `msg` to the receiver
  ## after the delay — UNLESS `cancel_timer` fires first. Two typing obligations:
  ##   1. **send_after is a typed send**: the scheduled message must be one the receiver
  ##      accepts — `MkTimer : Accepted(t) -> TimerRef(t, Pending)`. You cannot schedule a
  ##      message the receiver cannot handle.
  ##   2. **cancel is observable in the type**: a `TimerRef` is indexed by a lifecycle
  ##      state (`Pending`/`Cancelled`); `cancel` moves `Pending → Cancelled`, and only a
  ##      `Pending` timer can `SFire`. A cancelled timer can NEVER deliver — the type
  ##      makes "fire after cancel" unconstructible.
  ##
  ## **The safety theorem.** A fired timer delivers an accepted message (from the pending
  ## timer's evidence), so `preservation` holds; a cancelled timer never fires, so it can
  ## never deliver an unhandled message. `TTimeout` models the `receive ... after`
  ## timeout branch: the receiver's own timeout is just a scheduled message it accepts.
  ##
  ## **Honest scope.** The delay is abstract (no clock/ordering — a fired timer is one
  ## that reached its deadline); single timer; `SFire` delivers into the ether like any
  ## send. Composes with `Std.Otp.Safety`/`Std.Otp.Monitor` as another typed delivery.

  ## Vocabulary including the `TTimeout` message a `receive ... after` branch handles.
  type Tag = TInc | TQuery | TTimeout
  type TagList = TNil | TCons(Tag, TagList)

  type Accepted indices (t: Tag)
    AccInc     : Accepted(TInc)
    AccQuery   : Accepted(TQuery)
    AccTimeout : Accepted(TTimeout)

  type AllAccepted indices (ts: TagList)
    AANil  : AllAccepted(TNil)
    AACons : Accepted(t) -> AllAccepted(rest) -> AllAccepted(TCons(t, rest))

  type Config = MkConfig(TagList, TagList)
  type WT indices (c: Config)
    MkWT : AllAccepted(e) -> AllAccepted(m) -> WT(MkConfig(e, m))

  ## A timer's lifecycle state: it will fire, or it was cancelled.
  type TState = Pending | Cancelled

  ## A timer reference, indexed by the scheduled tag AND its state. A PENDING timer
  ## carries the proof that its scheduled message is accepted — the `send_after` typing
  ## rule. A cancelled timer carries no delivery evidence and can never fire.
  type TimerRef indices (t: Tag, s: TState)
    MkTimer : Accepted(t) -> TimerRef(t, Pending)
    Killed  : TimerRef(t, Cancelled)

  ## `cancel_timer`: a pending timer becomes cancelled and will never fire.
  fn cancel({t: Tag}, r: TimerRef(t, Pending)) -> TimerRef(t, Cancelled) = Killed()

  ## The reduction: a PENDING timer FIRES, delivering its scheduled message into the
  ## ether. It requires the pending timer — a cancelled timer cannot be passed here, so
  ## "fire after cancel" is unconstructible.
  type Step indices (before: Config, after: Config)
    SFire : TimerRef(t, Pending) -> Step(MkConfig(e, m), MkConfig(TCons(t, e), m))

  ## **PRESERVATION.** A fired timer delivers an accepted message (from the pending
  ## timer's evidence), so well-typedness is preserved; a cancelled timer never fires,
  ## so it can never deliver an unhandled message.
  fn preservation({b: Config}, {a: Config}, wt: WT(b), s: Step(b, a)) -> WT(a) = match s
    SFire(timer) -> match timer
      MkTimer(acc) -> match wt
        MkWT(ae, am) -> MkWT(AACons(acc, ae), am)

  ## A pending timer proves its scheduled message is accepted (reads the evidence out).
  fn scheduled_accepted({t: Tag}, r: TimerRef(t, Pending)) -> Accepted(t) = match r
    MkTimer(a) -> a

  ## Non-vacuity: a `receive ... after` timeout can be scheduled.
  fn schedule_timeout() -> TimerRef(TTimeout, Pending) = MkTimer(AccTimeout)
end
