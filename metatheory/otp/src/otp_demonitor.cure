@group(:concurrency)
mod Std.Otp.Demonitor
  ## MONITOR CANCELLATION — `demonitor`, completing the monitor lifecycle of
  ## `Std.Otp.Monitor` (build-out map G3 remainder).
  ##
  ## `Std.Otp.Monitor` established a monitor and showed DOWN delivery is safe. `demonitor`
  ## is the inverse: it cancels a monitor so no further DOWN is delivered through it. The
  ## typing makes this observable — a `MRef` is indexed by a lifecycle state
  ## (`Active`/`Removed`); `demonitor` moves `Active → Removed`, and the death step `SDown`
  ## REQUIRES an `Active` monitor. So "a DOWN delivered after `demonitor`" is
  ## unconstructible: once removed, a monitor can never drive a delivery.
  ##
  ## This mirrors `Std.Otp.Timer`'s Pending/Cancelled discipline — a cancellable
  ## capability whose spent state the type tracks — and completes the monitor lifecycle:
  ## establish (`MkMRef`) → observe (`SDown` / `Std.Otp.Monitor.preservation`) → cancel
  ## (`demonitor`). The parallel `unlink` for `Std.Otp.Link` is the same shape over the
  ## trap-flagged link.
  ##
  ## **Honest scope.** `demonitor(ref, [flush])`'s flush of an already-queued DOWN (the
  ## race where the process died just before `demonitor`) is an operational detail; this
  ## types the discipline that a REMOVED monitor originates no new delivery.

  type Tag = TInc | TQuery | TDown
  type TagList = TNil | TCons(Tag, TagList)

  type Accepted indices (t: Tag)
    AccInc   : Accepted(TInc)
    AccQuery : Accepted(TQuery)
    AccDown  : Accepted(TDown)

  type AllAccepted indices (ts: TagList)
    AANil  : AllAccepted(TNil)
    AACons : Accepted(t) -> AllAccepted(rest) -> AllAccepted(TCons(t, rest))

  type Config = MkConfig(TagList, TagList)
  type WT indices (c: Config)
    MkWT : AllAccepted(e) -> AllAccepted(m) -> WT(MkConfig(e, m))

  ## A monitor's lifecycle state.
  type MState = Active | Removed

  ## A monitor reference, indexed by state. An ACTIVE monitor carries the proof that its
  ## holder accepts DOWN (the `Std.Otp.Monitor` typing rule); a REMOVED one carries no
  ## delivery evidence.
  type MRef indices (s: MState)
    MkMRef : Accepted(TDown) -> MRef(Active)
    Gone   : MRef(Removed)

  ## `demonitor`: an active monitor becomes removed — no DOWN will be delivered through it.
  fn demonitor(r: MRef(Active)) -> MRef(Removed) = Gone

  ## The death step delivers DOWN — but ONLY through an ACTIVE monitor. A removed monitor
  ## cannot be passed here, so "DOWN after demonitor" is unconstructible.
  type Step indices (before: Config, after: Config)
    SDown : MRef(Active) -> Step(MkConfig(e, m), MkConfig(TCons(TDown, e), m))

  ## **PRESERVATION.** Delivering DOWN through an active monitor preserves
  ## well-typedness (from its `Accepted(TDown)` evidence) — as in `Std.Otp.Monitor`, but
  ## now the `Active` index is what admits the step at all.
  fn preservation({b: Config}, {a: Config}, wt: WT(b), s: Step(b, a)) -> WT(a) = match s
    SDown(mref) -> match mref
      MkMRef(accdown) -> match wt
        MkWT(ae, am) -> MkWT(AACons(accdown, ae), am)

  ## Non-vacuity: a monitor can be established (active) and then demonitored.
  fn establish() -> MRef(Active) = MkMRef(AccDown)
end
