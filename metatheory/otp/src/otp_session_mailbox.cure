@group(:concurrency)
mod Std.Otp.SessionMailbox
  use Std.Equivalent
  ## SESSION TYPES → MAILBOX TYPES (build-out map B3, de'Liguoro–Padovani §4.3–4.4, the headline
  ## encoding). A binary session endpoint is realized on the BEAM as a process with a MAILBOX: the
  ## messages it must be ready to receive. The encoding of an endpoint's session type is therefore
  ## the MULTISET of tags it RECEIVES (mailbox types are commutative — order-insensitive bags).
  ##
  ## `recvs(L)` is that mailbox multiset; `sends(L)` is the multiset of tags the endpoint EMITS.
  ## The load-bearing correctness property is FIDELITY: the mailbox an endpoint must service is
  ## exactly what its DUAL peer sends — `recvs(dual(L)) = sends(L)`. So encoding a session into
  ## mailboxes preserves communication safety: every message one side emits is one the other side's
  ## mailbox type accounts for, and vice versa.

  type Tag = TA | TB | TC
  ## A binary session endpoint type: send-then-continue, receive-then-continue, done, or the
  ## FORK/JOIN of two independent sub-sessions running in parallel (`LPar`).
  type Local = LEnd | LSend(Tag, Local) | LRecv(Tag, Local) | LPar(Local, Local)
  ## A mailbox type as a commutative multiset: counts of expected `TA`, `TB`, `TC` messages.
  type MS = MkMS(Nat, Nat, Nat)

  ## Nat addition and multiset (disjoint) union — the mailbox of a parallel composition is the
  ## sum of the components' mailboxes.
  fn add(m: Nat, n: Nat) -> Nat = match m
    Z()  -> n
    S(k) -> S(add(k, n))
  fn msum(m: MS, n: MS) -> MS = match m
    MkMS(a1, b1, c1) -> match n
      MkMS(a2, b2, c2) -> MkMS(add(a1, a2), add(b1, b2), add(c1, c2))

  ## Increment the counter for one tag.
  fn bump(t: Tag, m: MS) -> MS = match m
    MkMS(a, b, c) -> match t
      TA() -> MkMS(S(a), b, c)
      TB() -> MkMS(a, S(b), c)
      TC() -> MkMS(a, b, S(c))

  ## The encoding: the MAILBOX multiset of an endpoint — the tags it RECEIVES. Sends contribute
  ## nothing to the endpoint's own mailbox.
  fn recvs(l: Local) -> MS = match l
    LEnd()      -> MkMS(Z(), Z(), Z())
    LSend(t, k) -> recvs(k)
    LRecv(t, k) -> bump(t, recvs(k))
    LPar(a, b)  -> msum(recvs(a), recvs(b))

  ## The dual measure: the tags an endpoint SENDS (what lands in its peer's mailbox).
  fn sends(l: Local) -> MS = match l
    LEnd()      -> MkMS(Z(), Z(), Z())
    LSend(t, k) -> bump(t, sends(k))
    LRecv(t, k) -> sends(k)
    LPar(a, b)  -> msum(sends(a), sends(b))

  ## Dual endpoint: swap send and receive; fork/join dualizes componentwise.
  fn dual(l: Local) -> Local = match l
    LEnd()      -> LEnd()
    LSend(t, k) -> LRecv(t, dual(k))
    LRecv(t, k) -> LSend(t, dual(k))
    LPar(a, b)  -> LPar(dual(a), dual(b))

  ## Congruence for `bump` under equality of mailbox multisets.
  fn bump_cong(t: Tag, {a: MS}, {b: MS}, e: Equivalent(MS, a, b)) -> Equivalent(MS, bump(t, a), bump(t, b)) =
    rewrite e in reflexive(bump(t, b))

  ## Congruence for multiset union in both arguments.
  fn msum_cong({a1: MS}, {b1: MS}, {a2: MS}, {b2: MS}, ea: Equivalent(MS, a1, b1), eb: Equivalent(MS, a2, b2)) -> Equivalent(MS, msum(a1, a2), msum(b1, b2)) =
    rewrite ea in rewrite eb in reflexive(msum(b1, b2))

  ## **MAILBOX-ENCODING FIDELITY.** An endpoint's mailbox multiset equals what its DUAL peer
  ## sends: `recvs(dual(L)) = sends(L)`. Induction on `L` — dualizing turns each of the endpoint's
  ## sends into the peer's receive and vice versa, so the peer's mailbox accounts for exactly the
  ## messages this endpoint emits. This is the soundness of the session→mailbox encoding.
  fn recvs_dual(l: Local) -> Equivalent(MS, recvs(dual(l)), sends(l)) = match l
    LEnd()      -> reflexive(MkMS(Z(), Z(), Z()))
    LSend(t, k) -> bump_cong(t, recvs_dual(k))
    LRecv(t, k) -> recvs_dual(k)
    LPar(a, b)  -> msum_cong(recvs_dual(a), recvs_dual(b))

  ## The mirror: what an endpoint sends equals what its dual peer receives — `sends(dual(L)) =
  ## recvs(L)`. Together with `recvs_dual` this says the two mailbox multisets of a session's
  ## endpoints are exactly served by each other.
  fn sends_dual(l: Local) -> Equivalent(MS, sends(dual(l)), recvs(l)) = match l
    LEnd()      -> reflexive(MkMS(Z(), Z(), Z()))
    LSend(t, k) -> sends_dual(k)
    LRecv(t, k) -> bump_cong(t, sends_dual(k))
    LPar(a, b)  -> msum_cong(sends_dual(a), sends_dual(b))

  ## Structural COMPATIBILITY of two endpoints: a send on one side is a receive on the other, and
  ## parallel composes componentwise (fork/join). The tag is carried so the proof can name it.
  type Compat indices (l: Local, r: Local)
    CEnd : Compat(LEnd, LEnd)
    CSR  : (t: Tag) -> Compat(l, r) -> Compat(LSend(t, l), LRecv(t, r))
    CRS  : (t: Tag) -> Compat(l, r) -> Compat(LRecv(t, l), LSend(t, r))
    CPar : Compat(la, ra) -> Compat(lb, rb) -> Compat(LPar(la, lb), LPar(ra, rb))

  ## **ENCODING BALANCES COMPATIBILITY.** For compatible endpoints, one side's mailbox multiset is
  ## exactly what the other side sends: `recvs(l) = sends(r)`. Induction on the compatibility
  ## derivation — each matched send/receive contributes the same tag to `r`'s emissions and `l`'s
  ## mailbox. So the encoding turns a well-typed (compatible) session into a pair of mailboxes that
  ## exactly service each other's traffic — communication safety at the mailbox level.
  fn compat_recv_send({l: Local}, {r: Local}, c: Compat(l, r)) -> Equivalent(MS, recvs(l), sends(r)) = match c
    CEnd()        -> reflexive(MkMS(Z(), Z(), Z()))
    CSR(t, c2)    -> compat_recv_send(c2)
    CRS(t, c2)    -> bump_cong(t, compat_recv_send(c2))
    CPar(ca, cb)  -> msum_cong(compat_recv_send(ca), compat_recv_send(cb))

  ## The mirror: what one side sends is exactly the other side's mailbox — `sends(l) = recvs(r)`.
  ## Together the two say compatible endpoints' mailboxes are precisely served by each other.
  fn compat_send_recv({l: Local}, {r: Local}, c: Compat(l, r)) -> Equivalent(MS, sends(l), recvs(r)) = match c
    CEnd()        -> reflexive(MkMS(Z(), Z(), Z()))
    CSR(t, c2)    -> bump_cong(t, compat_send_recv(c2))
    CRS(t, c2)    -> compat_send_recv(c2)
    CPar(ca, cb)  -> msum_cong(compat_send_recv(ca), compat_send_recv(cb))

  ## SEQUENTIAL COMPOSITION of endpoints: run `s` to completion, then continue as `t`. This is the
  ## monoid operation on sessions, with `LEnd` as unit.
  fn seq(s: Local, t: Local) -> Local = match s
    LEnd()      -> t
    LSend(tg, k) -> LSend(tg, seq(k, t))
    LRecv(tg, k) -> LRecv(tg, seq(k, t))
    LPar(a, b)  -> LPar(a, seq(b, t))

  ## Supporting algebra for the homomorphism.
  fn add_assoc(x: Nat, y: Nat, z: Nat) -> Equivalent(Nat, add(add(x, y), z), add(x, add(y, z))) = match x
    Z()  -> reflexive(add(y, z))
    S(k) -> rewrite add_assoc(k, y, z) in reflexive(S(add(k, add(y, z))))
  fn mkms_cong({a1: Nat}, {a2: Nat}, {b1: Nat}, {b2: Nat}, {c1: Nat}, {c2: Nat}, ea: Equivalent(Nat, a1, a2), eb: Equivalent(Nat, b1, b2), ec: Equivalent(Nat, c1, c2)) -> Equivalent(MS, MkMS(a1, b1, c1), MkMS(a2, b2, c2)) =
    rewrite ea in rewrite eb in rewrite ec in reflexive(MkMS(a2, b2, c2))
  fn msum_assoc(m: MS, n: MS, p: MS) -> Equivalent(MS, msum(msum(m, n), p), msum(m, msum(n, p))) = match m
    MkMS(a1, b1, c1) -> match n
      MkMS(a2, b2, c2) -> match p
        MkMS(a3, b3, c3) -> mkms_cong(add_assoc(a1, a2, a3), add_assoc(b1, b2, b3), add_assoc(c1, c2, c3))
  ## `bump` on a sum increments the FIRST summand: reflexive per tag (`add(S(x),y)=S(add(x,y))`).
  fn bump_msum_dist(t: Tag, m: MS, n: MS) -> Equivalent(MS, bump(t, msum(m, n)), msum(bump(t, m), n)) = match m
    MkMS(a1, b1, c1) -> match n
      MkMS(a2, b2, c2) -> match t
        TA() -> reflexive(MkMS(S(add(a1, a2)), add(b1, b2), add(c1, c2)))
        TB() -> reflexive(MkMS(add(a1, a2), S(add(b1, b2)), add(c1, c2)))
        TC() -> reflexive(MkMS(add(a1, a2), add(b1, b2), S(add(c1, c2))))
  ## `n = msum(empty, n)` — the `LEnd` case of the homomorphism (both sides freeze folded and
  ## compare argument-wise since the K1 fix).
  fn msum_empty_l(n: MS) -> Equivalent(MS, n, msum(MkMS(Z(), Z(), Z()), n)) = match n
    MkMS(a, b, c) -> reflexive(MkMS(a, b, c))

  ## **THE ENCODING IS A MONOID HOMOMORPHISM.** `recvs` maps sequential composition of sessions to
  ## multiset SUM of mailboxes: `recvs(seq(s, t)) = msum(recvs(s), recvs(t))`. So the mailbox of a
  ## composite protocol is exactly the union of its parts' mailboxes — the encoding respects the
  ## algebraic structure. Induction on `s`; the receive case uses `bump_msum_dist`, fork/join uses
  ## `msum_assoc`. (Unblocked by the K1 kernel fix, which makes `msum(recvs(LEnd), …)` and
  ## `msum(empty, …)` compare equal.)
  fn recvs_hom(s: Local, t: Local) -> Equivalent(MS, recvs(seq(s, t)), msum(recvs(s), recvs(t))) = match s
    LEnd()       -> msum_empty_l(recvs(t))
    LSend(tg, k) -> recvs_hom(k, t)
    LRecv(tg, k) -> trans(bump_cong(tg, recvs_hom(k, t)), bump_msum_dist(tg, recvs(k), recvs(t)))
    LPar(a, b)   -> trans(msum_cong(reflexive(recvs(a)), recvs_hom(b, t)), sym(msum_assoc(recvs(a), recvs(b), recvs(t))))

  ## The mirror homomorphism for emissions: `sends(seq(s, t)) = msum(sends(s), sends(t))`.
  fn sends_hom(s: Local, t: Local) -> Equivalent(MS, sends(seq(s, t)), msum(sends(s), sends(t))) = match s
    LEnd()       -> msum_empty_l(sends(t))
    LSend(tg, k) -> trans(bump_cong(tg, sends_hom(k, t)), bump_msum_dist(tg, sends(k), sends(t)))
    LRecv(tg, k) -> sends_hom(k, t)
    LPar(a, b)   -> trans(msum_cong(reflexive(sends(a)), sends_hom(b, t)), sym(msum_assoc(sends(a), sends(b), sends(t))))

  ## Nat lemmas for the COMMUTATIVE half of the mailbox monoid.
  fn snat_cong({a: Nat}, {b: Nat}, e: Equivalent(Nat, a, b)) -> Equivalent(Nat, S(a), S(b)) =
    rewrite e in reflexive(S(b))
  fn add_zero_r(x: Nat) -> Equivalent(Nat, add(x, Z()), x) = match x
    Z()  -> reflexive(Z())
    S(k) -> snat_cong(add_zero_r(k))
  fn add_succ_r(x: Nat, y: Nat) -> Equivalent(Nat, add(x, S(y)), S(add(x, y))) = match x
    Z()  -> reflexive(S(y))
    S(k) -> snat_cong(add_succ_r(k, y))
  fn add_comm(x: Nat, y: Nat) -> Equivalent(Nat, add(x, y), add(y, x)) = match x
    Z()  -> sym(add_zero_r(y))
    S(k) -> trans(snat_cong(add_comm(k, y)), sym(add_succ_r(y, k)))

  ## **(MS, msum, empty) IS A COMMUTATIVE MONOID.** `msum` is COMMUTATIVE (mailbox types are bags:
  ## order-insensitive) — componentwise `add_comm` — and the empty multiset is a two-sided unit
  ## (`msum_empty_l` above, `msum_empty_r` here); `msum_assoc` gives associativity. So the mailbox
  ## codomain has exactly the commutative-monoid structure a bag semantics should.
  fn msum_comm(m: MS, n: MS) -> Equivalent(MS, msum(m, n), msum(n, m)) = match m
    MkMS(a1, b1, c1) -> match n
      MkMS(a2, b2, c2) -> mkms_cong(add_comm(a1, a2), add_comm(b1, b2), add_comm(c1, c2))
  fn msum_empty_r(m: MS) -> Equivalent(MS, msum(m, MkMS(Z(), Z(), Z())), m) = match m
    MkMS(a, b, c) -> mkms_cong(add_zero_r(a), add_zero_r(b), add_zero_r(c))

  ## Congruences for the session constructors (used by `seq_assoc`/`seq_end_r`).
  fn lsend_cong(tg: Tag, {a: Local}, {b: Local}, e: Equivalent(Local, a, b)) -> Equivalent(Local, LSend(tg, a), LSend(tg, b)) =
    rewrite e in reflexive(LSend(tg, b))
  fn lrecv_cong(tg: Tag, {a: Local}, {b: Local}, e: Equivalent(Local, a, b)) -> Equivalent(Local, LRecv(tg, a), LRecv(tg, b)) =
    rewrite e in reflexive(LRecv(tg, b))
  fn lpar_cong2(x: Local, {a: Local}, {b: Local}, e: Equivalent(Local, a, b)) -> Equivalent(Local, LPar(x, a), LPar(x, b)) =
    rewrite e in reflexive(LPar(x, b))

  ## **(Local, seq, LEnd) IS A MONOID.** Sequential composition is ASSOCIATIVE (`seq_assoc`) with
  ## `LEnd` a two-sided unit (`seq(LEnd, s) = s` definitionally; `seq_end_r` gives the right unit).
  ## With `recvs_hom`/`sends_hom` mapping this monoid to `(MS, msum, empty)` and preserving the unit
  ## (`recvs(LEnd) = empty`), `recvs` and `sends` are genuine MONOID HOMOMORPHISMS from the session
  ## monoid to the commutative mailbox monoid.
  fn seq_assoc(a: Local, b: Local, c: Local) -> Equivalent(Local, seq(seq(a, b), c), seq(a, seq(b, c))) = match a
    LEnd()       -> reflexive(seq(b, c))
    LSend(tg, k) -> lsend_cong(tg, seq_assoc(k, b, c))
    LRecv(tg, k) -> lrecv_cong(tg, seq_assoc(k, b, c))
    LPar(x, y)   -> lpar_cong2(x, seq_assoc(y, b, c))
  fn seq_end_r(s: Local) -> Equivalent(Local, seq(s, LEnd()), s) = match s
    LEnd()       -> reflexive(LEnd())
    LSend(tg, k) -> lsend_cong(tg, seq_end_r(k))
    LRecv(tg, k) -> lrecv_cong(tg, seq_end_r(k))
    LPar(x, y)   -> lpar_cong2(x, seq_end_r(y))

  ## **MAILBOX TYPES FORGET ORDER (the point of the encoding).** Fork/join is order-insensitive at
  ## the mailbox level — `recvs(LPar(a, b)) = recvs(LPar(b, a))` — directly from `msum_comm`.
  fn recvs_par_comm(a: Local, b: Local) -> Equivalent(MS, recvs(LPar(a, b)), recvs(LPar(b, a))) =
    msum_comm(recvs(a), recvs(b))

  ## And SEQUENTIAL composition's mailbox forgets order too: `recvs(seq(a, b)) = recvs(seq(b, a))`
  ## even though `seq` itself is NOT commutative (the sessions run in a fixed order). The mailbox is
  ## a commutative BAG, so swapping two composed sub-protocols leaves the set of expected messages
  ## unchanged — this is exactly why mailbox types can be commutative, DERIVED from the monoid
  ## homomorphism (`recvs_hom`) plus `msum_comm`. `sends` behaves the same way.
  fn recvs_seq_comm(a: Local, b: Local) -> Equivalent(MS, recvs(seq(a, b)), recvs(seq(b, a))) =
    trans(recvs_hom(a, b), trans(msum_comm(recvs(a), recvs(b)), sym(recvs_hom(b, a))))
  fn sends_seq_comm(a: Local, b: Local) -> Equivalent(MS, sends(seq(a, b)), sends(seq(b, a))) =
    trans(sends_hom(a, b), trans(msum_comm(sends(a), sends(b)), sym(sends_hom(b, a))))

  ## **THE ENCODING IS COMPOSITIONAL (a congruence).** Substituting mailbox-EQUIVALENT sub-protocols
  ## leaves the composite mailbox unchanged: if `recvs(s) = recvs(s2)` and `recvs(t) = recvs(t2)`
  ## then `recvs(seq(s, t)) = recvs(seq(s2, t2))`. So the mailbox of a protocol depends only on its
  ## parts' MAILBOXES, not their internal structure — you can type-check sub-protocols independently
  ## and compose the results (modularity of mailbox typing). Direct from the homomorphism + msum
  ## congruence; `LPar` is the definitional-`msum` case.
  fn mailbox_seq_cong(s: Local, s2: Local, t: Local, t2: Local, es: Equivalent(MS, recvs(s), recvs(s2)), et: Equivalent(MS, recvs(t), recvs(t2))) -> Equivalent(MS, recvs(seq(s, t)), recvs(seq(s2, t2))) =
    trans(recvs_hom(s, t), trans(msum_cong(es, et), sym(recvs_hom(s2, t2))))
  fn mailbox_par_cong(a: Local, a2: Local, b: Local, b2: Local, ea: Equivalent(MS, recvs(a), recvs(a2)), eb: Equivalent(MS, recvs(b), recvs(b2))) -> Equivalent(MS, recvs(LPar(a, b)), recvs(LPar(a2, b2))) =
    msum_cong(ea, eb)
end
