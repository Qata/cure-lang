@group(:concurrency)
mod Std.Otp.MailboxPattern
  ## COMMUTATIVE-REGEX mailbox types (build-out map B3, in-Cure half). The tag-SET inference
  ## model (`Std.Otp.Inference*`) tracks WHICH tags a mailbox handles; it cannot express
  ## MULTIPLICITY ("two `Put`s then a `Get`"). The mailbox-types literature (Special Delivery,
  ## de'Liguoro–Padovani) models a mailbox type as a COMMUTATIVE regular expression over the
  ## message alphabet — patterns `𝟙`, `E+F`, `E·F` (commutative), `*E` — denoting SETS of
  ## MULTISETS of messages (Parikh vectors), not flat tag sets.
  ##
  ## This module builds that model in Cure over a finite 3-tag alphabet: a multiset is a Parikh
  ## vector `MkMS(Nat, Nat, Nat)` (counts of `TA`/`TB`/`TC`), `Accepts(pat, m)` is the
  ## acceptance relation (which multisets a pattern denotes), and the two defining laws of the
  ## COMMUTATIVE fragment are proved — `times_comm` (`E·F` denotes the same multisets as `F·E`,
  ## the property that separates commutative from sequential regex) and `plus_comm`. The
  ## multiset arithmetic rests on `plus_comm` on `Nat`, proved here by the standard induction.
  ##
  ## Next slices (B3): `nullable` + Brzozowski derivatives + the fundamental theorem, then
  ## pattern SUBTYPING (inclusion). The DECISION procedure for general inclusion needs a
  ## Presburger/semilinear solver, which by the SMT trust-boundary decision stays OUT of the TCB
  ## (an untrusted lint) — the algebra and derivative correctness proved here do not.

  type Tag = TA | TB | TC
  type B = F | T

  ## Nat addition and commutativity (the multiset arithmetic; standard induction via rewrite).
  fn plus(m: Nat, n: Nat) -> Nat = match m
    Z()  -> n
    S(k) -> S(plus(k, n))
  fn plus_n_z(n: Nat) -> Equivalent(Nat, plus(n, Z()), n) = match n
    Z()  -> reflexive(Z())
    S(k) -> rewrite plus_n_z(k) in reflexive(S(k))
  fn plus_n_s(m: Nat, n: Nat) -> Equivalent(Nat, plus(m, S(n)), S(plus(m, n))) = match m
    Z()  -> reflexive(S(n))
    S(k) -> rewrite plus_n_s(k, n) in reflexive(S(S(plus(k, n))))
  fn plus_comm(m: Nat, n: Nat) -> Equivalent(Nat, plus(m, n), plus(n, m)) = match m
    Z()  -> rewrite plus_n_z(n) in reflexive(n)
    S(k) -> rewrite plus_n_s(n, k) in rewrite plus_comm(k, n) in reflexive(S(plus(n, k)))
  fn plus_assoc(a: Nat, b: Nat, c: Nat) -> Equivalent(Nat, plus(plus(a, b), c), plus(a, plus(b, c))) = match a
    Z()  -> reflexive(plus(b, c))
    S(k) -> rewrite plus_assoc(k, b, c) in reflexive(S(plus(k, plus(b, c))))

  ## A multiset over the 3-tag alphabet = a Parikh vector (counts per tag).
  type MS = MkMS(Nat, Nat, Nat)
  fn msadd(x: MS, y: MS) -> MS = match x
    MkMS(a, b, c) -> match y
      MkMS(d, e, f) -> MkMS(plus(a, d), plus(b, e), plus(c, f))
  fn msadd_comm(x: MS, y: MS) -> Equivalent(MS, msadd(x, y), msadd(y, x)) = match x
    MkMS(a, b, c) -> match y
      MkMS(d, e, f) -> rewrite plus_comm(d, a) in rewrite plus_comm(e, b) in rewrite plus_comm(f, c) in reflexive(MkMS(plus(a, d), plus(b, e), plus(c, f)))
  fn msadd_assoc(x: MS, y: MS, z: MS) -> Equivalent(MS, msadd(msadd(x, y), z), msadd(x, msadd(y, z))) = match x
    MkMS(a, b, c) -> match y
      MkMS(d, e, f) -> match z
        MkMS(g, h, i) -> rewrite plus_assoc(a, d, g) in rewrite plus_assoc(b, e, h) in rewrite plus_assoc(c, f, i) in reflexive(MkMS(plus(a, plus(d, g)), plus(b, plus(e, h)), plus(c, plus(f, i))))
  fn msadd_zero_left(y: MS) -> Equivalent(MS, msadd(MkMS(Z, Z, Z), y), y) = match y
    MkMS(d, e, f) -> reflexive(MkMS(d, e, f))

  ## Commutative-regex patterns over the alphabet.
  type Pat = PZero | POne | PAtom(Tag) | PPlus(Pat, Pat) | PTimes(Pat, Pat) | PStar(Pat)

  ## `Accepts(pat, m)` — the multiset `m` is denoted by `pat`. `PTimes` is the Minkowski sum
  ## (`msadd`), `PStar` its iterate; `PTimes`/`PStar` carry their split multisets EXPLICITLY so
  ## the commutativity proof can name them (index existentials are otherwise unnameable).
  type Accepts indices (pat: Pat, m: MS)
    AOne   : Accepts(POne, MkMS(Z, Z, Z))
    AAtomA : Accepts(PAtom(TA), MkMS(S(Z), Z, Z))
    AAtomB : Accepts(PAtom(TB), MkMS(Z, S(Z), Z))
    AAtomC : Accepts(PAtom(TC), MkMS(Z, Z, S(Z)))
    APlusL : Accepts(e, m) -> Accepts(PPlus(e, f), m)
    APlusR : Accepts(f, m) -> Accepts(PPlus(e, f), m)
    ATimes : (m1: MS) -> (m2: MS) -> Accepts(e, m1) -> Accepts(f, m2) -> Accepts(PTimes(e, f), msadd(m1, m2))
    AStar0 : Accepts(PStar(e), MkMS(Z, Z, Z))
    AStarN : (m1: MS) -> (m2: MS) -> Accepts(e, m1) -> Accepts(PStar(e), m2) -> Accepts(PStar(e), msadd(m1, m2))

  ## **CHOICE COMMUTATIVITY.** `E+F` and `F+E` denote the same multisets (swap the injection).
  fn plus_pat_comm({e: Pat}, {f: Pat}, {m: MS}, acc: Accepts(PPlus(e, f), m)) -> Accepts(PPlus(f, e), m) = match acc
    APlusL(ae) -> APlusR(ae)
    APlusR(af) -> APlusL(af)

  ## **CONCATENATION COMMUTATIVITY — the defining law of the COMMUTATIVE fragment.** `E·F` and
  ## `F·E` denote the same multisets: swap the two `ATimes` sub-derivations and rewrite by
  ## `msadd_comm` (the Minkowski sum is commutative because `+` on `Nat` is). This is exactly
  ## what a mailbox (an unordered bag of messages) needs and a sequential regex does not have.
  fn times_comm({e: Pat}, {f: Pat}, {m: MS}, acc: Accepts(PTimes(e, f), m)) -> Accepts(PTimes(f, e), m) = match acc
    ATimes(m1, m2, ae, af) -> rewrite msadd_comm(m1, m2) in ATimes(m2, m1, af, ae)

  ## **CONCATENATION ASSOCIATIVITY.** `(E·F)·G` and `E·(F·G)` denote the same multisets —
  ## reassociate the two `ATimes` splits and rewrite by `msadd_assoc`. With `times_comm` and
  ## `one_times` this makes `(Pat, PTimes, POne)` a COMMUTATIVE MONOID up to acceptance.
  fn times_assoc({e: Pat}, {f: Pat}, {g: Pat}, {m: MS}, acc: Accepts(PTimes(PTimes(e, f), g), m)) -> Accepts(PTimes(e, PTimes(f, g)), m) = match acc
    ATimes(mef, mg, acc_ef, acc_g) -> match acc_ef
      ATimes(me, mf, acc_e, acc_f) -> rewrite msadd_assoc(me, mf, mg) in ATimes(me, msadd(mf, mg), acc_e, ATimes(mf, mg, acc_f, acc_g))

  ## **UNIT.** `𝟙·E` denotes the same multisets as `E` (the empty bag is the identity of the
  ## Minkowski sum — definitionally, since `0 + n = n`).
  fn one_times({e: Pat}, {m: MS}, acc: Accepts(PTimes(POne, e), m)) -> Accepts(e, m) = match acc
    ATimes(m1, m2, a1, ae) -> match a1
      AOne() -> rewrite msadd_zero_left(m2) in ae

  ## Boolean connectives + their truth-inversion (which side is `T`), carrying the witness as
  ## a proof term so the derivation can be rebuilt without sibling-index refinement.
  fn orb(x: B, y: B) -> B = match x
    F() -> y
    T() -> T
  fn andb(x: B, y: B) -> B = match x
    F() -> F
    T() -> y
  type BOr indices (x: B, y: B)
    BOrL : Equivalent(B, x, T) -> BOr(x, y)
    BOrR : Equivalent(B, y, T) -> BOr(x, y)
  fn orb_true(x: B, y: B, e: Equivalent(B, orb(x, y), T)) -> BOr(x, y) = match x
    T() -> BOrL(reflexive(T))
    F() -> match y
      T() -> BOrR(reflexive(T))
      F() -> match e
  type BAnd indices (x: B, y: B)
    BAndBoth : Equivalent(B, x, T) -> Equivalent(B, y, T) -> BAnd(x, y)
  fn andb_true(x: B, y: B, e: Equivalent(B, andb(x, y), T)) -> BAnd(x, y) = match x
    T() -> match y
      T() -> BAndBoth(reflexive(T), reflexive(T))
      F() -> match e
    F() -> match e

  ## **NULLABILITY** — does a pattern accept the EMPTY bag (can the conversation end here)?
  ## The base case of Brzozowski derivation.
  fn nullable(pat: Pat) -> B = match pat
    PZero()      -> F
    POne()       -> T
    PAtom(t)     -> F
    PPlus(a, b)  -> orb(nullable(a), nullable(b))
    PTimes(a, b) -> andb(nullable(a), nullable(b))
    PStar(a)     -> T

  ## **NULLABILITY SOUNDNESS.** If `nullable(pat) = T` then `pat` accepts the empty bag —
  ## the decision procedure soundly certifies emptiness-acceptance. Induction on the pattern;
  ## the truth-inversion lemmas pick the right injection / build the empty `ATimes` split.
  fn nullable_sound(pat: Pat, e: Equivalent(B, nullable(pat), T)) -> Accepts(pat, MkMS(Z, Z, Z)) = match pat
    PZero()      -> match e
    POne()       -> AOne()
    PAtom(t)     -> match e
    PPlus(a, b)  -> match orb_true(nullable(a), nullable(b), e)
      BOrL(pa) -> APlusL(nullable_sound(a, pa))
      BOrR(pb) -> APlusR(nullable_sound(b, pb))
    PTimes(a, b) -> match andb_true(nullable(a), nullable(b), e)
      BAndBoth(pa, pb) -> ATimes(MkMS(Z, Z, Z), MkMS(Z, Z, Z), nullable_sound(a, pa), nullable_sound(b, pb))
    PStar(a)     -> AStar0()

  ## The singleton bag `{t}` and the commutative BRZOZOWSKI DERIVATIVE. `deriv(E, t)` accepts
  ## exactly the bags `m` with `E` accepting `m ⊎ {t}`. Bags are unordered, so a `PTimes`
  ## derivative peels the tag from EITHER factor; `PStar` peels one iteration.
  fn singleton(t: Tag) -> MS = match t
    TA() -> MkMS(S(Z), Z, Z)
    TB() -> MkMS(Z, S(Z), Z)
    TC() -> MkMS(Z, Z, S(Z))
  fn deriv(pat: Pat, t: Tag) -> Pat = match pat
    PZero()      -> PZero
    POne()       -> PZero
    PAtom(s)     -> match s
      TA() -> match t
        TA() -> POne
        TB() -> PZero
        TC() -> PZero
      TB() -> match t
        TA() -> PZero
        TB() -> POne
        TC() -> PZero
      TC() -> match t
        TA() -> PZero
        TB() -> PZero
        TC() -> POne
    PPlus(a, b)  -> PPlus(deriv(a, t), deriv(b, t))
    PTimes(a, b) -> PPlus(PTimes(deriv(a, t), b), PTimes(a, deriv(b, t)))
    PStar(a)     -> PTimes(deriv(a, t), PStar(a))

  ## Reassociate a Minkowski sum, moving `z` past `y` — `(x⊎y)⊎z ≡ (x⊎z)⊎y`.
  fn ms_swap(x: MS, y: MS, z: MS) -> Equivalent(MS, msadd(msadd(x, y), z), msadd(msadd(x, z), y)) =
    rewrite msadd_assoc(x, y, z) in rewrite msadd_comm(y, z) in rewrite msadd_assoc(x, z, y) in reflexive(msadd(x, msadd(z, y)))

  ## **DERIVATIVE SOUNDNESS** (one half of the Brzozowski fundamental theorem): if `deriv(E, t)`
  ## accepts `m`, then `E` accepts `m ⊎ {t}`. Constructive — rebuild the derivation, relocating
  ## the peeled `{t}` with the bag-algebra laws. The `PTimes`/`PStar` arms match `acc` (and the
  ## nested `ATimes`) INLINE under the outer `match pat`: the `ATimes` match refines the frozen
  ## total `m` to `msadd(m1,m2)` directly in the goal, so `rewrite msadd_assoc`/`ms_swap` find
  ## their redex without a delegation helper (E8: a constructor-headed scrutinee index carrying a
  ## computed subterm is inverted structurally, not detoured through the carried-eq mechanism).
  ## (The converse — completeness — needs `msadd` zero/one inversion, blocked by stuck-index
  ## retention on GADT match.)
  fn deriv_sound(pat: Pat, t: Tag, m: MS, acc: Accepts(deriv(pat, t), m)) -> Accepts(pat, msadd(m, singleton(t))) = match pat
    PZero()      -> match acc
    POne()       -> match acc
    PAtom(s)     -> match s
      TA() -> match t
        TA() -> match acc
          AOne() -> AAtomA()
        TB() -> match acc
        TC() -> match acc
      TB() -> match t
        TA() -> match acc
        TB() -> match acc
          AOne() -> AAtomB()
        TC() -> match acc
      TC() -> match t
        TA() -> match acc
        TB() -> match acc
        TC() -> match acc
          AOne() -> AAtomC()
    PPlus(a, b)  -> match acc
      APlusL(da) -> APlusL(deriv_sound(a, t, m, da))
      APlusR(db) -> APlusR(deriv_sound(b, t, m, db))
    PTimes(a, b) -> match acc
      APlusL(al) -> match al
        ATimes(m1, m2, da, ab) -> rewrite ms_swap(m1, m2, singleton(t)) in ATimes(msadd(m1, singleton(t)), m2, deriv_sound(a, t, m1, da), ab)
      APlusR(ar) -> match ar
        ATimes(m1, m2, aa, db) -> rewrite msadd_assoc(m1, m2, singleton(t)) in ATimes(m1, msadd(m2, singleton(t)), aa, deriv_sound(b, t, m2, db))
    PStar(a)     -> match acc
      ATimes(m1, m2, da, as) -> rewrite ms_swap(m1, m2, singleton(t)) in AStarN(msadd(m1, singleton(t)), m2, deriv_sound(a, t, m1, da), as)

  ## **KLEENE STAR FIXPOINT LAW.** `*E ≡ 𝟙 ⊕ E·(*E)` up to accepted bags — the defining
  ## unfolding of the star. Both directions are constructor rearrangements (`AStar0`/`AStarN`
  ## ↔ the choice of empty vs one-more-iteration), no bag arithmetic.
  fn star_unfold({a: Pat}, {m: MS}, acc: Accepts(PStar(a), m)) -> Accepts(PPlus(POne, PTimes(a, PStar(a))), m) = match acc
    AStar0()                -> APlusL(AOne())
    AStarN(m1, m2, ae, as)  -> APlusR(ATimes(m1, m2, ae, as))
  fn star_fold({a: Pat}, {m: MS}, acc: Accepts(PPlus(POne, PTimes(a, PStar(a))), m)) -> Accepts(PStar(a), m) = match acc
    APlusL(a1) -> match a1
      AOne() -> AStar0()
    APlusR(at) -> match at
      ATimes(m1, m2, ae, as) -> AStarN(m1, m2, ae, as)

  ## **LEFT DISTRIBUTIVITY.** `E·(F⊕G) ≡ (E·F)⊕(E·G)` up to accepted bags — the semiring
  ## distributive law. Both directions push the choice through the product; constructor
  ## rearrangement, no bag arithmetic.
  fn dist_fwd({a: Pat}, {b: Pat}, {c: Pat}, {m: MS}, acc: Accepts(PTimes(a, PPlus(b, c)), m)) -> Accepts(PPlus(PTimes(a, b), PTimes(a, c)), m) = match acc
    ATimes(m1, m2, aa, abc) -> match abc
      APlusL(ab) -> APlusL(ATimes(m1, m2, aa, ab))
      APlusR(ac) -> APlusR(ATimes(m1, m2, aa, ac))
  fn dist_bwd({a: Pat}, {b: Pat}, {c: Pat}, {m: MS}, acc: Accepts(PPlus(PTimes(a, b), PTimes(a, c)), m)) -> Accepts(PTimes(a, PPlus(b, c)), m) = match acc
    APlusL(al) -> match al
      ATimes(m1, m2, aa, ab) -> ATimes(m1, m2, aa, APlusL(ab))
    APlusR(ar) -> match ar
      ATimes(m1, m2, aa, ac) -> ATimes(m1, m2, aa, APlusR(ac))

  ## **ADDITIVE STRUCTURE.** Choice is associative (`(E⊕F)⊕G ≡ E⊕(F⊕G)`) with unit `PZero`
  ## (`E⊕𝟎 ≡ E`); together with `plus_pat_comm` this makes `(Pat, ⊕, 𝟎)` a commutative monoid.
  fn plus_assoc_fwd({a: Pat}, {b: Pat}, {c: Pat}, {m: MS}, acc: Accepts(PPlus(PPlus(a, b), c), m)) -> Accepts(PPlus(a, PPlus(b, c)), m) = match acc
    APlusL(al) -> match al
      APlusL(aa) -> APlusL(aa)
      APlusR(ab) -> APlusR(APlusL(ab))
    APlusR(ac) -> APlusR(APlusR(ac))
  fn plus_assoc_bwd({a: Pat}, {b: Pat}, {c: Pat}, {m: MS}, acc: Accepts(PPlus(a, PPlus(b, c)), m)) -> Accepts(PPlus(PPlus(a, b), c), m) = match acc
    APlusL(aa) -> APlusL(APlusL(aa))
    APlusR(ar) -> match ar
      APlusL(ab) -> APlusL(APlusR(ab))
      APlusR(ac) -> APlusR(ac)
  fn plus_zero_fwd({a: Pat}, {m: MS}, acc: Accepts(PPlus(a, PZero), m)) -> Accepts(a, m) = match acc
    APlusL(aa) -> aa
    APlusR(az) -> match az
  fn plus_zero_bwd({a: Pat}, {m: MS}, acc: Accepts(a, m)) -> Accepts(PPlus(a, PZero), m) = APlusL(acc)

  ## **ANNIHILATOR.** `𝟎·E` accepts nothing — `PZero` absorbs the product. The `PZero` factor's
  ## sub-derivation is uninhabited, so the whole thing is vacuous.
  fn zero_times({a: Pat}, {m: MS}, acc: Accepts(PTimes(PZero, a), m)) -> Accepts(PZero, m) = match acc
    ATimes(m1, m2, az, aa) -> match az

  ## **PATTERN SUBTYPING.** `Incl(E, F)` is a syntactic inclusion derivation: reflexivity,
  ## `𝟎` least, choice as least-upper-bound / injections, and `·`/`*` monotone, closed under
  ## transitivity. `incl_sound` proves it SOUND for semantic inclusion — every bag `E` accepts,
  ## `F` accepts too — so a mailbox typed `E` may be used where `F` is expected. Monotone
  ## `·`/`*` cases delegate to helpers (their `acc` is a parameter, so the product/star split
  ## refines the total — the E8 workaround).
  type Incl indices (e: Pat, f: Pat)
    IRefl  : Incl(e, e)
    IZero  : Incl(PZero, f)
    IPlus  : Incl(e, g) -> Incl(f, g) -> Incl(PPlus(e, f), g)
    IInL   : Incl(e, f) -> Incl(e, PPlus(f, g))
    IInR   : Incl(e, g) -> Incl(e, PPlus(f, g))
    ITimes : Incl(e1, e2) -> Incl(f1, f2) -> Incl(PTimes(e1, f1), PTimes(e2, f2))
    IStar  : Incl(e, f) -> Incl(PStar(e), PStar(f))
    ITrans : Incl(e, f) -> Incl(f, g) -> Incl(e, g)
  fn incl_times({e1: Pat}, {f1: Pat}, {e2: Pat}, {f2: Pat}, {m: MS}, s1: Incl(e1, e2), s2: Incl(f1, f2), acc: Accepts(PTimes(e1, f1), m)) -> Accepts(PTimes(e2, f2), m) = match acc
    ATimes(m1, m2, a1, a2) -> ATimes(m1, m2, incl_sound(s1, a1), incl_sound(s2, a2))
  fn incl_star({e: Pat}, {f: Pat}, {m: MS}, s: Incl(e, f), acc: Accepts(PStar(e), m)) -> Accepts(PStar(f), m) = match acc
    AStar0()                -> AStar0()
    AStarN(m1, m2, ae, as)  -> AStarN(m1, m2, incl_sound(s, ae), incl_star(s, as))
  fn incl_sound({e: Pat}, {f: Pat}, {m: MS}, sub: Incl(e, f), acc: Accepts(e, m)) -> Accepts(f, m) = match sub
    IRefl()        -> acc
    IZero()        -> match acc
    IPlus(se, sf)  -> match acc
      APlusL(ae) -> incl_sound(se, ae)
      APlusR(af) -> incl_sound(sf, af)
    IInL(sef)      -> APlusL(incl_sound(sef, acc))
    IInR(seg)      -> APlusR(incl_sound(seg, acc))
    ITimes(s1, s2) -> incl_times(s1, s2, acc)
    IStar(s)       -> incl_star(s, acc)
    ITrans(sef, sfg) -> incl_sound(sfg, incl_sound(sef, acc))

  ## **DERIVATIVE MONOTONICITY.** The Brzozowski derivative preserves subtyping:
  ## `E ≤ F ⟹ deriv(E,t) ≤ deriv(F,t)`. Induction on the inclusion derivation; the product and
  ## star cases rebuild the `PPlus`-of-derivatives shape with the choice/injection/monotonicity
  ## rules. Pure `Incl` recursion — no matching on acceptances.
  fn deriv_mono({e: Pat}, {f: Pat}, t: Tag, sub: Incl(e, f)) -> Incl(deriv(e, t), deriv(f, t)) = match sub
    IRefl()        -> IRefl()
    IZero()        -> IZero()
    IPlus(se, sf)  -> IPlus(deriv_mono(t, se), deriv_mono(t, sf))
    IInL(sef)      -> IInL(deriv_mono(t, sef))
    IInR(seg)      -> IInR(deriv_mono(t, seg))
    ITimes(s1, s2) -> IPlus(IInL(ITimes(deriv_mono(t, s1), s2)), IInR(ITimes(s1, deriv_mono(t, s2))))
    IStar(s)       -> ITimes(deriv_mono(t, s), IStar(s))
    ITrans(sef, sfg) -> ITrans(deriv_mono(t, sef), deriv_mono(t, sfg))

  ## **BRZOZOWSKI MATCHING** — the operational decision procedure for mailbox membership. A
  ## message stream is a `Word` (a list presenting a bag in some order); `parikh` is its bag,
  ## `dfold` folds the derivative along it, and matching = the residual is `nullable`.
  ## `matches_word_sound` proves it SOUND: if `dfold(E, w)` is nullable then `E` accepts
  ## `parikh(w)`. Induction on the word — `nullable_sound` at the empty tail, `deriv_sound`
  ## relocating each consumed tag back into the bag (up to `msadd_comm`).
  type Word = WNil | WCons(Tag, Word)
  fn parikh(w: Word) -> MS = match w
    WNil()         -> MkMS(Z, Z, Z)
    WCons(t, rest) -> msadd(singleton(t), parikh(rest))
  fn dfold(e: Pat, w: Word) -> Pat = match w
    WNil()         -> e
    WCons(t, rest) -> dfold(deriv(e, t), rest)
  fn matches_word_sound(e: Pat, w: Word, h: Equivalent(B, nullable(dfold(e, w)), T)) -> Accepts(e, parikh(w)) = match w
    WNil()         -> nullable_sound(e, h)
    WCons(t, rest) -> rewrite msadd_comm(singleton(t), parikh(rest)) in deriv_sound(e, t, parikh(rest), matches_word_sound(deriv(e, t), rest, h))
end
