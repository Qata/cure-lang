@group(:concurrency)
mod Std.Otp.SignalOrder
  ## KWC PER-SENDER SIGNAL ORDERING (build-out map B5). Erlang guarantees signal ordering
  ## PAIRWISE, not globally: messages from ONE sender to a receiver arrive in send order, but
  ## messages from DIFFERENT senders may interleave arbitrarily. The single-mailbox FIFO model
  ## (`Std.Otp.Fifo`) is stronger than reality; this module captures the actual KWC guarantee.
  ##
  ## A receiver's mailbox is an INTERLEAVING of the per-sender streams. `Interleave(xs, ys, mbox)`
  ## bakes the sender into each constructor (a left step delivers an `SA` message, a right step an
  ## `SB` message), so the mailbox is any order-preserving merge of an `SA`-stream and an
  ## `SB`-stream. The theorems `proj_left`/`proj_right` prove the guarantee: PROJECTING the
  ## mailbox to one sender recovers exactly that sender's stream, in order — so each sender's
  ## signals stay FIFO however the two interleave. No paper types this; KWC states it informally.

  type Sender = SA | SB
  type Tag = TA | TB | TC
  type Msg = MkMsg(Sender, Tag)
  type MList = MNil | MCons(Msg, MList)

  ## Keep only the messages from sender `s`, in order.
  fn proj(s: Sender, mbox: MList) -> MList = match mbox
    MNil()         -> MNil
    MCons(m, rest) -> match m
      MkMsg(sndr, t) -> match sndr
        SA() -> match s
          SA() -> MCons(MkMsg(SA, t), proj(s, rest))
          SB() -> proj(s, rest)
        SB() -> match s
          SA() -> proj(s, rest)
          SB() -> MCons(MkMsg(SB, t), proj(s, rest))

  ## An order-preserving merge of an `SA`-stream `xs` and an `SB`-stream `ys` into `mbox`. Each
  ## step delivers the next message of one sender, preserving that sender's order.
  type Interleave indices (xs: MList, ys: MList, mbox: MList)
    ILNil   : Interleave(MNil, MNil, MNil)
    ILLeft  : Interleave(xs, ys, mbox) -> Interleave(MCons(MkMsg(SA, t), xs), ys, MCons(MkMsg(SA, t), mbox))
    ILRight : Interleave(xs, ys, mbox) -> Interleave(xs, MCons(MkMsg(SB, t), ys), MCons(MkMsg(SB, t), mbox))

  ## **PER-SENDER ORDER PRESERVED (sender A).** Projecting the mailbox to `SA` recovers `xs`
  ## exactly — sender A's signals are FIFO in the mailbox regardless of the interleaving. A left
  ## step is kept by the projection, a right step (an `SB` message) is dropped.
  fn proj_left({xs: MList}, {ys: MList}, {mbox: MList}, il: Interleave(xs, ys, mbox)) -> Equivalent(MList, proj(SA, mbox), xs) = match il
    ILNil()      -> reflexive(MNil())
    ILLeft(il2)  -> rewrite proj_left(il2) in reflexive(xs)
    ILRight(il2) -> proj_left(il2)

  ## **PER-SENDER ORDER PRESERVED (sender B).** Symmetric: projecting to `SB` recovers `ys`.
  fn proj_right({xs: MList}, {ys: MList}, {mbox: MList}, il: Interleave(xs, ys, mbox)) -> Equivalent(MList, proj(SB, mbox), ys) = match il
    ILNil()      -> reflexive(MNil())
    ILLeft(il2)  -> proj_right(il2)
    ILRight(il2) -> rewrite proj_right(il2) in reflexive(ys)
end
