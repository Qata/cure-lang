mod PQueue
  use Std.Equivalent
  type OKey = OA | OB | OC
  type OBit = OF | OT
  fn le(a: OKey, b: OKey) -> OBit = match a
    OA() -> OT()
    OB() -> match b
      OA() -> OF()
      OB() -> OT()
      OC() -> OT()
    OC() -> match b
      OA() -> OF()
      OB() -> OF()
      OC() -> OT()
  fn kmin(a: OKey, b: OKey) -> OKey = match le(a, b)
    OT() -> a
    OF() -> b
  fn le_refl(a: OKey) -> Equivalent(OBit, le(a, a), OT()) = match a
    OA() -> reflexive(OT())
    OB() -> reflexive(OT())
    OC() -> reflexive(OT())
  fn le_trans(a: OKey, b: OKey, c: OKey, p: Equivalent(OBit, le(a, b), OT()), q: Equivalent(OBit, le(b, c), OT())) -> Equivalent(OBit, le(a, c), OT()) = match a
    OA() -> match b
      OA() -> match c
        OA() -> reflexive(OT())
        OB() -> reflexive(OT())
        OC() -> reflexive(OT())
      OB() -> match c
        OA() -> reflexive(OT())
        OB() -> reflexive(OT())
        OC() -> reflexive(OT())
      OC() -> match c
        OA() -> reflexive(OT())
        OB() -> reflexive(OT())
        OC() -> reflexive(OT())
    OB() -> match b
      OA() -> match c
        OA() -> match p
        OB() -> reflexive(OT())
        OC() -> reflexive(OT())
      OB() -> match c
        OA() -> match q
        OB() -> reflexive(OT())
        OC() -> reflexive(OT())
      OC() -> match c
        OA() -> match q
        OB() -> reflexive(OT())
        OC() -> reflexive(OT())
    OC() -> match b
      OA() -> match c
        OA() -> match p
        OB() -> match p
        OC() -> reflexive(OT())
      OB() -> match c
        OA() -> match p
        OB() -> match p
        OC() -> reflexive(OT())
      OC() -> match c
        OA() -> match q
        OB() -> match q
        OC() -> reflexive(OT())
  fn kmin_lower_l(a: OKey, b: OKey) -> Equivalent(OBit, le(kmin(a, b), a), OT()) = match a
    OA() -> match b
      OA() -> reflexive(OT())
      OB() -> reflexive(OT())
      OC() -> reflexive(OT())
    OB() -> match b
      OA() -> reflexive(OT())
      OB() -> reflexive(OT())
      OC() -> reflexive(OT())
    OC() -> match b
      OA() -> reflexive(OT())
      OB() -> reflexive(OT())
      OC() -> reflexive(OT())
  fn kmin_lower_r(a: OKey, b: OKey) -> Equivalent(OBit, le(kmin(a, b), b), OT()) = match a
    OA() -> match b
      OA() -> reflexive(OT())
      OB() -> reflexive(OT())
      OC() -> reflexive(OT())
    OB() -> match b
      OA() -> reflexive(OT())
      OB() -> reflexive(OT())
      OC() -> reflexive(OT())
    OC() -> match b
      OA() -> reflexive(OT())
      OB() -> reflexive(OT())
      OC() -> reflexive(OT())
  type PQ = PNil | PCons(OKey, PQ)
  fn pq_min(seed: OKey, q: PQ) -> OKey = match q
    PNil()         -> seed
    PCons(k, rest) -> kmin(k, pq_min(seed, rest))
  fn insert(k: OKey, q: PQ) -> PQ = PCons(k, q)
  fn min_le_seed(seed: OKey, q: PQ) -> Equivalent(OBit, le(pq_min(seed, q), seed), OT()) = match q
    PNil()         -> le_refl(seed)
    PCons(k, rest) -> le_trans(kmin(k, pq_min(seed, rest)), pq_min(seed, rest), seed, kmin_lower_r(k, pq_min(seed, rest)), min_le_seed(seed, rest))
  fn insert_min(k: OKey, seed: OKey, q: PQ) -> Equivalent(OBit, le(pq_min(seed, insert(k, q)), k), OT()) =
    kmin_lower_l(k, pq_min(seed, q))
end
