mod FairLiveness
  use Std.Equivalent
  ## CONCURRENT LIVENESS UNDER FAIRNESS — the honestly-hard concurrent property, because it is FALSE
  ## without a fairness assumption (an unfair scheduler starves a process forever). A schedule is a list of
  ## moves. POSITIVE: a Fair schedule (one that eventually lets P1's guarded entry fire) drives the waiting
  ## process to the critical section (fair_enters). NEGATIVE: a P2-only (unfair) schedule keeps P1 out
  ## indefinitely (starved) — so the fairness hypothesis is essential, not vacuous. Together: fairness is
  ## exactly what liveness needs.
  type Bool = F | T
  type P = Idle | Crit
  type Config = MkConfig(P, P)
  type Move = Enter1 | Exit1 | Enter2 | Exit2
  type EList = ENil | ECons(Move, EList)
  fn step(c: Config, m: Move) -> Config = match c
    MkConfig(p1, p2) -> match m
      Enter1() -> match p2
        Idle() -> MkConfig(Crit(), p2)
        Crit() -> MkConfig(p1, p2)
      Exit1()  -> MkConfig(Idle(), p2)
      Enter2() -> match p1
        Idle() -> MkConfig(p1, Crit())
        Crit() -> MkConfig(p1, p2)
      Exit2()  -> MkConfig(p1, Idle())
  fn p1_crit(c: Config) -> Bool = match c
    MkConfig(p1, p2) -> match p1
      Idle() -> F()
      Crit() -> T()
  fn p1_idle(c: Config) -> Bool = match c
    MkConfig(p1, p2) -> match p1
      Idle() -> T()
      Crit() -> F()
  fn runs(c: Config, sched: EList) -> Config = match sched
    ENil()          -> c
    ECons(m, rest)  -> runs(step(c, m), rest)
  ## A schedule that eventually lets P1 enter: it drives the system to a both-idle state and then fires
  ## Enter1. FairNow = P1 can enter right now; FairStep = P1 will enter later along the schedule.
  type Fair indices (c: Config, sched: EList)
    FairNow  : Fair(MkConfig(Idle, Idle), ECons(Enter1, rest))
    FairStep : Fair(step(c, m), rest) -> Fair(c, ECons(m, rest))
  ## P1 eventually reaches the critical section along the schedule.
  type EvP1Crit indices (c: Config, sched: EList)
    EvNow   : Equivalent(Bool, p1_crit(c), T()) -> EvP1Crit(c, sched)
    EvLater : EvP1Crit(step(c, m), rest) -> EvP1Crit(c, ECons(m, rest))
  ## **POSITIVE — a FAIR schedule makes the waiting process enter**: Fair(c,sched) ⟹ EvP1Crit(c,sched). By
  ## induction on the fairness witness; at the FairNow point Enter1 fires from both-idle, putting P1 critical.
  fn fair_enters({c: Config}, {sched: EList}, f: Fair(c, sched)) -> EvP1Crit(c, sched) = match f
    FairNow()     -> EvLater(EvNow(reflexive(T())))
    FairStep(f2)  -> EvLater(fair_enters(f2))
  ## An UNFAIR schedule: only the peer ever moves.
  type P2Only indices (sched: EList)
    P2Nil   : P2Only(ENil)
    P2Enter : P2Only(rest) -> P2Only(ECons(Enter2, rest))
    P2Exit  : P2Only(rest) -> P2Only(ECons(Exit2, rest))
  ## A peer move never disturbs P1's idle state (it only touches p2).
  fn enter2_keeps_idle(c: Config, h: Equivalent(Bool, p1_idle(c), T())) -> Equivalent(Bool, p1_idle(step(c, Enter2())), T()) = match c
    MkConfig(p1, p2) -> match p1
      Idle() -> reflexive(T())
      Crit() -> match h
  fn exit2_keeps_idle(c: Config, h: Equivalent(Bool, p1_idle(c), T())) -> Equivalent(Bool, p1_idle(step(c, Exit2())), T()) = match c
    MkConfig(p1, p2) -> match p1
      Idle() -> reflexive(T())
      Crit() -> match h
  ## **NEGATIVE — an UNFAIR (peer-only) schedule starves P1 forever**: if P1 is idle and only the peer is
  ## ever scheduled, P1 stays idle no matter how long the schedule runs — it never enters. So liveness
  ## genuinely requires fairness. Induction on the unfair schedule, preserving P1's idle state at each step.
  fn starved(c: Config, {sched: EList}, p2o: P2Only(sched), h: Equivalent(Bool, p1_idle(c), T())) -> Equivalent(Bool, p1_idle(runs(c, sched)), T()) = match p2o
    P2Nil()        -> h
    P2Enter(p2o2)  -> starved(step(c, Enter2()), p2o2, enter2_keeps_idle(c, h))
    P2Exit(p2o2)   -> starved(step(c, Exit2()), p2o2, exit2_keeps_idle(c, h))
end
