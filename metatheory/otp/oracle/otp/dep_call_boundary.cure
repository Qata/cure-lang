mod DepCallBoundary
  use Std.Equivalent
  ## THE DEPENDENT CALL BOUNDARY — the integration-spine core (algebra items 1+2). `Std.Otp.Proof` already
  ## types a reply at the request's OWN type `ReplyOf(req)` at the REPLY rule, and `Std.Otp.call` types a
  ## UNIFORM reply `r` for the whole server. The missing piece is the CLIENT-side dependent call:
  ## `call(server, req)` returning `ReplyOf(req)`, so ONE server answers DIFFERENT requests at DIFFERENT reply
  ## types, checked at the call site. `Std.Otp.call` avoids this only because a return-only implicit `r` cannot
  ## resolve through the effectful extern — but `ReplyOf(req)` is a function of the EXPLICIT request argument,
  ## so it IS determined, and a dependent `call` is well-formed. This models the boundary: a server carries a
  ## total dependent handler `(r: Req) -> ReplyOf(r)`, and `call` dispatches through it, returning the request's
  ## own reply type. `client_getcount` / `client_ping` witness two calls to ONE server resolving to two DISTINCT
  ## reply types. Promotes into `Std.Otp` as the dependent `call` over a `GenServer` indexed by `ReplyOf`.
  type Nat = Z | S(Nat)
  ## The two distinct reply types plus a field payload — the smallest heterogeneous request algebra.
  type RName  = Nm
  type RCount = Cnt(Nat)
  type RAck   = Ack
  type Req = GetCount | SetName(RName) | Ping
  ## Per-constructor reply type by large elimination: GetCount answers a count, the others an ack.
  fn ReplyOf(r: Req) -> Type = match r
    GetCount()  -> RCount
    SetName(_)  -> RAck
    Ping()      -> RAck
  ## A server handle carrying its total dependent handler (erased to a raw pid in the real algebra).
  type DepServer indices ()
    MkServer : ((r: Req) -> ReplyOf(r)) -> DepServer
  ## THE DEPENDENT CALL: the reply has the request's OWN type. This is what `Std.Otp.call` lacks.
  fn call(s: DepServer, r: Req) -> ReplyOf(r) = match s
    MkServer(h) -> h(r)
  ## A concrete total handler: every request answered at its own reply type.
  fn my_handle(r: Req) -> ReplyOf(r) = match r
    GetCount()  -> Cnt(Z())
    SetName(n)  -> Ack
    Ping()      -> Ack
  ## Two calls to ONE server resolve to two DISTINCT reply types at the client — the heterogeneity
  ## `Std.Otp.call` cannot express.
  fn client_getcount() -> RCount = call(MkServer(my_handle), GetCount())
  fn client_ping() -> RAck = call(MkServer(my_handle), Ping())
end
