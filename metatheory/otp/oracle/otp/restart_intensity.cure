mod RestartIntensity
  use Std.Equivalent
  ## OTP RESTART INTENSITY — the fault-tolerance safety valve. A supervisor tolerates only a bounded
  ## number of restarts (max_restarts) before it gives up and escalates. Model the supervisor as a
  ## restart BUDGET: each child failure consumes one restart; when the budget is exhausted the next
  ## failure escalates (GaveUp) instead of looping forever. This is what stops a "restart storm".
  type Nat = Z | S(Nat)
  type SupState = Running(Nat) | GaveUp
  ## One child failure: consume a restart, or escalate if the budget is gone.
  fn on_failure(s: SupState) -> SupState = match s
    GaveUp()     -> GaveUp()
    Running(b)   -> match b
      Z()    -> GaveUp()
      S(k)   -> Running(k)
  ## Drive n consecutive failures (a persistently-crashing child).
  fn crashes(s: SupState, n: Nat) -> SupState = match n
    Z()    -> s
    S(m)   -> crashes(on_failure(s), m)
  ## **BOUNDED INTENSITY ⇒ ESCALATION**: a supervisor with budget b, hit by S(b) consecutive failures,
  ## ends in GaveUp — it restarts at most b times, then escalates. Runaway restart loops are impossible.
  ## By induction on the budget.
  fn supervisor_escalates(b: Nat) -> Equivalent(SupState, crashes(Running(b), S(b)), GaveUp) = match b
    Z()    -> reflexive(GaveUp())
    S(k)   -> supervisor_escalates(k)
  ## **NO PREMATURE GIVE-UP**: with budget b, after exactly b failures the supervisor is STILL Running
  ## (down to its last life, Running(Z)) — it honours every restart it promised before escalating.
  ## Together with supervisor_escalates this pins the intensity EXACTLY: b restarts, escalate on the next.
  fn honours_budget(b: Nat) -> Equivalent(SupState, crashes(Running(b), b), Running(Z())) = match b
    Z()    -> reflexive(Running(Z()))
    S(k)   -> honours_budget(k)
end
