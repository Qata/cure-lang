mod GenStatemInvariant
  use Std.Equivalent
  ## GEN_STATEM SAFETY BY INVARIANT INDUCTION — the fundamental verification pattern. A gen_statem lock
  ## has state = the held-count; events acquire/release drive step. The safety invariant is MUTUAL
  ## EXCLUSION (count ≤ 1). inv_step proves every transition preserves it; inv_reachable lifts that to ALL
  ## reachable states by induction on the run; mutex_safe instantiates at the free start. So no reachable
  ## configuration ever has two holders — a genuine liveness/safety guarantee for the behaviour.
  type Nat = Z | S(Nat)
  type Bool = F | T
  type Event = Acquire | Release
  fn leq(a: Nat, b: Nat) -> Bool = match a
    Z()   -> T()
    S(k)  -> match b
      Z()   -> F()
      S(j)  -> leq(k, j)
  ## The gen_statem transition: acquire takes the lock only if free (else no-op); release frees it.
  fn step(n: Nat, e: Event) -> Nat = match e
    Acquire() -> match n
      Z()   -> S(Z())
      S(k)  -> S(k)
    Release() -> match n
      Z()   -> Z()
      S(k)  -> k
  ## The safety invariant: at most one holder.
  fn inv(n: Nat) -> Bool = leq(n, S(Z()))
  ## **EVERY TRANSITION PRESERVES MUTUAL EXCLUSION**: inv(n) ⟹ inv(step(n,e)). Case the event and the
  ## count; the only subtle case is release from a held lock, where the invariant forces the count to 1.
  fn inv_step(n: Nat, e: Event, h: Equivalent(Bool, inv(n), T())) -> Equivalent(Bool, inv(step(n, e)), T()) = match e
    Acquire() -> match n
      Z()   -> reflexive(T())
      S(k)  -> h
    Release() -> match n
      Z()   -> reflexive(T())
      S(k)  -> match k
        Z()   -> reflexive(T())
        S(j)  -> match h
  ## Reachability: s2 is reachable from s by a sequence of events.
  type Run indices (s: Nat, s2: Nat)
    RDone : Run(s, s)
    RStep : (e: Event) -> Run(step(s, e), s2) -> Run(s, s2)
  ## **THE INVARIANT HOLDS IN ALL REACHABLE STATES**: inv(s) and Run(s,s2) ⟹ inv(s2). Induction on the
  ## run, applying inv_step at each event. The core soundness of invariant-based verification.
  fn inv_reachable(s: Nat, {s2: Nat}, h: Equivalent(Bool, inv(s), T()), run: Run(s, s2)) -> Equivalent(Bool, inv(s2), T()) = match run
    RDone()          -> h
    RStep(e, run2)   -> inv_reachable(step(s, e), inv_step(s, e, h), run2)
  ## **MUTUAL EXCLUSION IS SAFE**: from the free start (count 0), every reachable state has count ≤ 1 —
  ## the lock never admits two holders, whatever the event sequence.
  fn mutex_safe({s2: Nat}, run: Run(Z(), s2)) -> Equivalent(Bool, inv(s2), T()) =
    inv_reachable(Z(), reflexive(T()), run)
end
