mod MergePerm
  use Std.Equivalent
  ## MERGE IS A PERMUTATION OF THE CONCATENATION — count-preservation, the second half of merge-sort
  ## correctness (`merge_sorted` was sortedness; together they are FULL merge correctness, mirroring the
  ## insertion_sort / insertion_sort_perm pair). Two lists are permutations iff every element occurs the
  ## same number of times, so `count(z, merge(l1,l2)) = plus(count(z,l1), count(z,l2))` says merge loses and
  ## invents nothing. Same three-function split as `merge_sorted`; `count` routes through `count_pick` so the
  ## equality test freezes VISIBLE (the A6 lesson) and the proof can refine it, and the arithmetic leans on
  ## `plus_zero` / `plus_succ_r` (plus recurses on its FIRST argument, so `plus(a, S(b))` needs a lemma).
  type Nat = Z | S(Nat)
  type Bool = F | T
  type List = LNil | LCons(Nat, List)
  fn leq(a: Nat, b: Nat) -> Bool = match a
    Z()   -> T()
    S(k)  -> match b
      Z()   -> F()
      S(j)  -> leq(k, j)
  type LeDec indices (x: Nat, y: Nat)
    LeYes : (x2: Nat) -> (y2: Nat) -> Equivalent(Bool, leq(x2, y2), T()) -> LeDec(x2, y2)
    LeNo  : (x2: Nat) -> (y2: Nat) -> Equivalent(Bool, leq(y2, x2), T()) -> LeDec(x2, y2)
  fn cmp(x: Nat, y: Nat) -> LeDec(x, y) = match x
    Z()   -> LeYes(Z(), y, reflexive(T()))
    S(x2) -> match y
      Z()   -> LeNo(S(x2), Z(), reflexive(T()))
      S(y2) -> match cmp(x2, y2)
        LeYes(a, b, e) -> LeYes(S(x2), S(y2), e)
        LeNo(a, b, e)  -> LeNo(S(x2), S(y2), e)
  ## Three-function total merge (same as merge_sorted): merge on l1, merge_into on l2, merge_pick routes
  ## the ordering decision as an explicit argument.
  fn merge_pick(x: Nat, r1: List, y: Nat, r2: List, d: LeDec(x, y)) -> List = match d
    LeYes(a, b, e) -> LCons(x, merge(r1, LCons(y, r2)))
    LeNo(a, b, e)  -> LCons(y, merge_into(x, r1, r2))
  fn merge_into(x: Nat, r1: List, l2: List) -> List = match l2
    LNil()        -> LCons(x, r1)
    LCons(y, r2)  -> merge_pick(x, r1, y, r2, cmp(x, y))
  fn merge(l1: List, l2: List) -> List = match l1
    LNil()        -> l2
    LCons(x, r1)  -> merge_into(x, r1, l2)
  fn plus(a: Nat, b: Nat) -> Nat = match a
    Z()   -> b
    S(k)  -> S(plus(k, b))
  fn eqn(a: Nat, b: Nat) -> Bool = match a
    Z()   -> match b
      Z()   -> T()
      S(k)  -> F()
    S(j)  -> match b
      Z()   -> F()
      S(k)  -> eqn(j, k)
  ## count routes the equality test through count_pick so it freezes with `eqn(z,w)` VISIBLE as an argument
  ## (an inline `match eqn` would A6-freeze the scrutinee, invisible to the motive — the merge_sorted lesson).
  fn count_pick(z: Nat, w: Nat, r: List, b: Bool) -> Nat = match b
    T() -> S(count(z, r))
    F() -> count(z, r)
  fn count(z: Nat, l: List) -> Nat = match l
    LNil()        -> Z()
    LCons(w, r)   -> count_pick(z, w, r, eqn(z, w))
  fn snat_cong(a: Nat, b: Nat, e: Equivalent(Nat, a, b)) -> Equivalent(Nat, S(a), S(b)) = rewrite e in reflexive(S(b))
  fn plus_zero(n: Nat) -> Equivalent(Nat, plus(n, Z()), n) = match n
    Z()   -> reflexive(Z())
    S(k)  -> snat_cong(plus(k, Z()), k, plus_zero(k))
  fn plus_succ_r(a: Nat, b: Nat) -> Equivalent(Nat, plus(a, S(b)), S(plus(a, b))) = match a
    Z()   -> reflexive(S(b))
    S(k)  -> snat_cong(plus(k, S(b)), S(plus(k, b)), plus_succ_r(k, b))
  ## **MERGE PRESERVES EVERY ELEMENT'S COUNT**: mirrors the three-function merge. The head chosen at each
  ## step contributes exactly one occurrence of itself; the `plus_succ_r` shuffle handles the case where the
  ## counted element equals the head coming from the SECOND list (plus doesn't reduce on its second argument).
  fn merge_pick_count(z: Nat, x: Nat, r1: List, y: Nat, r2: List, d: LeDec(x, y)) -> Equivalent(Nat, count(z, merge_pick(x, r1, y, r2, d)), plus(count(z, LCons(x, r1)), count(z, LCons(y, r2)))) = match d
    LeYes(a, b, e) -> match eqn(z, x)
      T() -> snat_cong(count(z, merge(r1, LCons(y, r2))), plus(count(z, r1), count(z, LCons(y, r2))), merge_count(z, r1, LCons(y, r2)))
      F() -> merge_count(z, r1, LCons(y, r2))
    LeNo(a, b, e)  -> match eqn(z, y)
      T() -> trans(snat_cong(count(z, merge_into(x, r1, r2)), plus(count(z, LCons(x, r1)), count(z, r2)), merge_into_count(z, x, r1, r2)), sym(plus_succ_r(count(z, LCons(x, r1)), count(z, r2))))
      F() -> merge_into_count(z, x, r1, r2)
  fn merge_into_count(z: Nat, x: Nat, r1: List, l2: List) -> Equivalent(Nat, count(z, merge_into(x, r1, l2)), plus(count(z, LCons(x, r1)), count(z, l2))) = match l2
    LNil()        -> sym(plus_zero(count(z, LCons(x, r1))))
    LCons(y, r2)  -> merge_pick_count(z, x, r1, y, r2, cmp(x, y))
  fn merge_count(z: Nat, l1: List, l2: List) -> Equivalent(Nat, count(z, merge(l1, l2)), plus(count(z, l1), count(z, l2))) = match l1
    LNil()        -> reflexive(count(z, l2))
    LCons(x, r1)  -> merge_into_count(z, x, r1, l2)
end
