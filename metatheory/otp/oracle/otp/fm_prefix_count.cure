mod FmPrefixCount
  use Std.Equivalent
  ## THE PREFIX-COUNT CORE of Fidge–Mattern COMPLETENESS. Soundness (`FidgeMattern`) shows a → b ⟹ VC(a) < VC(b);
  ## completeness is the CONVERSE and is FALSE on raw vector clocks — it needs the RETROSPECTIVE characterisation
  ## VC(e)[i] = #{ process-i events causally ≤ e }. That count is the POPCOUNT of a boolean bitmask: for
  ## coordinate i, mark position k with T iff the k-th event of process i causally precedes-or-equals e. Program
  ## order makes that mask DOWNWARD CLOSED (if position k is in the past then so is every earlier position) — a
  ## run of Ts followed by Fs, captured by `Prefix`. The load-bearing combinatorial fact is then: position k
  ## reads T EXACTLY WHEN k is below the popcount. `threshold` proves it. Everything Fidge–Mattern completeness
  ## adds on top (the diagonal VC(a)[proc a] = S(pos a), coordinate projection) reduces to this lemma at the
  ## coordinate proc(a). The reusable heart of the completeness direction.
  type Nat = Z | S(Nat)
  type Bool = F | T
  fn leq(a: Nat, b: Nat) -> Bool = match a
    Z()   -> T()
    S(k)  -> match b
      Z()   -> F()
      S(j)  -> leq(k, j)
  ## A process's causal-past bitmask: entry k = "does the k-th event of this process causally precede-or-equal b?"
  type Flags = FNil | FCons(Bool, Flags)
  ## The vector-clock coordinate: how many events of this process are in the past (the popcount).
  fn count_true(fs: Flags) -> Nat = match fs
    FNil()        -> Z()
    FCons(b, r)   -> match b
      T()   -> S(count_true(r))
      F()   -> count_true(r)
  ## Read position k (out of range = F, i.e. not in the past).
  fn nth(fs: Flags, k: Nat) -> Bool = match fs
    FNil()        -> F()
    FCons(x, r)   -> match k
      Z()   -> x
      S(k2) -> nth(r, k2)
  ## An all-F suffix: no further events are in the past.
  type AllF indices (fs: Flags)
    AFNil  : AllF(FNil)
    AFCons : (r: Flags) -> AllF(r) -> AllF(FCons(F, r))
  fn allf_nth(fs: Flags, h: AllF(fs), k: Nat) -> Equivalent(Bool, nth(fs, k), F()) = match h
    AFNil()        -> reflexive(F())
    AFCons(r, h2)  -> match k
      Z()   -> reflexive(F())
      S(k2) -> allf_nth(r, h2, k2)
  fn allf_count(fs: Flags, h: AllF(fs)) -> Equivalent(Nat, count_true(fs), Z()) = match h
    AFNil()        -> reflexive(Z())
    AFCons(r, h2)  -> allf_count(r, h2)
  ## DOWNWARD CLOSED: a run of Ts (the causal past, a prefix by program order) followed by an all-F suffix.
  type Prefix indices (fs: Flags)
    PBase : (fs: Flags) -> AllF(fs) -> Prefix(fs)
    PT    : (fs: Flags) -> Prefix(fs) -> Prefix(FCons(T, fs))
  ## THE THRESHOLD LEMMA: for a downward-closed mask, position k is in the past EXACTLY WHEN k is below the
  ## popcount. This is the whole content of "comparing the VC coordinate decides causal precedence".
  fn threshold(fs: Flags, h: Prefix(fs), k: Nat) -> Equivalent(Bool, nth(fs, k), leq(S(k), count_true(fs))) = match h
    PBase(fs2, af)  -> rewrite allf_count(fs2, af) in rewrite allf_nth(fs2, af, k) in reflexive(F())
    PT(fs2, p2)     -> match k
      Z()   -> reflexive(T())
      S(k2) -> threshold(fs2, p2, k2)
end
