mod GenStatemRefinement
  use Std.Equivalent
  ## FORWARD SIMULATION / DATA REFINEMENT — a concrete gen_statem faithfully implements an abstract spec
  ## machine. The abstract lock has two named states (AFree/AHeld); the concrete lock tracks a held-COUNT.
  ## The refinement relation R abstracts the count (0 ↔ AFree, 1 ↔ AHeld). sim_step proves every concrete
  ## transition is matched by the abstract one preserving R; sim_run lifts it to whole event sequences —
  ## running both machines on the SAME events keeps them R-related. So the concrete lock is a correct
  ## implementation of the abstract spec: every concrete behaviour mirrors an abstract behaviour.
  type Nat = Z | S(Nat)
  type AState = AFree | AHeld
  type Event = Acquire | Release
  ## Abstract transition (the spec).
  fn stepA(a: AState, e: Event) -> AState = match e
    Acquire() -> AHeld()
    Release() -> AFree()
  ## Concrete transition (the implementation): acquire takes the lock only if free, release frees it.
  fn stepC(n: Nat, e: Event) -> Nat = match e
    Acquire() -> match n
      Z()   -> S(Z())
      S(k)  -> S(k)
    Release() -> match n
      Z()   -> Z()
      S(k)  -> k
  ## The refinement relation: the count abstracts to a named state (0 = free, 1 = held).
  type R indices (c: Nat, a: AState)
    RFree : R(Z, AFree)
    RHeld : R(S(Z), AHeld)
  ## **SIMULATION STEP**: R(c,a) ⟹ R(stepC(c,e), stepA(a,e)) — each concrete transition is matched by the
  ## abstract one, preserving the abstraction. Case the relation and the event; all four cases land on a
  ## constructor of R.
  fn sim_step({c: Nat}, {a: AState}, e: Event, r: R(c, a)) -> R(stepC(c, e), stepA(a, e)) = match r
    RFree() -> match e
      Acquire() -> RHeld()
      Release() -> RFree()
    RHeld() -> match e
      Acquire() -> RHeld()
      Release() -> RFree()
  type EList = ENil | ECons(Event, EList)
  fn runC(c: Nat, es: EList) -> Nat = match es
    ENil()          -> c
    ECons(e, rest)  -> runC(stepC(c, e), rest)
  fn runA(a: AState, es: EList) -> AState = match es
    ENil()          -> a
    ECons(e, rest)  -> runA(stepA(a, e), rest)
  ## **SIMULATION OVER RUNS**: R(c,a) ⟹ R(runC(c,es), runA(a,es)) — running both machines on the SAME
  ## event sequence keeps them R-related. Forward simulation lifted to whole traces. Induction on the events.
  fn sim_run(c: Nat, a: AState, es: EList, r: R(c, a)) -> R(runC(c, es), runA(a, es)) = match es
    ENil()          -> r
    ECons(e, rest)  -> sim_run(stepC(c, e), stepA(a, e), rest, sim_step(e, r))
  ## **THE CONCRETE LOCK REFINES THE ABSTRACT SPEC**: from the aligned start (count 0 ~ AFree), any event
  ## sequence leaves the concrete count faithfully abstracting the abstract state. Correct-by-construction.
  fn refines(es: EList) -> R(runC(Z(), es), runA(AFree(), es)) =
    sim_run(Z(), AFree(), es, RFree())
end
