mod PriorityQueue
  use Std.Equivalent
  ## A VERIFIED PRIORITY QUEUE on the mergeable min-heap — the priority-queue INTERFACE built on merge, with
  ## its defining correctness. `insert` (= merge with a singleton) and `delete_min` (= merge the root's two
  ## heap subtrees) are defined purely in terms of `merge` and PRESERVE the heap invariant (`insert_heap`,
  ## `delete_min_heap`, both one-line corollaries of `merge_heap`). The load-bearing NEW result is MIN-AT-ROOT:
  ## `heap_below` proves a heap's root is a LOWER BOUND of EVERY element (a `Below` predicate ranging over the
  ## whole tree), via `root_le_trans` (order composes through the key). Hence `find_min_is_min`: `find_min(h)`
  ## is ≤ every element of h — the defining priority-queue guarantee that delete-min returns the smallest.
  type Nat = Z | S(Nat)
  type Bool = F | T
  fn leq(a: Nat, b: Nat) -> Bool = match a
    Z()   -> T()
    S(k)  -> match b
      Z()   -> F()
      S(j)  -> leq(k, j)
  fn leq_refl(a: Nat) -> Equivalent(Bool, leq(a, a), T()) = match a
    Z()   -> reflexive(T())
    S(k)  -> leq_refl(k)
  fn le_trans(a: Nat, b: Nat, c: Nat, hab: Equivalent(Bool, leq(a, b), T()), hbc: Equivalent(Bool, leq(b, c), T())) -> Equivalent(Bool, leq(a, c), T()) = match a
    Z()   -> reflexive(T())
    S(a2) -> match b
      Z()   -> match hab
      S(b2) -> match c
        Z()   -> match hbc
        S(c2) -> le_trans(a2, b2, c2, hab, hbc)
  type LeDec indices (x: Nat, y: Nat)
    LeYes : (x2: Nat) -> (y2: Nat) -> Equivalent(Bool, leq(x2, y2), T()) -> LeDec(x2, y2)
    LeNo  : (x2: Nat) -> (y2: Nat) -> Equivalent(Bool, leq(y2, x2), T()) -> LeDec(x2, y2)
  fn cmp(x: Nat, y: Nat) -> LeDec(x, y) = match x
    Z()   -> LeYes(Z(), y, reflexive(T()))
    S(x2) -> match y
      Z()   -> LeNo(S(x2), Z(), reflexive(T()))
      S(y2) -> match cmp(x2, y2)
        LeYes(a, b, e) -> LeYes(S(x2), S(y2), e)
        LeNo(a, b, e)  -> LeNo(S(x2), S(y2), e)
  type Tree = Empty | Node(Nat, Tree, Tree)
  fn root_le(x: Nat, h: Tree) -> Bool = match h
    Empty()        -> T()
    Node(y, l, r)  -> leq(x, y)
  type Heap indices (h: Tree)
    HEmpty : Heap(Empty)
    HNode  : (x: Nat) -> (l: Tree) -> (r: Tree) -> Equivalent(Bool, root_le(x, l), T()) -> Equivalent(Bool, root_le(x, r), T()) -> Heap(l) -> Heap(r) -> Heap(Node(x, l, r))
  fn merge_pick(x: Nat, l1: Tree, r1: Tree, y: Nat, l2: Tree, r2: Tree, d: LeDec(x, y)) -> Tree = match d
    LeYes(a, b, e) -> Node(x, l1, merge(r1, Node(y, l2, r2)))
    LeNo(a, b, e)  -> Node(y, l2, merge_into(x, l1, r1, r2))
  fn merge_into(x: Nat, l1: Tree, r1: Tree, h2: Tree) -> Tree = match h2
    Empty()        -> Node(x, l1, r1)
    Node(y, l2, r2) -> merge_pick(x, l1, r1, y, l2, r2, cmp(x, y))
  fn merge(h1: Tree, h2: Tree) -> Tree = match h1
    Empty()        -> h2
    Node(x, l1, r1) -> merge_into(x, l1, r1, h2)
  fn merge_pick_rle(z: Nat, x: Nat, l1: Tree, r1: Tree, y: Nat, l2: Tree, r2: Tree, hz1: Equivalent(Bool, root_le(z, Node(x, l1, r1)), T()), hz2: Equivalent(Bool, root_le(z, Node(y, l2, r2)), T()), d: LeDec(x, y)) -> Equivalent(Bool, root_le(z, merge_pick(x, l1, r1, y, l2, r2, d)), T()) = match d
    LeYes(a, b, e) -> hz1
    LeNo(a, b, e)  -> hz2
  fn merge_into_rle(z: Nat, x: Nat, l1: Tree, r1: Tree, h2: Tree, hz1: Equivalent(Bool, root_le(z, Node(x, l1, r1)), T()), hz2: Equivalent(Bool, root_le(z, h2), T())) -> Equivalent(Bool, root_le(z, merge_into(x, l1, r1, h2)), T()) = match h2
    Empty()        -> hz1
    Node(y, l2, r2) -> merge_pick_rle(z, x, l1, r1, y, l2, r2, hz1, hz2, cmp(x, y))
  fn merge_root_le(z: Nat, h1: Tree, h2: Tree, hz1: Equivalent(Bool, root_le(z, h1), T()), hz2: Equivalent(Bool, root_le(z, h2), T())) -> Equivalent(Bool, root_le(z, merge(h1, h2)), T()) = match h1
    Empty()        -> hz2
    Node(x, l1, r1) -> merge_into_rle(z, x, l1, r1, h2, hz1, hz2)
  fn merge_pick_heap(x: Nat, l1: Tree, r1: Tree, y: Nat, l2: Tree, r2: Tree, s1: Heap(Node(x, l1, r1)), s2: Heap(Node(y, l2, r2)), d: LeDec(x, y)) -> Heap(merge_pick(x, l1, r1, y, l2, r2, d)) = match d
    LeYes(a, b, e) -> match s1
      HNode(x3, l13, r13, hxl1, hxr1, hl1, hr1) -> HNode(x, l1, merge(r1, Node(y, l2, r2)), hxl1, merge_root_le(x, r1, Node(y, l2, r2), hxr1, e), hl1, merge_heap(r1, Node(y, l2, r2), hr1, s2))
    LeNo(a, b, e)  -> match s2
      HNode(y3, l23, r23, hyl2, hyr2, hl2, hr2) -> HNode(y, l2, merge_into(x, l1, r1, r2), hyl2, merge_into_rle(y, x, l1, r1, r2, e, hyr2), hl2, merge_into_heap(x, l1, r1, r2, s1, hr2))
  fn merge_into_heap(x: Nat, l1: Tree, r1: Tree, h2: Tree, s1: Heap(Node(x, l1, r1)), s2: Heap(h2)) -> Heap(merge_into(x, l1, r1, h2)) = match h2
    Empty()        -> s1
    Node(y, l2, r2) -> merge_pick_heap(x, l1, r1, y, l2, r2, s1, s2, cmp(x, y))
  fn merge_heap(h1: Tree, h2: Tree, s1: Heap(h1), s2: Heap(h2)) -> Heap(merge(h1, h2)) = match h1
    Empty()        -> s2
    Node(x, l1, r1) -> merge_into_heap(x, l1, r1, h2, s1, s2)
  ## b is a lower bound of EVERY element in the tree.
  type Below indices (b: Nat, h: Tree)
    BEmpty : Below(b, Empty)
    BNode  : (x: Nat) -> (l: Tree) -> (r: Tree) -> Equivalent(Bool, leq(b, x), T()) -> Below(b, l) -> Below(b, r) -> Below(b, Node(x, l, r))
  fn root_le_trans(b: Nat, x: Nat, l: Tree, hbx: Equivalent(Bool, leq(b, x), T()), hxl: Equivalent(Bool, root_le(x, l), T())) -> Equivalent(Bool, root_le(b, l), T()) = match l
    Empty()          -> reflexive(T())
    Node(z, ll, rr)  -> le_trans(b, x, z, hbx, hxl)
  ## **THE ROOT OF A HEAP IS A LOWER BOUND OF ALL ITS ELEMENTS** (min-at-root): the defining property.
  fn heap_below(b: Nat, h: Tree, hbh: Equivalent(Bool, root_le(b, h), T()), sh: Heap(h)) -> Below(b, h) = match sh
    HEmpty()                            -> BEmpty()
    HNode(x, l, r, hxl, hxr, shl, shr)  -> BNode(x, l, r, hbh, heap_below(b, l, root_le_trans(b, x, l, hbh, hxl), shl), heap_below(b, r, root_le_trans(b, x, r, hbh, hxr), shr))
  ## The priority-queue operations, all in terms of merge.
  fn singleton(x: Nat) -> Tree = Node(x, Empty(), Empty())
  fn insert(x: Nat, h: Tree) -> Tree = merge(singleton(x), h)
  fn delete_min(h: Tree) -> Tree = match h
    Empty()        -> Empty()
    Node(k, l, r)  -> merge(l, r)
  fn find_min(h: Tree) -> Nat = match h
    Empty()        -> Z()
    Node(k, l, r)  -> k
  fn h_singleton(x: Nat) -> Heap(singleton(x)) = HNode(x, Empty(), Empty(), reflexive(T()), reflexive(T()), HEmpty(), HEmpty())
  ## **INSERT PRESERVES THE HEAP INVARIANT** (insert = merge with a singleton).
  fn insert_heap(x: Nat, h: Tree, sh: Heap(h)) -> Heap(insert(x, h)) = merge_heap(singleton(x), h, h_singleton(x), sh)
  ## **DELETE-MIN PRESERVES THE HEAP INVARIANT** (drop the root, merge its two heap subtrees).
  fn delete_min_heap(h: Tree, sh: Heap(h)) -> Heap(delete_min(h)) = match sh
    HEmpty()                            -> HEmpty()
    HNode(k, l, r, hkl, hkr, shl, shr)  -> merge_heap(l, r, shl, shr)
  ## **FIND-MIN RETURNS THE MINIMUM**: find_min(h) is ≤ every element of h (a lower bound), by min-at-root.
  fn find_min_is_min(h: Tree, sh: Heap(h)) -> Below(find_min(h), h) = match sh
    HEmpty()                            -> BEmpty()
    HNode(x, l, r, hxl, hxr, shl, shr)  -> heap_below(x, Node(x, l, r), leq_refl(x), HNode(x, l, r, hxl, hxr, shl, shr))
end
