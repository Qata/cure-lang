mod GenStatemTransfer
  use Std.Equivalent
  ## SAFETY VIA REFINEMENT — the payoff of forward simulation. Rather than re-proving mutual exclusion on
  ## the concrete lock by a separate invariant induction (as gen_statem_invariant does), it is TRANSFERRED
  ## through the refinement relation R: the abstraction relates the concrete count only to valid states, so
  ## R itself carries the bound (r_bounds), and forward simulation preserves R over every run (sim_run), so
  ## the concrete count is ≤ 1 in ALL reachable states. Verify the simple abstract, get the concrete
  ## property for free — the reason stepwise refinement is used in practice.
  type Nat = Z | S(Nat)
  type Bool = F | T
  type AState = AFree | AHeld
  type Event = Acquire | Release
  fn leq(a: Nat, b: Nat) -> Bool = match a
    Z()   -> T()
    S(k)  -> match b
      Z()   -> F()
      S(j)  -> leq(k, j)
  fn stepA(a: AState, e: Event) -> AState = match e
    Acquire() -> AHeld()
    Release() -> AFree()
  fn stepC(n: Nat, e: Event) -> Nat = match e
    Acquire() -> match n
      Z()   -> S(Z())
      S(k)  -> S(k)
    Release() -> match n
      Z()   -> Z()
      S(k)  -> k
  type R indices (c: Nat, a: AState)
    RFree : R(Z, AFree)
    RHeld : R(S(Z), AHeld)
  fn sim_step({c: Nat}, {a: AState}, e: Event, r: R(c, a)) -> R(stepC(c, e), stepA(a, e)) = match r
    RFree() -> match e
      Acquire() -> RHeld()
      Release() -> RFree()
    RHeld() -> match e
      Acquire() -> RHeld()
      Release() -> RFree()
  type EList = ENil | ECons(Event, EList)
  fn runC(c: Nat, es: EList) -> Nat = match es
    ENil()          -> c
    ECons(e, rest)  -> runC(stepC(c, e), rest)
  fn runA(a: AState, es: EList) -> AState = match es
    ENil()          -> a
    ECons(e, rest)  -> runA(stepA(a, e), rest)
  fn sim_run(c: Nat, a: AState, es: EList, r: R(c, a)) -> R(runC(c, es), runA(a, es)) = match es
    ENil()          -> r
    ECons(e, rest)  -> sim_run(stepC(c, e), stepA(a, e), rest, sim_step(e, r))
  fn refines(es: EList) -> R(runC(Z(), es), runA(AFree(), es)) =
    sim_run(Z(), AFree(), es, RFree())
  ## **THE REFINEMENT RELATION CARRIES THE SAFETY BOUND**: any R-related concrete state has count ≤ 1.
  ## R relates the count only to a valid abstract state, so the concrete invariant is encoded in R itself.
  fn r_bounds({c: Nat}, {a: AState}, r: R(c, a)) -> Equivalent(Bool, leq(c, S(Z())), T()) = match r
    RFree() -> reflexive(T())
    RHeld() -> reflexive(T())
  ## **MUTUAL EXCLUSION, OBTAINED BY REFINEMENT**: from the free start, every reachable concrete state has
  ## count ≤ 1 — NOT by a fresh invariant induction on the concrete, but by transferring R (preserved by
  ## simulation) through r_bounds. Safety of the implementation follows from the refinement alone.
  fn mutex_by_refinement(es: EList) -> Equivalent(Bool, leq(runC(Z(), es), S(Z())), T()) =
    r_bounds(refines(es))
end
