mod Inference
  use Std.Decision
  type Tag = TA | TB | TC
  fn ta_ne_tb(p: Equivalent(Tag, TA(), TB())) -> Empty = match p
    reflexive() -> impossible
  fn ta_ne_tc(p: Equivalent(Tag, TA(), TC())) -> Empty = match p
    reflexive() -> impossible
  fn tb_ne_ta(p: Equivalent(Tag, TB(), TA())) -> Empty = match p
    reflexive() -> impossible
  fn tb_ne_tc(p: Equivalent(Tag, TB(), TC())) -> Empty = match p
    reflexive() -> impossible
  fn tc_ne_ta(p: Equivalent(Tag, TC(), TA())) -> Empty = match p
    reflexive() -> impossible
  fn tc_ne_tb(p: Equivalent(Tag, TC(), TB())) -> Empty = match p
    reflexive() -> impossible
  fn tag_eq(a: Tag, b: Tag) -> Decision(Equivalent(Tag, a, b)) = match a
    TA() -> match b
      TA() -> Yes(reflexive(TA()))
      TB() -> No(ta_ne_tb)
      TC() -> No(ta_ne_tc)
    TB() -> match b
      TA() -> No(tb_ne_ta)
      TB() -> Yes(reflexive(TB()))
      TC() -> No(tb_ne_tc)
    TC() -> match b
      TA() -> No(tc_ne_ta)
      TB() -> No(tc_ne_tb)
      TC() -> Yes(reflexive(TC()))
  type TagList = TNil | TCons(Tag, TagList)
  type Handles indices (t: Tag, iface: TagList)
    HHere  : Handles(t, TCons(t, rest))
    HThere : Handles(t, rest) -> Handles(t, TCons(y, rest))
  fn no_handles_nil(t: Tag, p: Handles(t, TNil)) -> Empty = match p
  fn handles_here(t: Tag, h: Tag, rest: TagList, eq: Equivalent(Tag, t, h)) -> Handles(t, TCons(h, rest)) =
    rewrite eq in HHere()
  fn handles_cons_absurd(t: Tag, h: Tag, rest: TagList, neq: (Equivalent(Tag, t, h)) -> Empty, nrest: (Handles(t, rest)) -> Empty, hp: Handles(t, TCons(h, rest))) -> Empty = match hp
    HHere()   -> neq(reflexive(t))
    HThere(q) -> nrest(q)
  fn decide_handles(t: Tag, iface: TagList) -> Decision(Handles(t, iface)) = match iface
    TNil() -> No(fn(p) -> no_handles_nil(t, p))
    TCons(h, rest) -> match tag_eq(t, h)
      Yes(eq) -> Yes(handles_here(t, h, rest, eq))
      No(neq) -> match decide_handles(t, rest)
        Yes(p)    -> Yes(HThere(p))
        No(nrest) -> No(fn(hp) -> handles_cons_absurd(t, h, rest, neq, nrest, hp))
  type AllHandled indices (s: TagList, iface: TagList)
    AHNil  : AllHandled(TNil, iface)
    AHCons : Handles(t, iface) -> AllHandled(rest, iface) -> AllHandled(TCons(t, rest), iface)
  fn ah_head_absurd(t: Tag, rest: TagList, iface: TagList, nt: (Handles(t, iface)) -> Empty, ah: AllHandled(TCons(t, rest), iface)) -> Empty = match ah
    AHCons(ht, ahrest) -> nt(ht)
  fn ah_tail_absurd(t: Tag, rest: TagList, iface: TagList, nrest: (AllHandled(rest, iface)) -> Empty, ah: AllHandled(TCons(t, rest), iface)) -> Empty = match ah
    AHCons(ht, ahrest) -> nrest(ahrest)
  fn decide_all_handled(s: TagList, iface: TagList) -> Decision(AllHandled(s, iface)) = match s
    TNil() -> Yes(AHNil())
    TCons(t, rest) -> match decide_handles(t, iface)
      No(nt)  -> No(fn(ah) -> ah_head_absurd(t, rest, iface, nt, ah))
      Yes(ht) -> match decide_all_handled(rest, iface)
        Yes(hrest) -> Yes(AHCons(ht, hrest))
        No(nrest)  -> No(fn(ah) -> ah_tail_absurd(t, rest, iface, nrest, ah))
end
