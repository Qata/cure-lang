mod InsertionSortPerm
  use Std.Equivalent
  ## INSERTION SORT IS A PERMUTATION — the second half of sorting correctness (sortedness was insertion_sort).
  ## Two lists are permutations iff every element occurs the same number of times; count-preservation is the
  ## clean way to prove it. insert_count: inserting x preserves the multiset (same counts as x::l); the
  ## reordering only commutes two conditional bumps (bump_swap). sort_count: the whole fold preserves every
  ## element's count — so sort(l) is a permutation of l. With sort_sorted this is full sorting correctness.
  type Nat = Z | S(Nat)
  type Bool = F | T
  type List = LNil | LCons(Nat, List)
  fn leq(a: Nat, b: Nat) -> Bool = match a
    Z()   -> T()
    S(k)  -> match b
      Z()   -> F()
      S(j)  -> leq(k, j)
  fn eq(a: Nat, b: Nat) -> Bool = match a
    Z()   -> match b
      Z()   -> T()
      S(j)  -> F()
    S(k)  -> match b
      Z()   -> F()
      S(j)  -> eq(k, j)
  type LeDec indices (x: Nat, y: Nat)
    LeYes : (x2: Nat) -> (y2: Nat) -> Equivalent(Bool, leq(x2, y2), T()) -> LeDec(x2, y2)
    LeNo  : (x2: Nat) -> (y2: Nat) -> Equivalent(Bool, leq(y2, x2), T()) -> LeDec(x2, y2)
  fn cmp(x: Nat, y: Nat) -> LeDec(x, y) = match x
    Z()   -> LeYes(Z(), y, reflexive(T()))
    S(x2) -> match y
      Z()   -> LeNo(S(x2), Z(), reflexive(T()))
      S(y2) -> match cmp(x2, y2)
        LeYes(a, b, e) -> LeYes(S(x2), S(y2), e)
        LeNo(a, b, e)  -> LeNo(S(x2), S(y2), e)
  fn insert_pick(x: Nat, y: Nat, rest: List, d: LeDec(x, y)) -> List = match d
    LeYes(a, b, e) -> LCons(x, LCons(y, rest))
    LeNo(a, b, e)  -> LCons(y, insert(x, rest))
  fn insert(x: Nat, l: List) -> List = match l
    LNil()          -> LCons(x, LNil())
    LCons(y, rest)  -> insert_pick(x, y, rest, cmp(x, y))
  fn sort(l: List) -> List = match l
    LNil()          -> LNil()
    LCons(x, rest)  -> insert(x, sort(rest))
  ## Add one to the count when the element matches.
  fn bump(b: Bool, n: Nat) -> Nat = match b
    T() -> S(n)
    F() -> n
  fn count(x: Nat, l: List) -> Nat = match l
    LNil()          -> Z()
    LCons(y, rest)  -> bump(eq(x, y), count(x, rest))
  fn bump_cong(b: Bool, {n1: Nat}, {n2: Nat}, e: Equivalent(Nat, n1, n2)) -> Equivalent(Nat, bump(b, n1), bump(b, n2)) =
    rewrite e in reflexive(bump(b, n2))
  ## Two conditional bumps commute (the multiset doesn't care about order).
  fn bump_swap(a: Bool, b: Bool, n: Nat) -> Equivalent(Nat, bump(a, bump(b, n)), bump(b, bump(a, n))) = match a
    T() -> match b
      T() -> reflexive(S(S(n)))
      F() -> reflexive(S(n))
    F() -> match b
      T() -> reflexive(S(n))
      F() -> reflexive(n)
  ## **INSERT PRESERVES THE MULTISET**: count(z, insert(x, l)) = count(z, x::l) for every z. The ordered
  ## insertion only relocates x; the differing-order case swaps two bumps (bump_swap).
  fn insert_count(z: Nat, x: Nat, l: List) -> Equivalent(Nat, count(z, insert(x, l)), count(z, LCons(x, l))) = match l
    LNil()          -> reflexive(count(z, LCons(x, LNil())))
    LCons(y, rest)  -> match cmp(x, y)
      LeYes(a, b, e) -> reflexive(count(z, LCons(x, LCons(y, rest))))
      LeNo(a, b, e)  -> trans(bump_cong(eq(z, y), insert_count(z, x, rest)), bump_swap(eq(z, y), eq(z, x), count(z, rest)))
  ## **SORT IS A PERMUTATION**: count(z, sort(l)) = count(z, l) for every z — sort preserves the multiset,
  ## so its output is a permutation of the input. Induction on the list, using insert_count at each step.
  fn sort_count(z: Nat, l: List) -> Equivalent(Nat, count(z, sort(l)), count(z, l)) = match l
    LNil()          -> reflexive(Z())
    LCons(x, rest)  -> trans(insert_count(z, x, sort(rest)), bump_cong(eq(z, x), sort_count(z, rest)))
end
