mod SubtypingPreorder
  use Std.Equivalent
  ## SESSION WIDTH-SUBTYPING IS A PREORDER. merge_glb gave the MEET of the external-choice subtyping order
  ## (Covers = "offers a superset of branches"); this proves the order's own laws — REFLEXIVITY and, the
  ## load-bearing one, TRANSITIVITY (S <: T <: U ⟹ S <: U, what lets refinements chain). Transitivity
  ## rests on membership TRANSPORT: if `big` covers `small` and a branch is in `small`, it is in `big`.
  ## With merge_glb's union-is-the-GLB this makes session subtyping a MEET-SEMILATTICE preorder.
  type Tag = TA | TB | TC
  type Branches = BNil | BCons(Tag, Branches)
  type InB indices (x: Tag, bs: Branches)
    InHead : InB(x, BCons(x, rest))
    InTail : InB(x, rest) -> InB(x, BCons(y, rest))
  type Covers indices (big: Branches, small: Branches)
    CovNil  : Covers(big, BNil)
    CovCons : InB(x, big) -> Covers(big, rest) -> Covers(big, BCons(x, rest))
  fn covers_weaken({big: Branches}, {small: Branches}, y: Tag, w: Covers(big, small)) -> Covers(BCons(y, big), small) = match w
    CovNil()          -> CovNil()
    CovCons(inx, w2)  -> CovCons(InTail(inx), covers_weaken(y, w2))
  ## **REFLEXIVITY**: every branch set covers itself (S <: S).
  fn covers_refl(bs: Branches) -> Covers(bs, bs) = match bs
    BNil()         -> CovNil()
    BCons(x, rest) -> CovCons(InHead(), covers_weaken(x, covers_refl(rest)))
  ## **MEMBERSHIP TRANSPORT** (the crux of transitivity): if `big` covers `small`, every branch of
  ## `small` is a branch of `big`. Induction on the membership derivation, reading the covering witness
  ## at each position: a head membership is exactly the branch CovCons supplied, a tail recurses.
  fn covers_mem({big: Branches}, {small: Branches}, {x: Tag}, cov: Covers(big, small), inm: InB(x, small)) -> InB(x, big) =
    match inm
      InHead()     -> match cov
        CovCons(inx, cov2) -> inx
      InTail(in2)  -> match cov
        CovCons(inx, cov2) -> covers_mem(cov2, in2)
  ## **TRANSITIVITY**: Covers(a,b) and Covers(b,c) ⟹ Covers(a,c) — subtyping chains. Induction on the
  ## second covering: for each branch of c, it is in b (from Covers(b,c)), hence in a (membership
  ## transport through Covers(a,b)), and the rest carries by the induction hypothesis.
  fn covers_trans({a: Branches}, {b: Branches}, {c: Branches}, ab: Covers(a, b), bc: Covers(b, c)) -> Covers(a, c) =
    match bc
      CovNil()          -> CovNil()
      CovCons(inx, bc2) -> CovCons(covers_mem(ab, inx), covers_trans(ab, bc2))
end
