mod SupervisionRestart
  use Std.Equivalent
  ## OTP SUPERVISION restart strategies — the fault-tolerance core. A supervisor holds an ordered list
  ## of children (each tracked by a RESTART GENERATION count). When a child fails, the strategy decides
  ## which children restart (bump their generation): one_for_one restarts only the failed child,
  ## one_for_all restarts EVERY child, rest_for_one restarts the failed child and all started AFTER it.
  type Nat = Z | S(Nat)
  type Children = CNil | CCons(Nat, Children)
  ## one_for_all: bump EVERY child's generation.
  fn bump_all(cs: Children) -> Children = match cs
    CNil()          -> CNil()
    CCons(g, rest)  -> CCons(S(g), bump_all(rest))
  ## one_for_one: bump ONLY the child at index i.
  fn bump_at(cs: Children, i: Nat) -> Children = match i
    Z()    -> match cs
      CNil()         -> CNil()
      CCons(g, rest) -> CCons(S(g), rest)
    S(j)   -> match cs
      CNil()         -> CNil()
      CCons(g, rest) -> CCons(g, bump_at(rest, j))
  ## rest_for_one: bump the child at i and ALL after it.
  fn bump_from(cs: Children, i: Nat) -> Children = match i
    Z()    -> bump_all(cs)
    S(j)   -> match cs
      CNil()         -> CNil()
      CCons(g, rest) -> CCons(g, bump_from(rest, j))
  fn nth(cs: Children, i: Nat) -> Nat = match i
    Z()    -> match cs
      CNil()         -> Z()
      CCons(g, rest) -> g
    S(j)   -> match cs
      CNil()         -> Z()
      CCons(g, rest) -> nth(rest, j)
  ## AllBumped(cs, cs2): cs2 is cs with EVERY generation incremented (all children restarted).
  type AllBumped indices (cs: Children, cs2: Children)
    ABNil  : AllBumped(CNil, CNil)
    ABCons : AllBumped(rest, rest2) -> AllBumped(CCons(g, rest), CCons(S(g), rest2))
  ## **ONE_FOR_ALL RESTARTS EVERY CHILD**: bump_all yields a tree where every child's generation is
  ## incremented — a one_for_all restart brings up ALL siblings afresh, regardless of which failed.
  ## General theorem, by induction on the child list.
  fn one_for_all_correct(cs: Children) -> AllBumped(cs, bump_all(cs)) = match cs
    CNil()          -> ABNil()
    CCons(g, rest)  -> ABCons(one_for_all_correct(rest))
  ## **REST_FOR_ONE AT THE FIRST CHILD = ONE_FOR_ALL**: failing the earliest child restarts everyone —
  ## rest_for_one degenerates to one_for_all when the head fails (definitional coincidence of the two
  ## strategies at index 0).
  fn rest_for_one_head_is_all(cs: Children) -> Equivalent(Children, bump_from(cs, Z()), bump_all(cs)) =
    reflexive(bump_all(cs))
  ## **ONE_FOR_ONE ISOLATES HEALTHY CHILDREN**: when a LATER child fails (index S(i)), the head child's
  ## generation is UNCHANGED — one_for_one contains the fault to the crashed child, leaving siblings
  ## before it untouched (fault isolation, the defining property that distinguishes it from one_for_all).
  fn one_for_one_isolates(g: Nat, rest: Children, i: Nat) -> Equivalent(Nat, nth(bump_at(CCons(g, rest), S(i)), Z()), g) =
    reflexive(g)
end
