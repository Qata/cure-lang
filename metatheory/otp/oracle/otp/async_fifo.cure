mod AsyncFifo
  use Std.Equivalent
  ## UNBOUNDED FIFO async buffers — true PIPELINING: a sender emits several messages before the
  ## receiver consumes any (the single-slot model blocked the second send). A send appends to the
  ## buffer TAIL (snoc); a receive takes the HEAD — so FIFO order is preserved end to end.
  type Tag = TA | TB
  type Local = LEnd | LSend(Tag, Local) | LRecv(Tag, Local)
  type Buf = BNil | BCons(Tag, Buf)
  fn snoc(b: Buf, t: Tag) -> Buf = match b
    BNil()          -> BCons(t, BNil())
    BCons(t2, rest) -> BCons(t2, snoc(rest, t))
  type Config = MkConfig(Local, Local, Buf, Buf)
  type AStep indices (c: Config, c2: Config)
    ASendA : AStep(MkConfig(LSend(t, ka), b, ab, ba), MkConfig(ka, b, snoc(ab, t), ba))
    ARecvB : AStep(MkConfig(a, LRecv(t, kb), BCons(t, ab), ba), MkConfig(a, kb, ab, ba))
    ASendB : AStep(MkConfig(a, LSend(t, kb), ab, ba), MkConfig(a, kb, ab, snoc(ba, t)))
    ARecvA : AStep(MkConfig(LRecv(t, ka), b, ab, BCons(t, ba)), MkConfig(ka, b, ab, ba))
  type ARun indices (c: Config, c2: Config)
    ARDone : ARun(c, c)
    ARStep : AStep(c, cm) -> ARun(cm, c2) -> ARun(c, c2)
  ## Steps with concrete configs (snoc reduces at concrete buffers, and the intermediate is pinned).
  fn p1(t1: Tag, t2: Tag) -> AStep(MkConfig(LSend(t1, LSend(t2, LEnd())), LRecv(t1, LRecv(t2, LEnd())), BNil(), BNil()), MkConfig(LSend(t2, LEnd()), LRecv(t1, LRecv(t2, LEnd())), BCons(t1, BNil()), BNil())) = ASendA()
  fn p2(t1: Tag, t2: Tag) -> AStep(MkConfig(LSend(t2, LEnd()), LRecv(t1, LRecv(t2, LEnd())), BCons(t1, BNil()), BNil()), MkConfig(LEnd(), LRecv(t1, LRecv(t2, LEnd())), BCons(t1, BCons(t2, BNil())), BNil())) = ASendA()
  fn p3(t1: Tag, t2: Tag) -> AStep(MkConfig(LEnd(), LRecv(t1, LRecv(t2, LEnd())), BCons(t1, BCons(t2, BNil())), BNil()), MkConfig(LEnd(), LRecv(t2, LEnd()), BCons(t2, BNil()), BNil())) = ARecvB()
  fn p4(t1: Tag, t2: Tag) -> AStep(MkConfig(LEnd(), LRecv(t2, LEnd()), BCons(t2, BNil()), BNil()), MkConfig(LEnd(), LEnd(), BNil(), BNil())) = ARecvB()
  ## **ASYNC FIFO PIPELINING**: RA sends t1 THEN t2 (both queued in-flight — see the middle state
  ## BCons(t1,BCons(t2,BNil)), two messages buffered at once), then RB receives t1 THEN t2 in order. The
  ## sender never blocks on the receiver (true asynchrony beyond the single-slot model), and the FIFO
  ## buffer preserves message order. Runs to (LEnd,LEnd,empty,empty): orphan-free and terminating.
  fn pipelined(t1: Tag, t2: Tag) -> ARun(MkConfig(LSend(t1, LSend(t2, LEnd())), LRecv(t1, LRecv(t2, LEnd())), BNil(), BNil()), MkConfig(LEnd(), LEnd(), BNil(), BNil())) =
    ARStep(p1(t1, t2), ARStep(p2(t1, t2), ARStep(p3(t1, t2), ARStep(p4(t1, t2), ARDone()))))
end
