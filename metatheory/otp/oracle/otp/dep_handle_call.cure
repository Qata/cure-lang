mod DepHandleCall
  use Std.Equivalent
  ## THE DEPENDENT `handle_call` SHAPE — the integration spine's SERVER side (algebra item 19). The client
  ## boundary ([[dep-call-boundary]] `dep_call_boundary`) types `call(server, req) : ReplyOf(req)`. The SERVER
  ## must produce the matching reply: a gen_server `handle_call` returns `{reply, Reply, NewState}`, and here the
  ## `Reply` component has the request's OWN type `ReplyOf(request)`. This is exactly what the `actor` macro
  ## CANNOT emit today — `actor.cure:181` emits `handle_call ... returns Effect(Tuple(Atom, reply_type, State))`
  ## with a UNIFORM `reply_type`. `handle_call` here is the target the macro must emit: a total function whose
  ## result tuple carries a reply typed PER REQUEST, checked per branch against `ReplyOf` reduced at the matched
  ## constructor — the same dependent-return discipline as `Std.Otp.Proof.handle`, wrapped in the
  ## `%[:reply, _, state]` tuple. (The real callback wraps this in `Effect(...)` and uses `Atom` for the tag; the
  ## `Reply` tag and bare tuple here keep the probe self-contained and Idris-mirrorable.)
  type RName  = Nm
  type RCount = Cnt
  type RAck   = Ack
  type Req = GetCount | SetName(RName) | Ping
  fn ReplyOf(r: Req) -> Type = match r
    GetCount()  -> RCount
    SetName(_)  -> RAck
    Ping()      -> RAck
  type ServerState = MkState
  ## The reply tag (stands for OTP's `:reply` atom).
  type Tag = Reply
  ## `handle_call`'s result: `%[:reply, <the request's own reply>, new state]`. The middle component is
  ## `ReplyOf(request)`, so the SAME callback answers different requests at different reply types — checked per
  ## branch.
  fn handle_call(request: Req, st: ServerState) -> Tuple(Tag, ReplyOf(request), ServerState) = match request
    GetCount()  -> %[Reply, Cnt, st]
    SetName(n)  -> %[Reply, Ack, st]
    Ping()      -> %[Reply, Ack, st]
end
