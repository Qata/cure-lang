mod TwoPhaseCommit
  use Std.Equivalent
  ## TWO-PHASE COMMIT SAFETY — a distributed-protocol correctness proof (a fresh domain: atomic commitment).
  ## Participants vote; the coordinator commits IFF every vote is yes, else aborts. Proved: VALIDITY (commit
  ## iff unanimous — `commit_valid` and `valid_commit`, the ⟹ direction via the convoy pattern so the boolean
  ## match refines the decision hypothesis and the abort branch refutes `Abort = Commit`); a REFLECTION between
  ## the boolean `all_yes` check and an inductive HasNo ("some participant voted No") — soundness (`hasno_sound`)
  ## and completeness (`hasno_complete`), so a failed unanimity always exhibits a concrete dissenter; that a
  ## dissenter FORCES ABORT (`abort_on_no` — no participant commits over a veto); and ATOMICITY / uniform
  ## agreement (`atomicity`) — every participant reaches the SAME decision, so none commits while another
  ## aborts (the outcome vector is uniformly the coordinator's decision, via `AllSame` + `all_same_replicate`).
  type Bool = F | T
  type Vote = VYes | VNo
  type Votes = VNil | VCons(Vote, Votes)
  fn all_yes(vs: Votes) -> Bool = match vs
    VNil()          -> T()
    VCons(v, rest)  -> match v
      VYes() -> all_yes(rest)
      VNo()  -> F()
  type Decision = Commit | Abort
  fn decide_b(b: Bool) -> Decision = match b
    T() -> Commit()
    F() -> Abort()
  ## The coordinator commits iff EVERY participant voted yes, else aborts.
  fn decide(vs: Votes) -> Decision = decide_b(all_yes(vs))
  ## Evidence that at least one participant voted NO.
  type HasNo indices (vs: Votes)
    HNHere  : (rest: Votes) -> HasNo(VCons(VNo, rest))
    HNThere : (v: Vote) -> (rest: Votes) -> HasNo(rest) -> HasNo(VCons(v, rest))
  ## **A NO VOTE FALSIFIES UNANIMITY** (soundness of the boolean check against the inductive predicate).
  fn hasno_sound(vs: Votes, h: HasNo(vs)) -> Equivalent(Bool, all_yes(vs), F()) = match h
    HNHere(rest)          -> reflexive(F())
    HNThere(v, rest, h2)  -> match v
      VYes() -> hasno_sound(rest, h2)
      VNo()  -> reflexive(F())
  ## **FAILED UNANIMITY EXHIBITS A NO VOTE** (completeness — every abort has a concrete dissenter).
  fn hasno_complete(vs: Votes, e: Equivalent(Bool, all_yes(vs), F())) -> HasNo(vs) = match vs
    VNil()          -> match e
    VCons(v, rest)  -> match v
      VYes() -> HNThere(VYes(), rest, hasno_complete(rest, e))
      VNo()  -> HNHere(rest)
  ## **VALIDITY (commit ⟸ unanimity)**: if all voted yes, the decision is Commit.
  fn commit_valid(vs: Votes, e: Equivalent(Bool, all_yes(vs), T())) -> Equivalent(Decision, decide(vs), Commit()) = rewrite e in reflexive(Commit())
  ## **VALIDITY (commit ⟹ unanimity)**: a Commit decision implies every participant voted yes (convoy so the
  ## boolean match refines the decision hypothesis; the Abort branch refutes `Abort = Commit`).
  fn valid_commit_b(b: Bool) -> ((Equivalent(Decision, decide_b(b), Commit())) -> Equivalent(Bool, b, T())) = match b
    T() -> fn(e) -> reflexive(T())
    F() -> fn(e) -> match e
  fn valid_commit(vs: Votes, e: Equivalent(Decision, decide(vs), Commit())) -> Equivalent(Bool, all_yes(vs), T()) = valid_commit_b(all_yes(vs))(e)
  ## **A DISSENTER FORCES ABORT**: any No vote makes the decision Abort (no participant commits over a veto).
  fn abort_on_no(vs: Votes, h: HasNo(vs)) -> Equivalent(Decision, decide(vs), Abort()) = rewrite hasno_sound(vs, h) in reflexive(Abort())
  ## The broadcast phase: every participant adopts the coordinator's single decision.
  type DList = DNil | DCons(Decision, DList)
  fn outcomes(d: Decision, vs: Votes) -> DList = match vs
    VNil()          -> DNil()
    VCons(v, rest)  -> DCons(d, outcomes(d, rest))
  ## Every element of the outcome list equals d.
  type AllSame indices (d: Decision, ds: DList)
    ASNil  : AllSame(d, DNil)
    ASCons : (d0: Decision) -> (rest: DList) -> AllSame(d0, rest) -> AllSame(d0, DCons(d0, rest))
  fn all_same_replicate(d: Decision, vs: Votes) -> AllSame(d, outcomes(d, vs)) = match vs
    VNil()          -> ASNil()
    VCons(v, rest)  -> ASCons(d, outcomes(d, rest), all_same_replicate(d, rest))
  ## **ATOMICITY / UNIFORM AGREEMENT**: every participant reaches the SAME decision — no participant commits
  ## while another aborts. The outcome vector is uniformly the coordinator's decision.
  fn atomicity(vs: Votes) -> AllSame(decide(vs), outcomes(decide(vs), vs)) = all_same_replicate(decide(vs), vs)
end
