mod KeyLattice
  use Std.Equivalent
  ## A TOTAL ORDER INDUCES A DISTRIBUTIVE LATTICE. The certified order (OA < OB < OC) with kmin = meet and
  ## kmax = join is not just a meet-semilattice: it is a full DISTRIBUTIVE lattice. Beyond kmax_assoc (the
  ## join's associativity, the KeyOrder open item), the two ABSORPTION laws tie meet and join into a
  ## lattice, and DISTRIBUTIVITY (each of meet/join distributes over the other) — the property that fails
  ## in a general lattice but always holds for a chain — completes the structure underlying every ordered
  ## structure here (Bst / Gbt / PQueue). Proved by exhaustive casing; each case computes and reflects.
  type OKey = OA | OB | OC
  type OBit = OF | OT
  fn le(a: OKey, b: OKey) -> OBit = match a
    OA() -> OT()
    OB() -> match b
      OA() -> OF()
      OB() -> OT()
      OC() -> OT()
    OC() -> match b
      OA() -> OF()
      OB() -> OF()
      OC() -> OT()
  fn kmin(a: OKey, b: OKey) -> OKey = match le(a, b)
    OT() -> a
    OF() -> b
  fn kmax(a: OKey, b: OKey) -> OKey = match le(a, b)
    OT() -> b
    OF() -> a
  ## **JOIN ASSOCIATIVITY** (kmax_assoc, the KeyOrder open item): kmax(kmax(a,b),c) = kmax(a,kmax(b,c)).
  fn kmax_assoc(a: OKey, b: OKey, c: OKey) -> Equivalent(OKey, kmax(kmax(a, b), c), kmax(a, kmax(b, c))) = match a
      OA() -> match b
        OA() -> match c
          OA() -> reflexive(OA())
          OB() -> reflexive(OB())
          OC() -> reflexive(OC())
        OB() -> match c
          OA() -> reflexive(OB())
          OB() -> reflexive(OB())
          OC() -> reflexive(OC())
        OC() -> match c
          OA() -> reflexive(OC())
          OB() -> reflexive(OC())
          OC() -> reflexive(OC())
      OB() -> match b
        OA() -> match c
          OA() -> reflexive(OB())
          OB() -> reflexive(OB())
          OC() -> reflexive(OC())
        OB() -> match c
          OA() -> reflexive(OB())
          OB() -> reflexive(OB())
          OC() -> reflexive(OC())
        OC() -> match c
          OA() -> reflexive(OC())
          OB() -> reflexive(OC())
          OC() -> reflexive(OC())
      OC() -> match b
        OA() -> match c
          OA() -> reflexive(OC())
          OB() -> reflexive(OC())
          OC() -> reflexive(OC())
        OB() -> match c
          OA() -> reflexive(OC())
          OB() -> reflexive(OC())
          OC() -> reflexive(OC())
        OC() -> match c
          OA() -> reflexive(OC())
          OB() -> reflexive(OC())
          OC() -> reflexive(OC())
  ## **ABSORPTION** kmin(a, kmax(a,b)) = a — meet absorbs join.
  fn kmin_absorb(a: OKey, b: OKey) -> Equivalent(OKey, kmin(a, kmax(a, b)), a) = match a
      OA() -> match b
        OA() -> reflexive(OA())
        OB() -> reflexive(OA())
        OC() -> reflexive(OA())
      OB() -> match b
        OA() -> reflexive(OB())
        OB() -> reflexive(OB())
        OC() -> reflexive(OB())
      OC() -> match b
        OA() -> reflexive(OC())
        OB() -> reflexive(OC())
        OC() -> reflexive(OC())
  ## **ABSORPTION** kmax(a, kmin(a,b)) = a — join absorbs meet. With kmin_absorb these make (OKey,kmin,kmax) a lattice.
  fn kmax_absorb(a: OKey, b: OKey) -> Equivalent(OKey, kmax(a, kmin(a, b)), a) = match a
      OA() -> match b
        OA() -> reflexive(OA())
        OB() -> reflexive(OA())
        OC() -> reflexive(OA())
      OB() -> match b
        OA() -> reflexive(OB())
        OB() -> reflexive(OB())
        OC() -> reflexive(OB())
      OC() -> match b
        OA() -> reflexive(OC())
        OB() -> reflexive(OC())
        OC() -> reflexive(OC())
  ## **DISTRIBUTIVITY** meet over join: kmin(a, kmax(b,c)) = kmax(kmin(a,b), kmin(a,c)).
  fn kmin_distrib_kmax(a: OKey, b: OKey, c: OKey) -> Equivalent(OKey, kmin(a, kmax(b, c)), kmax(kmin(a, b), kmin(a, c))) = match a
      OA() -> match b
        OA() -> match c
          OA() -> reflexive(OA())
          OB() -> reflexive(OA())
          OC() -> reflexive(OA())
        OB() -> match c
          OA() -> reflexive(OA())
          OB() -> reflexive(OA())
          OC() -> reflexive(OA())
        OC() -> match c
          OA() -> reflexive(OA())
          OB() -> reflexive(OA())
          OC() -> reflexive(OA())
      OB() -> match b
        OA() -> match c
          OA() -> reflexive(OA())
          OB() -> reflexive(OB())
          OC() -> reflexive(OB())
        OB() -> match c
          OA() -> reflexive(OB())
          OB() -> reflexive(OB())
          OC() -> reflexive(OB())
        OC() -> match c
          OA() -> reflexive(OB())
          OB() -> reflexive(OB())
          OC() -> reflexive(OB())
      OC() -> match b
        OA() -> match c
          OA() -> reflexive(OA())
          OB() -> reflexive(OB())
          OC() -> reflexive(OC())
        OB() -> match c
          OA() -> reflexive(OB())
          OB() -> reflexive(OB())
          OC() -> reflexive(OC())
        OC() -> match c
          OA() -> reflexive(OC())
          OB() -> reflexive(OC())
          OC() -> reflexive(OC())
  ## **DISTRIBUTIVITY** join over meet: kmax(a, kmin(b,c)) = kmin(kmax(a,b), kmax(a,c)). OKey is a DISTRIBUTIVE lattice.
  fn kmax_distrib_kmin(a: OKey, b: OKey, c: OKey) -> Equivalent(OKey, kmax(a, kmin(b, c)), kmin(kmax(a, b), kmax(a, c))) = match a
      OA() -> match b
        OA() -> match c
          OA() -> reflexive(OA())
          OB() -> reflexive(OA())
          OC() -> reflexive(OA())
        OB() -> match c
          OA() -> reflexive(OA())
          OB() -> reflexive(OB())
          OC() -> reflexive(OB())
        OC() -> match c
          OA() -> reflexive(OA())
          OB() -> reflexive(OB())
          OC() -> reflexive(OC())
      OB() -> match b
        OA() -> match c
          OA() -> reflexive(OB())
          OB() -> reflexive(OB())
          OC() -> reflexive(OB())
        OB() -> match c
          OA() -> reflexive(OB())
          OB() -> reflexive(OB())
          OC() -> reflexive(OB())
        OC() -> match c
          OA() -> reflexive(OB())
          OB() -> reflexive(OB())
          OC() -> reflexive(OC())
      OC() -> match b
        OA() -> match c
          OA() -> reflexive(OC())
          OB() -> reflexive(OC())
          OC() -> reflexive(OC())
        OB() -> match c
          OA() -> reflexive(OC())
          OB() -> reflexive(OC())
          OC() -> reflexive(OC())
        OC() -> match c
          OA() -> reflexive(OC())
          OB() -> reflexive(OC())
          OC() -> reflexive(OC())
end
