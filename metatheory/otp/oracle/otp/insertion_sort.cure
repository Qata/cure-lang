mod InsertionSort
  use Std.Equivalent
  ## INSERTION SORT PRODUCES SORTED OUTPUT — algorithm verification (a fresh domain). Keys are Nat under a
  ## total order; sortedness is an inductive predicate (each head ≤ all that follow). The proof composes
  ## several inductions: le_trans (order transitivity), an evidence-carrying comparison cmp, leall_trans (a
  ## lower bound survives transitivity), insert_leall (insertion preserves a lower bound), insert_sorted
  ## (inserting into a sorted list keeps it sorted), and sort_sorted (the whole fold is sorted).
  type Nat = Z | S(Nat)
  type Bool = F | T
  type List = LNil | LCons(Nat, List)
  fn leq(a: Nat, b: Nat) -> Bool = match a
    Z()   -> T()
    S(k)  -> match b
      Z()   -> F()
      S(j)  -> leq(k, j)
  fn le_trans(a: Nat, b: Nat, c: Nat, hab: Equivalent(Bool, leq(a, b), T()), hbc: Equivalent(Bool, leq(b, c), T())) -> Equivalent(Bool, leq(a, c), T()) = match a
    Z()   -> reflexive(T())
    S(a2) -> match b
      Z()   -> match hab
      S(b2) -> match c
        Z()   -> match hbc
        S(c2) -> le_trans(a2, b2, c2, hab, hbc)
  ## Evidence-carrying comparison (indices explicit so the constructor pins the right LeDec).
  type LeDec indices (x: Nat, y: Nat)
    LeYes : (x2: Nat) -> (y2: Nat) -> Equivalent(Bool, leq(x2, y2), T()) -> LeDec(x2, y2)
    LeNo  : (x2: Nat) -> (y2: Nat) -> Equivalent(Bool, leq(y2, x2), T()) -> LeDec(x2, y2)
  fn cmp(x: Nat, y: Nat) -> LeDec(x, y) = match x
    Z()   -> LeYes(Z(), y, reflexive(T()))
    S(x2) -> match y
      Z()   -> LeNo(S(x2), Z(), reflexive(T()))
      S(y2) -> match cmp(x2, y2)
        LeYes(a, b, e) -> LeYes(S(x2), S(y2), e)
        LeNo(a, b, e)  -> LeNo(S(x2), S(y2), e)
  fn insert_pick(x: Nat, y: Nat, rest: List, d: LeDec(x, y)) -> List = match d
    LeYes(a, b, e) -> LCons(x, LCons(y, rest))
    LeNo(a, b, e)  -> LCons(y, insert(x, rest))
  fn insert(x: Nat, l: List) -> List = match l
    LNil()          -> LCons(x, LNil())
    LCons(y, rest)  -> insert_pick(x, y, rest, cmp(x, y))
  type LeAll indices (x: Nat, l: List)
    LANil  : LeAll(x, LNil)
    LACons : (y: Nat) -> (rest: List) -> Equivalent(Bool, leq(x, y), T()) -> LeAll(x, rest) -> LeAll(x, LCons(y, rest))
  type Sorted indices (l: List)
    SNil  : Sorted(LNil)
    SCons : (x: Nat) -> (rest: List) -> LeAll(x, rest) -> Sorted(rest) -> Sorted(LCons(x, rest))
  fn leall_trans(x: Nat, y: Nat, l: List, hxy: Equivalent(Bool, leq(x, y), T()), hl: LeAll(y, l)) -> LeAll(x, l) = match hl
    LANil()               -> LANil()
    LACons(z, rest, hyz, hl2) -> LACons(z, rest, le_trans(x, y, z, hxy, hyz), leall_trans(x, y, rest, hxy, hl2))
  fn insert_leall(z: Nat, x: Nat, l: List, hz: Equivalent(Bool, leq(z, x), T()), hl: LeAll(z, l)) -> LeAll(z, insert(x, l)) = match l
    LNil()          -> LACons(x, LNil(), hz, LANil())
    LCons(y, rest)  -> match cmp(x, y)
      LeYes(a, b, e) -> LACons(x, LCons(y, rest), hz, hl)
      LeNo(a, b, e)  -> match hl
        LACons(y2, rest2, hzy, hl2) -> LACons(y, insert(x, rest), hzy, insert_leall(z, x, rest, hz, hl2))
  ## **INSERT PRESERVES SORTEDNESS**: Sorted(l) ⟹ Sorted(insert(x, l)).
  fn insert_sorted(x: Nat, l: List, h: Sorted(l)) -> Sorted(insert(x, l)) = match l
    LNil()          -> SCons(x, LNil(), LANil(), SNil())
    LCons(y, rest)  -> match cmp(x, y)
      LeYes(a, b, e) -> match h
        SCons(y2, rest2, la, sr) -> SCons(x, LCons(y, rest), LACons(y, rest, e, leall_trans(x, y, rest, e, la)), h)
      LeNo(a, b, e)  -> match h
        SCons(y2, rest2, la, sr) -> SCons(y, insert(x, rest), insert_leall(y, x, rest, e, la), insert_sorted(x, rest, sr))
  fn sort(l: List) -> List = match l
    LNil()          -> LNil()
    LCons(x, rest)  -> insert(x, sort(rest))
  ## **INSERTION SORT PRODUCES A SORTED LIST**: Sorted(sort(l)) for every input.
  fn sort_sorted(l: List) -> Sorted(sort(l)) = match l
    LNil()          -> SNil()
    LCons(x, rest)  -> insert_sorted(x, sort(rest), sort_sorted(rest))
end
