mod NaryMerge
  use Std.Equivalent
  type TB2 = F | T
  type Tag = TA | TB | TC
  fn tag_eq(x: Tag, y: Tag) -> TB2 = match x
    TA() -> match y
      TA() -> T()
      TB() -> F()
      TC() -> F()
    TB() -> match y
      TA() -> F()
      TB() -> T()
      TC() -> F()
    TC() -> match y
      TA() -> F()
      TB() -> F()
      TC() -> T()
  type Local = LEnd | LRecv(Tag, Local) | LBra(Branches) | LErr
  type Branches = BNil | BCons(Tag, Local, Branches)
  ## Union two external-choice branch lists by CONCATENATION (the bystander accepts any label either
  ## branch offered). Defined BEFORE merge so merge's forward reference certifies immediately.
  fn union_branches(bs1: Branches, bs2: Branches) -> Branches = match bs1
    BNil()            -> bs2
    BCons(t, k, rest) -> BCons(t, k, union_branches(rest, bs2))
  fn is_err(l: Local) -> TB2 = match l
    LEnd()      -> F()
    LRecv(t, k) -> F()
    LBra(bs)    -> F()
    LErr()      -> T()
  ## The BRANCH-MERGE operator, n-ary. Same-tag receives merge pointwise; DIFFERING receives union into
  ## a two-branch external choice; two external choices union their branch lists; mismatched shapes
  ## conflict (LErr).
  fn merge(x: Local, y: Local) -> Local = match x
    LEnd()        -> match y
      LEnd()        -> LEnd()
      LRecv(t2, k2) -> LErr()
      LBra(bs2)     -> LErr()
      LErr()        -> LErr()
    LRecv(t1, k1) -> match y
      LEnd()        -> LErr()
      LRecv(t2, k2) -> match tag_eq(t1, t2)
        T() -> LRecv(t1, merge(k1, k2))
        F() -> LBra(BCons(t1, k1, BCons(t2, k2, BNil())))
      LBra(bs2)     -> LErr()
      LErr()        -> LErr()
    LBra(bs1)     -> match y
      LEnd()        -> LErr()
      LRecv(t2, k2) -> LErr()
      LBra(bs2)     -> LBra(union_branches(bs1, bs2))
      LErr()        -> LErr()
    LErr()        -> LErr()
  type Mergeable indices (x: Local, y: Local)
    MgEnd    : Mergeable(LEnd, LEnd)
    MgRecvEq : (t: Tag) -> Mergeable(k1, k2) -> Mergeable(LRecv(t, k1), LRecv(t, k2))
    MgRecvNe : (a: Tag) -> (b: Tag) -> Equivalent(TB2, tag_eq(a, b), F()) -> Mergeable(LRecv(a, k1), LRecv(b, k2))
    MgBra    : Mergeable(LBra(bs1), LBra(bs2))
  ## **N-ARY BYSTANDER DEFINEDNESS**: Mergeable(x,y) ⟹ merge(x,y) is DEFINED (not LErr). A bystander
  ## combining its branch-behaviours across an n-ary choice never conflicts when they are mergeable —
  ## the projectability foundation, generalized binary→n-ary. The two-choice case is unconditional
  ## (merging any two external choices yields an LBra, never LErr at the top); receive cases reduce
  ## merge one step (tag cased concretely) to a non-LErr head.
  fn merge_ok({x: Local}, {y: Local}, w: Mergeable(x, y)) -> Equivalent(TB2, is_err(merge(x, y)), F()) = match w
    MgEnd()             -> reflexive(F())
    MgRecvEq(t, m)      -> match t
      TA() -> reflexive(F())
      TB() -> reflexive(F())
      TC() -> reflexive(F())
    MgRecvNe(a, b, pne) -> match a
      TA() -> match b
        TA() -> match pne
        TB() -> reflexive(F())
        TC() -> reflexive(F())
      TB() -> match b
        TA() -> reflexive(F())
        TB() -> match pne
        TC() -> reflexive(F())
      TC() -> match b
        TA() -> reflexive(F())
        TB() -> reflexive(F())
        TC() -> match pne
    MgBra()             -> reflexive(F())
end
