mod AsyncServer
  use Std.Equivalent
  ## A gen_server serving a WORKLOAD: a client makes a whole batch of gen_server:call requests, the
  ## server handles each (receive request, send back reply_for(request)) and moves to the next — over
  ## the async mailbox. Proves the batch is served to completion, for ANY request list, with each reply
  ## dependently typed by its request. This is the gen_server call loop over a real workload.
  type Msg = MGet | MPut | MVal | MAck
  fn reply_for(m: Msg) -> Msg = match m
    MGet() -> MVal()
    MPut() -> MAck()
    MVal() -> MVal()
    MAck() -> MAck()
  type Local = LEnd | LSend(Msg, Local) | LRecv(Msg, Local)
  type Reqs = RNil | RCons(Msg, Reqs)
  ## The client / server session types generated by a request list: per request, send-then-recv (client)
  ## / recv-then-send (server), the reply label computed by reply_for.
  fn client_local(rs: Reqs) -> Local = match rs
    RNil()            -> LEnd()
    RCons(req, rest)  -> LSend(req, LRecv(reply_for(req), client_local(rest)))
  fn server_local(rs: Reqs) -> Local = match rs
    RNil()            -> LEnd()
    RCons(req, rest)  -> LRecv(req, LSend(reply_for(req), server_local(rest)))
  type Buf = BEmpty | BFull(Msg)
  type Config = MkConfig(Local, Local, Buf, Buf)
  type AStep indices (c: Config, c2: Config)
    ASendA : AStep(MkConfig(LSend(t, ka), b, BEmpty, ba), MkConfig(ka, b, BFull(t), ba))
    ARecvB : AStep(MkConfig(a, LRecv(t, kb), BFull(t), ba), MkConfig(a, kb, BEmpty, ba))
    ASendB : AStep(MkConfig(a, LSend(t, kb), ab, BEmpty), MkConfig(a, kb, ab, BFull(t)))
    ARecvA : AStep(MkConfig(LRecv(t, ka), b, ab, BFull(t)), MkConfig(ka, b, ab, BEmpty))
  type ARun indices (c: Config, c2: Config)
    ARDone : ARun(c, c)
    ARStep : AStep(c, cm) -> ARun(cm, c2) -> ARun(c, c2)
  ## One call cycle (client=slot a, server=slot b), continuations kc/ks threaded; concrete types pin
  ## the intermediates.
  fn cyc1(req: Msg, kc: Local, ks: Local) -> AStep(MkConfig(LSend(req, LRecv(reply_for(req), kc)), LRecv(req, LSend(reply_for(req), ks)), BEmpty(), BEmpty()), MkConfig(LRecv(reply_for(req), kc), LRecv(req, LSend(reply_for(req), ks)), BFull(req), BEmpty())) = ASendA()
  fn cyc2(req: Msg, kc: Local, ks: Local) -> AStep(MkConfig(LRecv(reply_for(req), kc), LRecv(req, LSend(reply_for(req), ks)), BFull(req), BEmpty()), MkConfig(LRecv(reply_for(req), kc), LSend(reply_for(req), ks), BEmpty(), BEmpty())) = ARecvB()
  fn cyc3(req: Msg, kc: Local, ks: Local) -> AStep(MkConfig(LRecv(reply_for(req), kc), LSend(reply_for(req), ks), BEmpty(), BEmpty()), MkConfig(LRecv(reply_for(req), kc), ks, BEmpty(), BFull(reply_for(req)))) = ASendB()
  fn cyc4(req: Msg, kc: Local, ks: Local) -> AStep(MkConfig(LRecv(reply_for(req), kc), ks, BEmpty(), BFull(reply_for(req))), MkConfig(kc, ks, BEmpty(), BEmpty())) = ARecvA()
  ## **gen_server SERVES A BATCH OF DEPENDENT CALLS**: for ANY request list rs, the async session
  ## between client_local(rs) and server_local(rs) runs to completion — every call's request is
  ## delivered, handled, and its dependently-typed reply (reply_for(req)) returned, the next call
  ## proceeding after; the mailbox ends empty. Induction on the request list: the empty workload is
  ## done, and each call is a four-step round-trip that returns both sides to the tail's session. So a
  ## gen_server correctly serves an arbitrary sequence of typed calls, asynchronously, with no deadlock
  ## or orphaned reply.
  fn batch_serves(rs: Reqs) -> ARun(MkConfig(client_local(rs), server_local(rs), BEmpty(), BEmpty()), MkConfig(LEnd(), LEnd(), BEmpty(), BEmpty())) = match rs
    RNil()           -> ARDone()
    RCons(req, rest) -> ARStep(cyc1(req, client_local(rest), server_local(rest)), ARStep(cyc2(req, client_local(rest), server_local(rest)), ARStep(cyc3(req, client_local(rest), server_local(rest)), ARStep(cyc4(req, client_local(rest), server_local(rest)), batch_serves(rest)))))
end
