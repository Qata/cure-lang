mod Reach
  use Std.Equivalent
  ## GRAPH REACHABILITY — a fresh GRAPH-THEORY domain. A graph is given by an adjacency test `edge`; `Reach` is
  ## unbounded reachability (the reflexive-transitive closure of `edge`), `ReachN` is step-counted reachability
  ## (reachable in EXACTLY k steps). Proved: reachability is TRANSITIVE (`reach_trans` — with `RRefl`, a
  ## preorder — by concatenating the two walks); counted reachability COMPOSES ADDITIVELY (`reachn_trans`: a
  ## j-step walk followed by a k-step walk is a `(j+k)`-step walk — the walk lengths ADD, the operational
  ## content behind transitivity); and unbounded reachability EQUALS the existence of a bounded walk
  ## (`reach_to_ex` / `ex_to_reach`, both directions) — the declarative closure and the operational
  ## step-counted walk coincide. Every proof is edge-AGNOSTIC: it only threads the `edge(u,mid)=T` witnesses,
  ## never inspecting the concrete graph, so the results hold for any adjacency relation.
  type Nat = Z | S(Nat)
  type Bool = F | T
  fn plus(a: Nat, b: Nat) -> Nat = match a
    Z()   -> b
    S(k)  -> S(plus(k, b))
  fn eqn(a: Nat, b: Nat) -> Bool = match a
    Z()   -> match b
      Z()   -> T()
      S(k)  -> F()
    S(j)  -> match b
      Z()   -> F()
      S(k)  -> eqn(j, k)
  ## The graph, as an adjacency test. (Concrete instance — a path graph u → u+1 — but every proof below is
  ## edge-AGNOSTIC: it only ever passes the `edge(u,mid)=T` witnesses around, never inspecting this definition.)
  fn edge(u: Nat, v: Nat) -> Bool = eqn(S(u), v)
  ## Unbounded reachability: the reflexive-transitive closure of the edge relation.
  type Reach indices (u: Nat, v: Nat)
    RRefl : (x: Nat) -> Reach(x, x)
    RStep : (u2: Nat) -> (v2: Nat) -> (mid: Nat) -> Equivalent(Bool, edge(u2, mid), T()) -> Reach(mid, v2) -> Reach(u2, v2)
  ## **REACHABILITY IS TRANSITIVE** (with RRefl, a preorder): concatenate the two walks.
  fn reach_trans(u: Nat, v: Nat, w: Nat, r1: Reach(u, v), r2: Reach(v, w)) -> Reach(u, w) = match r1
    RRefl(x)                  -> r2
    RStep(u2, v2, mid, e, r0) -> RStep(u2, w, mid, e, reach_trans(mid, v, w, r0, r2))
  ## Step-counted reachability: reachable in EXACTLY k steps.
  type ReachN indices (k: Nat, u: Nat, v: Nat)
    RN0 : (x: Nat) -> ReachN(Z, x, x)
    RNS : (k2: Nat) -> (u2: Nat) -> (v2: Nat) -> (mid: Nat) -> Equivalent(Bool, edge(u2, mid), T()) -> ReachN(k2, mid, v2) -> ReachN(S(k2), u2, v2)
  ## **COUNTED REACHABILITY COMPOSES ADDITIVELY**: a j-step walk then a k-step walk is a (j+k)-step walk. The
  ## walk lengths ADD — the operational content behind transitivity, tracking path length exactly.
  fn reachn_trans(j: Nat, u: Nat, v: Nat, k: Nat, w: Nat, r1: ReachN(j, u, v), r2: ReachN(k, v, w)) -> ReachN(plus(j, k), u, w) = match r1
    RN0(x)                        -> r2
    RNS(j0, u2, v2, mid, e, r0)   -> RNS(plus(j0, k), u2, w, mid, e, reachn_trans(j0, mid, v, k, w, r0, r2))
  ## Existence of a bounded walk from u to v (the step count is packed away).
  type ExReachN indices (u: Nat, v: Nat)
    MkEx : (k: Nat) -> (u2: Nat) -> (v2: Nat) -> ReachN(k, u2, v2) -> ExReachN(u2, v2)
  ## **UNBOUNDED REACHABILITY = EXISTENCE OF A BOUNDED WALK** (both directions), so the declarative closure and
  ## the operational step-counted walk agree.
  fn reachn_to_reach(k: Nat, u: Nat, v: Nat, rn: ReachN(k, u, v)) -> Reach(u, v) = match rn
    RN0(x)                        -> RRefl(x)
    RNS(k0, u2, v2, mid, e, r0)   -> RStep(u2, v2, mid, e, reachn_to_reach(k0, mid, v2, r0))
  fn reach_to_ex(u: Nat, v: Nat, r: Reach(u, v)) -> ExReachN(u, v) = match r
    RRefl(x)                  -> MkEx(Z(), x, x, RN0(x))
    RStep(u2, v2, mid, e, r0) -> match reach_to_ex(mid, v2, r0)
      MkEx(k, mu, mv, rn) -> MkEx(S(k), u2, v2, RNS(k, u2, v2, mid, e, rn))
  fn ex_to_reach(u: Nat, v: Nat, ex: ExReachN(u, v)) -> Reach(u, v) = match ex
    MkEx(k, u2, v2, rn) -> reachn_to_reach(k, u2, v2, rn)
end
