mod ConcMutex
  use Std.Equivalent
  ## COMPOSITIONAL SAFETY — two CONCURRENT processes, interleaved, never both in the critical section. This
  ## is the canonical concurrent property (mutual exclusion) and the first PARALLEL-composition result: the
  ## configuration holds both processes' states; a Move advances ONE process (interleaving); entry is
  ## GUARDED on the other process not being critical. mutex_step proves every interleaved move preserves the
  ## joint invariant, and mutex_safe lifts it to all reachable configurations from the idle start.
  type Bool = F | T
  type P = Idle | Crit
  type Config = MkConfig(P, P)
  type Move = Enter1 | Exit1 | Enter2 | Exit2
  ## The joint invariant: not both critical.
  fn mutex(c: Config) -> Bool = match c
    MkConfig(p1, p2) -> match p1
      Idle() -> T()
      Crit() -> match p2
        Idle() -> T()
        Crit() -> F()
  ## Interleaved step: one process moves. Enter is guarded on the OTHER not being critical.
  fn step(c: Config, m: Move) -> Config = match c
    MkConfig(p1, p2) -> match m
      Enter1() -> match p2
        Idle() -> MkConfig(Crit(), p2)
        Crit() -> MkConfig(p1, p2)
      Exit1()  -> MkConfig(Idle(), p2)
      Enter2() -> match p1
        Idle() -> MkConfig(p1, Crit())
        Crit() -> MkConfig(p1, p2)
      Exit2()  -> MkConfig(p1, Idle())
  ## **EVERY INTERLEAVED MOVE PRESERVES MUTUAL EXCLUSION**: mutex(c) ⟹ mutex(step(c,m)). The guards make
  ## the entry cases safe; the case that would violate it (entering while the peer is critical) is refuted
  ## by the invariant hypothesis.
  fn mutex_step(c: Config, m: Move, h: Equivalent(Bool, mutex(c), T())) -> Equivalent(Bool, mutex(step(c, m)), T()) = match c
    MkConfig(p1, p2) -> match m
      Enter1() -> match p2
        Idle() -> reflexive(T())
        Crit() -> match p1
          Idle() -> reflexive(T())
          Crit() -> match h
      Exit1()  -> reflexive(T())
      Enter2() -> match p1
        Idle() -> reflexive(T())
        Crit() -> match p2
          Idle() -> reflexive(T())
          Crit() -> match h
      Exit2()  -> match p1
        Idle() -> reflexive(T())
        Crit() -> reflexive(T())
  ## Reachability under interleaving.
  type Run indices (c: Config, c2: Config)
    RDone : Run(c, c)
    RStep : (m: Move) -> Run(step(c, m), c2) -> Run(c, c2)
  ## **MUTUAL EXCLUSION IN ALL REACHABLE CONFIGURATIONS**: mutex(c) and Run(c,c2) ⟹ mutex(c2). Induction on
  ## the interleaved run, applying mutex_step at each move.
  fn mutex_reachable(c: Config, {c2: Config}, h: Equivalent(Bool, mutex(c), T()), run: Run(c, c2)) -> Equivalent(Bool, mutex(c2), T()) = match run
    RDone()        -> h
    RStep(m, run2) -> mutex_reachable(step(c, m), mutex_step(c, m, h), run2)
  ## **CONCURRENT MUTUAL EXCLUSION IS SAFE**: from both-idle, no reachable interleaving ever puts both
  ## processes in the critical section — whatever the schedule.
  fn mutex_safe({c2: Config}, run: Run(MkConfig(Idle(), Idle()), c2)) -> Equivalent(Bool, mutex(c2), T()) =
    mutex_reachable(MkConfig(Idle(), Idle()), reflexive(T()), run)
end
