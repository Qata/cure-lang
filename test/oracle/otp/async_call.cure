mod AsyncCall
  use Std.Equivalent
  ## gen_server:call over the ASYNC MAILBOX with a DEPENDENT reply: a client sends a request and gets
  ## back a reply whose LABEL is COMPUTED from the request (reply_for) — MGet is answered by a value
  ## MVal, MPut by an acknowledgment MAck. The request/reply round-trip happens through the async
  ## buffers (send request, server receives, server sends reply, client receives), and the type system
  ## pins the client to receive EXACTLY reply_for(req). This is the OTP call idiom, dependently typed.
  type Msg = MGet | MPut | MVal | MAck
  fn reply_for(m: Msg) -> Msg = match m
    MGet() -> MVal()
    MPut() -> MAck()
    MVal() -> MVal()
    MAck() -> MAck()
  type Local = LEnd | LSend(Msg, Local) | LRecv(Msg, Local)
  type Buf = BEmpty | BFull(Msg)
  type Config = MkConfig(Local, Local, Buf, Buf)
  type AStep indices (c: Config, c2: Config)
    ASendA : AStep(MkConfig(LSend(t, ka), b, BEmpty, ba), MkConfig(ka, b, BFull(t), ba))
    ARecvB : AStep(MkConfig(a, LRecv(t, kb), BFull(t), ba), MkConfig(a, kb, BEmpty, ba))
    ASendB : AStep(MkConfig(a, LSend(t, kb), ab, BEmpty), MkConfig(a, kb, ab, BFull(t)))
    ARecvA : AStep(MkConfig(LRecv(t, ka), b, ab, BFull(t)), MkConfig(ka, b, ab, BEmpty))
  type ARun indices (c: Config, c2: Config)
    ARDone : ARun(c, c)
    ARStep : AStep(c, cm) -> ARun(cm, c2) -> ARun(c, c2)
  ## Steps of the call (client=slot a, server=slot b), concrete types pin the intermediates. The reply
  ## label reply_for(req) is threaded through all four states.
  fn cstep1(req: Msg) -> AStep(MkConfig(LSend(req, LRecv(reply_for(req), LEnd())), LRecv(req, LSend(reply_for(req), LEnd())), BEmpty(), BEmpty()), MkConfig(LRecv(reply_for(req), LEnd()), LRecv(req, LSend(reply_for(req), LEnd())), BFull(req), BEmpty())) = ASendA()
  fn cstep2(req: Msg) -> AStep(MkConfig(LRecv(reply_for(req), LEnd()), LRecv(req, LSend(reply_for(req), LEnd())), BFull(req), BEmpty()), MkConfig(LRecv(reply_for(req), LEnd()), LSend(reply_for(req), LEnd()), BEmpty(), BEmpty())) = ARecvB()
  fn cstep3(req: Msg) -> AStep(MkConfig(LRecv(reply_for(req), LEnd()), LSend(reply_for(req), LEnd()), BEmpty(), BEmpty()), MkConfig(LRecv(reply_for(req), LEnd()), LEnd(), BEmpty(), BFull(reply_for(req)))) = ASendB()
  fn cstep4(req: Msg) -> AStep(MkConfig(LRecv(reply_for(req), LEnd()), LEnd(), BEmpty(), BFull(reply_for(req))), MkConfig(LEnd(), LEnd(), BEmpty(), BEmpty())) = ARecvA()
  ## **ASYNC DEPENDENT gen_server:call COMPLETES**: for EVERY request req, the async call — client
  ## sends req, server receives it, server sends back reply_for(req), client receives it — runs to
  ## completion (LEnd, LEnd, empty, empty). The client is TYPED to receive exactly reply_for(req)
  ## (a value for a get, an ack for a put), so the dependent reply is delivered correctly over the
  ## mailbox, buffers empty at the end. The OTP call, asynchronous and dependently typed, for all
  ## requests.
  fn async_call(req: Msg) -> ARun(MkConfig(LSend(req, LRecv(reply_for(req), LEnd())), LRecv(req, LSend(reply_for(req), LEnd())), BEmpty(), BEmpty()), MkConfig(LEnd(), LEnd(), BEmpty(), BEmpty())) =
    ARStep(cstep1(req), ARStep(cstep2(req), ARStep(cstep3(req), ARStep(cstep4(req), ARDone()))))
end
