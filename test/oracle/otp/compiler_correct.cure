mod CompilerCorrect
  use Std.Equivalent
  ## COMPILER CORRECTNESS for arithmetic expressions — a miniature verified compiler (McCarthy–Painter /
  ## Hutton), a fresh domain and thematically apt (Cure IS a compiler). Source `Expr` (Lit/Add/Mul) has a
  ## denotational semantics `eval`; the target is a STACK MACHINE with `exec` running a `Program` of push/add/
  ## mul instructions over a `Stack`. `compile` lowers an expression to stack code. The theorem
  ## `compile_correct` proves `exec(compile(e), s) = SCons(eval(e), s)` for EVERY expression and EVERY initial
  ## stack — the compiled code leaves exactly the evaluator's value on top, so source and target semantics
  ## agree through `compile`. The crux lemma is `exec_append` (exec distributes over program concatenation:
  ## running `p ++ q` is running `q` on the result of running `p`), proved by induction on `p` casing the
  ## stack in the binary-op instructions; `compile_correct` then follows by induction on `e` as a `trans`
  ## chain (unfold via exec_append, rewrite each subexpression by the IH, reduce the final op). `exec_cong`
  ## lifts the IH under a fixed program. This is proof-carrying compilation in miniature — the CompCert shape.
  type Nat = Z | S(Nat)
  fn plus(a: Nat, b: Nat) -> Nat = match a
    Z()   -> b
    S(k)  -> S(plus(k, b))
  fn times(a: Nat, b: Nat) -> Nat = match a
    Z()   -> Z()
    S(k)  -> plus(b, times(k, b))
  ## Source: arithmetic expressions.
  type Expr = Lit(Nat) | Add(Expr, Expr) | Mul(Expr, Expr)
  fn eval(e: Expr) -> Nat = match e
    Lit(n)     -> n
    Add(a, b)  -> plus(eval(a), eval(b))
    Mul(a, b)  -> times(eval(a), eval(b))
  ## Target: a stack machine.
  type Instr = Push(Nat) | AddOp | MulOp
  type Program = PNil | PCons(Instr, Program)
  type Stack = SNil | SCons(Nat, Stack)
  fn app(p: Program, q: Program) -> Program = match p
    PNil()        -> q
    PCons(i, is)  -> PCons(i, app(is, q))
  fn compile(e: Expr) -> Program = match e
    Lit(n)     -> PCons(Push(n), PNil())
    Add(a, b)  -> app(compile(a), app(compile(b), PCons(AddOp(), PNil())))
    Mul(a, b)  -> app(compile(a), app(compile(b), PCons(MulOp(), PNil())))
  fn exec(p: Program, s: Stack) -> Stack = match p
    PNil()        -> s
    PCons(i, rest) -> match i
      Push(n)  -> exec(rest, SCons(n, s))
      AddOp()  -> match s
        SNil()            -> exec(rest, s)
        SCons(top, s1)    -> match s1
          SNil()            -> exec(rest, s)
          SCons(below, s2)  -> exec(rest, SCons(plus(below, top), s2))
      MulOp()  -> match s
        SNil()            -> exec(rest, s)
        SCons(top, s1)    -> match s1
          SNil()            -> exec(rest, s)
          SCons(below, s2)  -> exec(rest, SCons(times(below, top), s2))
  ## **EXEC DISTRIBUTES OVER PROGRAM CONCATENATION**: running p++q is running q on the result of running p.
  fn exec_append(p: Program, q: Program, s: Stack) -> Equivalent(Stack, exec(app(p, q), s), exec(q, exec(p, s))) = match p
    PNil()        -> reflexive(exec(q, s))
    PCons(i, rest) -> match i
      Push(n)  -> exec_append(rest, q, SCons(n, s))
      AddOp()  -> match s
        SNil()            -> exec_append(rest, q, s)
        SCons(top, s1)    -> match s1
          SNil()            -> exec_append(rest, q, s)
          SCons(below, s2)  -> exec_append(rest, q, SCons(plus(below, top), s2))
      MulOp()  -> match s
        SNil()            -> exec_append(rest, q, s)
        SCons(top, s1)    -> match s1
          SNil()            -> exec_append(rest, q, s)
          SCons(below, s2)  -> exec_append(rest, q, SCons(times(below, top), s2))
  fn exec_cong(p: Program, s1: Stack, s2: Stack, e: Equivalent(Stack, s1, s2)) -> Equivalent(Stack, exec(p, s1), exec(p, s2)) = rewrite e in reflexive(exec(p, s2))
  ## **COMPILER CORRECTNESS**: exec(compile(e), s) = eval(e) :: s — the compiled stack code leaves exactly the
  ## evaluator's value on top of the stack, for every expression and every initial stack. A miniature verified
  ## compiler (McCarthy–Painter / Hutton): source semantics `eval` and target semantics `exec` agree via `compile`.
  fn compile_correct(e: Expr, s: Stack) -> Equivalent(Stack, exec(compile(e), s), SCons(eval(e), s)) = match e
    Lit(n)     -> reflexive(SCons(n, s))
    Add(a, b)  -> trans(exec_append(compile(a), app(compile(b), PCons(AddOp(), PNil())), s),
      trans(exec_cong(app(compile(b), PCons(AddOp(), PNil())), exec(compile(a), s), SCons(eval(a), s), compile_correct(a, s)),
        trans(exec_append(compile(b), PCons(AddOp(), PNil()), SCons(eval(a), s)),
          trans(exec_cong(PCons(AddOp(), PNil()), exec(compile(b), SCons(eval(a), s)), SCons(eval(b), SCons(eval(a), s)), compile_correct(b, SCons(eval(a), s))),
            reflexive(SCons(plus(eval(a), eval(b)), s))))))
    Mul(a, b)  -> trans(exec_append(compile(a), app(compile(b), PCons(MulOp(), PNil())), s),
      trans(exec_cong(app(compile(b), PCons(MulOp(), PNil())), exec(compile(a), s), SCons(eval(a), s), compile_correct(a, s)),
        trans(exec_append(compile(b), PCons(MulOp(), PNil()), SCons(eval(a), s)),
          trans(exec_cong(PCons(MulOp(), PNil()), exec(compile(b), SCons(eval(a), s)), SCons(eval(b), SCons(eval(a), s)), compile_correct(b, SCons(eval(a), s))),
            reflexive(SCons(times(eval(a), eval(b)), s))))))
end
