mod SessionLiveness
  use Std.Equivalent
  ## BRIDGE: restart INTENSITY × session PROGRESS → unified LIVENESS. A supervised session shares one
  ## state Run(orig, cur, budget): `orig` is the protocol to restart to, `cur` the current position,
  ## `budget` the remaining restarts. A PROGRESS event advances `cur` toward LEnd (→ Completed at the
  ## end); a CRASH event resets `cur` to `orig` and consumes one budget (→ Abandoned at zero). The
  ## liveness guarantee: a doomed session cannot loop forever — bounded progress COMPLETES it, bounded
  ## crashes ABANDON it, and both terminal states are absorbing. Ties restart intensity to session progress.
  type Nat = Z | S(Nat)
  type Msg = MReq | MAns
  type Local = LSend(Msg, Local) | LRecv(Msg, Local) | LEnd
  type Sup = Run(Local, Local, Nat) | Completed | Abandoned
  fn proto_len(l: Local) -> Nat = match l
    LEnd()        -> Z()
    LSend(m, k)   -> S(proto_len(k))
    LRecv(m, k)   -> S(proto_len(k))
  ## A progress step: advance the current protocol position; at LEnd the session is Completed.
  fn progress(s: Sup) -> Sup = match s
    Run(orig, cur, b)  -> match cur
      LEnd()        -> Completed()
      LSend(m, k)   -> Run(orig, k, b)
      LRecv(m, k)   -> Run(orig, k, b)
    Completed()        -> Completed()
    Abandoned()        -> Abandoned()
  ## A crash: reset to the original protocol and consume one restart; at zero budget the session is Abandoned.
  fn crash(s: Sup) -> Sup = match s
    Run(orig, cur, b)  -> match b
      Z()    -> Abandoned()
      S(b2)  -> Run(orig, orig, b2)
    Completed()        -> Completed()
    Abandoned()        -> Abandoned()
  fn progresses(s: Sup, n: Nat) -> Sup = match n
    Z()    -> s
    S(m)   -> progresses(progress(s), m)
  fn crashes(s: Sup, n: Nat) -> Sup = match n
    Z()    -> s
    S(m)   -> crashes(crash(s), m)
  ## **PROGRESS COMPLETES**: from any running state, S(proto_len(cur)) progress steps reach Completed —
  ## a session making progress terminates in success after exactly its remaining-protocol-length steps.
  ## Induction on the protocol (progress is message-agnostic, so no per-message casing needed).
  fn progress_completes(orig: Local, cur: Local, b: Nat) -> Equivalent(Sup, progresses(Run(orig, cur, b), S(proto_len(cur))), Completed()) =
    match cur
      LEnd()        -> reflexive(Completed())
      LSend(m, k)   -> progress_completes(orig, k, b)
      LRecv(m, k)   -> progress_completes(orig, k, b)
  ## **CRASH ABANDONS**: from any running state, S(budget) crashes reach Abandoned — a session that keeps
  ## crashing exhausts its restart intensity and is abandoned, never retried forever. Induction on budget.
  fn crash_abandons(orig: Local, cur: Local, b: Nat) -> Equivalent(Sup, crashes(Run(orig, cur, b), S(b)), Abandoned()) =
    match b
      Z()    -> reflexive(Abandoned())
      S(b2)  -> crash_abandons(orig, orig, b2)
  ## **BOTH TERMINAL STATES ABSORBING (cross events too)**: a Completed session ignores a spurious crash,
  ## an Abandoned session ignores a spurious progress — no resurrection under EITHER event kind.
  fn completed_absorbs_crash() -> Equivalent(Sup, crash(Completed()), Completed()) = reflexive(Completed())
  fn completed_absorbs_progress() -> Equivalent(Sup, progress(Completed()), Completed()) = reflexive(Completed())
  fn abandoned_absorbs_progress() -> Equivalent(Sup, progress(Abandoned()), Abandoned()) = reflexive(Abandoned())
  fn abandoned_absorbs_crash() -> Equivalent(Sup, crash(Abandoned()), Abandoned()) = reflexive(Abandoned())
end
