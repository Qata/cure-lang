mod IntAdditiveGroup
  ## Verified-LIA Task 1 computation probe. These operations deliberately live
  ## in Std.Proof.IntOrder: later algebra proofs must unfold the same structural
  ## definitions that the certificate checker evaluates.
  use Std.Bool
  use Std.Nat
  use Std.Int
  use Std.Equivalent
  use Std.Proof.IntMath
  use Std.Proof.IntOrder

  fn zero_scale_negative() -> Equivalent(Int,
    scale_nat_int(Z(), NegativeSuccessor(S(Z()))),
    FromNat(Z())) =
    reflexive(FromNat(Z()))

  fn positive_scale_negative() -> Equivalent(Int,
    scale_nat_int(S(S(Z())), NegativeSuccessor(Z())),
    NegativeSuccessor(S(Z()))) =
    reflexive(NegativeSuccessor(S(Z())))

  fn positive_times_positive() -> Equivalent(Int,
    multiply_int(FromNat(S(S(Z()))), FromNat(S(S(S(Z()))))),
    FromNat(S(S(S(S(S(S(Z())))))))) =
    reflexive(FromNat(S(S(S(S(S(S(Z()))))))))

  fn positive_times_negative() -> Equivalent(Int,
    multiply_int(FromNat(S(S(Z()))), NegativeSuccessor(Z())),
    NegativeSuccessor(S(Z()))) =
    reflexive(NegativeSuccessor(S(Z())))

  fn negative_times_positive() -> Equivalent(Int,
    multiply_int(NegativeSuccessor(Z()), FromNat(S(S(S(Z()))))),
    NegativeSuccessor(S(S(Z())))) =
    reflexive(NegativeSuccessor(S(S(Z()))))

  fn negative_times_negative() -> Equivalent(Int,
    multiply_int(NegativeSuccessor(Z()), NegativeSuccessor(S(Z()))),
    FromNat(S(S(Z())))) =
    reflexive(FromNat(S(S(Z()))))

  ## Symbolic laws: these quantify over arbitrary canonical integers, so the
  ## kernel checks the reusable substrate rather than only closed reductions.
  fn addition_commutes(left: Int, right: Int) -> Equivalent(Int,
    add_int(left, right), add_int(right, left)) =
    add_int_commutative(left, right)

  fn addition_associates(a: Int, b: Int, c: Int) -> Equivalent(Int,
    add_int(a, add_int(b, c)), add_int(add_int(a, b), c)) =
    add_int_associative(a, b, c)

  fn scaling_distributes(k: Nat, left: Int, right: Int) -> Equivalent(Int,
    scale_nat_int(k, add_int(left, right)),
    add_int(scale_nat_int(k, left), scale_nat_int(k, right))) =
    scale_nat_int_distributes_over_add(k, left, right)

  fn scaling_preserves_arbitrary_signed_order(
    k: Nat, left: Int, right: Int,
    proof: IsLessThanOrEqual(left, right)
  ) -> IsLessThanOrEqual(scale_nat_int(k, left), scale_nat_int(k, right)) =
    scale_nat_int_is_monotone(k, left, right, proof)

  ## Decisive negative-operand instance: -2 <= 1 scaled by 3.
  fn negative_scaling_gate() -> IsLessThanOrEqual(
    scale_nat_int(S(S(S(Z()))), NegativeSuccessor(S(Z()))),
    scale_nat_int(S(S(S(Z()))), FromNat(S(Z())))) =
    scale_nat_int_is_monotone(
      S(S(S(Z()))), NegativeSuccessor(S(Z())), FromNat(S(Z())), AtMost(Confirmed()))

  fn start() -> Bool =
    le_int(
      multiply_int(NegativeSuccessor(Z()), FromNat(S(S(S(Z()))))),
      scale_nat_int(Z(), NegativeSuccessor(S(Z()))))
end
