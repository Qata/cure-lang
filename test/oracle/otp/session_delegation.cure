mod SessionDelegation
  type Tag = TA | TB | TC
  type SType = SEnd | SSend(Tag, SType) | SRecv(Tag, SType) | SDeleg(SType, SType) | SResume(SType, SType)
  fn dual(s: SType) -> SType = match s
    SEnd()          -> SEnd()
    SSend(t, k)     -> SRecv(t, dual(k))
    SRecv(t, k)     -> SSend(t, dual(k))
    SDeleg(a, k)    -> SResume(a, dual(k))
    SResume(a, k)   -> SDeleg(a, dual(k))
  fn dual_involution(s: SType) -> Equivalent(SType, dual(dual(s)), s) = match s
    SEnd()        -> reflexive(SEnd())
    SSend(t, k)   -> rewrite dual_involution(k) in reflexive(SSend(t, k))
    SRecv(t, k)   -> rewrite dual_involution(k) in reflexive(SRecv(t, k))
    SDeleg(a, k)  -> rewrite dual_involution(k) in reflexive(SDeleg(a, k))
    SResume(a, k) -> rewrite dual_involution(k) in reflexive(SResume(a, k))
  type Compat indices (l: SType, r: SType)
    CEnd : Compat(SEnd, SEnd)
    CSR  : (t: Tag) -> Compat(l, r) -> Compat(SSend(t, l), SRecv(t, r))
    CRS  : (t: Tag) -> Compat(l, r) -> Compat(SRecv(t, l), SSend(t, r))
    CDel : (a: SType) -> Compat(l, r) -> Compat(SDeleg(a, l), SResume(a, r))
    CRes : (a: SType) -> Compat(l, r) -> Compat(SResume(a, l), SDeleg(a, r))
  fn ssend_cong(t: Tag, {a: SType}, {b: SType}, e: Equivalent(SType, a, b)) -> Equivalent(SType, SSend(t, a), SSend(t, b)) =
    rewrite e in reflexive(SSend(t, b))
  fn srecv_cong(t: Tag, {a: SType}, {b: SType}, e: Equivalent(SType, a, b)) -> Equivalent(SType, SRecv(t, a), SRecv(t, b)) =
    rewrite e in reflexive(SRecv(t, b))
  fn sdeleg_cong(a: SType, {x: SType}, {y: SType}, e: Equivalent(SType, x, y)) -> Equivalent(SType, SDeleg(a, x), SDeleg(a, y)) =
    rewrite e in reflexive(SDeleg(a, y))
  fn sresume_cong(a: SType, {x: SType}, {y: SType}, e: Equivalent(SType, x, y)) -> Equivalent(SType, SResume(a, x), SResume(a, y)) =
    rewrite e in reflexive(SResume(a, y))
  fn compat_dual({l: SType}, {r: SType}, c: Compat(l, r)) -> Equivalent(SType, l, dual(r)) = match c
    CEnd()       -> reflexive(SEnd())
    CSR(t, c2)   -> ssend_cong(t, compat_dual(c2))
    CRS(t, c2)   -> srecv_cong(t, compat_dual(c2))
    CDel(a, c2)  -> sdeleg_cong(a, compat_dual(c2))
    CRes(a, c2)  -> sresume_cong(a, compat_dual(c2))
end
