mod CompilerVar
  use Std.Equivalent
  ## COMPILER CORRECTNESS WITH VARIABLES AND ENVIRONMENTS — a real step up from the closed-expression compiler.
  ## The source `Expr` gains DE BRUIJN VARIABLES (`Var(k)` reads the k-th environment entry, out-of-range → Z);
  ## the target stack machine gains a `Load(k)` instruction that pushes a variable from a read-only ENVIRONMENT
  ## threaded through `exec`. `compile_correct` proves `exec(compile(e), env, s) = NCons(eval(e, env), s)` for
  ## every expression, every variable environment, and every initial stack — the classic "compiling with an
  ## environment" theorem. The `Var` case is discharged by the `Load` instruction reading `lookup(k, env)`; the
  ## rest is the McCarthy–Painter proof (crux `exec_append`, then a `trans` chain by induction on `e`) with
  ## `env` threaded unchanged through every step (`exec`/`exec_append`/`exec_cong` all carry it read-only).
  type Nat = Z | S(Nat)
  fn plus(a: Nat, b: Nat) -> Nat = match a
    Z()   -> b
    S(k)  -> S(plus(k, b))
  fn times(a: Nat, b: Nat) -> Nat = match a
    Z()   -> Z()
    S(k)  -> plus(b, times(k, b))
  ## A list of Nat, used for BOTH the variable environment and the machine stack.
  type NL = NNil | NCons(Nat, NL)
  ## De Bruijn variable lookup (out-of-range defaults to Z).
  fn lookup(i: Nat, l: NL) -> Nat = match i
    Z()   -> match l
      NNil()        -> Z()
      NCons(x, rest) -> x
    S(k)  -> match l
      NNil()        -> Z()
      NCons(x, rest) -> lookup(k, rest)
  ## Source: arithmetic expressions WITH variables.
  type Expr = Lit(Nat) | Var(Nat) | Add(Expr, Expr) | Mul(Expr, Expr)
  fn eval(e: Expr, env: NL) -> Nat = match e
    Lit(n)     -> n
    Var(k)     -> lookup(k, env)
    Add(a, b)  -> plus(eval(a, env), eval(b, env))
    Mul(a, b)  -> times(eval(a, env), eval(b, env))
  ## Target: a stack machine with a read-only environment; Load(k) pushes the k-th variable.
  type Instr = Push(Nat) | Load(Nat) | AddOp | MulOp
  type Program = PNil | PCons(Instr, Program)
  fn app(p: Program, q: Program) -> Program = match p
    PNil()        -> q
    PCons(i, is)  -> PCons(i, app(is, q))
  fn compile(e: Expr) -> Program = match e
    Lit(n)     -> PCons(Push(n), PNil())
    Var(k)     -> PCons(Load(k), PNil())
    Add(a, b)  -> app(compile(a), app(compile(b), PCons(AddOp(), PNil())))
    Mul(a, b)  -> app(compile(a), app(compile(b), PCons(MulOp(), PNil())))
  fn exec(p: Program, env: NL, s: NL) -> NL = match p
    PNil()        -> s
    PCons(i, rest) -> match i
      Push(n)  -> exec(rest, env, NCons(n, s))
      Load(k)  -> exec(rest, env, NCons(lookup(k, env), s))
      AddOp()  -> match s
        NNil()            -> exec(rest, env, s)
        NCons(top, s1)    -> match s1
          NNil()            -> exec(rest, env, s)
          NCons(below, s2)  -> exec(rest, env, NCons(plus(below, top), s2))
      MulOp()  -> match s
        NNil()            -> exec(rest, env, s)
        NCons(top, s1)    -> match s1
          NNil()            -> exec(rest, env, s)
          NCons(below, s2)  -> exec(rest, env, NCons(times(below, top), s2))
  ## **EXEC DISTRIBUTES OVER CONCATENATION** (environment threaded unchanged).
  fn exec_append(p: Program, q: Program, env: NL, s: NL) -> Equivalent(NL, exec(app(p, q), env, s), exec(q, env, exec(p, env, s))) = match p
    PNil()        -> reflexive(exec(q, env, s))
    PCons(i, rest) -> match i
      Push(n)  -> exec_append(rest, q, env, NCons(n, s))
      Load(k)  -> exec_append(rest, q, env, NCons(lookup(k, env), s))
      AddOp()  -> match s
        NNil()            -> exec_append(rest, q, env, s)
        NCons(top, s1)    -> match s1
          NNil()            -> exec_append(rest, q, env, s)
          NCons(below, s2)  -> exec_append(rest, q, env, NCons(plus(below, top), s2))
      MulOp()  -> match s
        NNil()            -> exec_append(rest, q, env, s)
        NCons(top, s1)    -> match s1
          NNil()            -> exec_append(rest, q, env, s)
          NCons(below, s2)  -> exec_append(rest, q, env, NCons(times(below, top), s2))
  fn exec_cong(p: Program, env: NL, s1: NL, s2: NL, e: Equivalent(NL, s1, s2)) -> Equivalent(NL, exec(p, env, s1), exec(p, env, s2)) = rewrite e in reflexive(exec(p, env, s2))
  ## **COMPILER CORRECTNESS WITH VARIABLES**: exec(compile(e), env, s) = eval(e, env) :: s — for every
  ## expression, every variable environment, and every initial stack. The Var case is discharged by the Load
  ## instruction reading the environment; the rest is the closed-expression proof with `env` threaded through.
  fn compile_correct(e: Expr, env: NL, s: NL) -> Equivalent(NL, exec(compile(e), env, s), NCons(eval(e, env), s)) = match e
    Lit(n)     -> reflexive(NCons(n, s))
    Var(k)     -> reflexive(NCons(lookup(k, env), s))
    Add(a, b)  -> trans(exec_append(compile(a), app(compile(b), PCons(AddOp(), PNil())), env, s),
      trans(exec_cong(app(compile(b), PCons(AddOp(), PNil())), env, exec(compile(a), env, s), NCons(eval(a, env), s), compile_correct(a, env, s)),
        trans(exec_append(compile(b), PCons(AddOp(), PNil()), env, NCons(eval(a, env), s)),
          trans(exec_cong(PCons(AddOp(), PNil()), env, exec(compile(b), env, NCons(eval(a, env), s)), NCons(eval(b, env), NCons(eval(a, env), s)), compile_correct(b, env, NCons(eval(a, env), s))),
            reflexive(NCons(plus(eval(a, env), eval(b, env)), s))))))
    Mul(a, b)  -> trans(exec_append(compile(a), app(compile(b), PCons(MulOp(), PNil())), env, s),
      trans(exec_cong(app(compile(b), PCons(MulOp(), PNil())), env, exec(compile(a), env, s), NCons(eval(a, env), s), compile_correct(a, env, s)),
        trans(exec_append(compile(b), PCons(MulOp(), PNil()), env, NCons(eval(a, env), s)),
          trans(exec_cong(PCons(MulOp(), PNil()), env, exec(compile(b), env, NCons(eval(a, env), s)), NCons(eval(b, env), NCons(eval(a, env), s)), compile_correct(b, env, NCons(eval(a, env), s))),
            reflexive(NCons(times(eval(a, env), eval(b, env)), s))))))
end
