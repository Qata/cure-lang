mod NNF
  use Std.Equivalent
  ## NEGATION NORMAL FORM IS MEANING-PRESERVING — a fresh domain: boolean logic / normal forms. Propositional
  ## formulas over variables (`FVar`/`FNot`/`FAnd`/`FOr`) have a truth-value semantics `eval` under an
  ## assignment `Env`. `nnf` pushes every negation DOWN to the variables (via De Morgan and double-negation),
  ## with a companion `nnf_neg(f)` computing the NNF of `¬f`. `nnf_correct` proves `eval(nnf(f), env) =
  ## eval(f, env)` for EVERY formula and EVERY assignment — normalizing to NNF never changes what a formula
  ## means. It is proved by MUTUAL induction with `nnf_neg_correct` (`eval(nnf_neg(f), env) = ¬eval(f, env)`),
  ## the pushed-negation cases discharged by the De Morgan laws (`dm_and`/`dm_or`) and double-negation
  ## (`notnot`); the connective cases lift the induction hypotheses through `andb_cong2`/`orb_cong2`.
  type Nat = Z | S(Nat)
  type Bool = F | T
  fn notb(a: Bool) -> Bool = match a
    T() -> F()
    F() -> T()
  fn andb(a: Bool, b: Bool) -> Bool = match a
    T() -> b
    F() -> F()
  fn orb(a: Bool, b: Bool) -> Bool = match a
    T() -> T()
    F() -> b
  ## De Morgan and double-negation on booleans (each a small case check).
  fn dm_and(a: Bool, b: Bool) -> Equivalent(Bool, notb(andb(a, b)), orb(notb(a), notb(b))) = match a
    T() -> match b
      T() -> reflexive(F())
      F() -> reflexive(T())
    F() -> match b
      T() -> reflexive(T())
      F() -> reflexive(T())
  fn dm_or(a: Bool, b: Bool) -> Equivalent(Bool, notb(orb(a, b)), andb(notb(a), notb(b))) = match a
    T() -> match b
      T() -> reflexive(F())
      F() -> reflexive(F())
    F() -> match b
      T() -> reflexive(F())
      F() -> reflexive(T())
  fn notnot(a: Bool) -> Equivalent(Bool, notb(notb(a)), a) = match a
    T() -> reflexive(T())
    F() -> reflexive(F())
  fn andb_cong2(a: Bool, ap: Bool, b: Bool, bp: Bool, ea: Equivalent(Bool, a, ap), eb: Equivalent(Bool, b, bp)) -> Equivalent(Bool, andb(a, b), andb(ap, bp)) = rewrite ea in rewrite eb in reflexive(andb(ap, bp))
  fn orb_cong2(a: Bool, ap: Bool, b: Bool, bp: Bool, ea: Equivalent(Bool, a, ap), eb: Equivalent(Bool, b, bp)) -> Equivalent(Bool, orb(a, b), orb(ap, bp)) = rewrite ea in rewrite eb in reflexive(orb(ap, bp))
  ## Boolean assignment: a list of truth values, indexed by variable number.
  type Env = ENil | ECons(Bool, Env)
  fn lookup(v: Nat, env: Env) -> Bool = match v
    Z()   -> match env
      ENil()        -> F()
      ECons(x, rest) -> x
    S(k)  -> match env
      ENil()        -> F()
      ECons(x, rest) -> lookup(k, rest)
  ## Propositional formulas over variables.
  type Formula = FVar(Nat) | FNot(Formula) | FAnd(Formula, Formula) | FOr(Formula, Formula)
  fn eval(f: Formula, env: Env) -> Bool = match f
    FVar(v)     -> lookup(v, env)
    FNot(g)     -> notb(eval(g, env))
    FAnd(a, b)  -> andb(eval(a, env), eval(b, env))
    FOr(a, b)   -> orb(eval(a, env), eval(b, env))
  ## Negation normal form: push all negations down to the variables. `nnf_neg(f)` computes the NNF of `¬f`.
  fn nnf(f: Formula) -> Formula = match f
    FVar(v)     -> FVar(v)
    FNot(g)     -> nnf_neg(g)
    FAnd(a, b)  -> FAnd(nnf(a), nnf(b))
    FOr(a, b)   -> FOr(nnf(a), nnf(b))
  fn nnf_neg(f: Formula) -> Formula = match f
    FVar(v)     -> FNot(FVar(v))
    FNot(g)     -> nnf(g)
    FAnd(a, b)  -> FOr(nnf_neg(a), nnf_neg(b))
    FOr(a, b)   -> FAnd(nnf_neg(a), nnf_neg(b))
  ## **NNF PRESERVES MEANING**: eval(nnf(f), env) = eval(f, env) for every formula and assignment; and its
  ## companion, eval(nnf_neg(f), env) = ¬eval(f, env). Proved by MUTUAL induction, the De Morgan / double-
  ## negation identities discharging the pushed-negation cases. So normalizing to NNF is semantics-preserving.
  fn nnf_correct(f: Formula, env: Env) -> Equivalent(Bool, eval(nnf(f), env), eval(f, env)) = match f
    FVar(v)     -> reflexive(lookup(v, env))
    FNot(g)     -> nnf_neg_correct(g, env)
    FAnd(a, b)  -> andb_cong2(eval(nnf(a), env), eval(a, env), eval(nnf(b), env), eval(b, env), nnf_correct(a, env), nnf_correct(b, env))
    FOr(a, b)   -> orb_cong2(eval(nnf(a), env), eval(a, env), eval(nnf(b), env), eval(b, env), nnf_correct(a, env), nnf_correct(b, env))
  fn nnf_neg_correct(f: Formula, env: Env) -> Equivalent(Bool, eval(nnf_neg(f), env), notb(eval(f, env))) = match f
    FVar(v)     -> reflexive(notb(lookup(v, env)))
    FNot(g)     -> trans(nnf_correct(g, env), sym(notnot(eval(g, env))))
    FAnd(a, b)  -> trans(orb_cong2(eval(nnf_neg(a), env), notb(eval(a, env)), eval(nnf_neg(b), env), notb(eval(b, env)), nnf_neg_correct(a, env), nnf_neg_correct(b, env)), sym(dm_and(eval(a, env), eval(b, env))))
    FOr(a, b)   -> trans(andb_cong2(eval(nnf_neg(a), env), notb(eval(a, env)), eval(nnf_neg(b), env), notb(eval(b, env)), nnf_neg_correct(a, env), nnf_neg_correct(b, env)), sym(dm_or(eval(a, env), eval(b, env))))
end
