mod SessionFidelity
  use Std.Equivalent
  ## OPERATIONAL FIDELITY — the projected configuration faithfully realizes the global protocol, and ONLY
  ## it. The model enrichment is DIRECTED locals: LSend/LRecv record the PEER role, so "the sender can only
  ## send to q" becomes expressible (the undirected model of multiparty_progress could not). For a head
  ## communication GMsg(p,q,t,k): the sender's action is FORCED to send-to-q-tag-t (completeness — it can
  ## do nothing else), the receiver's is FORCED to receive-from-p-tag-t, bystanders are IDLE, and PERFORMING
  ## the head lands every role exactly on project(k,.) = config(k) (soundness + preservation). fidelity_ab
  ## shows the whole 3-role config stepping GMsg(RA,RB,t,k) -> k.
  type Role = RA | RB | RC
  type Tag = TA | TB | TC
  type B = F | T
  type Global = GEnd | GMsg(Role, Role, Tag, Global)
  type Local = LEnd | LSend(Role, Tag, Local) | LRecv(Role, Tag, Local)
  type Config = MkCfg(Local, Local, Local)
  fn role_eq(x: Role, y: Role) -> B = match x
    RA() -> match y
      RA() -> T()
      RB() -> F()
      RC() -> F()
    RB() -> match y
      RA() -> F()
      RB() -> T()
      RC() -> F()
    RC() -> match y
      RA() -> F()
      RB() -> F()
      RC() -> T()
  ## DIRECTED projection: the sender records its destination `to`, the receiver its source `from`.
  fn project(g: Global, r: Role) -> Local = match g
    GEnd()               -> LEnd()
    GMsg(from, to, t, k) -> match role_eq(from, r)
      T() -> LSend(to, t, project(k, r))
      F() -> match role_eq(to, r)
        T() -> LRecv(from, t, project(k, r))
        F() -> project(k, r)
  fn config(g: Global) -> Config = MkCfg(project(g, RA()), project(g, RB()), project(g, RC()))
  ## Perform a role's head action (consume the send / receive).
  fn perform_send(l: Local) -> Local = match l
    LEnd()          -> LEnd()
    LSend(to, t, k) -> k
    LRecv(fr, t, k) -> l
  fn perform_recv(l: Local) -> Local = match l
    LEnd()          -> LEnd()
    LSend(to, t, k) -> l
    LRecv(fr, t, k) -> k
  ## **SENDER ACTION FORCED (completeness)**: the head sender's projection is EXACTLY LSend(q,t,...) — it
  ## can send only to q, only tag t. The protocol determines its next action uniquely.
  fn sender_forced(p: Role, q: Role, t: Tag, k: Global) -> Equivalent(Local, project(GMsg(p, q, t, k), p), LSend(q, t, project(k, p))) = match p
    RA() -> reflexive(LSend(q, t, project(k, RA())))
    RB() -> reflexive(LSend(q, t, project(k, RB())))
    RC() -> reflexive(LSend(q, t, project(k, RC())))
  ## **RECEIVER ACTION FORCED (completeness)**: the head receiver's projection is EXACTLY LRecv(p,t,...) —
  ## it can receive only from p, only tag t (given p != q).
  fn receiver_forced(p: Role, q: Role, t: Tag, k: Global, neq: Equivalent(B, role_eq(p, q), F())) -> Equivalent(Local, project(GMsg(p, q, t, k), q), LRecv(p, t, project(k, q))) = match p
    RA() -> match q
      RA() -> match neq
      RB() -> reflexive(LRecv(RA(), t, project(k, RB())))
      RC() -> reflexive(LRecv(RA(), t, project(k, RC())))
    RB() -> match q
      RA() -> reflexive(LRecv(RB(), t, project(k, RA())))
      RB() -> match neq
      RC() -> reflexive(LRecv(RB(), t, project(k, RC())))
    RC() -> match q
      RA() -> reflexive(LRecv(RC(), t, project(k, RA())))
      RB() -> reflexive(LRecv(RC(), t, project(k, RB())))
      RC() -> match neq
  ## **BYSTANDER IDLE**: a role r not in {p,q} keeps its local across the head step (project past it).
  fn bystander_idle(p: Role, q: Role, t: Tag, k: Global, r: Role, np: Equivalent(B, role_eq(p, r), F()), nq: Equivalent(B, role_eq(q, r), F())) -> Equivalent(Local, project(GMsg(p, q, t, k), r), project(k, r)) =
    match p
      RA() -> match q
        RA() -> match r
          RA() -> match np
          RB() -> reflexive(project(k, RB()))
          RC() -> reflexive(project(k, RC()))
        RB() -> match r
          RA() -> match np
          RB() -> match nq
          RC() -> reflexive(project(k, RC()))
        RC() -> match r
          RA() -> match np
          RB() -> reflexive(project(k, RB()))
          RC() -> match nq
      RB() -> match q
        RA() -> match r
          RA() -> match nq
          RB() -> match np
          RC() -> reflexive(project(k, RC()))
        RB() -> match r
          RA() -> reflexive(project(k, RA()))
          RB() -> match np
          RC() -> reflexive(project(k, RC()))
        RC() -> match r
          RA() -> reflexive(project(k, RA()))
          RB() -> match np
          RC() -> match nq
      RC() -> match q
        RA() -> match r
          RA() -> match nq
          RB() -> reflexive(project(k, RB()))
          RC() -> match np
        RB() -> match r
          RA() -> reflexive(project(k, RA()))
          RB() -> match nq
          RC() -> match np
        RC() -> match r
          RA() -> reflexive(project(k, RA()))
          RB() -> reflexive(project(k, RB()))
          RC() -> match np
  ## **SENDER LANDS (soundness)**: after performing its send, the head sender is at project(k,p).
  fn sender_lands(p: Role, q: Role, t: Tag, k: Global) -> Equivalent(Local, perform_send(project(GMsg(p, q, t, k), p)), project(k, p)) =
    rewrite sender_forced(p, q, t, k) in reflexive(project(k, p))
  ## **RECEIVER LANDS (soundness)**: after performing its receive, the head receiver is at project(k,q).
  fn receiver_lands(p: Role, q: Role, t: Tag, k: Global, neq: Equivalent(B, role_eq(p, q), F())) -> Equivalent(Local, perform_recv(project(GMsg(p, q, t, k), q)), project(k, q)) =
    rewrite receiver_forced(p, q, t, k, neq) in reflexive(project(k, q))
  ## **WHOLE-CONFIG FIDELITY (concrete)**: firing the head RA->RB:t (RA sends, RB receives, RC idle)
  ## drives config(GMsg(RA,RB,t,k)) to config(k) EXACTLY — the projected system steps in lockstep with
  ## the global protocol. Assembled from sender_lands + receiver_lands + bystander_idle.
  fn fidelity_ab(t: Tag, k: Global) -> Equivalent(Config, MkCfg(perform_send(project(GMsg(RA(), RB(), t, k), RA())), perform_recv(project(GMsg(RA(), RB(), t, k), RB())), project(GMsg(RA(), RB(), t, k), RC())), config(k)) =
    rewrite sender_lands(RA(), RB(), t, k) in rewrite receiver_lands(RA(), RB(), t, k, reflexive(F())) in rewrite bystander_idle(RA(), RB(), t, k, RC(), reflexive(F()), reflexive(F())) in reflexive(config(k))
end
