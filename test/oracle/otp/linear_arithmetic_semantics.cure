mod LinearArithmeticSemantics
  use Std.Bool
  use Std.Nat
  use Std.Int
  use Std.List
  use Std.Equivalent
  use Std.Proof.IntOrder
  use Std.Proof.LinearArithmetic
  use Std.Proof.LinearArithmetic.Semantics

  fn zero_homomorphism(
    {coefficients: List(Int)}, {valuation: List(Int)},
    shape: ZeroCoefficientsAt(coefficients, valuation)
  ) -> Equivalent(Int, dot(coefficients, valuation), int_zero()) =
    dot_zero_coefficients(shape)

  fn addition_homomorphism(
    {left: List(Int)}, {right: List(Int)}, {result: List(Int)},
    {valuation: List(Int)},
    shape: AddedCoefficientsAt(left, right, result, valuation)
  ) -> Equivalent(Int,
    dot(result, valuation), add_int(dot(left, valuation), dot(right, valuation))) =
    dot_added_coefficients(shape)

  fn scaling_homomorphism(
    {scalar: Nat}, {source: List(Int)}, {result: List(Int)},
    {valuation: List(Int)},
    shape: ScaledCoefficientsAt(scalar, source, result, valuation)
  ) -> Equivalent(Int,
    dot(result, valuation), scale_nat_int(scalar, dot(source, valuation))) =
    dot_scaled_coefficients(shape)

  fn strict_normalization_preserves_truth(
    coefficients: List(Int), constant: Int, relation: Relation, valuation: Valuation
  ) -> Equivalent(Bool,
    evaluate_atom(
      normalize_atom(linear_atom(coefficients, constant, relation)), valuation),
    evaluate_atom(linear_atom(coefficients, constant, relation), valuation)) =
    normalize_atom_preserves_evaluation(coefficients, constant, relation, valuation)

  fn zero_shape(first: Int, second: Int) -> ZeroCoefficientsAt(
    Cons(int_zero(), Cons(int_zero(), Nil())), Cons(first, Cons(second, Nil()))) =
    ZeroAtCons(ZeroAtCons(ZeroAtEmpty()))

  fn added_shape(first: Int, second: Int) -> AddedCoefficientsAt(
    Cons(FromNat(S(Z())), Cons(NegativeSuccessor(Z()), Nil())),
    Cons(FromNat(S(S(Z()))), Cons(FromNat(S(Z())), Nil())),
    Cons(FromNat(S(S(S(Z())))), Cons(FromNat(Z()), Nil())),
    Cons(first, Cons(second, Nil()))) =
    AddedCons(AddedCons(AddedEmpty()))

  fn scaled_shape(first: Int, second: Int) -> ScaledCoefficientsAt(
    S(S(Z())),
    Cons(FromNat(S(Z())), Cons(NegativeSuccessor(Z()), Nil())),
    Cons(FromNat(S(S(Z()))), Cons(NegativeSuccessor(S(Z())), Nil())),
    Cons(first, Cons(second, Nil()))) =
    ScaledCons(ScaledCons(ScaledEmpty()))

  fn start() -> Bool = True()
end
