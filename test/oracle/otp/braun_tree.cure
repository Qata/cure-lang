mod BraunTree
  use Std.Equivalent
  ## BRAUN TREES — balanced-by-construction functional arrays, a fresh data-structure domain distinct from the
  ## min-heap (balance is about SIZE symmetry, not element order). The Braun invariant is size-symmetric: at
  ## every node the left subtree's size equals the right's, or is EXACTLY ONE larger (`Bal(m,n)` = `m=n` or
  ## `m=S(n)`). The classic Braun `insert` seats x at the root, pushes the OLD root into the right subtree, and
  ## SWAPS the subtrees. `size_insert` proves it increments the size (`size(insert(x,t)) = S(size(t))`, via
  ## `plus_comm` to reconcile the swapped subtrees); `braun_insert` proves it PRESERVES the invariant — the
  ## subtree swap trades the balance disjuncts (a balanced node becomes left-heavy and a left-heavy node
  ## becomes balanced), matched by casing the incoming `Bal` witness and rebuilding the opposite constructor.
  type Nat = Z | S(Nat)
  fn plus(a: Nat, b: Nat) -> Nat = match a
    Z()   -> b
    S(k)  -> S(plus(k, b))
  fn snat_cong(a: Nat, b: Nat, e: Equivalent(Nat, a, b)) -> Equivalent(Nat, S(a), S(b)) = rewrite e in reflexive(S(b))
  fn plus_zero(n: Nat) -> Equivalent(Nat, plus(n, Z()), n) = match n
    Z()   -> reflexive(Z())
    S(k)  -> snat_cong(plus(k, Z()), k, plus_zero(k))
  fn plus_succ_r(a: Nat, b: Nat) -> Equivalent(Nat, plus(a, S(b)), S(plus(a, b))) = match a
    Z()   -> reflexive(S(b))
    S(k)  -> snat_cong(plus(k, S(b)), S(plus(k, b)), plus_succ_r(k, b))
  fn plus_comm(a: Nat, b: Nat) -> Equivalent(Nat, plus(a, b), plus(b, a)) = match a
    Z()   -> sym(plus_zero(b))
    S(k)  -> trans(snat_cong(plus(k, b), plus(b, k), plus_comm(k, b)), sym(plus_succ_r(b, k)))
  fn plus_cong_l(a: Nat, b: Nat, c: Nat, e: Equivalent(Nat, a, b)) -> Equivalent(Nat, plus(a, c), plus(b, c)) = rewrite e in reflexive(plus(b, c))
  type BTree = Leaf | Node(Nat, BTree, BTree)
  fn size(t: BTree) -> Nat = match t
    Leaf()         -> Z()
    Node(y, l, r)  -> S(plus(size(l), size(r)))
  ## The Braun balance condition on two subtree sizes: equal, or the left exactly one larger.
  type Bal indices (m: Nat, n: Nat)
    BalEq : (m2: Nat) -> (n2: Nat) -> Equivalent(Nat, m2, n2) -> Bal(m2, n2)
    BalHi : (m2: Nat) -> (n2: Nat) -> Equivalent(Nat, m2, S(n2)) -> Bal(m2, n2)
  ## The Braun invariant: both subtrees Braun, and balanced at every node.
  type Braun indices (t: BTree)
    BLeaf : Braun(Leaf)
    BNode : (y: Nat) -> (l: BTree) -> (r: BTree) -> Braun(l) -> Braun(r) -> Bal(size(l), size(r)) -> Braun(Node(y, l, r))
  ## Braun insert: seat x at the root, push the old root into the RIGHT subtree, and swap the subtrees —
  ## the classic balance-preserving move.
  fn insert(x: Nat, t: BTree) -> BTree = match t
    Leaf()         -> Node(x, Leaf(), Leaf())
    Node(y, l, r)  -> Node(x, insert(y, r), l)
  ## **INSERT INCREMENTS THE SIZE**: size(insert(x,t)) = S(size(t)).
  fn size_insert(x: Nat, t: BTree) -> Equivalent(Nat, size(insert(x, t)), S(size(t))) = match t
    Leaf()         -> reflexive(S(Z()))
    Node(y, l, r)  -> trans(snat_cong(plus(size(insert(y, r)), size(l)), plus(S(size(r)), size(l)), plus_cong_l(size(insert(y, r)), S(size(r)), size(l), size_insert(y, r))), snat_cong(S(plus(size(r), size(l))), S(plus(size(l), size(r))), snat_cong(plus(size(r), size(l)), plus(size(l), size(r)), plus_comm(size(r), size(l)))))
  ## **INSERT PRESERVES THE BRAUN INVARIANT**: Braun(t) ⟹ Braun(insert(x,t)). The subtree swap turns the old
  ## balance into the new one — a left-heavy node becomes balanced and vice versa (the disjuncts trade places).
  fn braun_insert(x: Nat, t: BTree, bt: Braun(t)) -> Braun(insert(x, t)) = match bt
    BLeaf()                       -> BNode(x, Leaf(), Leaf(), BLeaf(), BLeaf(), BalEq(Z(), Z(), reflexive(Z())))
    BNode(y, l, r, bl, br, bal)   -> match bal
      BalEq(m2, n2, e) -> BNode(x, insert(y, r), l, braun_insert(y, r, br), bl, BalHi(size(insert(y, r)), size(l), trans(size_insert(y, r), snat_cong(size(r), size(l), sym(e)))))
      BalHi(m2, n2, e) -> BNode(x, insert(y, r), l, braun_insert(y, r, br), bl, BalEq(size(insert(y, r)), size(l), trans(size_insert(y, r), sym(e))))
end
