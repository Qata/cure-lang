mod FidgeMattern
  use Std.Equivalent
  ## THE CLOCK CONDITION (Fidge–Mattern soundness) — the capstone of the logical-time development: if event a
  ## causally precedes event b, then its vector clock is STRICTLY less (vc_lt(a,b)). Causal precedence (Lamport
  ## happens-before) is modelled INDUCTIVELY over clock-stamped events by the inductive `HB`, generated by the
  ## two operational rules — a LOCAL event (tick, program order) and a RECEIVE (merge the sender's timestamp
  ## then tick, message order) — closed under transitivity. Soundness (`hb_sound`) means comparing timestamps
  ## SOUNDLY detects causality: if VC(a) is NOT strictly less than VC(b), then a did NOT cause b (the basis of
  ## vector-clock causality tracking in distributed / BEAM systems). The proof composes the whole logical-time
  ## corner: local step = `tick_strict`; receive = sender's stamp ≤ the merge (`vmax_ub_r`) ≺ the ticked
  ## receive clock (`tick_strict`), chained by the new mixed-transitivity `le_lt_trans`; transitivity =
  ## `vc_lt_trans`. (The converse, VC(a) < VC(b) ⟹ a → b, is the deeper COMPLETENESS direction — still open.)
  type Nat = Z | S(Nat)
  type Bool = F | T
  fn leq(a: Nat, b: Nat) -> Bool = match a
    Z()   -> T()
    S(k)  -> match b
      Z()   -> F()
      S(j)  -> leq(k, j)
  fn leq_refl(a: Nat) -> Equivalent(Bool, leq(a, a), T()) = match a
    Z()   -> reflexive(T())
    S(k)  -> leq_refl(k)
  fn leq_succ_self_f(a: Nat) -> Equivalent(Bool, leq(S(a), a), F()) = match a
    Z()   -> reflexive(F())
    S(k)  -> leq_succ_self_f(k)
  fn le_succ(a: Nat) -> Equivalent(Bool, leq(a, S(a)), T()) = match a
    Z()   -> reflexive(T())
    S(k)  -> le_succ(k)
  fn le_trans(a: Nat, b: Nat, c: Nat, hab: Equivalent(Bool, leq(a, b), T()), hbc: Equivalent(Bool, leq(b, c), T())) -> Equivalent(Bool, leq(a, c), T()) = match a
    Z()   -> reflexive(T())
    S(a2) -> match b
      Z()   -> match hab
      S(b2) -> match c
        Z()   -> match hbc
        S(c2) -> le_trans(a2, b2, c2, hab, hbc)
  fn max(a: Nat, b: Nat) -> Nat = match a
    Z()   -> b
    S(k)  -> match b
      Z()   -> S(k)
      S(j)  -> S(max(k, j))
  fn le_max_r(a: Nat, b: Nat) -> Equivalent(Bool, leq(b, max(a, b)), T()) = match a
    Z()   -> leq_refl(b)
    S(k)  -> match b
      Z()   -> reflexive(T())
      S(j)  -> le_max_r(k, j)
  fn andb(a: Bool, b: Bool) -> Bool = match a
    T() -> b
    F() -> F()
  fn notb(b: Bool) -> Bool = match b
    T() -> F()
    F() -> T()
  fn andb_true_l(a: Bool, b: Bool, e: Equivalent(Bool, andb(a, b), T())) -> Equivalent(Bool, a, T()) = match a
    T() -> reflexive(T())
    F() -> match e
  fn andb_true_r(a: Bool, b: Bool, e: Equivalent(Bool, andb(a, b), T())) -> Equivalent(Bool, b, T()) = match a
    T() -> e
    F() -> match e
  fn andb_intro(a: Bool, b: Bool, ea: Equivalent(Bool, a, T()), eb: Equivalent(Bool, b, T())) -> Equivalent(Bool, andb(a, b), T()) = match a
    T() -> eb
    F() -> match ea
  fn notb_true(b: Bool, e: Equivalent(Bool, notb(b), T())) -> Equivalent(Bool, b, F()) = match b
    T() -> match e
    F() -> reflexive(F())
  fn notb_f(b: Bool, e: Equivalent(Bool, b, F())) -> Equivalent(Bool, notb(b), T()) = rewrite e in reflexive(T())
  fn bool_mt(b: Bool, c: Bool, hc: Equivalent(Bool, c, F())) -> ((Equivalent(Bool, b, T())) -> Equivalent(Bool, c, T())) -> Equivalent(Bool, b, F()) = match b
    T() -> fn(g) -> match trans(sym(g(reflexive(T()))), hc)
    F() -> fn(g) -> reflexive(F())
  type VC = VNil | VCons(Nat, VC)
  fn vc_le(u: VC, v: VC) -> Bool = match u
    VNil()        -> T()
    VCons(x, u2)  -> match v
      VNil()        -> F()
      VCons(y, v2)  -> andb(leq(x, y), vc_le(u2, v2))
  fn vc_le_refl(u: VC) -> Equivalent(Bool, vc_le(u, u), T()) = match u
    VNil()        -> reflexive(T())
    VCons(x, u2)  -> andb_intro(leq(x, x), vc_le(u2, u2), leq_refl(x), vc_le_refl(u2))
  fn vc_le_trans(u: VC, v: VC, w: VC, h1: Equivalent(Bool, vc_le(u, v), T()), h2: Equivalent(Bool, vc_le(v, w), T())) -> Equivalent(Bool, vc_le(u, w), T()) = match u
    VNil()        -> reflexive(T())
    VCons(x, u2)  -> match v
      VNil()        -> match h1
      VCons(y, v2)  -> match w
        VNil()        -> match h2
        VCons(z, w2)  -> andb_intro(leq(x, z), vc_le(u2, w2),
          le_trans(x, y, z, andb_true_l(leq(x, y), vc_le(u2, v2), h1), andb_true_l(leq(y, z), vc_le(v2, w2), h2)),
          vc_le_trans(u2, v2, w2, andb_true_r(leq(x, y), vc_le(u2, v2), h1), andb_true_r(leq(y, z), vc_le(v2, w2), h2)))
  fn vc_lt(u: VC, v: VC) -> Bool = andb(vc_le(u, v), notb(vc_le(v, u)))
  fn vc_lt_trans(u: VC, v: VC, w: VC, h1: Equivalent(Bool, vc_lt(u, v), T()), h2: Equivalent(Bool, vc_lt(v, w), T())) -> Equivalent(Bool, vc_lt(u, w), T()) =
    andb_intro(vc_le(u, w), notb(vc_le(w, u)),
      vc_le_trans(u, v, w, andb_true_l(vc_le(u, v), notb(vc_le(v, u)), h1), andb_true_l(vc_le(v, w), notb(vc_le(w, v)), h2)),
      notb_f(vc_le(w, u),
        bool_mt(vc_le(w, u), vc_le(w, v),
          notb_true(vc_le(w, v), andb_true_r(vc_le(v, w), notb(vc_le(w, v)), h2)))(
          fn(hwu) -> vc_le_trans(w, u, v, hwu, andb_true_l(vc_le(u, v), notb(vc_le(v, u)), h1)))))
  ## **≤ THEN ≺ IS ≺**: m ≤ a and a ≺ b ⟹ m ≺ b — a lower event stays strictly below what a dominates it does.
  fn le_lt_trans(m: VC, a: VC, b: VC, hma: Equivalent(Bool, vc_le(m, a), T()), hab: Equivalent(Bool, vc_lt(a, b), T())) -> Equivalent(Bool, vc_lt(m, b), T()) =
    andb_intro(vc_le(m, b), notb(vc_le(b, m)),
      vc_le_trans(m, a, b, hma, andb_true_l(vc_le(a, b), notb(vc_le(b, a)), hab)),
      notb_f(vc_le(b, m),
        bool_mt(vc_le(b, m), vc_le(b, a),
          notb_true(vc_le(b, a), andb_true_r(vc_le(a, b), notb(vc_le(b, a)), hab)))(
          fn(hbm) -> vc_le_trans(b, m, a, hbm, hma))))
  fn vmax(u: VC, v: VC) -> VC = match u
    VNil()        -> v
    VCons(x, u2)  -> match v
      VNil()        -> VCons(x, u2)
      VCons(y, v2)  -> VCons(max(x, y), vmax(u2, v2))
  fn vmax_ub_r(u: VC, v: VC) -> Equivalent(Bool, vc_le(v, vmax(u, v)), T()) = match u
    VNil()        -> vc_le_refl(v)
    VCons(x, u2)  -> match v
      VNil()        -> reflexive(T())
      VCons(y, v2)  -> andb_intro(leq(y, max(x, y)), vc_le(v2, vmax(u2, v2)), le_max_r(x, y), vmax_ub_r(u2, v2))
  fn tick(i: Nat, v: VC) -> VC = match v
    VNil()        -> VNil()
    VCons(x, r)   -> match i
      Z()   -> VCons(S(x), r)
      S(k)  -> VCons(x, tick(k, r))
  fn tick_mono(i: Nat, v: VC) -> Equivalent(Bool, vc_le(v, tick(i, v)), T()) = match v
    VNil()        -> reflexive(T())
    VCons(x, r)   -> match i
      Z()   -> andb_intro(leq(x, S(x)), vc_le(r, r), le_succ(x), vc_le_refl(r))
      S(k)  -> andb_intro(leq(x, x), vc_le(r, tick(k, r)), leq_refl(x), tick_mono(k, r))
  type InRange indices (i: Nat, v: VC)
    IRHere  : (x: Nat) -> (r: VC) -> InRange(Z, VCons(x, r))
    IRThere : (x: Nat) -> (k: Nat) -> (r: VC) -> InRange(k, r) -> InRange(S(k), VCons(x, r))
  fn tick_gt(i: Nat, v: VC, hir: InRange(i, v)) -> Equivalent(Bool, vc_le(tick(i, v), v), F()) = match hir
    IRHere(x, r)           -> rewrite leq_succ_self_f(x) in reflexive(F())
    IRThere(x, k, r, hir2) -> rewrite leq_refl(x) in rewrite tick_gt(k, r, hir2) in reflexive(F())
  fn tick_strict(i: Nat, v: VC, hir: InRange(i, v)) -> Equivalent(Bool, vc_lt(v, tick(i, v)), T()) =
    andb_intro(vc_le(v, tick(i, v)), notb(vc_le(tick(i, v), v)), tick_mono(i, v), notb_f(vc_le(tick(i, v), v), tick_gt(i, v, hir)))
  ## Causal precedence (Lamport happens-before) between clock-stamped events, generated operationally:
  ## a LOCAL event (tick, program order) and a RECEIVE (merge the sender's timestamp then tick, message order),
  ## closed under transitivity.
  type HB indices (a: VC, b: VC)
    HBTick  : (i: Nat) -> (v: VC) -> InRange(i, v) -> HB(v, tick(i, v))
    HBRecv  : (j: Nat) -> (v: VC) -> (m: VC) -> InRange(j, vmax(v, m)) -> HB(m, tick(j, vmax(v, m)))
    HBTrans : (a: VC) -> (b: VC) -> (c: VC) -> HB(a, b) -> HB(b, c) -> HB(a, c)
  ## **THE CLOCK CONDITION (Fidge–Mattern soundness)**: if event a causally precedes event b, then its vector
  ## clock is STRICTLY less — vc_lt(a, b). So comparing timestamps SOUNDLY detects causality: VC(a) ⊀ VC(b)
  ## proves a did NOT cause b. Local step = tick_strict; receive = the sender's stamp ≤ the merge ≺ the ticked
  ## receive clock (vmax_ub_r + tick_strict via le_lt_trans); transitivity = vc_lt_trans.
  fn hb_sound(a: VC, b: VC, h: HB(a, b)) -> Equivalent(Bool, vc_lt(a, b), T()) = match h
    HBTick(i, v, hir)          -> tick_strict(i, v, hir)
    HBRecv(j, v, m, hir)       -> le_lt_trans(m, vmax(v, m), tick(j, vmax(v, m)), vmax_ub_r(v, m), tick_strict(j, vmax(v, m), hir))
    HBTrans(a2, b2, c2, hab, hbc) -> vc_lt_trans(a2, b2, c2, hb_sound(a2, b2, hab), hb_sound(b2, c2, hbc))
end
