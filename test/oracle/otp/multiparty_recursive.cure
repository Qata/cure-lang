mod MultipartyRecursive
  use Std.Equivalent
  type TB2 = F | T
  type Tag = TA | TB | TC
  type Role = RA | RB | RC
  fn role_eq(x: Role, y: Role) -> TB2 = match x
    RA() -> match y
      RA() -> T()
      RB() -> F()
      RC() -> F()
    RB() -> match y
      RA() -> F()
      RB() -> T()
      RC() -> F()
    RC() -> match y
      RA() -> F()
      RB() -> F()
      RC() -> T()
  type Global = GEnd | GMsg(Role, Role, Tag, Global) | GRec(Global) | GVar
  type Local = LEnd | LSend(Tag, Local) | LRecv(Tag, Local) | LRec(Local) | LVar
  ## PROJECTION onto a role, now with RECURSION: GRec projects structurally to LRec, the loop
  ## variable GVar to LVar. Messages project as before (sender->LSend, receiver->LRecv, bystander skip).
  fn project(g: Global, r: Role) -> Local = match g
    GEnd()               -> LEnd()
    GMsg(from, to, t, k) -> match role_eq(from, r)
      T() -> LSend(t, project(k, r))
      F() -> match role_eq(to, r)
        T() -> LRecv(t, project(k, r))
        F() -> project(k, r)
    GRec(body)           -> LRec(project(body, r))
    GVar()               -> LVar()
  ## Unfolding substitutes the loop variable. gsubst replaces GVar by s (opaque under an inner GRec,
  ## single-variable recursion); lsubst is its local mirror.
  fn gsubst(g: Global, s: Global) -> Global = match g
    GEnd()               -> GEnd()
    GMsg(from, to, t, k) -> GMsg(from, to, t, gsubst(k, s))
    GRec(body)           -> GRec(body)
    GVar()               -> s
  fn lsubst(l: Local, s: Local) -> Local = match l
    LEnd()      -> LEnd()
    LSend(t, k) -> LSend(t, lsubst(k, s))
    LRecv(t, k) -> LRecv(t, lsubst(k, s))
    LRec(body)  -> LRec(body)
    LVar()      -> s
  fn lsend_cong(t: Tag, {a: Local}, {b: Local}, e: Equivalent(Local, a, b)) -> Equivalent(Local, LSend(t, a), LSend(t, b)) =
    rewrite e in reflexive(LSend(t, b))
  fn lrecv_cong(t: Tag, {a: Local}, {b: Local}, e: Equivalent(Local, a, b)) -> Equivalent(Local, LRecv(t, a), LRecv(t, b)) =
    rewrite e in reflexive(LRecv(t, b))
  ## **PROJECTION IS A SUBSTITUTION HOMOMORPHISM.** project(gsubst(g,s), r) = lsubst(project(g,r),
  ## project(s,r)) — projecting after substituting the loop body equals substituting the projected
  ## body into the projected continuation. The crux lemma making recursive multiparty projection
  ## well-behaved. Induction on g; the message case cases all three roles concretely so role_eq
  ## reduces (sender/receiver recurse under lsend/lrecv congruence, a bystander recurses directly).
  fn project_subst_hom(g: Global, s: Global, r: Role) -> Equivalent(Local, project(gsubst(g, s), r), lsubst(project(g, r), project(s, r))) = match g
    GEnd()               -> reflexive(LEnd())
    GVar()               -> reflexive(project(s, r))
    GRec(body)           -> reflexive(LRec(project(body, r)))
    GMsg(from, to, t, k) -> match from
      RA() -> match to
        RA() -> match r
          RA() -> lsend_cong(t, project_subst_hom(k, s, RA()))
          RB() -> project_subst_hom(k, s, RB())
          RC() -> project_subst_hom(k, s, RC())
        RB() -> match r
          RA() -> lsend_cong(t, project_subst_hom(k, s, RA()))
          RB() -> lrecv_cong(t, project_subst_hom(k, s, RB()))
          RC() -> project_subst_hom(k, s, RC())
        RC() -> match r
          RA() -> lsend_cong(t, project_subst_hom(k, s, RA()))
          RB() -> project_subst_hom(k, s, RB())
          RC() -> lrecv_cong(t, project_subst_hom(k, s, RC()))
      RB() -> match to
        RA() -> match r
          RA() -> lrecv_cong(t, project_subst_hom(k, s, RA()))
          RB() -> lsend_cong(t, project_subst_hom(k, s, RB()))
          RC() -> project_subst_hom(k, s, RC())
        RB() -> match r
          RA() -> project_subst_hom(k, s, RA())
          RB() -> lsend_cong(t, project_subst_hom(k, s, RB()))
          RC() -> project_subst_hom(k, s, RC())
        RC() -> match r
          RA() -> project_subst_hom(k, s, RA())
          RB() -> lsend_cong(t, project_subst_hom(k, s, RB()))
          RC() -> lrecv_cong(t, project_subst_hom(k, s, RC()))
      RC() -> match to
        RA() -> match r
          RA() -> lrecv_cong(t, project_subst_hom(k, s, RA()))
          RB() -> project_subst_hom(k, s, RB())
          RC() -> lsend_cong(t, project_subst_hom(k, s, RC()))
        RB() -> match r
          RA() -> project_subst_hom(k, s, RA())
          RB() -> lrecv_cong(t, project_subst_hom(k, s, RB()))
          RC() -> lsend_cong(t, project_subst_hom(k, s, RC()))
        RC() -> match r
          RA() -> project_subst_hom(k, s, RA())
          RB() -> project_subst_hom(k, s, RB())
          RC() -> lsend_cong(t, project_subst_hom(k, s, RC()))
  ## **PROJECTION COMMUTES WITH RECURSION UNFOLDING** (the multiparty analog of dual_unfold_commute):
  ## project(unfold(GRec body), r) = unfold_local(project(GRec body, r)). Unfolding a recursive global
  ## then projecting equals projecting then unfolding the local type — so a looping protocol's per-role
  ## behaviour is stable across every unfolding. Direct corollary of the substitution homomorphism at
  ## s = GRec(body), since project(GRec body, r) = LRec(project(body, r)).
  fn unfold_commute(body: Global, r: Role) -> Equivalent(Local, project(gsubst(body, GRec(body)), r), lsubst(project(body, r), LRec(project(body, r)))) =
    project_subst_hom(body, GRec(body), r)

  fn lrec_cong({a: Local}, {b: Local}, e: Equivalent(Local, a, b)) -> Equivalent(Local, LRec(a), LRec(b)) =
    rewrite e in reflexive(LRec(b))
  ## DUALITY on recursive local types: send<->receive, recursion/variable fixed. dual_involution shows
  ## it is an involution; dual_subst_hom that it distributes over substitution; dual_unfold_commute
  ## (its corollary) that DUAL COMMUTES WITH UNFOLDING — a looping endpoint's dual is the dual endpoint
  ## looping, so the two peers stay dual across every unfolding.
  fn dual(l: Local) -> Local = match l
    LEnd()      -> LEnd()
    LSend(t, k) -> LRecv(t, dual(k))
    LRecv(t, k) -> LSend(t, dual(k))
    LRec(body)  -> LRec(dual(body))
    LVar()      -> LVar()
  fn dual_involution(l: Local) -> Equivalent(Local, dual(dual(l)), l) = match l
    LEnd()      -> reflexive(LEnd())
    LSend(t, k) -> lsend_cong(t, dual_involution(k))
    LRecv(t, k) -> lrecv_cong(t, dual_involution(k))
    LRec(body)  -> lrec_cong(dual_involution(body))
    LVar()      -> reflexive(LVar())
  fn dual_subst_hom(l: Local, s: Local) -> Equivalent(Local, dual(lsubst(l, s)), lsubst(dual(l), dual(s))) = match l
    LEnd()      -> reflexive(LEnd())
    LSend(t, k) -> lrecv_cong(t, dual_subst_hom(k, s))
    LRecv(t, k) -> lsend_cong(t, dual_subst_hom(k, s))
    LRec(body)  -> reflexive(LRec(dual(body)))
    LVar()      -> reflexive(dual(s))
  fn dual_unfold_commute(body: Local) -> Equivalent(Local, dual(lsubst(body, LRec(body))), lsubst(dual(body), LRec(dual(body)))) =
    dual_subst_hom(body, LRec(body))
  ## **RECURSIVE TWO-PARTY COHERENCE.** A coherent RA/RB recursive protocol projects its two active
  ## roles to DUAL endpoints — project(g, RA) = dual(project(g, RB)) — through the recursion: the
  ## GRec/GVar cases carry the duality under LRec/LVar. Since coherence holds at every unfolded global
  ## (projection_duality is over ALL coherent g), duality is preserved across unfolding. Honda-Yoshida-
  ## Carbone coherence lifted to recursive protocols.
  type Coherent indices (g: Global)
    CoEnd : Coherent(GEnd)
    CoAB  : (t: Tag) -> Coherent(k) -> Coherent(GMsg(RA, RB, t, k))
    CoBA  : (t: Tag) -> Coherent(k) -> Coherent(GMsg(RB, RA, t, k))
    CoRec : Coherent(body) -> Coherent(GRec(body))
    CoVar : Coherent(GVar)
  fn projection_duality({g: Global}, w: Coherent(g)) -> Equivalent(Local, project(g, RA()), dual(project(g, RB()))) = match w
    CoEnd()     -> reflexive(LEnd())
    CoAB(t, w2) -> lsend_cong(t, projection_duality(w2))
    CoBA(t, w2) -> lrecv_cong(t, projection_duality(w2))
    CoRec(w2)   -> lrec_cong(projection_duality(w2))
    CoVar()     -> reflexive(LVar())
end
