mod VectorClock
  use Std.Equivalent
  ## VECTOR CLOCKS AND THE CAUSAL ORDER — the metatheory of LOGICAL TIME for message-passing / BEAM systems.
  ## A vector clock is one Nat counter per process; the causal (happens-before-or-equal) order between two
  ## clocks is the POINTWISE Nat order. The core results: that order is a genuine PARTIAL ORDER — reflexive
  ## (vc_le_refl), transitive (vc_le_trans, componentwise le_trans), and antisymmetric (vc_le_antisym,
  ## componentwise leq_antisym); the induced STRICT order is irreflexive (vc_lt_irrefl, no event before
  ## itself); and CONCURRENCY (causal incomparability) is symmetric (vc_conc_sym). The componentwise proofs
  ## decompose the pointwise `andb` into its two conjuncts and recombine them, reusing the Nat order lemmas.
  type Nat = Z | S(Nat)
  type Bool = F | T
  fn leq(a: Nat, b: Nat) -> Bool = match a
    Z()   -> T()
    S(k)  -> match b
      Z()   -> F()
      S(j)  -> leq(k, j)
  fn leq_refl(a: Nat) -> Equivalent(Bool, leq(a, a), T()) = match a
    Z()   -> reflexive(T())
    S(k)  -> leq_refl(k)
  fn le_trans(a: Nat, b: Nat, c: Nat, hab: Equivalent(Bool, leq(a, b), T()), hbc: Equivalent(Bool, leq(b, c), T())) -> Equivalent(Bool, leq(a, c), T()) = match a
    Z()   -> reflexive(T())
    S(a2) -> match b
      Z()   -> match hab
      S(b2) -> match c
        Z()   -> match hbc
        S(c2) -> le_trans(a2, b2, c2, hab, hbc)
  fn snat_cong(a: Nat, b: Nat, e: Equivalent(Nat, a, b)) -> Equivalent(Nat, S(a), S(b)) = rewrite e in reflexive(S(b))
  fn leq_antisym(a: Nat, b: Nat, h1: Equivalent(Bool, leq(a, b), T()), h2: Equivalent(Bool, leq(b, a), T())) -> Equivalent(Nat, a, b) = match a
    Z()   -> match b
      Z()   -> reflexive(Z())
      S(k)  -> match h2
    S(j)  -> match b
      Z()   -> match h1
      S(k)  -> snat_cong(j, k, leq_antisym(j, k, h1, h2))
  fn eqn(a: Nat, b: Nat) -> Bool = match a
    Z()   -> match b
      Z()   -> T()
      S(k)  -> F()
    S(j)  -> match b
      Z()   -> F()
      S(k)  -> eqn(j, k)
  fn eqn_refl(a: Nat) -> Equivalent(Bool, eqn(a, a), T()) = match a
    Z()   -> reflexive(T())
    S(k)  -> eqn_refl(k)
  fn andb(a: Bool, b: Bool) -> Bool = match a
    T() -> b
    F() -> F()
  fn notb(b: Bool) -> Bool = match b
    T() -> F()
    F() -> T()
  fn andb_true_l(a: Bool, b: Bool, e: Equivalent(Bool, andb(a, b), T())) -> Equivalent(Bool, a, T()) = match a
    T() -> reflexive(T())
    F() -> match e
  fn andb_true_r(a: Bool, b: Bool, e: Equivalent(Bool, andb(a, b), T())) -> Equivalent(Bool, b, T()) = match a
    T() -> e
    F() -> match e
  fn andb_intro(a: Bool, b: Bool, ea: Equivalent(Bool, a, T()), eb: Equivalent(Bool, b, T())) -> Equivalent(Bool, andb(a, b), T()) = match a
    T() -> eb
    F() -> match ea
  fn andb_comm(a: Bool, b: Bool) -> Equivalent(Bool, andb(a, b), andb(b, a)) = match a
    T() -> match b
      T() -> reflexive(T())
      F() -> reflexive(F())
    F() -> match b
      T() -> reflexive(F())
      F() -> reflexive(F())
  ## A vector clock: one Nat counter per process.
  type VC = VNil | VCons(Nat, VC)
  ## Pointwise causal order (F on a length mismatch — vector clocks compared are same-dimension).
  fn vc_le(u: VC, v: VC) -> Bool = match u
    VNil()        -> match v
      VNil()        -> T()
      VCons(y, v2)  -> F()
    VCons(x, u2)  -> match v
      VNil()        -> F()
      VCons(y, v2)  -> andb(leq(x, y), vc_le(u2, v2))
  fn vc_eq(u: VC, v: VC) -> Bool = match u
    VNil()        -> match v
      VNil()        -> T()
      VCons(y, v2)  -> F()
    VCons(x, u2)  -> match v
      VNil()        -> F()
      VCons(y, v2)  -> andb(eqn(x, y), vc_eq(u2, v2))
  fn vc_eq_refl(u: VC) -> Equivalent(Bool, vc_eq(u, u), T()) = match u
    VNil()        -> reflexive(T())
    VCons(x, u2)  -> andb_intro(eqn(x, x), vc_eq(u2, u2), eqn_refl(x), vc_eq_refl(u2))
  fn vcons_cong(x: Nat, y: Nat, u2: VC, v2: VC, exy: Equivalent(Nat, x, y), euv: Equivalent(VC, u2, v2)) -> Equivalent(VC, VCons(x, u2), VCons(y, v2)) = rewrite exy in rewrite euv in reflexive(VCons(y, v2))
  ## **CAUSAL ORDER IS REFLEXIVE**: every clock happens-before-or-equal itself.
  fn vc_le_refl(u: VC) -> Equivalent(Bool, vc_le(u, u), T()) = match u
    VNil()        -> reflexive(T())
    VCons(x, u2)  -> andb_intro(leq(x, x), vc_le(u2, u2), leq_refl(x), vc_le_refl(u2))
  ## **CAUSAL ORDER IS TRANSITIVE**: u ≤ v ≤ w ⟹ u ≤ w (componentwise, via Nat le_trans + andb).
  fn vc_le_trans(u: VC, v: VC, w: VC, h1: Equivalent(Bool, vc_le(u, v), T()), h2: Equivalent(Bool, vc_le(v, w), T())) -> Equivalent(Bool, vc_le(u, w), T()) = match u
    VNil()        -> match v
      VNil()        -> match w
        VNil()        -> reflexive(T())
        VCons(z, w2)  -> match h2
      VCons(y, v2)  -> match h1
    VCons(x, u2)  -> match v
      VNil()        -> match h1
      VCons(y, v2)  -> match w
        VNil()        -> match h2
        VCons(z, w2)  -> andb_intro(leq(x, z), vc_le(u2, w2),
          le_trans(x, y, z, andb_true_l(leq(x, y), vc_le(u2, v2), h1), andb_true_l(leq(y, z), vc_le(v2, w2), h2)),
          vc_le_trans(u2, v2, w2, andb_true_r(leq(x, y), vc_le(u2, v2), h1), andb_true_r(leq(y, z), vc_le(v2, w2), h2)))
  ## **CAUSAL ORDER IS ANTISYMMETRIC**: u ≤ v and v ≤ u ⟹ u = v (componentwise leq_antisym). With refl+trans,
  ## vector-clock causal order is a genuine PARTIAL ORDER on clocks.
  fn vc_le_antisym(u: VC, v: VC, h1: Equivalent(Bool, vc_le(u, v), T()), h2: Equivalent(Bool, vc_le(v, u), T())) -> Equivalent(VC, u, v) = match u
    VNil()        -> match v
      VNil()        -> reflexive(VNil())
      VCons(y, v2)  -> match h1
    VCons(x, u2)  -> match v
      VNil()        -> match h2
      VCons(y, v2)  -> vcons_cong(x, y, u2, v2,
        leq_antisym(x, y, andb_true_l(leq(x, y), vc_le(u2, v2), h1), andb_true_l(leq(y, x), vc_le(v2, u2), h2)),
        vc_le_antisym(u2, v2, andb_true_r(leq(x, y), vc_le(u2, v2), h1), andb_true_r(leq(y, x), vc_le(v2, u2), h2)))
  ## Strict causal order (happens-strictly-before) and concurrency (incomparable events).
  fn vc_lt(u: VC, v: VC) -> Bool = andb(vc_le(u, v), notb(vc_eq(u, v)))
  fn vc_conc(u: VC, v: VC) -> Bool = andb(notb(vc_le(u, v)), notb(vc_le(v, u)))
  ## **STRICT CAUSAL ORDER IS IRREFLEXIVE**: no event happens strictly before itself.
  fn vc_lt_irrefl(u: VC) -> Equivalent(Bool, vc_lt(u, u), F()) = rewrite vc_le_refl(u) in rewrite vc_eq_refl(u) in reflexive(F())
  ## **CONCURRENCY IS SYMMETRIC**: u ∥ v iff v ∥ u — being causally unrelated is a symmetric relation.
  fn vc_conc_sym(u: VC, v: VC) -> Equivalent(Bool, vc_conc(u, v), vc_conc(v, u)) = andb_comm(notb(vc_le(u, v)), notb(vc_le(v, u)))
end
