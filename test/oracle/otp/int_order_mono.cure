mod IntOrderMono
  ## Phase-2 probe: `Std.Proof.IntOrder` transitivity and add-monotonicity hold
  ## on closed integer instances. Transitivity chains -1 ≤ 0 ≤ 2 into -1 ≤ 2;
  ## monotonicity adds -2 to both sides of 0 ≤ 2 to get -2 ≤ 0 (forcing the
  ## iterated `add_int` to compute). The Idris mirror (int_order_mono.idr)
  ## reproduces the reflected-form family and both derivations; `rel=same`.
  use Std.Bool
  use Std.Nat
  use Std.Int
  use Std.Proof.IntOrder

  ## -1 ≤ 0 : any negative is ≤ any nonnegative, so le_int computes to True.
  fn neg_one_at_most_zero() -> IsLessThanOrEqual(NegativeSuccessor(Z()), FromNat(Z())) =
    AtMost(Confirmed())

  ## 0 ≤ 2 : le_int reduces to le_nat(0, 2) = True.
  fn zero_at_most_two() -> IsLessThanOrEqual(FromNat(Z()), FromNat(S(S(Z())))) =
    AtMost(Confirmed())

  ## -1 ≤ 2 by transitivity through 0.
  fn neg_one_at_most_two() -> IsLessThanOrEqual(NegativeSuccessor(Z()), FromNat(S(S(Z())))) =
    is_less_than_or_equal_is_transitive(
      NegativeSuccessor(Z()), FromNat(Z()), FromNat(S(S(Z()))),
      neg_one_at_most_zero(), zero_at_most_two())

  ## -2 ≤ 0 by adding -2 to both sides of 0 ≤ 2. -2 = NegativeSuccessor(S(Z)).
  fn neg_two_at_most_zero() -> IsLessThanOrEqual(add_int(NegativeSuccessor(S(Z())), FromNat(Z())), add_int(NegativeSuccessor(S(Z())), FromNat(S(S(Z()))))) =
    adding_the_same_number_preserves_less_than_or_equal(
      NegativeSuccessor(S(Z())), FromNat(Z()), FromNat(S(S(Z()))),
      zero_at_most_two())

  ## Observable: -2 + 2 = 0, and le_int(-2, 0) = True.
  fn start() -> Bool =
    le_int(add_int(NegativeSuccessor(S(Z())), FromNat(Z())), add_int(NegativeSuccessor(S(Z())), FromNat(S(S(Z())))))
end
