mod Lifecycle
  type Phase = PInit | PRunning | PTerminated
  type Callback indices (from: Phase, to: Phase)
    CbInit      : Callback(PInit, PRunning)
    CbCall      : Callback(PRunning, PRunning)
    CbCast      : Callback(PRunning, PRunning)
    CbInfo      : Callback(PRunning, PRunning)
    CbStop      : Callback(PRunning, PTerminated)
    CbTerminate : Callback(PTerminated, PTerminated)
  type Lifecycle indices (from: Phase, to: Phase)
    LEnd  : Lifecycle(p, p)
    LStep : Callback(from, mid) -> Lifecycle(mid, to) -> Lifecycle(from, to)
  type Empty = |
  fn init_only({to: Phase}, cb: Callback(PInit, to)) -> Equivalent(Phase, to, PRunning) = match cb
    CbInit() -> reflexive(PRunning())
  fn nothing_reinits({from: Phase}, cb: Callback(from, PInit)) -> Empty = match cb
  fn terminated_absorbing({to: Phase}, cb: Callback(PTerminated, to)) -> Equivalent(Phase, to, PTerminated) = match cb
    CbTerminate() -> reflexive(PTerminated())
  fn no_resurrection({to: Phase}, lc: Lifecycle(PTerminated, to)) -> Equivalent(Phase, to, PTerminated) = match lc
    LEnd()         -> reflexive(PTerminated())
    LStep(cb, lc2) -> match cb
      CbTerminate() -> no_resurrection(lc2)
end
