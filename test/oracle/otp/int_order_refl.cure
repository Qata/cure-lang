mod IntOrderRefl
  ## Phase-2 probe: `Std.Proof.IntOrder` reflexivity holds on closed integer
  ## instances (2 ≤ 2 nonneg, -3 ≤ -3 negative) and the decision procedure
  ## agrees. The Idris mirror (int_order_refl.idr) reproduces the reflected-form
  ## family (`So (leInt a b)`) and the same reflexivity derivation; `rel=same` —
  ## both accept.
  use Std.Bool
  use Std.Nat
  use Std.Int
  use Std.Decision
  use Std.Proof.IntOrder

  ## 2 ≤ 2 by reflexivity (2 = FromNat(S(S(Z)))).
  fn two_at_most_two() -> IsLessThanOrEqual(FromNat(S(S(Z()))), FromNat(S(S(Z())))) =
    is_less_than_or_equal_is_reflexive(FromNat(S(S(Z()))))

  ## -3 ≤ -3 by reflexivity (-3 = NegativeSuccessor(S(S(Z)))).
  fn neg_three_at_most_neg_three() -> IsLessThanOrEqual(NegativeSuccessor(S(S(Z()))), NegativeSuccessor(S(S(Z())))) =
    is_less_than_or_equal_is_reflexive(NegativeSuccessor(S(S(Z()))))

  ## Observable: decide 2 ≤ 2 — the reflexive instance is accepted (Yes).
  fn start() -> Bool =
    match decide_is_less_than_or_equal(FromNat(S(S(Z()))), FromNat(S(S(Z()))))
      Yes(proof) -> True()
      No(refuter) -> False()
end
