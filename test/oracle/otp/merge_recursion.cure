mod MergeRecursion
  use Std.Equivalent
  type TB2 = F | T
  type Tag = TA | TB | TC
  fn tag_eq(x: Tag, y: Tag) -> TB2 = match x
    TA() -> match y
      TA() -> T()
      TB() -> F()
      TC() -> F()
    TB() -> match y
      TA() -> F()
      TB() -> T()
      TC() -> F()
    TC() -> match y
      TA() -> F()
      TB() -> F()
      TC() -> T()
  ## Local types with CHOICE (LSel/LBra), RECURSION (LRec/LVar), and the conflict marker LErr.
  type Local = LEnd | LSend(Tag, Local) | LRecv(Tag, Local) | LSel(Tag, Local, Tag, Local) | LBra(Tag, Local, Tag, Local) | LRec(Local) | LVar | LErr
  fn merge(x: Local, y: Local) -> Local = match x
    LEnd() -> match y
      LEnd()      -> LEnd()
      LSend(t2, k2)      -> LErr()
      LRecv(t2, k2)      -> LErr()
      LSel(a2, A2, b2, B2)      -> LErr()
      LBra(a2, A2, b2, B2)      -> LErr()
      LRec(p2)      -> LErr()
      LVar()      -> LErr()
      LErr()      -> LErr()
    LSend(t1, k1) -> match y
      LEnd()      -> LErr()
      LSend(t2, k2)      -> match tag_eq(t1, t2)
        T() -> LSend(t1, merge(k1, k2))
        F() -> LErr()
      LRecv(t2, k2)      -> LErr()
      LSel(a2, A2, b2, B2)      -> LErr()
      LBra(a2, A2, b2, B2)      -> LErr()
      LRec(p2)      -> LErr()
      LVar()      -> LErr()
      LErr()      -> LErr()
    LRecv(t1, k1) -> match y
      LEnd()      -> LErr()
      LSend(t2, k2)      -> LErr()
      LRecv(t2, k2)      -> match tag_eq(t1, t2)
        T() -> LRecv(t1, merge(k1, k2))
        F() -> LBra(t1, k1, t2, k2)
      LSel(a2, A2, b2, B2)      -> LErr()
      LBra(a2, A2, b2, B2)      -> LErr()
      LRec(p2)      -> LErr()
      LVar()      -> LErr()
      LErr()      -> LErr()
    LSel(a1, A1, b1, B1) -> match y
      LEnd()      -> LErr()
      LSend(t2, k2)      -> LErr()
      LRecv(t2, k2)      -> LErr()
      LSel(a2, A2, b2, B2)      -> match tag_eq(a1, a2)
        T() -> match tag_eq(b1, b2)
          T() -> LSel(a1, merge(A1, A2), b1, merge(B1, B2))
          F() -> LErr()
        F() -> LErr()
      LBra(a2, A2, b2, B2)      -> LErr()
      LRec(p2)      -> LErr()
      LVar()      -> LErr()
      LErr()      -> LErr()
    LBra(a1, A1, b1, B1) -> match y
      LEnd()      -> LErr()
      LSend(t2, k2)      -> LErr()
      LRecv(t2, k2)      -> LErr()
      LSel(a2, A2, b2, B2)      -> LErr()
      LBra(a2, A2, b2, B2)      -> match tag_eq(a1, a2)
        T() -> match tag_eq(b1, b2)
          T() -> LBra(a1, merge(A1, A2), b1, merge(B1, B2))
          F() -> LErr()
        F() -> LErr()
      LRec(p2)      -> LErr()
      LVar()      -> LErr()
      LErr()      -> LErr()
    LRec(p1) -> match y
      LEnd()      -> LErr()
      LSend(t2, k2)      -> LErr()
      LRecv(t2, k2)      -> LErr()
      LSel(a2, A2, b2, B2)      -> LErr()
      LBra(a2, A2, b2, B2)      -> LErr()
      LRec(p2)      -> LRec(merge(p1, p2))
      LVar()      -> LErr()
      LErr()      -> LErr()
    LVar() -> match y
      LEnd()      -> LErr()
      LSend(t2, k2)      -> LErr()
      LRecv(t2, k2)      -> LErr()
      LSel(a2, A2, b2, B2)      -> LErr()
      LBra(a2, A2, b2, B2)      -> LErr()
      LRec(p2)      -> LErr()
      LVar()      -> LVar()
      LErr()      -> LErr()
    LErr() -> match y
      LEnd()      -> LErr()
      LSend(t2, k2)      -> LErr()
      LRecv(t2, k2)      -> LErr()
      LSel(a2, A2, b2, B2)      -> LErr()
      LBra(a2, A2, b2, B2)      -> LErr()
      LRec(p2)      -> LErr()
      LVar()      -> LErr()
      LErr()      -> LErr()
  fn lsend_cong(t: Tag, {a: Local}, {b: Local}, e: Equivalent(Local, a, b)) -> Equivalent(Local, LSend(t, a), LSend(t, b)) = rewrite e in reflexive(LSend(t, b))
  fn lrecv_cong(t: Tag, {a: Local}, {b: Local}, e: Equivalent(Local, a, b)) -> Equivalent(Local, LRecv(t, a), LRecv(t, b)) = rewrite e in reflexive(LRecv(t, b))
  fn lrec_cong({a: Local}, {b: Local}, e: Equivalent(Local, a, b)) -> Equivalent(Local, LRec(a), LRec(b)) = rewrite e in reflexive(LRec(b))
  fn lsel_cong(a: Tag, {A1: Local}, {A2: Local}, eA: Equivalent(Local, A1, A2), b: Tag, {B1: Local}, {B2: Local}, eB: Equivalent(Local, B1, B2)) -> Equivalent(Local, LSel(a, A1, b, B1), LSel(a, A2, b, B2)) = rewrite eA in rewrite eB in reflexive(LSel(a, A2, b, B2))
  fn lbra_cong(a: Tag, {A1: Local}, {A2: Local}, eA: Equivalent(Local, A1, A2), b: Tag, {B1: Local}, {B2: Local}, eB: Equivalent(Local, B1, B2)) -> Equivalent(Local, LBra(a, A1, b, B1), LBra(a, A2, b, B2)) = rewrite eA in rewrite eB in reflexive(LBra(a, A2, b, B2))
  ## Single-variable substitution (unfolding): opaque under an inner LRec.
  fn lsubst(l: Local, s: Local) -> Local = match l
    LEnd()           -> LEnd()
    LSend(t, k)      -> LSend(t, lsubst(k, s))
    LRecv(t, k)      -> LRecv(t, lsubst(k, s))
    LSel(a, A, b, B) -> LSel(a, lsubst(A, s), b, lsubst(B, s))
    LBra(a, A, b, B) -> LBra(a, lsubst(A, s), b, lsubst(B, s))
    LRec(body)       -> LRec(body)
    LVar()           -> s
    LErr()           -> LErr()
  ## **MERGE IS IDEMPOTENT** (needed for the recursion-variable case below): merge(l, l) = l.
  fn merge_idem(l: Local) -> Equivalent(Local, merge(l, l), l) = match l
    LEnd()          -> reflexive(LEnd())
    LSend(t, k)     -> match t
      TA() -> lsend_cong(TA(), merge_idem(k))
      TB() -> lsend_cong(TB(), merge_idem(k))
      TC() -> lsend_cong(TC(), merge_idem(k))
    LRecv(t, k)     -> match t
      TA() -> lrecv_cong(TA(), merge_idem(k))
      TB() -> lrecv_cong(TB(), merge_idem(k))
      TC() -> lrecv_cong(TC(), merge_idem(k))
    LSel(a, A, b, B) -> match a
      TA() -> match b
        TA() -> lsel_cong(TA(), merge_idem(A), TA(), merge_idem(B))
        TB() -> lsel_cong(TA(), merge_idem(A), TB(), merge_idem(B))
        TC() -> lsel_cong(TA(), merge_idem(A), TC(), merge_idem(B))
      TB() -> match b
        TA() -> lsel_cong(TB(), merge_idem(A), TA(), merge_idem(B))
        TB() -> lsel_cong(TB(), merge_idem(A), TB(), merge_idem(B))
        TC() -> lsel_cong(TB(), merge_idem(A), TC(), merge_idem(B))
      TC() -> match b
        TA() -> lsel_cong(TC(), merge_idem(A), TA(), merge_idem(B))
        TB() -> lsel_cong(TC(), merge_idem(A), TB(), merge_idem(B))
        TC() -> lsel_cong(TC(), merge_idem(A), TC(), merge_idem(B))
    LBra(a, A, b, B) -> match a
      TA() -> match b
        TA() -> lbra_cong(TA(), merge_idem(A), TA(), merge_idem(B))
        TB() -> lbra_cong(TA(), merge_idem(A), TB(), merge_idem(B))
        TC() -> lbra_cong(TA(), merge_idem(A), TC(), merge_idem(B))
      TB() -> match b
        TA() -> lbra_cong(TB(), merge_idem(A), TA(), merge_idem(B))
        TB() -> lbra_cong(TB(), merge_idem(A), TB(), merge_idem(B))
        TC() -> lbra_cong(TB(), merge_idem(A), TC(), merge_idem(B))
      TC() -> match b
        TA() -> lbra_cong(TC(), merge_idem(A), TA(), merge_idem(B))
        TB() -> lbra_cong(TC(), merge_idem(A), TB(), merge_idem(B))
        TC() -> lbra_cong(TC(), merge_idem(A), TC(), merge_idem(B))
    LRec(p)         -> lrec_cong(merge_idem(p))
    LVar()          -> reflexive(LVar())
    LErr()          -> reflexive(LErr())
  ## MERGEABILITY, extended with a recursion-variable case (MgVar) and a recursion case (MgRec).
  ## Differing receives carry their continuations as explicit fields so the union LBra is nameable.
  type Mergeable indices (x: Local, y: Local)
    MgEnd    : Mergeable(LEnd, LEnd)
    MgSend   : (t: Tag) -> Mergeable(k1, k2) -> Mergeable(LSend(t, k1), LSend(t, k2))
    MgRecvEq : (t: Tag) -> Mergeable(k1, k2) -> Mergeable(LRecv(t, k1), LRecv(t, k2))
    MgRecvNe : (a: Tag) -> (b: Tag) -> (xk: Local) -> (yk: Local) -> Equivalent(TB2, tag_eq(a, b), F()) -> Mergeable(LRecv(a, xk), LRecv(b, yk))
    MgSel    : (a: Tag) -> (b: Tag) -> Mergeable(A1, A2) -> Mergeable(B1, B2) -> Mergeable(LSel(a, A1, b, B1), LSel(a, A2, b, B2))
    MgBra    : (a: Tag) -> (b: Tag) -> Mergeable(A1, A2) -> Mergeable(B1, B2) -> Mergeable(LBra(a, A1, b, B1), LBra(a, A2, b, B2))
    MgVar    : Mergeable(LVar, LVar)
    MgRec    : (p1: Local) -> (p2: Local) -> Mergeable(p1, p2) -> Mergeable(LRec(p1), LRec(p2))
  ## **MERGE COMMUTES WITH SUBSTITUTION FOR MERGEABLE BRANCHES** (the crux of choice-under-recursion):
  ## Mergeable(x, y) ⟹ merge(lsubst(x, s), lsubst(y, s)) = lsubst(merge(x, y), s). So unfolding a
  ## recursive protocol and THEN merging a bystander's two branch-behaviours equals merging first and
  ## then unfolding — hence bystander projection is stable under unfolding. The apparent obstacle
  ## (substituting into a bare LVar merged with a concrete type could change mergeability) never arises
  ## BECAUSE that pair is exactly non-mergeable; the only variable case is MgVar (LVar with LVar),
  ## discharged by MERGE IDEMPOTENCE on the substituted value merge(s, s) = s. Induction on the
  ## mergeability derivation.
  fn merge_lsubst_commute({x: Local}, {y: Local}, m: Mergeable(x, y), s: Local) -> Equivalent(Local, merge(lsubst(x, s), lsubst(y, s)), lsubst(merge(x, y), s)) = match m
    MgEnd()               -> reflexive(LEnd())
    MgSend(t, m2)         -> match t
      TA() -> lsend_cong(TA(), merge_lsubst_commute(m2, s))
      TB() -> lsend_cong(TB(), merge_lsubst_commute(m2, s))
      TC() -> lsend_cong(TC(), merge_lsubst_commute(m2, s))
    MgRecvEq(t, m2)       -> match t
      TA() -> lrecv_cong(TA(), merge_lsubst_commute(m2, s))
      TB() -> lrecv_cong(TB(), merge_lsubst_commute(m2, s))
      TC() -> lrecv_cong(TC(), merge_lsubst_commute(m2, s))
    MgRecvNe(a, b, xk, yk, pne) -> match a
      TA() -> match b
        TA() -> match pne
        TB() -> reflexive(LBra(TA(), lsubst(xk, s), TB(), lsubst(yk, s)))
        TC() -> reflexive(LBra(TA(), lsubst(xk, s), TC(), lsubst(yk, s)))
      TB() -> match b
        TA() -> reflexive(LBra(TB(), lsubst(xk, s), TA(), lsubst(yk, s)))
        TB() -> match pne
        TC() -> reflexive(LBra(TB(), lsubst(xk, s), TC(), lsubst(yk, s)))
      TC() -> match b
        TA() -> reflexive(LBra(TC(), lsubst(xk, s), TA(), lsubst(yk, s)))
        TB() -> reflexive(LBra(TC(), lsubst(xk, s), TB(), lsubst(yk, s)))
        TC() -> match pne
    MgSel(a, b, mA, mB)   -> match a
      TA() -> match b
        TA() -> lsel_cong(TA(), merge_lsubst_commute(mA, s), TA(), merge_lsubst_commute(mB, s))
        TB() -> lsel_cong(TA(), merge_lsubst_commute(mA, s), TB(), merge_lsubst_commute(mB, s))
        TC() -> lsel_cong(TA(), merge_lsubst_commute(mA, s), TC(), merge_lsubst_commute(mB, s))
      TB() -> match b
        TA() -> lsel_cong(TB(), merge_lsubst_commute(mA, s), TA(), merge_lsubst_commute(mB, s))
        TB() -> lsel_cong(TB(), merge_lsubst_commute(mA, s), TB(), merge_lsubst_commute(mB, s))
        TC() -> lsel_cong(TB(), merge_lsubst_commute(mA, s), TC(), merge_lsubst_commute(mB, s))
      TC() -> match b
        TA() -> lsel_cong(TC(), merge_lsubst_commute(mA, s), TA(), merge_lsubst_commute(mB, s))
        TB() -> lsel_cong(TC(), merge_lsubst_commute(mA, s), TB(), merge_lsubst_commute(mB, s))
        TC() -> lsel_cong(TC(), merge_lsubst_commute(mA, s), TC(), merge_lsubst_commute(mB, s))
    MgBra(a, b, mA, mB)   -> match a
      TA() -> match b
        TA() -> lbra_cong(TA(), merge_lsubst_commute(mA, s), TA(), merge_lsubst_commute(mB, s))
        TB() -> lbra_cong(TA(), merge_lsubst_commute(mA, s), TB(), merge_lsubst_commute(mB, s))
        TC() -> lbra_cong(TA(), merge_lsubst_commute(mA, s), TC(), merge_lsubst_commute(mB, s))
      TB() -> match b
        TA() -> lbra_cong(TB(), merge_lsubst_commute(mA, s), TA(), merge_lsubst_commute(mB, s))
        TB() -> lbra_cong(TB(), merge_lsubst_commute(mA, s), TB(), merge_lsubst_commute(mB, s))
        TC() -> lbra_cong(TB(), merge_lsubst_commute(mA, s), TC(), merge_lsubst_commute(mB, s))
      TC() -> match b
        TA() -> lbra_cong(TC(), merge_lsubst_commute(mA, s), TA(), merge_lsubst_commute(mB, s))
        TB() -> lbra_cong(TC(), merge_lsubst_commute(mA, s), TB(), merge_lsubst_commute(mB, s))
        TC() -> lbra_cong(TC(), merge_lsubst_commute(mA, s), TC(), merge_lsubst_commute(mB, s))
    MgVar()               -> merge_idem(s)
    MgRec(p1, p2, mp)     -> reflexive(LRec(merge(p1, p2)))
end
