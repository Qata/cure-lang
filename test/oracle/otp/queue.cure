mod Queue
  use Std.Equivalent
  type QList = QNil | QCons(Nat, QList)
  fn append(xs: QList, ys: QList) -> QList = match xs
    QNil()       -> ys
    QCons(h, t)  -> QCons(h, append(t, ys))
  fn reverse(xs: QList) -> QList = match xs
    QNil()       -> QNil()
    QCons(h, t)  -> append(reverse(t), QCons(h, QNil()))
  fn cons_cong(h: Nat, {a: QList}, {b: QList}, e: Equivalent(QList, a, b)) -> Equivalent(QList, QCons(h, a), QCons(h, b)) =
    rewrite e in reflexive(QCons(h, b))
  fn append_assoc(xs: QList, ys: QList, zs: QList) -> Equivalent(QList, append(append(xs, ys), zs), append(xs, append(ys, zs))) = match xs
    QNil()       -> reflexive(append(ys, zs))
    QCons(h, t)  -> cons_cong(h, append_assoc(t, ys, zs))
  type Q = MkQ(QList, QList)
  fn to_list(q: Q) -> QList = match q
    MkQ(f, b) -> append(f, reverse(b))
  fn enqueue(x: Nat, q: Q) -> Q = match q
    MkQ(f, b) -> MkQ(f, QCons(x, b))
  fn enqueue_appends(x: Nat, q: Q) -> Equivalent(QList, to_list(enqueue(x, q)), append(to_list(q), QCons(x, QNil()))) = match q
    MkQ(f, b) -> sym(append_assoc(f, reverse(b), QCons(x, QNil())))
  fn append_nil_r(xs: QList) -> Equivalent(QList, append(xs, QNil()), xs) = match xs
    QNil()      -> reflexive(QNil())
    QCons(h, t) -> cons_cong(h, append_nil_r(t))
  type QOut = QEmpty | Out(Nat, Q)
  fn deq_list(xs: QList) -> QOut = match xs
    QNil()      -> QEmpty()
    QCons(h, t) -> Out(h, MkQ(t, QNil()))
  fn dequeue(q: Q) -> QOut = match q
    MkQ(f, b) -> match f
      QCons(h, f2) -> Out(h, MkQ(f2, b))
      QNil()       -> deq_list(reverse(b))
  fn reassemble(o: QOut) -> QList = match o
    QEmpty()   -> QNil()
    Out(x, q2) -> QCons(x, to_list(q2))
  fn deq_list_reassembles(xs: QList) -> Equivalent(QList, reassemble(deq_list(xs)), xs) = match xs
    QNil()      -> reflexive(QNil())
    QCons(h, t) -> cons_cong(h, append_nil_r(t))
  fn dequeue_reassembles(q: Q) -> Equivalent(QList, reassemble(dequeue(q)), to_list(q)) = match q
    MkQ(f, b) -> match f
      QCons(h, f2) -> reflexive(QCons(h, append(f2, reverse(b))))
      QNil()       -> deq_list_reassembles(reverse(b))
  fn append_cong(c: QList, {a: QList}, {b: QList}, e: Equivalent(QList, a, b)) -> Equivalent(QList, append(a, c), append(b, c)) =
    rewrite e in reflexive(append(b, c))
  fn enqueue_respects(x: Nat, q1: Q, q2: Q, e: Equivalent(QList, to_list(q1), to_list(q2))) -> Equivalent(QList, to_list(enqueue(x, q1)), to_list(enqueue(x, q2))) =
    trans(enqueue_appends(x, q1), trans(append_cong(QCons(x, QNil()), e), sym(enqueue_appends(x, q2))))
  fn dequeue_respects(q1: Q, q2: Q, e: Equivalent(QList, to_list(q1), to_list(q2))) -> Equivalent(QList, reassemble(dequeue(q1)), reassemble(dequeue(q2))) =
    trans(dequeue_reassembles(q1), trans(e, sym(dequeue_reassembles(q2))))
  type QOpt = QNone | QSome(Nat)
  fn peek_list(xs: QList) -> QOpt = match xs
    QNil()      -> QNone()
    QCons(h, t) -> QSome(h)
  fn peek(q: Q) -> QOpt = match q
    MkQ(f, b) -> match f
      QCons(h, f2) -> QSome(h)
      QNil()       -> peek_list(reverse(b))
  fn head_of(o: QOut) -> QOpt = match o
    QEmpty()   -> QNone()
    Out(x, q2) -> QSome(x)
  fn peek_list_deq(xs: QList) -> Equivalent(QOpt, peek_list(xs), head_of(deq_list(xs))) = match xs
    QNil()      -> reflexive(QNone())
    QCons(h, t) -> reflexive(QSome(h))
  fn peek_dequeue(q: Q) -> Equivalent(QOpt, peek(q), head_of(dequeue(q))) = match q
    MkQ(f, b) -> match f
      QCons(h, f2) -> reflexive(QSome(h))
      QNil()       -> peek_list_deq(reverse(b))
  type B = F | T
  fn qnull(xs: QList) -> B = match xs
    QNil()      -> T()
    QCons(h, t) -> F()
  fn andb(a: B, b: B) -> B = match a
    F() -> F()
    T() -> b
  fn is_empty(q: Q) -> B = match q
    MkQ(f, b) -> andb(qnull(f), qnull(b))
  fn qnull_append_cons(xs: QList, h: Nat) -> Equivalent(B, qnull(append(xs, QCons(h, QNil()))), F()) = match xs
    QNil()      -> reflexive(F())
    QCons(a, t) -> reflexive(F())
  fn qnull_reverse(xs: QList) -> Equivalent(B, qnull(reverse(xs)), qnull(xs)) = match xs
    QNil()      -> reflexive(T())
    QCons(h, t) -> qnull_append_cons(reverse(t), h)
  fn is_empty_reflects(q: Q) -> Equivalent(B, is_empty(q), qnull(to_list(q))) = match q
    MkQ(f, b) -> match f
      QCons(h, f2) -> reflexive(F())
      QNil()       -> sym(qnull_reverse(b))
end
