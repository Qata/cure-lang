mod RecursiveSession
  type Tag = TA | TB | TC
  type RSType = REnd | RSend(Tag, RSType) | RRecv(Tag, RSType) | RVar | RMu(RSType)
  fn subst(s: RSType, u: RSType) -> RSType = match s
    REnd()      -> REnd()
    RSend(t, k) -> RSend(t, subst(k, u))
    RRecv(t, k) -> RRecv(t, subst(k, u))
    RVar()      -> u
    RMu(body)   -> RMu(body)
  fn unfold(m: RSType) -> RSType = match m
    REnd()      -> REnd()
    RSend(t, k) -> RSend(t, k)
    RRecv(t, k) -> RRecv(t, k)
    RVar()      -> RVar()
    RMu(body)   -> subst(body, RMu(body))
  fn rdual(s: RSType) -> RSType = match s
    REnd()      -> REnd()
    RSend(t, k) -> RRecv(t, rdual(k))
    RRecv(t, k) -> RSend(t, rdual(k))
    RVar()      -> RVar()
    RMu(body)   -> RMu(rdual(body))
  fn rdual_involution(s: RSType) -> Equivalent(RSType, rdual(rdual(s)), s) = match s
    REnd()      -> reflexive(REnd())
    RSend(t, k) -> rewrite rdual_involution(k) in reflexive(RSend(t, k))
    RRecv(t, k) -> rewrite rdual_involution(k) in reflexive(RRecv(t, k))
    RVar()      -> reflexive(RVar())
    RMu(body)   -> rewrite rdual_involution(body) in reflexive(RMu(body))
  fn subst_dual(s: RSType, u: RSType) -> Equivalent(RSType, rdual(subst(s, u)), subst(rdual(s), rdual(u))) = match s
    REnd()      -> reflexive(REnd())
    RSend(t, k) -> rewrite subst_dual(k, u) in reflexive(RRecv(t, subst(rdual(k), rdual(u))))
    RRecv(t, k) -> rewrite subst_dual(k, u) in reflexive(RSend(t, subst(rdual(k), rdual(u))))
    RVar()      -> reflexive(rdual(u))
    RMu(body)   -> reflexive(RMu(rdual(body)))
  fn dual_unfold_commute(body: RSType) -> Equivalent(RSType, rdual(unfold(RMu(body))), unfold(RMu(rdual(body)))) =
    subst_dual(body, RMu(body))
end
