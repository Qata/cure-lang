mod IntOrderSign
  ## Phase-2 probe: `Std.Proof.IntOrder` sign lemmas, nonnegative-scaling
  ## monotonicity, and the `0 ≤ -1` contradiction extractor hold on closed
  ## integer instances. `nonneg_of_from_nat` gives `0 ≤ 3`; scaling `1 ≤ 2` by
  ## the nonnegative scalar `2` yields `2·1 ≤ 2·2` (i.e. `2 ≤ 4`), forcing the
  ## local `multiply` to compute; and `0 ≤ -1` is refuted. The Idris mirror
  ## (int_order_sign.idr) reproduces the reflected-form family, natural-number
  ## multiplication, the Boolean monotonicity chain, and each derivation;
  ## `rel=same`.
  use Std.Bool
  use Std.Nat
  use Std.Int
  use Std.Proof.IntOrder

  ## 0 ≤ 3 for the nonnegative integer 3.
  fn zero_at_most_three() -> IsLessThanOrEqual(FromNat(Z()), FromNat(S(S(S(Z()))))) =
    nonneg_of_from_nat(S(S(S(Z()))))

  ## 1 ≤ 2 : le_int reduces to le_nat(1, 2) = True.
  fn one_at_most_two() -> IsLessThanOrEqual(FromNat(S(Z())), FromNat(S(S(Z())))) =
    AtMost(Confirmed())

  ## Scaling 1 ≤ 2 by the nonnegative scalar 2 gives 2·1 ≤ 2·2, i.e. 2 ≤ 4. The
  ## return type is stated in reduced form, so conversion computes multiply(2,1)
  ## = 2 and multiply(2,2) = 4.
  fn two_at_most_four() -> IsLessThanOrEqual(FromNat(S(S(Z()))), FromNat(S(S(S(S(Z())))))) =
    scaling_by_nonneg_preserves_less_than_or_equal(
      S(S(Z())), S(Z()), S(S(Z())), one_at_most_two())

  ## 0 ≤ -1 is impossible: the contradiction extractor turns the evidence into Empty.
  fn zero_is_not_at_most_neg_one(
    proof: IsLessThanOrEqual(FromNat(Z()), NegativeSuccessor(Z()))
  ) -> Empty =
    zero_is_not_at_most_negative_one(proof)

  ## Observable: 2 ≤ 4, so le_int computes to True.
  fn start() -> Bool =
    le_int(FromNat(S(S(Z()))), FromNat(S(S(S(S(Z()))))))
end
