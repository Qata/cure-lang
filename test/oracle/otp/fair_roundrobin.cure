mod FairRoundRobin
  use Std.Equivalent
  ## ROUND-ROBIN FAIRNESS FOR N PROCESSES — lifting fair scheduling to arbitrary process count. The
  ## scheduler is a rotating queue: the head is the currently-scheduled process, and rotate moves it to the
  ## back. Fairness is three properties: rotation ADVANCES the head to the next process (progress toward any
  ## waiter), and it preserves both the process COUNT and MEMBERSHIP (no process is ever dropped from the
  ## rotation — no starvation by omission). So every process keeps its place in the cycle and is reached in turn.
  type Nat = Z | S(Nat)
  type Q = QNil | QCons(Nat, Q)
  type Opt = ONone | OSome(Nat)
  fn snat_cong({a: Nat}, {b: Nat}, e: Equivalent(Nat, a, b)) -> Equivalent(Nat, S(a), S(b)) =
    rewrite e in reflexive(S(b))
  fn snoc(q: Q, x: Nat) -> Q = match q
    QNil()          -> QCons(x, QNil())
    QCons(y, rest)  -> QCons(y, snoc(rest, x))
  fn rotate(q: Q) -> Q = match q
    QNil()          -> QNil()
    QCons(x, rest)  -> snoc(rest, x)
  fn head_of(q: Q) -> Opt = match q
    QNil()          -> ONone()
    QCons(x, rest)  -> OSome(x)
  fn length(q: Q) -> Nat = match q
    QNil()          -> Z()
    QCons(x, rest)  -> S(length(rest))
  ## **ROTATION ADVANCES THE HEAD**: rotating a queue of ≥2 processes brings the SECOND to the head — the
  ## scheduler steps to the next process. Repeatedly, the turn walks through the whole queue toward any waiter.
  fn rotate_advances(x: Nat, y: Nat, rest: Q) -> Equivalent(Opt, head_of(rotate(QCons(x, QCons(y, rest)))), OSome(y)) =
    reflexive(OSome(y))
  fn len_snoc(q: Q, x: Nat) -> Equivalent(Nat, length(snoc(q, x)), S(length(q))) = match q
    QNil()          -> reflexive(S(Z()))
    QCons(y, rest)  -> snat_cong(len_snoc(rest, x))
  ## **ROTATION PRESERVES THE COUNT**: the queue keeps the same number of processes — none added or lost.
  fn rotate_length(q: Q) -> Equivalent(Nat, length(rotate(q)), length(q)) = match q
    QNil()          -> reflexive(Z())
    QCons(x, rest)  -> len_snoc(rest, x)
  ## Membership of a process in the queue.
  type InQ indices (x: Nat, q: Q)
    InHead : (rest: Q) -> InQ(x, QCons(x, rest))
    InTail : (y: Nat) -> (rest: Q) -> InQ(x, rest) -> InQ(x, QCons(y, rest))
  fn in_snoc(x: Nat, {q: Q}, y: Nat, m: InQ(x, q)) -> InQ(x, snoc(q, y)) = match m
    InHead(rest)         -> InHead(snoc(rest, y))
    InTail(z, rest, m2)  -> InTail(z, snoc(rest, y), in_snoc(x, y, m2))
  fn in_snoc_last(q: Q, x: Nat) -> InQ(x, snoc(q, x)) = match q
    QNil()          -> InHead(QNil())
    QCons(y, rest)  -> InTail(y, snoc(rest, x), in_snoc_last(rest, x))
  ## **ROTATION PRESERVES MEMBERSHIP (no starvation by omission)**: every process still in the queue before
  ## rotation is still in it after — the scheduler never drops a waiting process. The head goes to the back
  ## (in_snoc_last), the rest stays (in_snoc). So a waiting process keeps its slot in the rotation.
  fn rotate_mem(x: Nat, {q: Q}, m: InQ(x, q)) -> InQ(x, rotate(q)) = match m
    InHead(rest)         -> in_snoc_last(rest, x)
    InTail(z, rest, m2)  -> in_snoc(x, z, m2)
end
