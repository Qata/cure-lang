mod Conversation
  type Tag = TA | TB | TC
  type Mailbox = BNil | BCons(Tag, Mailbox)
  type MList = MNil | MCons(Tag, MList)
  type Protocol = PDone | PExpect(Tag, Protocol)
  fn ptags(p: Protocol) -> MList = match p
    PDone()          -> MNil
    PExpect(t, rest) -> MCons(t, ptags(rest))
  type SingleRecv indices (t: Tag, before: Mailbox, after: Mailbox)
    SVHere : SingleRecv(t, BCons(t, rest), rest)
    SVSkip : SingleRecv(t, rest, after) -> SingleRecv(t, BCons(h, rest), BCons(h, after))
  type ConvRecv indices (proto: Protocol, before: Mailbox, after: Mailbox, received: MList)
    CRDone : ConvRecv(PDone, mbox, mbox, MNil)
    CRStep : (t: Tag) -> SingleRecv(t, before, mid) -> ConvRecv(rest, mid, after, msgs) -> ConvRecv(PExpect(t, rest), before, after, MCons(t, msgs))
  fn mcons_cong(t: Tag, {xs: MList}, {ys: MList}, e: Equivalent(MList, xs, ys)) -> Equivalent(MList, MCons(t, xs), MCons(t, ys)) =
    rewrite e in reflexive(MCons(t, ys))
  fn conv_order({proto: Protocol}, {before: Mailbox}, {after: Mailbox}, {received: MList}, cr: ConvRecv(proto, before, after, received)) -> Equivalent(MList, received, ptags(proto)) = match cr
    CRDone()           -> reflexive(MNil())
    CRStep(t, sv, cr2) -> mcons_cong(t, conv_order(cr2))
end
