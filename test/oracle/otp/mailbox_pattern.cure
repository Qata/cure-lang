mod MailboxPattern
  type Tag = TA | TB | TC
  type B = F | T

  fn plus(m: Nat, n: Nat) -> Nat = match m
    Z()  -> n
    S(k) -> S(plus(k, n))
  fn plus_n_z(n: Nat) -> Equivalent(Nat, plus(n, Z()), n) = match n
    Z()  -> reflexive(Z())
    S(k) -> rewrite plus_n_z(k) in reflexive(S(k))
  fn plus_n_s(m: Nat, n: Nat) -> Equivalent(Nat, plus(m, S(n)), S(plus(m, n))) = match m
    Z()  -> reflexive(S(n))
    S(k) -> rewrite plus_n_s(k, n) in reflexive(S(S(plus(k, n))))
  fn plus_comm(m: Nat, n: Nat) -> Equivalent(Nat, plus(m, n), plus(n, m)) = match m
    Z()  -> rewrite plus_n_z(n) in reflexive(n)
    S(k) -> rewrite plus_n_s(n, k) in rewrite plus_comm(k, n) in reflexive(S(plus(n, k)))
  fn plus_assoc(a: Nat, b: Nat, c: Nat) -> Equivalent(Nat, plus(plus(a, b), c), plus(a, plus(b, c))) = match a
    Z()  -> reflexive(plus(b, c))
    S(k) -> rewrite plus_assoc(k, b, c) in reflexive(S(plus(k, plus(b, c))))

  type MS = MkMS(Nat, Nat, Nat)
  fn msadd(x: MS, y: MS) -> MS = match x
    MkMS(a, b, c) -> match y
      MkMS(d, e, f) -> MkMS(plus(a, d), plus(b, e), plus(c, f))
  fn msadd_comm(x: MS, y: MS) -> Equivalent(MS, msadd(x, y), msadd(y, x)) = match x
    MkMS(a, b, c) -> match y
      MkMS(d, e, f) -> rewrite plus_comm(d, a) in rewrite plus_comm(e, b) in rewrite plus_comm(f, c) in reflexive(MkMS(plus(a, d), plus(b, e), plus(c, f)))
  fn msadd_assoc(x: MS, y: MS, z: MS) -> Equivalent(MS, msadd(msadd(x, y), z), msadd(x, msadd(y, z))) = match x
    MkMS(a, b, c) -> match y
      MkMS(d, e, f) -> match z
        MkMS(g, h, i) -> rewrite plus_assoc(a, d, g) in rewrite plus_assoc(b, e, h) in rewrite plus_assoc(c, f, i) in reflexive(MkMS(plus(a, plus(d, g)), plus(b, plus(e, h)), plus(c, plus(f, i))))
  fn msadd_zero_left(y: MS) -> Equivalent(MS, msadd(MkMS(Z, Z, Z), y), y) = match y
    MkMS(d, e, f) -> reflexive(MkMS(d, e, f))

  type Pat = PZero | POne | PAtom(Tag) | PPlus(Pat, Pat) | PTimes(Pat, Pat) | PStar(Pat)

  type Accepts indices (pat: Pat, m: MS)
    AOne   : Accepts(POne, MkMS(Z, Z, Z))
    AAtomA : Accepts(PAtom(TA), MkMS(S(Z), Z, Z))
    AAtomB : Accepts(PAtom(TB), MkMS(Z, S(Z), Z))
    AAtomC : Accepts(PAtom(TC), MkMS(Z, Z, S(Z)))
    APlusL : Accepts(e, m) -> Accepts(PPlus(e, f), m)
    APlusR : Accepts(f, m) -> Accepts(PPlus(e, f), m)
    ATimes : (m1: MS) -> (m2: MS) -> Accepts(e, m1) -> Accepts(f, m2) -> Accepts(PTimes(e, f), msadd(m1, m2))
    AStar0 : Accepts(PStar(e), MkMS(Z, Z, Z))
    AStarN : (m1: MS) -> (m2: MS) -> Accepts(e, m1) -> Accepts(PStar(e), m2) -> Accepts(PStar(e), msadd(m1, m2))

  fn plus_pat_comm({e: Pat}, {f: Pat}, {m: MS}, acc: Accepts(PPlus(e, f), m)) -> Accepts(PPlus(f, e), m) = match acc
    APlusL(ae) -> APlusR(ae)
    APlusR(af) -> APlusL(af)

  fn times_comm({e: Pat}, {f: Pat}, {m: MS}, acc: Accepts(PTimes(e, f), m)) -> Accepts(PTimes(f, e), m) = match acc
    ATimes(m1, m2, ae, af) -> rewrite msadd_comm(m1, m2) in ATimes(m2, m1, af, ae)

  fn times_assoc({e: Pat}, {f: Pat}, {g: Pat}, {m: MS}, acc: Accepts(PTimes(PTimes(e, f), g), m)) -> Accepts(PTimes(e, PTimes(f, g)), m) = match acc
    ATimes(mef, mg, acc_ef, acc_g) -> match acc_ef
      ATimes(me, mf, acc_e, acc_f) -> rewrite msadd_assoc(me, mf, mg) in ATimes(me, msadd(mf, mg), acc_e, ATimes(mf, mg, acc_f, acc_g))

  fn one_times({e: Pat}, {m: MS}, acc: Accepts(PTimes(POne, e), m)) -> Accepts(e, m) = match acc
    ATimes(m1, m2, a1, ae) -> match a1
      AOne() -> rewrite msadd_zero_left(m2) in ae

  fn orb(x: B, y: B) -> B = match x
    F() -> y
    T() -> T
  fn andb(x: B, y: B) -> B = match x
    F() -> F
    T() -> y
  type BOr indices (x: B, y: B)
    BOrL : Equivalent(B, x, T) -> BOr(x, y)
    BOrR : Equivalent(B, y, T) -> BOr(x, y)
  fn orb_true(x: B, y: B, e: Equivalent(B, orb(x, y), T)) -> BOr(x, y) = match x
    T() -> BOrL(reflexive(T))
    F() -> match y
      T() -> BOrR(reflexive(T))
      F() -> match e
  type BAnd indices (x: B, y: B)
    BAndBoth : Equivalent(B, x, T) -> Equivalent(B, y, T) -> BAnd(x, y)
  fn andb_true(x: B, y: B, e: Equivalent(B, andb(x, y), T)) -> BAnd(x, y) = match x
    T() -> match y
      T() -> BAndBoth(reflexive(T), reflexive(T))
      F() -> match e
    F() -> match e

  fn nullable(pat: Pat) -> B = match pat
    PZero()      -> F
    POne()       -> T
    PAtom(t)     -> F
    PPlus(a, b)  -> orb(nullable(a), nullable(b))
    PTimes(a, b) -> andb(nullable(a), nullable(b))
    PStar(a)     -> T

  fn nullable_sound(pat: Pat, e: Equivalent(B, nullable(pat), T)) -> Accepts(pat, MkMS(Z, Z, Z)) = match pat
    PZero()      -> match e
    POne()       -> AOne()
    PAtom(t)     -> match e
    PPlus(a, b)  -> match orb_true(nullable(a), nullable(b), e)
      BOrL(pa) -> APlusL(nullable_sound(a, pa))
      BOrR(pb) -> APlusR(nullable_sound(b, pb))
    PTimes(a, b) -> match andb_true(nullable(a), nullable(b), e)
      BAndBoth(pa, pb) -> ATimes(MkMS(Z, Z, Z), MkMS(Z, Z, Z), nullable_sound(a, pa), nullable_sound(b, pb))
    PStar(a)     -> AStar0()
end
