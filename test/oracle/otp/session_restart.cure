mod SessionRestart
  use Std.Equivalent
  ## BRIDGE: SUPERVISION restart strategy × SESSION-TYPE integrity. A session-typed worker follows a
  ## protocol (a Local type) against a peer; the config is well-typed exactly when the two are DUAL. A
  ## crash resets a restarted process to its INITIAL protocol state. The question OTP design must answer:
  ## which restart strategy keeps a mid-session config well-typed? one_for_one restarts ONLY the worker
  ## (peer keeps its mid-protocol state); one_for_all restarts BOTH to their initial duals. This bridges
  ## the fault-tolerance pillar (restart strategy) to the session pillar (duality/compatibility).
  type Bool = False | True
  type Msg = MReq | MAns
  type Local = LSend(Msg, Local) | LRecv(Msg, Local) | LEnd
  fn andb(a: Bool, b: Bool) -> Bool = match a
    True()   -> b
    False()  -> False()
  fn meq(a: Msg, b: Msg) -> Bool = match a
    MReq()  -> match b
      MReq()  -> True()
      MAns()  -> False()
    MAns()  -> match b
      MReq()  -> False()
      MAns()  -> True()
  ## The dual protocol: swap send/recv, keep messages.
  fn dual(l: Local) -> Local = match l
    LEnd()        -> LEnd()
    LSend(m, k)   -> LRecv(m, dual(k))
    LRecv(m, k)   -> LSend(m, dual(k))
  ## Structural compatibility: worker `w` and peer `p` are dual — every send meets a matching recv.
  fn compatible(w: Local, p: Local) -> Bool = match w
    LEnd()        -> match p
      LEnd()        -> True()
      LSend(m2, k2) -> False()
      LRecv(m2, k2) -> False()
    LSend(m, k)   -> match p
      LEnd()        -> False()
      LSend(m2, k2) -> False()
      LRecv(m2, k2) -> andb(meq(m, m2), compatible(k, k2))
    LRecv(m, k)   -> match p
      LEnd()        -> False()
      LSend(m2, k2) -> andb(meq(m, m2), compatible(k, k2))
      LRecv(m2, k2) -> False()
  fn meq_refl(m: Msg) -> Equivalent(Bool, meq(m, m), True()) = match m
    MReq()  -> reflexive(True())
    MAns()  -> reflexive(True())
  ## **ONE_FOR_ALL RESTORES DUALITY (general)**: resetting BOTH participants to a protocol and its dual
  ## always yields a well-typed config — `compatible(pr, dual(pr)) = True` for EVERY protocol `pr`. So a
  ## one_for_all restart of a session's participants re-establishes the session invariant. Induction on
  ## the protocol; each message is cased so `meq` reduces (K1 freeze keeps it folded on an abstract Msg).
  fn one_for_all_restores(pr: Local) -> Equivalent(Bool, compatible(pr, dual(pr)), True()) = match pr
    LEnd()        -> reflexive(True())
    LSend(m, k)   -> match m
      MReq()  -> one_for_all_restores(k)
      MAns()  -> one_for_all_restores(k)
    LRecv(m, k)   -> match m
      MReq()  -> one_for_all_restores(k)
      MAns()  -> one_for_all_restores(k)
  ## The running example: worker sends MReq then receives MAns. Mid-session (after the send) the peer is
  ## at LSend(MAns, LEnd) — still owing the answer.
  ## **ONE_FOR_ALL on this protocol is well-typed** (instance of the general theorem):
  fn both_restart_ok() -> Equivalent(Bool, compatible(LSend(MReq(), LRecv(MAns(), LEnd())), dual(LSend(MReq(), LRecv(MAns(), LEnd())))), True()) =
    one_for_all_restores(LSend(MReq(), LRecv(MAns(), LEnd())))
  ## **ONE_FOR_ONE MID-SESSION BREAKS DUALITY**: restart the WORKER only — it resets to its init
  ## LSend(MReq, ...) while the peer is still mid-protocol at LSend(MAns, LEnd). Now both sides want to
  ## SEND: `compatible = False`. So a one_for_one restart of a session-carrying worker desyncs the
  ## protocol — the concrete witness that session integrity across a crash needs one_for_all.
  fn worker_only_breaks() -> Equivalent(Bool, compatible(LSend(MReq(), LRecv(MAns(), LEnd())), LSend(MAns(), LEnd())), False()) =
    reflexive(False())
end
