mod MultipartyProgress
  use Std.Equivalent
  ## THE MULTIPARTY PROGRESS THEOREM (Honda-Yoshida-Carbone), for ARBITRARY roles. A well-formed global
  ## type projects onto each role's local type; the safety guarantee is that at every communication the
  ## two active roles are READY (a matching send/recv) and every OTHER role is a transparent BYSTANDER
  ## (the step is invisible to it). This generalises the existing fixed-RA/RB two-party probes to any
  ## pair of roles with correct bystander skipping — the property that makes projection well-defined for
  ## true N-party sessions. Deadlock-freedom by construction: a projected system never gets stuck before GEnd.
  type Role = RA | RB | RC
  type Tag = TA | TB | TC
  type B = F | T
  type Global = GEnd | GMsg(Role, Role, Tag, Global)
  type Local = LEnd | LSend(Tag, Local) | LRecv(Tag, Local)
  fn role_eq(x: Role, y: Role) -> B = match x
    RA() -> match y
      RA() -> T()
      RB() -> F()
      RC() -> F()
    RB() -> match y
      RA() -> F()
      RB() -> T()
      RC() -> F()
    RC() -> match y
      RA() -> F()
      RB() -> F()
      RC() -> T()
  fn teq(a: Tag, b: Tag) -> B = match a
    TA() -> match b
      TA() -> T()
      TB() -> F()
      TC() -> F()
    TB() -> match b
      TA() -> F()
      TB() -> T()
      TC() -> F()
    TC() -> match b
      TA() -> F()
      TB() -> F()
      TC() -> T()
  fn teq_refl(t: Tag) -> Equivalent(B, teq(t, t), T()) = match t
    TA() -> reflexive(T())
    TB() -> reflexive(T())
    TC() -> reflexive(T())
  ## Projection of a global type onto role r (same convention as three_party/multiparty_session).
  fn project(g: Global, r: Role) -> Local = match g
    GEnd()               -> LEnd()
    GMsg(from, to, t, k) -> match role_eq(from, r)
      T() -> LSend(t, project(k, r))
      F() -> match role_eq(to, r)
        T() -> LRecv(t, project(k, r))
        F() -> project(k, r)
  ## Two locals can COMMUNICATE: a send meets a recv carrying the same tag.
  fn tmatches(s: Local, r: Local) -> B = match s
    LEnd()       -> F()
    LSend(t, k)  -> match r
      LEnd()        -> F()
      LSend(t2, k2) -> F()
      LRecv(t2, k2) -> teq(t, t2)
    LRecv(t, k)  -> match r
      LEnd()        -> F()
      LSend(t2, k2) -> F()
      LRecv(t2, k2) -> F()
  ## **SENDER READY (any role)**: the sender's projection of GMsg(p,q,t,k) is exactly LSend(t, ...).
  fn sender_ready(p: Role, q: Role, t: Tag, k: Global) -> Equivalent(Local, project(GMsg(p, q, t, k), p), LSend(t, project(k, p))) = match p
    RA() -> reflexive(LSend(t, project(k, RA())))
    RB() -> reflexive(LSend(t, project(k, RB())))
    RC() -> reflexive(LSend(t, project(k, RC())))
  ## **RECEIVER READY (any role, q != p)**: the receiver's projection is exactly LRecv(t, ...).
  fn receiver_ready(p: Role, q: Role, t: Tag, k: Global, neq: Equivalent(B, role_eq(p, q), F())) -> Equivalent(Local, project(GMsg(p, q, t, k), q), LRecv(t, project(k, q))) = match p
    RA() -> match q
      RA() -> match neq
      RB() -> reflexive(LRecv(t, project(k, RB())))
      RC() -> reflexive(LRecv(t, project(k, RC())))
    RB() -> match q
      RA() -> reflexive(LRecv(t, project(k, RA())))
      RB() -> match neq
      RC() -> reflexive(LRecv(t, project(k, RC())))
    RC() -> match q
      RA() -> reflexive(LRecv(t, project(k, RA())))
      RB() -> reflexive(LRecv(t, project(k, RB())))
      RC() -> match neq
  ## **BYSTANDER TRANSPARENT (any third role r, r != p and r != q)**: a communication between p and
  ## q is INVISIBLE to every other role — its projection skips the step. The property that makes
  ## projection well-defined for N > 2 parties; 27-way on the three roles, the two off-role premises
  ## refuting the r = p and r = q diagonals.
  fn bystander_transparent(p: Role, q: Role, t: Tag, k: Global, r: Role, neq_pr: Equivalent(B, role_eq(p, r), F()), neq_qr: Equivalent(B, role_eq(q, r), F())) -> Equivalent(Local, project(GMsg(p, q, t, k), r), project(k, r)) =
    match p
      RA() -> match q
        RA() -> match r
          RA() -> match neq_pr
          RB() -> reflexive(project(k, RB()))
          RC() -> reflexive(project(k, RC()))
        RB() -> match r
          RA() -> match neq_pr
          RB() -> match neq_qr
          RC() -> reflexive(project(k, RC()))
        RC() -> match r
          RA() -> match neq_pr
          RB() -> reflexive(project(k, RB()))
          RC() -> match neq_qr
      RB() -> match q
        RA() -> match r
          RA() -> match neq_qr
          RB() -> match neq_pr
          RC() -> reflexive(project(k, RC()))
        RB() -> match r
          RA() -> reflexive(project(k, RA()))
          RB() -> match neq_pr
          RC() -> reflexive(project(k, RC()))
        RC() -> match r
          RA() -> reflexive(project(k, RA()))
          RB() -> match neq_pr
          RC() -> match neq_qr
      RC() -> match q
        RA() -> match r
          RA() -> match neq_qr
          RB() -> reflexive(project(k, RB()))
          RC() -> match neq_pr
        RB() -> match r
          RA() -> reflexive(project(k, RA()))
          RB() -> match neq_qr
          RC() -> match neq_pr
        RC() -> match r
          RA() -> reflexive(project(k, RA()))
          RB() -> reflexive(project(k, RB()))
          RC() -> match neq_pr
  ## **PROGRESS**: at any GMsg(p,q,t,k) with p != q, the two active roles CAN communicate —
  ## tmatches(project onto p, project onto q) = T. Deadlock-freedom of the head action, any roles.
  fn progress(p: Role, q: Role, t: Tag, k: Global, neq: Equivalent(B, role_eq(p, q), F())) -> Equivalent(B, tmatches(project(GMsg(p, q, t, k), p), project(GMsg(p, q, t, k), q)), T()) =
    rewrite sender_ready(p, q, t, k) in rewrite receiver_ready(p, q, t, k, neq) in teq_refl(t)
end
