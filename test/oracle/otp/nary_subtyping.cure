mod NarySub
  use Std.Equivalent
  ## N-ARY session SUBTYPING with WIDTH (Gay-Hole): an external choice (LBra) offering MORE labels is
  ## a SUBTYPE of one offering fewer. Sub over Local, BraSub over branch lists, and Lookup (label
  ## membership) are MUTUALLY recursive — enabled by mutual-recursion delta-reduction.
  type Tag = TA | TB | TC
  type Local = LEnd | LRecv(Tag, Local) | LBra(Branches)
  type Branches = BNil | BCons(Tag, Local, Branches)
  ## Lookup(bs, t, k): the branch list bs has a branch labelled t with continuation k.
  type Lookup indices (bs: Branches, t: Tag, k: Local)
    LookHere  : Lookup(BCons(t, k, rest), t, k)
    LookThere : Lookup(rest, t, k) -> Lookup(BCons(t2, k2, rest), t, k)
  fn lookup_weaken({bs: Branches}, {t: Tag}, {k: Local}, t2: Tag, k2: Local, lk: Lookup(bs, t, k)) -> Lookup(BCons(t2, k2, bs), t, k) =
    LookThere(lk)
  type Sub indices (s: Local, t: Local)
    SubEnd  : Sub(LEnd, LEnd)
    SubRecv : (t: Tag) -> Sub(k1, k2) -> Sub(LRecv(t, k1), LRecv(t, k2))
    SubBra  : BraSub(bs1, bs2) -> Sub(LBra(bs1), LBra(bs2))
  ## BraSub(bsSub, bsSup): EXTERNAL-choice width+depth — bsSub offers at least bsSup, i.e. EVERY label
  ## in bsSup is found in bsSub with a subtype-related continuation. So LBra(bsSub) <: LBra(bsSup) when
  ## bsSub offers more (extra branches are simply ignored by BraSubNil bottoming out).
  type BraSub indices (bsSub: Branches, bsSup: Branches)
    BraSubNil  : BraSub(bsSub, BNil)
    BraSubCons : (t: Tag) -> Lookup(bsSub, t, kSub) -> Sub(kSub, kSup) -> BraSub(bsSub, rest) -> BraSub(bsSub, BCons(t, kSup, rest))
  ## Weakening: adding a branch to the SUB side preserves BraSub (every lookup still succeeds deeper).
  fn brasub_weaken({bsSub: Branches}, {bsSup: Branches}, t2: Tag, k2: Local, bw: BraSub(bsSub, bsSup)) -> BraSub(BCons(t2, k2, bsSub), bsSup) = match bw
    BraSubNil()               -> BraSubNil()
    BraSubCons(t, lk, sb, rst) -> BraSubCons(t, lookup_weaken(t2, k2, lk), sb, brasub_weaken(t2, k2, rst))
  ## **N-ARY SUBTYPING IS REFLEXIVE** — every type is a subtype of itself, including n-ary choice
  ## (every branch found in itself). Mutually recursive with brasub_refl over branch lists.
  fn sub_refl(l: Local) -> Sub(l, l) = match l
    LEnd()      -> SubEnd()
    LRecv(t, k) -> SubRecv(t, sub_refl(k))
    LBra(bs)    -> SubBra(brasub_refl(bs))
  fn brasub_refl(bs: Branches) -> BraSub(bs, bs) = match bs
    BNil()          -> BraSubNil()
    BCons(t, k, rest) -> BraSubCons(t, LookHere(), sub_refl(k), brasub_weaken(t, k, brasub_refl(rest)))
  ## **CONCRETE WIDTH WITNESS**: LBra{TA,TB} <: LBra{TA} — an external choice offering both TA and TB
  ## is usable where one offering only TA is expected (a process that handles more inputs is safe).
  fn width_example() -> Sub(LBra(BCons(TA(), LEnd(), BCons(TB(), LEnd(), BNil()))), LBra(BCons(TA(), LEnd(), BNil()))) =
    SubBra(BraSubCons(TA(), LookHere(), SubEnd(), BraSubNil()))

  ## LookSub(a, t, kSup): the branch list a has a branch labelled t whose continuation is a SUBTYPE of
  ## kSup — the existential produced when BraSub transports a lookup from the supertype into the subtype.
  type LookSub indices (a: Branches, t: Tag, kSup: Local)
    MkLookSub : Lookup(a, t, kSub) -> Sub(kSub, kSup) -> LookSub(a, t, kSup)
  ## BraSub TRANSPORTS A LOOKUP: if a offers at least b (BraSub(a,b)) and b has a branch (t, kb), then
  ## a has a matching branch whose continuation subtypes kb. The key to composing BraSub.
  fn brasub_lookup({a: Branches}, {b: Branches}, {t: Tag}, {kb: Local}, ab: BraSub(a, b), lk: Lookup(b, t, kb)) -> LookSub(a, t, kb) = match lk
    LookHere()      -> match ab
      BraSubCons(t2, lk_a, sb, rst) -> MkLookSub(lk_a, sb)
    LookThere(lk2)  -> match ab
      BraSubCons(t2, lk_a, sb, rst) -> brasub_lookup(rst, lk2)
  ## **N-ARY SUBTYPING IS TRANSITIVE** — Sub(a,b) + Sub(b,c) ⟹ Sub(a,c). With sub_refl this makes n-ary
  ## session `<:` a PREORDER (the substitution-principle precondition). Mutually recursive with
  ## brasub_trans, which composes the branch-list width relations by transporting each supertype label
  ## down through the middle type (brasub_lookup) and chaining continuations (sub_trans).
  fn sub_trans({a: Local}, {b: Local}, {c: Local}, s1: Sub(a, b), s2: Sub(b, c)) -> Sub(a, c) = match s1
    SubEnd()      -> match s2
      SubEnd() -> SubEnd()
    SubRecv(t, p) -> match s2
      SubRecv(t2, q) -> SubRecv(t, sub_trans(p, q))
    SubBra(ab)    -> match s2
      SubBra(bc) -> SubBra(brasub_trans(ab, bc))
  fn brasub_trans({a: Branches}, {b: Branches}, {c: Branches}, ab: BraSub(a, b), bc: BraSub(b, c)) -> BraSub(a, c) = match bc
    BraSubNil()                    -> BraSubNil()
    BraSubCons(t, lk_bc, sub_bc, rest_bc) -> match brasub_lookup(ab, lk_bc)
      MkLookSub(lk_ac, sub_ab) -> BraSubCons(t, lk_ac, sub_trans(sub_ab, sub_bc), brasub_trans(ab, rest_bc))
end
