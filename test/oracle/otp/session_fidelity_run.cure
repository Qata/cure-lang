mod SessionFidelityRun
  use Std.Equivalent
  ## RUN-LEVEL OPERATIONAL FIDELITY — single-step config fidelity lifted to a WHOLE protocol. Each
  ## operational step (step_config, firing a head p->q) is justified by config_fidelity (it lands exactly
  ## on config of the continuation). CRun is the reflexive-transitive closure of that real operational
  ## step; config_terminates proves config(g) CRuns all the way to config(GEnd) for every global g. So the
  ## projected multiparty configuration executes the ENTIRE global protocol to completion, step for step.
  type Role = RA | RB | RC
  type Tag = TA | TB | TC
  type B = F | T
  type Global = GEnd | GMsg(Role, Role, Tag, Global)
  type Local = LEnd | LSend(Role, Tag, Local) | LRecv(Role, Tag, Local)
  type Config = MkCfg(Local, Local, Local)
  fn role_eq(x: Role, y: Role) -> B = match x
    RA() -> match y
      RA() -> T()
      RB() -> F()
      RC() -> F()
    RB() -> match y
      RA() -> F()
      RB() -> T()
      RC() -> F()
    RC() -> match y
      RA() -> F()
      RB() -> F()
      RC() -> T()
  fn project(g: Global, r: Role) -> Local = match g
    GEnd()               -> LEnd()
    GMsg(from, to, t, k) -> match role_eq(from, r)
      T() -> LSend(to, t, project(k, r))
      F() -> match role_eq(to, r)
        T() -> LRecv(from, t, project(k, r))
        F() -> project(k, r)
  fn config(g: Global) -> Config = MkCfg(project(g, RA()), project(g, RB()), project(g, RC()))
  fn perform_send(l: Local) -> Local = match l
    LEnd()          -> LEnd()
    LSend(to, t, k) -> k
    LRecv(fr, t, k) -> l
  fn perform_recv(l: Local) -> Local = match l
    LEnd()          -> LEnd()
    LSend(to, t, k) -> l
    LRecv(fr, t, k) -> k
  fn role_after(g: Global, p: Role, q: Role, r: Role) -> Local = match role_eq(p, r)
    T() -> perform_send(project(g, r))
    F() -> match role_eq(q, r)
      T() -> perform_recv(project(g, r))
      F() -> project(g, r)
  fn step_config(g: Global, p: Role, q: Role) -> Config = MkCfg(role_after(g, p, q, RA()), role_after(g, p, q, RB()), role_after(g, p, q, RC()))
  fn role_fidelity(p: Role, q: Role, t: Tag, k: Global, r: Role) -> Equivalent(Local, role_after(GMsg(p, q, t, k), p, q, r), project(k, r)) =
    match p
      RA() -> match q
        RA() -> match r
          RA() -> reflexive(project(k, RA()))
          RB() -> reflexive(project(k, RB()))
          RC() -> reflexive(project(k, RC()))
        RB() -> match r
          RA() -> reflexive(project(k, RA()))
          RB() -> reflexive(project(k, RB()))
          RC() -> reflexive(project(k, RC()))
        RC() -> match r
          RA() -> reflexive(project(k, RA()))
          RB() -> reflexive(project(k, RB()))
          RC() -> reflexive(project(k, RC()))
      RB() -> match q
        RA() -> match r
          RA() -> reflexive(project(k, RA()))
          RB() -> reflexive(project(k, RB()))
          RC() -> reflexive(project(k, RC()))
        RB() -> match r
          RA() -> reflexive(project(k, RA()))
          RB() -> reflexive(project(k, RB()))
          RC() -> reflexive(project(k, RC()))
        RC() -> match r
          RA() -> reflexive(project(k, RA()))
          RB() -> reflexive(project(k, RB()))
          RC() -> reflexive(project(k, RC()))
      RC() -> match q
        RA() -> match r
          RA() -> reflexive(project(k, RA()))
          RB() -> reflexive(project(k, RB()))
          RC() -> reflexive(project(k, RC()))
        RB() -> match r
          RA() -> reflexive(project(k, RA()))
          RB() -> reflexive(project(k, RB()))
          RC() -> reflexive(project(k, RC()))
        RC() -> match r
          RA() -> reflexive(project(k, RA()))
          RB() -> reflexive(project(k, RB()))
          RC() -> reflexive(project(k, RC()))
  fn mkcfg_cong({a1: Local}, {b1: Local}, {a2: Local}, {b2: Local}, {a3: Local}, {b3: Local}, e1: Equivalent(Local, a1, b1), e2: Equivalent(Local, a2, b2), e3: Equivalent(Local, a3, b3)) -> Equivalent(Config, MkCfg(a1, a2, a3), MkCfg(b1, b2, b3)) =
    rewrite e1 in rewrite e2 in rewrite e3 in reflexive(MkCfg(b1, b2, b3))
  ## Single-step fidelity: firing p->q drives config(GMsg(p,q,t,k)) to config(k) exactly.
  fn config_fidelity(p: Role, q: Role, t: Tag, k: Global) -> Equivalent(Config, step_config(GMsg(p, q, t, k), p, q), config(k)) =
    mkcfg_cong(role_fidelity(p, q, t, k, RA()), role_fidelity(p, q, t, k, RB()), role_fidelity(p, q, t, k, RC()))
  ## CRun: reflexive-transitive closure of the real operational step (step_config firing a head). A
  ## CRStep from config(GMsg(p,q,t,k)) goes to step_config(GMsg(p,q,t,k),p,q) — the genuine operational
  ## result of firing p->q — and continues from there.
  type CRun indices (c1: Config, c2: Config)
    CRDone : CRun(c, c)
    CRStep : (p: Role) -> (q: Role) -> (t: Tag) -> (k: Global) -> CRun(step_config(GMsg(p, q, t, k), p, q), c3) -> CRun(config(GMsg(p, q, t, k)), c3)
  ## **RUN-LEVEL FIDELITY**: config(g) reaches config(GEnd) by real operational steps, for every g. At each
  ## head the operational step lands on config(continuation) (config_fidelity, transported into the step
  ## target), and the induction runs the rest. The projected system executes the whole protocol faithfully.
  fn config_terminates(g: Global) -> CRun(config(g), config(GEnd())) = match g
    GEnd()           -> CRDone()
    GMsg(p, q, t, k) -> CRStep(p, q, t, k, rewrite config_fidelity(p, q, t, k) in config_terminates(k))
end
