mod RecursiveCoverage
  type B = F | T
  type IF = MkIF(B, B, B)
  type Imp indices (a: B, b: B)
    ImpFF : Imp(F, F)
    ImpFT : Imp(F, T)
    ImpTT : Imp(T, T)
  type Sub indices (x: IF, y: IF)
    MkSub : Imp(a, a2) -> Imp(b, b2) -> Imp(c, c2) -> Sub(MkIF(a, b, c), MkIF(a2, b2, c2))
  type Tag = TA | TB | TC

  fn bot() -> IF = MkIF(F, F, F)
  fn orb(p: B, q: B) -> B = match p
    F() -> q
    T() -> T
  fn join(x: IF, y: IF) -> IF = match x
    MkIF(a, b, c) -> match y
      MkIF(a2, b2, c2) -> MkIF(orb(a, a2), orb(b, b2), orb(c, c2))
  fn setbit(t: Tag, x: IF) -> IF = match x
    MkIF(a, b, c) -> match t
      TA() -> MkIF(T, b, c)
      TB() -> MkIF(a, T, c)
      TC() -> MkIF(a, b, T)
  fn getb(x: IF, t: Tag) -> B = match x
    MkIF(a, b, c) -> match t
      TA() -> a
      TB() -> b
      TC() -> c

  fn getb_mono(x: IF, y: IF, s: Sub(x, y), t: Tag, e: Equivalent(B, getb(x, t), T)) -> Equivalent(B, getb(y, t), T) = match t
    TA() -> match x
      MkIF(xa, xb, xc) -> match y
        MkIF(ya, yb, yc) -> match s
          MkSub(ia, ib, ic) -> match ia
            ImpFF() -> match e
            ImpFT() -> match e
            ImpTT() -> reflexive(T)
    TB() -> match x
      MkIF(xa, xb, xc) -> match y
        MkIF(ya, yb, yc) -> match s
          MkSub(ia, ib, ic) -> match ib
            ImpFF() -> match e
            ImpFT() -> match e
            ImpTT() -> reflexive(T)
    TC() -> match x
      MkIF(xa, xb, xc) -> match y
        MkIF(ya, yb, yc) -> match s
          MkSub(ia, ib, ic) -> match ic
            ImpFF() -> match e
            ImpFT() -> match e
            ImpTT() -> reflexive(T)

  fn getb_setbit_here(t: Tag, x: IF) -> Equivalent(B, getb(setbit(t, x), t), T) = match t
    TA() -> match x
      MkIF(a, b, c) -> reflexive(T)
    TB() -> match x
      MkIF(a, b, c) -> reflexive(T)
    TC() -> match x
      MkIF(a, b, c) -> reflexive(T)
  fn getb_setbit_preserve(s: Tag, t: Tag, x: IF, e: Equivalent(B, getb(x, t), T)) -> Equivalent(B, getb(setbit(s, x), t), T) = match s
    TA() -> match t
      TA() -> match x
        MkIF(a, b, c) -> reflexive(T)
      TB() -> match x
        MkIF(a, b, c) -> e
      TC() -> match x
        MkIF(a, b, c) -> e
    TB() -> match t
      TA() -> match x
        MkIF(a, b, c) -> e
      TB() -> match x
        MkIF(a, b, c) -> reflexive(T)
      TC() -> match x
        MkIF(a, b, c) -> e
    TC() -> match t
      TA() -> match x
        MkIF(a, b, c) -> e
      TB() -> match x
        MkIF(a, b, c) -> e
      TC() -> match x
        MkIF(a, b, c) -> reflexive(T)

  fn getb_join_left(x: IF, y: IF, t: Tag, e: Equivalent(B, getb(x, t), T)) -> Equivalent(B, getb(join(x, y), t), T) = match t
    TA() -> match x
      MkIF(a, b, c) -> match y
        MkIF(a2, b2, c2) -> match a
          F() -> match e
          T() -> reflexive(T)
    TB() -> match x
      MkIF(a, b, c) -> match y
        MkIF(a2, b2, c2) -> match b
          F() -> match e
          T() -> reflexive(T)
    TC() -> match x
      MkIF(a, b, c) -> match y
        MkIF(a2, b2, c2) -> match c
          F() -> match e
          T() -> reflexive(T)
  fn getb_join_right(x: IF, y: IF, t: Tag, e: Equivalent(B, getb(y, t), T)) -> Equivalent(B, getb(join(x, y), t), T) = match t
    TA() -> match x
      MkIF(a, b, c) -> match y
        MkIF(a2, b2, c2) -> match a
          F() -> match a2
            F() -> match e
            T() -> reflexive(T)
          T() -> reflexive(T)
    TB() -> match x
      MkIF(a, b, c) -> match y
        MkIF(a2, b2, c2) -> match b
          F() -> match b2
            F() -> match e
            T() -> reflexive(T)
          T() -> reflexive(T)
    TC() -> match x
      MkIF(a, b, c) -> match y
        MkIF(a2, b2, c2) -> match c
          F() -> match c2
            F() -> match e
            T() -> reflexive(T)
          T() -> reflexive(T)

  type RBody = RNil | RVar | RSend(Tag, RBody) | RRecv(Tag, RBody) | RSeq(RBody, RBody)
  fn tset(body: RBody, i: IF) -> IF = match body
    RNil()       -> bot()
    RVar()       -> i
    RSend(t, k)  -> setbit(t, tset(k, i))
    RRecv(t, k)  -> setbit(t, tset(k, i))
    RSeq(l, r)   -> join(tset(l, i), tset(r, i))

  type RSendsIn indices (body: RBody, t: Tag)
    RSHere  : RSendsIn(RSend(t, k), t)
    RSSendK : RSendsIn(k, t) -> RSendsIn(RSend(y, k), t)
    RSRecvK : RSendsIn(k, t) -> RSendsIn(RRecv(y, k), t)
    RSSeqL  : RSendsIn(l, t) -> RSendsIn(RSeq(l, r), t)
    RSSeqR  : RSendsIn(r, t) -> RSendsIn(RSeq(l, r), t)

  fn tset_covers(body: RBody, i: IF, t: Tag, sends: RSendsIn(body, t)) -> Equivalent(B, getb(tset(body, i), t), T) = match sends
    RSHere()    -> match body
      RSend(t2, k) -> getb_setbit_here(t2, tset(k, i))
    RSSendK(s2) -> match body
      RSend(y, k)  -> getb_setbit_preserve(y, t, tset(k, i), tset_covers(k, i, t, s2))
    RSRecvK(s2) -> match body
      RRecv(y, k)  -> getb_setbit_preserve(y, t, tset(k, i), tset_covers(k, i, t, s2))
    RSSeqL(s2)  -> match body
      RSeq(l, r)   -> getb_join_left(tset(l, i), tset(r, i), t, tset_covers(l, i, t, s2))
    RSSeqR(s2)  -> match body
      RSeq(l, r)   -> getb_join_right(tset(l, i), tset(r, i), t, tset_covers(r, i, t, s2))
end
