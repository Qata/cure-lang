mod LinearArithmeticFixture
  use Std.Bool
  use Std.Nat
  use Std.Int
  use Std.Option
  use Std.Equivalent
  use Std.Proof.IntOrder
  use Std.Proof.LinearArithmetic

  fn zero() -> Int = FromNat(Z())
  fn one() -> Int = FromNat(S(Z()))
  fn two() -> Int = FromNat(S(S(Z())))
  fn three() -> Int = FromNat(S(S(S(Z()))))
  fn neg_one() -> Int = NegativeSuccessor(Z())
  fn neg_two() -> Int = NegativeSuccessor(S(Z()))
  fn neg_three() -> Int = NegativeSuccessor(S(S(Z())))

  ## a>=0, encoded -a<=0.
  fn a_nonnegative() -> LinearAtom = LinearAtom{coefficients: [neg_one(), zero()], constant: zero(), relation: LessOrEqual()}
  ## b>=0, encoded -b<=0.
  fn b_nonnegative() -> LinearAtom = LinearAtom{coefficients: [zero(), neg_one()], constant: zero(), relation: LessOrEqual()}
  ## 2a+3b>=0, encoded -(2a+3b)<=0.
  fn positive_combination_goal() -> LinearAtom = LinearAtom{coefficients: [neg_two(), neg_three()], constant: zero(), relation: LessOrEqual()}
  fn hypotheses() -> List(LinearAtom) = [a_nonnegative(), b_nonnegative()]
  fn accepted_witness() -> List(Nat) = [S(S(Z())), S(S(S(Z()))), S(Z())]
  fn forged_witness() -> List(Nat) = [S(Z()), S(Z()), S(Z())]
  fn short_witness() -> List(Nat) = [S(S(Z())), S(S(S(Z())))]
  fn wrong_dimension_hypotheses() -> List(LinearAtom) = [LinearAtom{coefficients: [neg_one()], constant: zero(), relation: LessOrEqual()}]
  fn wrong_dimension_witness() -> List(Nat) = [S(Z()), S(Z())]
  fn short_valuation() -> List(Int) = [one()]
  fn valid_valuation() -> List(Int) = [two(), three()]

  ## Integer-only boundary: 2n=1 has no integer solution but has the rational
  ## solution n=1/2. Rejecting this one candidate is a regression sample, not a
  ## claim that finite Farkas search proves global integer nonexistence.
  fn boundary_upper() -> LinearAtom = LinearAtom{coefficients: [two()], constant: one(), relation: LessOrEqual()}
  fn boundary_lower() -> LinearAtom = LinearAtom{coefficients: [neg_two()], constant: neg_one(), relation: LessOrEqual()}
  fn boundary_hypotheses() -> List(LinearAtom) = [boundary_upper(), boundary_lower()]
  fn boundary_goal() -> LinearAtom = LinearAtom{coefficients: [zero()], constant: neg_one(), relation: LessOrEqual()}
  fn boundary_witness() -> List(Nat) = [S(Z()), S(Z()), S(Z())]
end

mod LinearArithmeticCompute
  use Std.Bool
  use Std.Nat
  use Std.Int
  use Std.List
  use Std.Option
  use Std.Equivalent
  use Std.Proof.LinearArithmetic
  use LinearArithmeticFixture

  fn accepted_farkas_witness() -> Bool = check_lia_candidate(hypotheses(), positive_combination_goal(), accepted_witness())

  fn forged_witness_rejected() -> Bool = check_lia_candidate(hypotheses(), positive_combination_goal(), forged_witness())

  fn wrong_witness_length_rejected() -> Bool = check_lia_candidate(hypotheses(), positive_combination_goal(), short_witness())

  fn wrong_atom_dimension_rejected() -> Bool = check_lia_candidate(wrong_dimension_hypotheses(), positive_combination_goal(), wrong_dimension_witness())

  fn wrong_valuation_dimension_rejected() -> Option(Bool) = evaluate_atom_checked(positive_combination_goal(), short_valuation())

  fn valid_evaluation() -> Option(Bool) = evaluate_atom_checked(a_nonnegative(), valid_valuation())

  fn integer_only_boundary_sample_rejected() -> Bool = check_lia_candidate(boundary_hypotheses(), boundary_goal(), boundary_witness())

  fn start() -> Bool = check_lia_candidate(hypotheses(), positive_combination_goal(), accepted_witness())
end
