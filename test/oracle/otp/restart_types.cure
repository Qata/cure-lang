mod RestartTypes
  use Std.Equivalent
  ## OTP CHILD RESTART TYPES — the child_spec `restart` field decides WHETHER a terminated child is
  ## restarted at all, from its exit reason. permanent: always restarted. transient: restarted only on
  ## ABNORMAL exit (a crash), left down on a normal exit. temporary: never restarted. This is the fourth
  ## orthogonal axis of supervision (alongside strategy = which siblings, intensity = how many, tree
  ## escalation = propagation upward).
  type Bool = False | True
  type ExitReason = Normal | Abnormal
  type RestartType = Permanent | Transient | Temporary
  fn should_restart(t: RestartType, r: ExitReason) -> Bool = match t
    Permanent()  -> True()
    Transient()  -> match r
      Normal()    -> False()
      Abnormal()  -> True()
    Temporary()  -> False()
  ## **PERMANENT ALWAYS RESTARTS**: a permanent child is restarted regardless of why it terminated.
  fn permanent_always(r: ExitReason) -> Equivalent(Bool, should_restart(Permanent(), r), True()) =
    reflexive(True())
  ## **TEMPORARY NEVER RESTARTS**: a temporary child is never restarted, whatever its exit reason.
  fn temporary_never(r: ExitReason) -> Equivalent(Bool, should_restart(Temporary(), r), False()) =
    reflexive(False())
  ## **TRANSIENT DISCRIMINATES ON THE EXIT REASON**: a transient child is left down after a normal exit
  ## but restarted after a crash — the defining behaviour that separates it from the other two types.
  fn transient_on_normal() -> Equivalent(Bool, should_restart(Transient(), Normal()), False()) =
    reflexive(False())
  fn transient_on_abnormal() -> Equivalent(Bool, should_restart(Transient(), Abnormal()), True()) =
    reflexive(True())
end
