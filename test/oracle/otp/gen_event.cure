mod GenEvent
  use Std.Equivalent
  type Event = EvA | EvB | EvC
  type B = F | T
  type EvSet = MkEvSet(B, B, B)
  fn member(e: Event, s: EvSet) -> B = match s
    MkEvSet(a, b, c) -> match e
      EvA() -> a
      EvB() -> b
      EvC() -> c
  fn step(e: Event, iface: EvSet, st: Nat) -> Nat = match member(e, iface)
    T() -> S(st)
    F() -> st
  type IfaceList = INil | ICons(EvSet, IfaceList)
  type Manager indices (ifaces: IfaceList)
    MNil  : Manager(INil)
    MCons : (iface: EvSet) -> Nat -> Manager(rest) -> Manager(ICons(iface, rest))
  fn add_handler(iface: EvSet, st: Nat, {ifaces: IfaceList}, mgr: Manager(ifaces)) -> Manager(ICons(iface, ifaces)) =
    MCons(iface, st, mgr)
  fn notify(e: Event, {ifaces: IfaceList}, mgr: Manager(ifaces)) -> Manager(ifaces) = match mgr
    MNil()                 -> MNil()
    MCons(iface, st, rest) -> MCons(iface, step(e, iface, st), notify(e, rest))
  fn count({ifaces: IfaceList}, mgr: Manager(ifaces)) -> Nat = match mgr
    MNil()                 -> Z()
    MCons(iface, st, rest) -> S(count(rest))
  fn interfaces({ifaces: IfaceList}, mgr: Manager(ifaces)) -> IfaceList = match mgr
    MNil()                 -> INil()
    MCons(iface, st, rest) -> ICons(iface, interfaces(rest))
  fn snat_cong({a: Nat}, {b: Nat}, e: Equivalent(Nat, a, b)) -> Equivalent(Nat, S(a), S(b)) =
    rewrite e in reflexive(S(b))
  fn icons_cong(iface: EvSet, {a: IfaceList}, {b: IfaceList}, e: Equivalent(IfaceList, a, b)) -> Equivalent(IfaceList, ICons(iface, a), ICons(iface, b)) =
    rewrite e in reflexive(ICons(iface, b))
  fn notify_preserves_count(e: Event, {ifaces: IfaceList}, mgr: Manager(ifaces)) -> Equivalent(Nat, count(notify(e, mgr)), count(mgr)) = match mgr
    MNil()                 -> reflexive(Z())
    MCons(iface, st, rest) -> snat_cong(notify_preserves_count(e, rest))
  fn notify_preserves_ifaces(e: Event, {ifaces: IfaceList}, mgr: Manager(ifaces)) -> Equivalent(IfaceList, interfaces(notify(e, mgr)), interfaces(mgr)) = match mgr
    MNil()                 -> reflexive(INil())
    MCons(iface, st, rest) -> icons_cong(iface, notify_preserves_ifaces(e, rest))
  fn remove_head({iface: EvSet}, {rest: IfaceList}, mgr: Manager(ICons(iface, rest))) -> Manager(rest) = match mgr
    MCons(i, st, r) -> r
  fn add_remove_inverse(iface: EvSet, st: Nat, {ifaces: IfaceList}, mgr: Manager(ifaces)) -> Equivalent(Manager(ifaces), remove_head(add_handler(iface, st, mgr)), mgr) =
    reflexive(mgr)
  fn count_after_add(iface: EvSet, st: Nat, {ifaces: IfaceList}, mgr: Manager(ifaces)) -> Equivalent(Nat, count(add_handler(iface, st, mgr)), S(count(mgr))) =
    reflexive(S(count(mgr)))
  type Pos indices (ifaces: IfaceList)
    Here  : (iface: EvSet) -> (rest: IfaceList) -> Pos(ICons(iface, rest))
    There : (iface: EvSet) -> Pos(rest) -> Pos(ICons(iface, rest))
  fn delete_at({ifaces: IfaceList}, pos: Pos(ifaces)) -> IfaceList = match pos
    Here(iface, rest) -> rest
    There(iface, p)   -> ICons(iface, delete_at(p))
  fn remove_at({ifaces: IfaceList}, mgr: Manager(ifaces), pos: Pos(ifaces)) -> Manager(delete_at(pos)) = match pos
    Here(iface, rest) -> match mgr
      MCons(i, st, r) -> r
    There(iface, p)   -> match mgr
      MCons(i, st, r) -> MCons(i, st, remove_at(r, p))
  fn swap_at({ifaces: IfaceList}, mgr: Manager(ifaces), pos: Pos(ifaces), new_st: Nat) -> Manager(ifaces) = match pos
    Here(iface, rest) -> match mgr
      MCons(i, st, r) -> MCons(i, new_st, r)
    There(iface, p)   -> match mgr
      MCons(i, st, r) -> MCons(i, st, swap_at(r, p, new_st))
  fn swap_preserves_ifaces({ifaces: IfaceList}, mgr: Manager(ifaces), pos: Pos(ifaces), new_st: Nat) -> Equivalent(IfaceList, interfaces(swap_at(mgr, pos, new_st)), interfaces(mgr)) = match pos
    Here(iface, rest) -> match mgr
      MCons(i, st, r) -> reflexive(ICons(i, interfaces(r)))
    There(iface, p)   -> match mgr
      MCons(i, st, r) -> icons_cong(i, swap_preserves_ifaces(r, p, new_st))
end
