mod SessionSubtyping
  type B = F | T
  type BLe indices (x: B, y: B)
    BLeF : BLe(F, y)
    BLeT : BLe(T, T)
  fn ble_refl(x: B) -> BLe(x, x) = match x
    F() -> BLeF()
    T() -> BLeT()
  fn ble_trans({x: B}, {y: B}, {z: B}, p: BLe(x, y), q: BLe(y, z)) -> BLe(x, z) = match p
    BLeF() -> BLeF()
    BLeT() -> match q
      BLeT() -> BLeT()
  type LSet = MkLSet(B, B, B)
  type LSub indices (s: LSet, t: LSet)
    MkLSub : BLe(a1, a2) -> BLe(b1, b2) -> BLe(c1, c2) -> LSub(MkLSet(a1, b1, c1), MkLSet(a2, b2, c2))
  fn lsub_refl(s: LSet) -> LSub(s, s) = match s
    MkLSet(a, b, c) -> MkLSub(ble_refl(a), ble_refl(b), ble_refl(c))
  fn lsub_trans({s: LSet}, {u: LSet}, {v: LSet}, p: LSub(s, u), q: LSub(u, v)) -> LSub(s, v) = match p
    MkLSub(pa, pb, pc) -> match q
      MkLSub(qa, qb, qc) -> MkLSub(ble_trans(pa, qa), ble_trans(pb, qb), ble_trans(pc, qc))
  type Tag = TA | TB | TC
  type SType = SEnd | SSend(Tag, SType) | SRecv(Tag, SType) | SSelect(LSet, SType) | SBranch(LSet, SType)
  type Sub indices (s: SType, t: SType)
    SubEnd  : Sub(SEnd, SEnd)
    SubSend : (tg: Tag) -> Sub(k1, k2) -> Sub(SSend(tg, k1), SSend(tg, k2))
    SubRecv : (tg: Tag) -> Sub(k1, k2) -> Sub(SRecv(tg, k1), SRecv(tg, k2))
    SubSel  : LSub(s1, s2) -> Sub(k1, k2) -> Sub(SSelect(s1, k1), SSelect(s2, k2))
    SubBra  : LSub(s2, s1) -> Sub(k1, k2) -> Sub(SBranch(s1, k1), SBranch(s2, k2))
  fn sub_refl(s: SType) -> Sub(s, s) = match s
    SEnd()          -> SubEnd()
    SSend(tg, k)    -> SubSend(tg, sub_refl(k))
    SRecv(tg, k)    -> SubRecv(tg, sub_refl(k))
    SSelect(ls, k)  -> SubSel(lsub_refl(ls), sub_refl(k))
    SBranch(ls, k)  -> SubBra(lsub_refl(ls), sub_refl(k))
  fn sub_trans({a: SType}, {b: SType}, {c: SType}, p: Sub(a, b), q: Sub(b, c)) -> Sub(a, c) = match p
    SubEnd() -> match q
      SubEnd() -> SubEnd()
    SubSend(tg, p2) -> match q
      SubSend(tg2, q2) -> SubSend(tg, sub_trans(p2, q2))
    SubRecv(tg, p2) -> match q
      SubRecv(tg2, q2) -> SubRecv(tg, sub_trans(p2, q2))
    SubSel(pl, p2) -> match q
      SubSel(ql, q2) -> SubSel(lsub_trans(pl, ql), sub_trans(p2, q2))
    SubBra(pl, p2) -> match q
      SubBra(ql, q2) -> SubBra(lsub_trans(ql, pl), sub_trans(p2, q2))
  fn dual(s: SType) -> SType = match s
    SEnd()          -> SEnd()
    SSend(tg, k)    -> SRecv(tg, dual(k))
    SRecv(tg, k)    -> SSend(tg, dual(k))
    SSelect(ls, k)  -> SBranch(ls, dual(k))
    SBranch(ls, k)  -> SSelect(ls, dual(k))
  fn sub_dual_antitone({s: SType}, {t: SType}, p: Sub(s, t)) -> Sub(dual(t), dual(s)) = match p
    SubEnd()        -> SubEnd()
    SubSend(tg, p2) -> SubRecv(tg, sub_dual_antitone(p2))
    SubRecv(tg, p2) -> SubSend(tg, sub_dual_antitone(p2))
    SubSel(pl, p2)  -> SubBra(pl, sub_dual_antitone(p2))
    SubBra(pl, p2)  -> SubSel(pl, sub_dual_antitone(p2))
  type Compat indices (l: SType, r: SType)
    CEnd    : Compat(SEnd, SEnd)
    CSR     : (tg: Tag) -> Compat(l, r) -> Compat(SSend(tg, l), SRecv(tg, r))
    CRS     : (tg: Tag) -> Compat(l, r) -> Compat(SRecv(tg, l), SSend(tg, r))
    CSelBra : LSub(sl, sr) -> Compat(kl, kr) -> Compat(SSelect(sl, kl), SBranch(sr, kr))
    CBraSel : LSub(sr, sl) -> Compat(kl, kr) -> Compat(SBranch(sl, kl), SSelect(sr, kr))
  fn narrow({s: SType}, {s2: SType}, {t: SType}, sub: Sub(s, s2), c: Compat(s2, t)) -> Compat(s, t) = match sub
    SubEnd()          -> c
    SubSend(tg, sub2) -> match c
      CSR(tg2, c2) -> CSR(tg, narrow(sub2, c2))
    SubRecv(tg, sub2) -> match c
      CRS(tg2, c2) -> CRS(tg, narrow(sub2, c2))
    SubSel(sl, sub2) -> match c
      CSelBra(cl, c2) -> CSelBra(lsub_trans(sl, cl), narrow(sub2, c2))
    SubBra(sl, sub2) -> match c
      CBraSel(cl, c2) -> CBraSel(lsub_trans(cl, sl), narrow(sub2, c2))
  fn ble_antisym({x: B}, {y: B}, p: BLe(x, y), q: BLe(y, x)) -> Equivalent(B, x, y) = match p
    BLeF() -> match q
      BLeF() -> reflexive(F())
    BLeT() -> reflexive(T())
  fn mklset_cong({a1: B}, {a2: B}, {b1: B}, {b2: B}, {c1: B}, {c2: B}, ea: Equivalent(B, a1, a2), eb: Equivalent(B, b1, b2), ec: Equivalent(B, c1, c2)) -> Equivalent(LSet, MkLSet(a1, b1, c1), MkLSet(a2, b2, c2)) =
    rewrite ea in rewrite eb in rewrite ec in reflexive(MkLSet(a2, b2, c2))
  fn lsub_antisym({s: LSet}, {t: LSet}, p: LSub(s, t), q: LSub(t, s)) -> Equivalent(LSet, s, t) = match p
    MkLSub(pa, pb, pc) -> match q
      MkLSub(qa, qb, qc) -> mklset_cong(ble_antisym(pa, qa), ble_antisym(pb, qb), ble_antisym(pc, qc))
  fn ssend_cong(tg: Tag, {x: SType}, {y: SType}, e: Equivalent(SType, x, y)) -> Equivalent(SType, SSend(tg, x), SSend(tg, y)) =
    rewrite e in reflexive(SSend(tg, y))
  fn srecv_cong(tg: Tag, {x: SType}, {y: SType}, e: Equivalent(SType, x, y)) -> Equivalent(SType, SRecv(tg, x), SRecv(tg, y)) =
    rewrite e in reflexive(SRecv(tg, y))
  fn sselect_cong2({s1: LSet}, {s2: LSet}, {x: SType}, {y: SType}, es: Equivalent(LSet, s1, s2), ek: Equivalent(SType, x, y)) -> Equivalent(SType, SSelect(s1, x), SSelect(s2, y)) =
    rewrite es in rewrite ek in reflexive(SSelect(s2, y))
  fn sbranch_cong2({s1: LSet}, {s2: LSet}, {x: SType}, {y: SType}, es: Equivalent(LSet, s1, s2), ek: Equivalent(SType, x, y)) -> Equivalent(SType, SBranch(s1, x), SBranch(s2, y)) =
    rewrite es in rewrite ek in reflexive(SBranch(s2, y))
  fn sub_antisym({s: SType}, {t: SType}, p: Sub(s, t), q: Sub(t, s)) -> Equivalent(SType, s, t) = match p
    SubEnd() -> match q
      SubEnd() -> reflexive(SEnd())
    SubSend(tg, p2) -> match q
      SubSend(tg2, q2) -> ssend_cong(tg, sub_antisym(p2, q2))
    SubRecv(tg, p2) -> match q
      SubRecv(tg2, q2) -> srecv_cong(tg, sub_antisym(p2, q2))
    SubSel(pl, p2) -> match q
      SubSel(ql, q2) -> sselect_cong2(lsub_antisym(pl, ql), sub_antisym(p2, q2))
    SubBra(pl, p2) -> match q
      SubBra(ql, q2) -> sbranch_cong2(lsub_antisym(ql, pl), sub_antisym(p2, q2))
end
