mod AsyncMultiparty
  use Std.Equivalent
  ## MULTIPARTY ASYNC: peer-annotated local types — a send/receive names its PEER, so the in-flight
  ## message BFull(from, to, tag) is ROUTED, and only the addressed role can consume it. Three roles;
  ## one in-flight slot (bounded mailbox). This is what the two-party model couldn't capture: routing.
  type Tag = TA | TB
  type Role = RA | RB | RC
  type Local = LEnd | LSendTo(Role, Tag, Local) | LRecvFrom(Role, Tag, Local)
  type Buf = BEmpty | BFull(Role, Role, Tag)
  type Config = MkConfig(Local, Local, Local, Buf)
  type AStep indices (c: Config, c2: Config)
    ASendA : AStep(MkConfig(LSendTo(to, t, ka), lb, lc, BEmpty), MkConfig(ka, lb, lc, BFull(RA, to, t)))
    ASendB : AStep(MkConfig(la, LSendTo(to, t, kb), lc, BEmpty), MkConfig(la, kb, lc, BFull(RB, to, t)))
    ASendC : AStep(MkConfig(la, lb, LSendTo(to, t, kc), BEmpty), MkConfig(la, lb, kc, BFull(RC, to, t)))
    ARecvA : AStep(MkConfig(LRecvFrom(from, t, ka), lb, lc, BFull(from, RA, t)), MkConfig(ka, lb, lc, BEmpty))
    ARecvB : AStep(MkConfig(la, LRecvFrom(from, t, kb), lc, BFull(from, RB, t)), MkConfig(la, kb, lc, BEmpty))
    ARecvC : AStep(MkConfig(la, lb, LRecvFrom(from, t, kc), BFull(from, RC, t)), MkConfig(la, lb, kc, BEmpty))
  type ARun indices (c: Config, c2: Config)
    ARDone : ARun(c, c)
    ARStep : AStep(c, cm) -> ARun(cm, c2) -> ARun(c, c2)
  ## Steps with concrete types (pin the intermediate config in ARStep composition).
  fn send_ac(t: Tag, ka: Local, lb: Local, kc: Local) -> AStep(MkConfig(LSendTo(RC(), t, ka), lb, LRecvFrom(RA(), t, kc), BEmpty()), MkConfig(ka, lb, LRecvFrom(RA(), t, kc), BFull(RA(), RC(), t))) = ASendA()
  fn recv_ca(t: Tag, ka: Local, lb: Local, kc: Local) -> AStep(MkConfig(ka, lb, LRecvFrom(RA(), t, kc), BFull(RA(), RC(), t)), MkConfig(ka, lb, kc, BEmpty())) = ARecvC()
  ## **MULTIPARTY ASYNC ROUTING + BYSTANDER NON-INTERFERENCE**: a message RA→RC is delivered to RC
  ## (routed by the peer annotation), and the bystander RB is UNTOUCHED throughout. The send deposits
  ## BFull(RA, RC, t); only RC's receive-from-RA can consume it — RB's receive would need BFull(_, RB,
  ## _), so RB can never intercept it. So async routing is correct and a non-participant is unaffected.
  fn exchange_ac(lb: Local, t: Tag, ka: Local, kc: Local) -> ARun(MkConfig(LSendTo(RC(), t, ka), lb, LRecvFrom(RA(), t, kc), BEmpty()), MkConfig(ka, lb, kc, BEmpty())) =
    ARStep(send_ac(t, ka, lb, kc), ARStep(recv_ca(t, ka, lb, kc), ARDone()))
end
