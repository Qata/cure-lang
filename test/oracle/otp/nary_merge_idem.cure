mod NaryMergeIdem
  use Std.Equivalent
  type TB2 = F | T
  type Tag = TA | TB | TC
  fn tag_eq(x: Tag, y: Tag) -> TB2 = match x
    TA() -> match y
      TA() -> T()
      TB() -> F()
      TC() -> F()
    TB() -> match y
      TA() -> F()
      TB() -> T()
      TC() -> F()
    TC() -> match y
      TA() -> F()
      TB() -> F()
      TC() -> T()
  type Local = LEnd | LRecv(Tag, Local) | LBra(Branches) | LErr
  type Branches = BNil | BCons(Tag, Local, Branches)
  ## FAITHFUL branch-merge (continuation-merging) via POSITIONAL PAIRING of aligned branch lists —
  ## structured so the recursion is on structural subterms only, so the merge/merge_bra mutual group
  ## certifies total and delta-reduces (the insert-based union does not: Cure's size-change checker is
  ## more conservative than Idris here — recorded as a finding). Same-tag receives merge pointwise; two
  ## external choices merge branch-by-branch; mismatches yield LErr / truncate.
  fn merge(x: Local, y: Local) -> Local = match x
    LEnd()        -> match y
      LEnd()        -> LEnd()
      LRecv(t2, k2) -> LErr()
      LBra(bs2)     -> LErr()
      LErr()        -> LErr()
    LRecv(t1, k1) -> match y
      LEnd()        -> LErr()
      LRecv(t2, k2) -> match tag_eq(t1, t2)
        T() -> LRecv(t1, merge(k1, k2))
        F() -> LErr()
      LBra(bs2)     -> LErr()
      LErr()        -> LErr()
    LBra(bs1)     -> match y
      LEnd()        -> LErr()
      LRecv(t2, k2) -> LErr()
      LBra(bs2)     -> LBra(merge_bra(bs1, bs2))
      LErr()        -> LErr()
    LErr()        -> LErr()
  fn merge_bra(bs1: Branches, bs2: Branches) -> Branches = match bs1
    BNil()            -> BNil()
    BCons(t1, k1, r1) -> match bs2
      BNil()            -> BNil()
      BCons(t2, k2, r2) -> match tag_eq(t1, t2)
        T() -> BCons(t1, merge(k1, k2), merge_bra(r1, r2))
        F() -> BNil()
  fn lrecv_cong(t: Tag, {a: Local}, {b: Local}, e: Equivalent(Local, a, b)) -> Equivalent(Local, LRecv(t, a), LRecv(t, b)) = rewrite e in reflexive(LRecv(t, b))
  fn lbra_cong({a: Branches}, {b: Branches}, e: Equivalent(Branches, a, b)) -> Equivalent(Local, LBra(a), LBra(b)) = rewrite e in reflexive(LBra(b))
  fn bcons_cong(t: Tag, {k1: Local}, {k2: Local}, ek: Equivalent(Local, k1, k2), {r1: Branches}, {r2: Branches}, er: Equivalent(Branches, r1, r2)) -> Equivalent(Branches, BCons(t, k1, r1), BCons(t, k2, r2)) = rewrite ek in rewrite er in reflexive(BCons(t, k2, r2))
  ## **N-ARY MERGE IS IDEMPOTENT** — merge(l, l) = l, mutually with merge_bra_idem over branch lists.
  ## A bystander with IDENTICAL branch-behaviour in every branch of an n-ary choice merges to exactly
  ## that behaviour — the base of projection coherence, faithfully merging continuations (not just
  ## deduplicating), generalized binary→n-ary.
  fn merge_idem(l: Local) -> Equivalent(Local, merge(l, l), l) = match l
    LEnd()      -> reflexive(LEnd())
    LRecv(t, k) -> match t
      TA() -> lrecv_cong(TA(), merge_idem(k))
      TB() -> lrecv_cong(TB(), merge_idem(k))
      TC() -> lrecv_cong(TC(), merge_idem(k))
    LBra(bs)    -> lbra_cong(merge_bra_idem(bs))
    LErr()      -> reflexive(LErr())
  fn merge_bra_idem(bs: Branches) -> Equivalent(Branches, merge_bra(bs, bs), bs) = match bs
    BNil()            -> reflexive(BNil())
    BCons(t, k, rest) -> match t
      TA() -> bcons_cong(TA(), merge_idem(k), merge_bra_idem(rest))
      TB() -> bcons_cong(TB(), merge_idem(k), merge_bra_idem(rest))
      TC() -> bcons_cong(TC(), merge_idem(k), merge_bra_idem(rest))
end
