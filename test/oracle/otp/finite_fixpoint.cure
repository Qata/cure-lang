mod FiniteFixpoint
  ## FINITE least-fixed-point theorem for mailbox-type inference over RECURSIVE behaviours
  ## (build-out map G9 / BRec) — the piece recursion adequacy needs. A mathlib port
  ## (`Order.FixedPoints` + `Finite.wellFounded_of_trans_of_irrefl` +
  ## `OrderIsoNat.monotone_chain_condition`) of the CONSTRUCTIVE, finite version: on a finite
  ## interface lattice the least fixed point of a monotone transfer `f` is reached by bounded
  ## Kleene iteration `f^N(⊥)` and IS a fixed point — no complete-lattice `sInf` needed.
  ##
  ## The lattice here is subsets of a fixed three-tag universe as a `Bool`-per-tag record `IF`,
  ## ordered pointwise (`Sub`), with `size` = the count of present tags (0..3, the height). The
  ## chain `⊥ ⊑ f(⊥) ⊑ f²(⊥) ⊑ …` (`asc`) either stabilizes or strictly grows the size
  ## (`grow_or_eq`); since size is bounded by 3 (`size_bound`), a chain of length 5 must stabilize
  ## (`chain_bound`, the finite monotone-chain condition). Hence:
  ##   * `lfp_le` — every iterate is below any pre-fixed point (principality / leastness);
  ##   * `monotone_iterate` — the ascending chain (also gives `lfp ⊑ f(lfp)`);
  ##   * `map_lfp_le` — `f(f⁴(⊥)) ⊑ f⁴(⊥)`, the FIXED-POINT property `BRec` coverage needs.
  ##
  ## Uses the E1 dependent-match sibling refinement (matching an `Imp` witness refines its bit
  ## variables, so `size` reduces) landed alongside. Idris `rel=same`.

  type B = F | T
  type IF = MkIF(B, B, B)

  ## Bool implication as evidence (no Imp(T,F) — that is the strict-increase witness).
  type Imp indices (a: B, b: B)
    ImpFF : Imp(F, F)
    ImpFT : Imp(F, T)
    ImpTT : Imp(T, T)

  ## Pointwise subset x ⊑ y.
  type Sub indices (x: IF, y: IF)
    MkSub : Imp(a, a2) -> Imp(b, b2) -> Imp(c, c2) -> Sub(MkIF(a, b, c), MkIF(a2, b2, c2))

  fn bot() -> IF = MkIF(F, F, F)
  fn bot_imp(a: B) -> Imp(F, a) = match a
    F() -> ImpFF()
    T() -> ImpFT()
  fn bot_sub(x: IF) -> Sub(bot(), x) = match x
    MkIF(a, b, c) -> MkSub(bot_imp(a), bot_imp(b), bot_imp(c))

  fn imp_refl(a: B) -> Imp(a, a) = match a
    F() -> ImpFF()
    T() -> ImpTT()
  fn sub_refl(x: IF) -> Sub(x, x) = match x
    MkIF(a, b, c) -> MkSub(imp_refl(a), imp_refl(b), imp_refl(c))
  fn imp_trans({a: B}, {b: B}, {c: B}, ab: Imp(a, b), bc: Imp(b, c)) -> Imp(a, c) = match ab
    ImpFF() -> match bc
      ImpFF() -> ImpFF()
      ImpFT() -> ImpFT()
    ImpFT() -> match bc
      ImpTT() -> ImpFT()
    ImpTT() -> match bc
      ImpTT() -> ImpTT()
  fn sub_trans({x: IF}, {y: IF}, {z: IF}, xy: Sub(x, y), yz: Sub(y, z)) -> Sub(x, z) = match xy
    MkSub(a, b, c) -> match yz
      MkSub(a2, b2, c2) -> MkSub(imp_trans(a, a2), imp_trans(b, b2), imp_trans(c, c2))

  ## size = number of T bits, in 0..3.
  fn bcount(a: B) -> Nat = match a
    F() -> Z()
    T() -> S(Z())
  fn plus(m: Nat, n: Nat) -> Nat = match m
    Z()    -> n
    S(k)   -> S(plus(k, n))
  fn size(x: IF) -> Nat = match x
    MkIF(a, b, c) -> plus(bcount(a), plus(bcount(b), bcount(c)))

  ## Nat order.
  type Le indices (m: Nat, n: Nat)
    LeZ : Le(Z, n)
    LeS : Le(m, n) -> Le(S(m), S(n))
  fn le_refl(n: Nat) -> Le(n, n) = match n
    Z()  -> LeZ()
    S(k) -> LeS(le_refl(k))
  fn le_trans({a: Nat}, {b: Nat}, {c: Nat}, ab: Le(a, b), bc: Le(b, c)) -> Le(a, c) = match ab
    LeZ()    -> LeZ()
    LeS(ab2) -> match bc
      LeS(bc2) -> LeS(le_trans(ab2, bc2))
  fn le_succ_right({m: Nat}, {n: Nat}, mn: Le(m, n)) -> Le(m, S(n)) = match mn
    LeZ()    -> LeZ()
    LeS(mn2) -> LeS(le_succ_right(mn2))

  fn bcount_mono({a: B}, {b: B}, i: Imp(a, b)) -> Le(bcount(a), bcount(b)) = match i
    ImpFF() -> LeZ()
    ImpFT() -> LeZ()
    ImpTT() -> LeS(LeZ())

  ## plus monotone. Match the relevant Nats FIRST (data-before-evidence), then the order proof.
  fn le_plus_left(c: Nat, {b: Nat}, {d: Nat}, bd: Le(b, d)) -> Le(b, plus(c, d)) = match c
    Z()  -> bd
    S(k) -> le_succ_right(le_plus_left(k, bd))
  fn plus_mono(a: Nat, b: Nat, c: Nat, d: Nat, ac: Le(a, c), bd: Le(b, d)) -> Le(plus(a, b), plus(c, d)) = match a
    Z()  -> le_plus_left(c, bd)
    S(k) -> match c
      Z()  -> match ac
      S(j) -> match ac
        LeS(kj) -> LeS(plus_mono(k, b, j, d, kj, bd))

  ## size monotone under ⊑. Match the IF endpoints first (bits become relevant), then the Sub.
  fn size_mono(x: IF, y: IF, s: Sub(x, y)) -> Le(size(x), size(y)) = match x
    MkIF(xa, xb, xc) -> match y
      MkIF(ya, yb, yc) -> match s
        MkSub(ia, ib, ic) ->
          plus_mono(bcount(xa), plus(bcount(xb), bcount(xc)), bcount(ya), plus(bcount(yb), bcount(yc)),
                    bcount_mono(ia),
                    plus_mono(bcount(xb), bcount(xc), bcount(yb), bcount(yc), bcount_mono(ib), bcount_mono(ic)))

  ## Each ⊑ step is STABLE (y ⊑ x too, so set-equal) or strictly GROWS the size.
  type StepResult indices (x: IF, y: IF)
    Stable : Sub(y, x) -> StepResult(x, y)
    Grew   : Le(S(size(x)), size(y)) -> StepResult(x, y)
  fn grow_or_eq(x: IF, y: IF, s: Sub(x, y)) -> StepResult(x, y) = match s
    MkSub(ia, ib, ic) -> match ia
      ImpFF() -> match ib
        ImpFF() -> match ic
          ImpFF() -> Stable(MkSub(ImpFF(), ImpFF(), ImpFF()))
          ImpFT() -> Grew(LeS(LeZ()))
          ImpTT() -> Stable(MkSub(ImpFF(), ImpFF(), ImpTT()))
        ImpFT() -> match ic
          ImpFF() -> Grew(LeS(LeZ()))
          ImpFT() -> Grew(LeS(LeZ()))
          ImpTT() -> Grew(LeS(LeS(LeZ())))
        ImpTT() -> match ic
          ImpFF() -> Stable(MkSub(ImpFF(), ImpTT(), ImpFF()))
          ImpFT() -> Grew(LeS(LeS(LeZ())))
          ImpTT() -> Stable(MkSub(ImpFF(), ImpTT(), ImpTT()))
      ImpFT() -> match ib
        ImpFF() -> match ic
          ImpFF() -> Grew(LeS(LeZ()))
          ImpFT() -> Grew(LeS(LeZ()))
          ImpTT() -> Grew(LeS(LeS(LeZ())))
        ImpFT() -> match ic
          ImpFF() -> Grew(LeS(LeZ()))
          ImpFT() -> Grew(LeS(LeZ()))
          ImpTT() -> Grew(LeS(LeS(LeZ())))
        ImpTT() -> match ic
          ImpFF() -> Grew(LeS(LeS(LeZ())))
          ImpFT() -> Grew(LeS(LeS(LeZ())))
          ImpTT() -> Grew(LeS(LeS(LeS(LeZ()))))
      ImpTT() -> match ib
        ImpFF() -> match ic
          ImpFF() -> Stable(MkSub(ImpTT(), ImpFF(), ImpFF()))
          ImpFT() -> Grew(LeS(LeS(LeZ())))
          ImpTT() -> Stable(MkSub(ImpTT(), ImpFF(), ImpTT()))
        ImpFT() -> match ic
          ImpFF() -> Grew(LeS(LeS(LeZ())))
          ImpFT() -> Grew(LeS(LeS(LeZ())))
          ImpTT() -> Grew(LeS(LeS(LeS(LeZ()))))
        ImpTT() -> match ic
          ImpFF() -> Stable(MkSub(ImpTT(), ImpTT(), ImpFF()))
          ImpFT() -> Grew(LeS(LeS(LeS(LeZ()))))
          ImpTT() -> Stable(MkSub(ImpTT(), ImpTT(), ImpTT()))
  fn size_bound(x: IF) -> Le(size(x), S(S(S(Z)))) = match x
    MkIF(a, b, c) -> match a
      F() -> match b
        F() -> match c
          F() -> LeZ()
          T() -> LeS(LeZ())
        T() -> match c
          F() -> LeS(LeZ())
          T() -> LeS(LeS(LeZ()))
      T() -> match b
        F() -> match c
          F() -> LeS(LeZ())
          T() -> LeS(LeS(LeZ()))
        T() -> match c
          F() -> LeS(LeS(LeZ()))
          T() -> LeS(LeS(LeS(LeZ())))
  ## Kleene iteration f^n(bot) and the ascending chain, over the finite lattice.
  fn iter(f: (IF) -> IF, n: Nat) -> IF = match n
    Z()  -> bot()
    S(k) -> f(iter(f, k))
  fn asc(f: (IF) -> IF, mono: (x: IF) -> (y: IF) -> (Sub(x, y)) -> Sub(f(x), f(y)), n: Nat) -> Sub(iter(f, n), iter(f, S(n))) = match n
    Z()  -> bot_sub(iter(f, S(Z)))
    S(k) -> mono(iter(f, k), iter(f, S(k)), asc(f, mono, k))

  ## Stability propagates: iter_k fixed ⟹ iter_{S(k)} fixed. Just `mono` applied to the witness.
  fn propagate(f: (IF) -> IF, mono: (x: IF) -> (y: IF) -> (Sub(x, y)) -> Sub(f(x), f(y)), k: Nat, fx: Sub(iter(f, S(k)), iter(f, k))) -> Sub(iter(f, S(S(k))), iter(f, S(k))) =
    mono(iter(f, S(k)), iter(f, k), fx)

  type Empty = |
  fn le_irrefl_succ(n: Nat, h: Le(S(n), n)) -> Empty = match n
    Z()  -> match h
    S(k) -> match h
      LeS(h2) -> le_irrefl_succ(k, h2)

  ## COUNTING (mathlib monotone_chain_condition, finite instance). After n steps the chain has
  ## either STABILIZED (its next iterate is ⊑ the current, hence a fixed point) or grown to size ≥ n.
  type ChainState indices (prev: IF, next: IF, n: Nat)
    CFixed : Sub(next, prev) -> ChainState(prev, next, n)
    CSize  : Le(n, size(prev)) -> ChainState(prev, next, n)
  fn chain_bound(f: (IF) -> IF, mono: (x: IF) -> (y: IF) -> (Sub(x, y)) -> Sub(f(x), f(y)), n: Nat) -> ChainState(iter(f, n), iter(f, S(n)), n) = match n
    Z()  -> CSize(LeZ())
    S(k) -> match chain_bound(f, mono, k)
      CFixed(fx) -> CFixed(propagate(f, mono, k, fx))
      CSize(sz)  -> match grow_or_eq(iter(f, k), iter(f, S(k)), asc(f, mono, k))
        Stable(st) -> CFixed(propagate(f, mono, k, st))
        Grew(g)    -> CSize(le_trans(LeS(sz), g))

  ## **MAP_LFP (fixed-point property).** lfp := f^4(bot); the chain of length 5 (0..4) cannot
  ## strictly grow past size 3 (`size_bound`), so `chain_bound` at 4 forces the STABILIZED case:
  ## f(lfp) ⊑ lfp. Together with `monotone_iterate` (lfp ⊑ f(lfp)) this is the least fixed point.
  fn map_lfp_le(f: (IF) -> IF, mono: (x: IF) -> (y: IF) -> (Sub(x, y)) -> Sub(f(x), f(y))) -> Sub(f(iter(f, S(S(S(S(Z)))))), iter(f, S(S(S(S(Z)))))) = match chain_bound(f, mono, S(S(S(S(Z)))))
    CFixed(fx) -> fx
    CSize(sz)  -> match le_irrefl_succ(S(S(S(Z))), le_trans(sz, size_bound(iter(f, S(S(S(S(Z))))))))
end
