mod Le01
  # Large elimination: a type-level selector `Foci : Kind -> Type` that matches on
  # a `Kind` value and returns DIFFERENT types per branch, then USES the reduced
  # type at each kind. This is the kernel capability underpinning Std.Optic's
  # kind-indexed representation (spec 2026-07-11-std-optic-design §4): the elaborator
  # must reduce `Foci(KLens)` to `Unit` and `Foci(KAffine)` to `Two` to check the
  # constructor bodies. Proven to compute by the paired negative control in
  # test/cure/elab (MkUnit : Foci(KAffine) is rejected).
  type Kind = KLens | KAffine | KTraversal
  type Unit = MkUnit
  type Two = T | F
  fn Foci(k: Kind) -> Type = match k
    KLens -> Unit
    KAffine -> Two
    KTraversal -> Unit
  fn mk_lens() -> Foci(KLens) = MkUnit
  fn ok_affine() -> Foci(KAffine) = T
end
