mod Rw09
  type Nat = Z | S(Nat)
  fn plus(m: Nat, n: Nat) -> Nat = match m
    Z() -> n
    S(k) -> S(plus(k, n))
  fn plus_zero_right(n: Nat) -> Eq(Nat, plus(n, Z), n) = match n
    Z() -> refl(Z)
    S(k) -> rewrite plus_zero_right(k) in refl(S(k))
  # CONVERSION multi-occurrence: `plus(Z, n)` reduces to `n`, so the endpoint
  # `plus(n, Z)` is present only up-to-conversion, and appears TWICE. One
  # `rewrite` must bridge + abstract both up-to-def-eq occurrences.
  fn multi_conv(n: Nat) -> Eq(Nat, plus(plus(plus(Z, n), Z), plus(plus(Z, n), Z)), plus(n, n)) =
    rewrite plus_zero_right(n) in refl(plus(n, n))
end
