@group(:concurrency)
mod Std.Otp.PatternReceive
  ## PATTERN-DIRECTED SELECTIVE RECEIVE (build-out map B4). `Std.Otp.SelectiveReceive` types a
  ## single-TAG ordered scan (receive the next message with one fixed tag). Real Erlang
  ## `receive` selects by a PATTERN — a set of acceptable message shapes — scanning the mailbox
  ## front-to-back for the first message the pattern matches and leaving the rest in order.
  ##
  ## Here the pattern is a set of acceptable tags (`InSet`). `SelRecv(set, before, got, after)`
  ## scans `before`, consumes the received message `got`, and leaves `after`; a `SRHere` step
  ## takes a head that matches the pattern, a `SRSkip` step passes over a head and keeps it in
  ## the residual. The two theorems certify the selective-receive contract: `selrecv_matches`
  ## — the received message always matches the pattern; `selrecv_present` — it was actually in
  ## the mailbox (nothing is fabricated). So a pattern-directed receive only ever delivers a
  ## message the pattern accepts, and only one that was really waiting.

  type Tag = TA | TB | TC
  type TagList = TNil | TCons(Tag, TagList)
  type Mailbox = BNil | BCons(Tag, Mailbox)

  ## `InSet(t, set)` — tag `t` is in the acceptable-pattern set.
  type InSet indices (t: Tag, set: TagList)
    Here  : InSet(t, TCons(t, rest))
    There : InSet(t, rest) -> InSet(t, TCons(y, rest))

  ## `InMbox(t, mbox)` — tag `t` occurs in the mailbox.
  type InMbox indices (t: Tag, mbox: Mailbox)
    MHere  : InMbox(t, BCons(t, rest))
    MThere : InMbox(t, rest) -> InMbox(t, BCons(y, rest))

  ## Pattern-directed selective receive: scan `before`, take a pattern-matching message `got`,
  ## leave `after`. `SRHere` matches the head against the pattern; `SRSkip` passes a head over.
  type SelRecv indices (set: TagList, before: Mailbox, got: Tag, after: Mailbox)
    SRHere : InSet(t, set) -> SelRecv(set, BCons(t, rest), t, rest)
    SRSkip : SelRecv(set, rest, g, after) -> SelRecv(set, BCons(h, rest), g, BCons(h, after))

  ## **PATTERN-DIRECTEDNESS.** The received message always matches the pattern — whether it was
  ## the head or found deeper in the mailbox.
  fn selrecv_matches({set: TagList}, {before: Mailbox}, {got: Tag}, {after: Mailbox}, sr: SelRecv(set, before, got, after)) -> InSet(got, set) = match sr
    SRHere(mem) -> mem
    SRSkip(sr2) -> selrecv_matches(sr2)

  ## **NON-FABRICATION.** The received message was actually present in the mailbox.
  fn selrecv_present({set: TagList}, {before: Mailbox}, {got: Tag}, {after: Mailbox}, sr: SelRecv(set, before, got, after)) -> InMbox(got, before) = match sr
    SRHere(mem) -> MHere()
    SRSkip(sr2) -> MThere(selrecv_present(sr2))
end
