@group(:text)
mod Std.Regex
  ## Pure Cure regular-expression syntax.
  ##
  ## This is the first layer of the TyRE-inspired implementation: a regex
  ## pattern is parsed into an ordinary Cure value.  No OTP regex engine, NIF,
  ## opaque handle, or foreign parser is involved.

  use Std.Char
  use Std.List
  use Std.Option
  use Std.String

  ## The syntax tree deliberately keeps the representation small and explicit.
  ## Captures are represented by `Capture`; matching semantics are added on top
  ## of this tree rather than hidden in a runtime regex object.
  type Regex =
    | Configured(Regex, RegexOptions)
    | Empty()
    | Start()
    | End()
    | Literal(Char) 
    | Any()
    | CharSet(List(Char), List(CharRange)) 
    | NegatedCharSet(List(Char), List(CharRange))
    | Sequence(Regex, Regex) 
    | Alternate(Regex, Regex) 
    | Repeat(Regex) 
    | Plus(Regex) 
    | Optional(Regex) 
    | Capture(Regex)

  ## Retain the source modifier string. This keeps option order and aliases
  ## observable, while allowing the matcher to add semantics independently.
  type RegexOptions =
    | RawOptions(String)

  type CharRange = 
    Range(Char, Char)

  type Parse = 
    | Parsed(Regex, String) 
    | ParseFailure()
  type ClassParse = 
    | ClassParsed(List(Char), List(CharRange), String) 
    | ClassFailure()

  type AtomKind =
    | AnyKind()
    | GroupKind()
    | ClassKind()
    | CaptureKind()
    | StartKind()
    | EndKind()
    | EscapeAtomKind()
    | InvalidKind()
    | LiteralKind()

  type EscapeKind =
    | DigitEscape()
    | NotDigitEscape()
    | WordEscape()
    | NotWordEscape()
    | SpaceEscape()
    | NotSpaceEscape()
    | NewlineEscape()
    | TabEscape()
    | LiteralEscape()

  ## Parse a complete pattern.  `None` means that the syntax was malformed or
  ## that an opening group/class was not closed.
  fn parse(pattern: String) -> Option(Regex) =
    match parse_alternate(pattern)
      Parsed(tree, rest) -> parse_complete(tree, rest)
      ParseFailure() -> None()

  fn parse_complete(tree: Regex, rest: String) -> Option(Regex) =
    match rest
      [] -> Some(tree)
      _ -> None()

  ## Compile-time literal expansion target.  The compiler's regex literal macro
  ## emits this ordinary typed call, so `/.../` has the inferred type `Regex`
  ## while the parser and resulting value remain Cure definitions.
  fn literal(pattern: String, flags: String) -> Regex =
    match parse(normalize_extended(pattern, has_flag(flags, 'x')))
      Some(tree) -> Configured(tree, parse_flags(flags))
      None() -> Empty()

  ## Full-string matching over the parsed tree.  `run/2` returns every
  ## possible suffix, and the public predicate succeeds exactly when one
  ## suffix is empty.  The implementation is deliberately expressed as pure
  ## list recursion; the Thompson machine compilation layer will replace this
  ## backtracking representation in the next step without changing this API.
  fn is_match(regex: Regex, input: String) -> Bool = has_empty(run(regex, input))

  fn has_empty(suffixes: List(String)) -> Bool =
    match suffixes
      [] -> false
      [head | tail] ->
        match head
          [] -> true
          _ -> has_empty(tail)

  fn run(regex: Regex, input: String) -> List(String) =
    run_normalized(regex, input)

  fn run_normalized(regex: Regex, input: String) -> List(String) =
    match regex
      Configured(inner, options) -> run_with(inner, input, options, true, true)
      _ -> run_with(regex, input, RawOptions([]), true, true)

  fn run_with(regex: Regex, input: String, options: RegexOptions, at_start: Bool, at_line_start: Bool) -> List(String) =
    match regex
      Configured(inner, nested) -> run_with(inner, input, nested, at_start, at_line_start)
      Empty() -> [input]
      Start() ->
        match at_start or (has_option(options, 'm') and at_line_start)
          true -> [input]
          false -> []
      End() ->
        match input
          [] -> [input]
          [head | _] ->
            match has_option(options, 'm') and is_newline(head)
              true -> [input]
              false -> []
      Literal(expected) ->
        match input
          [actual | rest] ->
            match chars_equal(expected, actual, options)
              true -> [rest]
              false -> []
          [] -> []
      Any() ->
        match input
          [actual | rest] ->
            match dot_matches(actual, options)
              true -> [rest]
              false -> []
          [] -> []
      CharSet(chars, ranges) ->
        match input
          [actual | rest] ->
            match char_in_set(actual, chars, ranges, options)
              true -> [rest]
              false -> []
          [] -> []
      NegatedCharSet(chars, ranges) ->
        match input
          [actual | rest] ->
            match char_in_set(actual, chars, ranges, options)
              true -> []
              false -> [rest]
          [] -> []
      Sequence(left, right) ->
        Std.List.flat_map(run_with(left, input, options, at_start, at_line_start),
          fn(rest) -> run_with(right, rest, options,
            at_start and is_nullable(left),
            next_line_start(input, rest, at_line_start, is_nullable(left))))
      Alternate(left, right) -> Std.List.append(run_with(left, input, options, at_start, at_line_start), run_with(right, input, options, at_start, at_line_start))
      Repeat(inner) -> repeat_all(inner, [input], [input], options, at_start, at_line_start)
      Plus(inner) ->
        Std.List.flat_map(run_with(inner, input, options, at_start, at_line_start),
          fn(rest) -> repeat_all(inner, [rest], [rest], options, false, false))
      Optional(inner) -> Std.List.append([input], run_with(inner, input, options, at_start, at_line_start))
      Capture(inner) -> run_with(inner, input, options, at_start, at_line_start)

  fn repeat_all(inner: Regex, frontier: List(String), found: List(String), options: RegexOptions, at_start: Bool, at_line_start: Bool) -> List(String) =
    order_repeat(repeat_all_raw(inner, frontier, found, options, at_start, at_line_start), options)

  fn repeat_all_raw(inner: Regex, frontier: List(String), found: List(String), options: RegexOptions, at_start: Bool, at_line_start: Bool) -> List(String) =
    match frontier
      [] -> found
      [candidate | rest] ->
        let next =
          Std.List.filter(
            run_with(inner, candidate, options, at_start, at_line_start),
            fn(suffix) -> Std.Builtin.int_lt(Std.String.length(suffix), Std.String.length(candidate))
          )
        repeat_all_raw(inner, Std.List.append(rest, next), Std.List.append(found, next), options, false, false)

  fn order_repeat(found: List(String), options: RegexOptions) -> List(String) =
    match options
      RawOptions(flags) ->
        match has_flag(flags, 'U') or has_flag(flags, 'r')
          true -> found
          false -> Std.List.reverse(found)

  fn char_in_set(actual: Char, chars: List(Char), ranges: List(CharRange), options: RegexOptions) -> Bool =
    match chars
      [] -> char_in_ranges(actual, ranges, options)
      [head | tail] ->
        match chars_equal(actual, head, options)
          true -> true
          false -> char_in_set(actual, tail, ranges, options)

  fn char_in_ranges(actual: Char, ranges: List(CharRange), options: RegexOptions) -> Bool =
    match ranges
      [] -> false
      [Range(first, last) | tail] ->
        match Std.Builtin.int_lt(range_code(actual, options), range_code(first, options))
          true -> char_in_ranges(actual, tail, options)
          false ->
            match Std.Builtin.int_lt(range_code(last, options), range_code(actual, options))
              true -> char_in_ranges(actual, tail, options)
              false -> true

  fn parse_flags(flags: String) -> RegexOptions =
    RawOptions(flags)

  fn has_flag(flags: String, wanted: Char) -> Bool =
    match flags
      [] -> false
      [head | rest] ->
        match head == wanted
          true -> true
          false -> has_flag(rest, wanted)

  fn has_option(options: RegexOptions, wanted: Char) -> Bool =
    match options
      RawOptions(flags) -> has_flag(flags, wanted)

  fn next_line_start(input: String, rest: String, at_line_start: Bool, nullable: Bool) -> Bool =
    match nullable
      true -> at_line_start
      false ->
        let consumed = Std.Builtin.int_sub(Std.String.length(input), Std.String.length(rest))
        match int_same(consumed, 0)
          true -> at_line_start
          false ->
            is_newline(Std.List.nth(input, Std.Builtin.int_sub(consumed, 1), 'x'))

  fn is_newline(char: Char) -> Bool
    | '\n' -> true
    | _ -> false

  ## Extended mode is kept as an explicit normalization seam. The parser's
  ## character-class grammar currently needs a stateful scanner before `x` can
  ## safely remove whitespace/comments without changing `[ ]` semantics.
  fn normalize_extended(pattern: String, enabled: Bool) -> String =
    match enabled
      false -> pattern
      true -> Std.List.reverse(strip_extended(pattern, false, false, []))

  fn strip_extended(input: String, in_class: Bool, escaped: Bool, output: List(Char)) -> List(Char) =
    match input
      [] -> output
      [head | rest] ->
        match escaped
          true -> strip_extended(rest, in_class, false, [head | output])
          false ->
            match head
              '\\' -> strip_extended(rest, in_class, true, [head | output])
              '[' -> strip_extended(rest, true, false, [head | output])
              ']' -> strip_extended(rest, false, false, [head | output])
              _ ->
                match in_class
                  true -> strip_extended(rest, in_class, false, [head | output])
                  false ->
                    match head
                      '#' -> strip_extended(skip_extended_comment(rest), in_class, false, output)
                      _ ->
                        match is_extended_space(head)
                          true -> strip_extended(rest, in_class, false, output)
                          false -> strip_extended(rest, in_class, false, [head | output])

  fn skip_extended_comment(input: String) -> String =
    match input
      [] -> []
      [head | rest] ->
        match head
          '\n' -> rest
          _ -> skip_extended_comment(rest)

  fn is_extended_space(head: Char) -> Bool
    | ' ' -> true
    | '\t' -> true
    | '\n' -> true
    | '\r' -> true
    | _ -> false

  fn chars_equal(expected: Char, actual: Char, options: RegexOptions) -> Bool =
    match options
      RawOptions(flags) ->
        match has_flag(flags, 'i')
          true -> same_chars(Std.String.downcase([expected]), Std.String.downcase([actual]))
          false -> expected == actual

  fn range_code(char: Char, options: RegexOptions) -> Int =
    match options
      RawOptions(flags) ->
        match has_flag(flags, 'i')
          true -> Std.Char.code_point(Std.List.nth(Std.String.downcase([char]), 0, char))
          false -> Std.Char.code_point(char)

  fn same_chars(left: String, right: String) -> Bool =
    match left
      [] ->
        match right
          [] -> true
          _ -> false
      [left_head | left_tail] ->
        match right
          [right_head | right_tail] ->
            left_head == right_head and same_chars(left_tail, right_tail)
          [] -> false

  fn dot_matches(actual: Char, options: RegexOptions) -> Bool =
    match options
      RawOptions(flags) ->
        match has_flag(flags, 's')
          true -> true
          false ->
            match actual
              '\n' -> false
              _ -> true

  fn int_same(left: Int, right: Int) -> Bool =
    match Std.Builtin.int_lt(left, right)
      true -> false
      false ->
        match Std.Builtin.int_lt(right, left)
          true -> false
          false -> true

  fn parse_alternate(input: String) -> Parse =
    match parse_sequence(input)
      ParseFailure() -> ParseFailure()
      Parsed(left, rest) -> parse_alternate_tail(left, rest)

  fn parse_alternate_tail(left: Regex, input: String) -> Parse =
    match input
      [] -> Parsed(left, input)
      [head | rest] ->
        match head
          '|' ->
            match parse_sequence(rest)
              ParseFailure() -> ParseFailure()
              Parsed(right, tail) -> parse_alternate_tail(Alternate(left, right), tail)
          _ -> Parsed(left, input)

  ## A sequence ends before `|`, `)`, `]`, or end-of-input.  An empty sequence
  ## is the identity element required by `*`, `?`, and empty alternatives.
  fn parse_sequence(input: String) -> Parse =
    match input
      [] -> Parsed(Empty(), [])
      [head | _] ->
        match is_sequence_stop(head)
          true -> Parsed(Empty(), input)
          false ->
            match parse_repetition(input)
              ParseFailure() -> ParseFailure()
              Parsed(first, rest) -> parse_sequence_tail(first, rest)

  fn parse_sequence_tail(left: Regex, input: String) -> Parse =
    match input
      [] -> Parsed(left, [])
      [head | _] ->
        match is_sequence_stop(head)
          true -> Parsed(left, input)
          false ->
            match parse_repetition(input)
              ParseFailure() -> ParseFailure()
              Parsed(right, rest) -> parse_sequence_tail(Sequence(left, right), rest)

  fn parse_repetition(input: String) -> Parse =
    match parse_atom(input)
      ParseFailure() -> ParseFailure()
      Parsed(atom, rest) ->
        match rest
          [] -> Parsed(atom, rest)
          [head | tail] ->
            match head
              '*' -> Parsed(Repeat(atom), tail)
              '+' -> Parsed(Plus(atom), tail)
              '?' -> Parsed(Optional(atom), tail)
              _ -> Parsed(atom, rest)

  fn parse_atom(input: String) -> Parse =
    match input
      [] -> ParseFailure()
      [head | rest] -> parse_atom_head(head, rest)

  fn parse_atom_head(head: Char, rest: String) -> Parse =
    parse_atom_kind(atom_kind(head), head, rest)

  fn atom_kind(head: Char) -> AtomKind
    | '.' -> AnyKind()
    | '(' -> GroupKind()
    | '[' -> ClassKind()
    | '!' -> CaptureKind()
    | '^' -> StartKind()
    | '$' -> EndKind()
    | '\\' -> EscapeAtomKind()
    | '*' -> InvalidKind()
    | '+' -> InvalidKind()
    | '?' -> InvalidKind()
    | _ -> LiteralKind()

  fn parse_atom_kind(kind: AtomKind, head: Char, rest: String) -> Parse =
    match kind
      AnyKind() -> Parsed(Any(), rest)
      GroupKind() -> parse_group(rest)
      ClassKind() -> parse_class_atom(rest)
      CaptureKind() ->
        match parse_atom(rest)
          ParseFailure() -> ParseFailure()
          Parsed(tree, tail) -> Parsed(Capture(tree), tail)
      StartKind() -> Parsed(Start(), rest)
      EndKind() -> Parsed(End(), rest)
      EscapeAtomKind() -> parse_escape(rest)
      InvalidKind() -> ParseFailure()
      LiteralKind() -> Parsed(Literal(head), rest)

  fn parse_escape(input: String) -> Parse =
    match input
      [] -> ParseFailure()
      [head | rest] -> parse_escape_kind(escape_kind(head), head, rest)

  fn escape_kind(head: Char) -> EscapeKind
    | 'd' -> DigitEscape()
    | 'D' -> NotDigitEscape()
    | 'w' -> WordEscape()
    | 'W' -> NotWordEscape()
    | 's' -> SpaceEscape()
    | 'S' -> NotSpaceEscape()
    | 'n' -> NewlineEscape()
    | 't' -> TabEscape()
    | _ -> LiteralEscape()

  fn parse_escape_kind(kind: EscapeKind, head: Char, rest: String) -> Parse =
    match kind
      DigitEscape() -> Parsed(CharSet([], [Range('0', '9')]), rest)
      NotDigitEscape() -> Parsed(NegatedCharSet([], [Range('0', '9')]), rest)
      WordEscape() -> Parsed(CharSet(['_'], [Range('a', 'z'), Range('A', 'Z'), Range('0', '9')]), rest)
      NotWordEscape() -> Parsed(NegatedCharSet(['_'], [Range('a', 'z'), Range('A', 'Z'), Range('0', '9')]), rest)
      SpaceEscape() -> Parsed(CharSet([' ', '\t', '\n'], []), rest)
      NotSpaceEscape() -> Parsed(NegatedCharSet([' ', '\t', '\n'], []), rest)
      NewlineEscape() -> Parsed(Literal('\n'), rest)
      TabEscape() -> Parsed(Literal('\t'), rest)
      LiteralEscape() -> Parsed(Literal(head), rest)

  fn is_sequence_stop(head: Char) -> Bool
    | '|' -> true
    | ')' -> true
    | ']' -> true
    | _ -> false

  fn is_repetition(head: Char) -> Bool
    | '*' -> true
    | '+' -> true
    | '?' -> true
    | _ -> false

  fn is_nullable(regex: Regex) -> Bool =
    match regex
      Configured(inner, _) -> is_nullable(inner)
      Empty() -> true
      Start() -> true
      End() -> true
      Optional(_) -> true
      Repeat(_) -> true
      Alternate(left, right) -> is_nullable(left) or is_nullable(right)
      Sequence(left, right) -> is_nullable(left) and is_nullable(right)
      _ -> false

  fn parse_group(input: String) -> Parse =
    match parse_alternate(input)
      ParseFailure() -> ParseFailure()
      Parsed(tree, rest) ->
        match rest
          [head | tail] ->
            match head
              ')' -> Parsed(tree, tail)
              _ -> ParseFailure()
          _ -> ParseFailure()

  fn parse_class_atom(input: String) -> Parse =
    match input
      [head | tail] ->
        match head
          '^' ->
            match parse_class_items(tail, [], [])
              ClassFailure() -> ParseFailure()
              ClassParsed(chars, ranges, rest) -> Parsed(NegatedCharSet(chars, ranges), rest)
          _ ->
            match parse_class_items(input, [], [])
              ClassFailure() -> ParseFailure()
              ClassParsed(chars, ranges, rest) -> Parsed(CharSet(chars, ranges), rest)
      [] -> ParseFailure()

  fn parse_class_items(input: String, chars: List(Char), ranges: List(CharRange)) -> ClassParse =
    match input
      [] -> ClassFailure()
      [head | rest] ->
        match head
          ']' -> ClassParsed(Std.List.reverse(chars), Std.List.reverse(ranges), rest)
          _ ->
            match rest
              [dash | after_dash] ->
                match dash
                  '-' ->
                    match after_dash
                      [last | tail] -> parse_class_items(tail, chars, [Range(head, last) | ranges])
                      [] -> parse_class_items(rest, [head | chars], ranges)
                  _ -> parse_class_items(rest, [head | chars], ranges)
              [] -> parse_class_items(rest, [head | chars], ranges)
