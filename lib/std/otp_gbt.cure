@group(:concurrency)
mod Std.Otp.Gbt
  use Std.Equivalent
  ## ERLANG `gb_trees` AS A MAP — the ordered key→value balanced tree behind `gb_trees:enter`/
  ## `lookup` (and `gb_sets`). Distinct from `Std.Otp.Bst` (a set): every node carries a VALUE as
  ## well as a key, `insert` is `enter` (insert-or-UPDATE), and `lookup` returns an optional value.
  ## The two defining finite-map laws are certified: looking up a key you just entered returns the
  ## entered value, and entering a DIFFERENT key leaves an unrelated lookup unchanged.
  ##
  ## Keys are a fixed finite ordered domain `GA < GB < GC` with a total `gcmp`, so comparisons
  ## REDUCE at proof time (same concrete-domain technique as `Std.Otp.Set`/`Std.Otp.Bst`).

  type GKey = GA | GB | GC
  type GCmp = GLt | GEq | GGt
  type GBit = BF | BT
  type GOpt = GNone | GSome(Nat)

  fn gcmp(a: GKey, b: GKey) -> GCmp = match a
    GA() -> match b
      GA() -> GEq()
      GB() -> GLt()
      GC() -> GLt()
    GB() -> match b
      GA() -> GGt()
      GB() -> GEq()
      GC() -> GLt()
    GC() -> match b
      GA() -> GGt()
      GB() -> GGt()
      GC() -> GEq()

  ## Key equality, whose `= BF` witnesses the "different key" side condition of the neq law.
  fn gkeq(x: GKey, k: GKey) -> GBit = match x
    GA() -> match k
      GA() -> BT()
      GB() -> BF()
      GC() -> BF()
    GB() -> match k
      GA() -> BF()
      GB() -> BT()
      GC() -> BF()
    GC() -> match k
      GA() -> BF()
      GB() -> BF()
      GC() -> BT()

  type GTree = GLeaf | GNode(GTree, GKey, Nat, GTree)

  ## Lookup steers by the comparison, returning the value at a hit.
  fn lookup(k: GKey, t: GTree) -> GOpt = match t
    GLeaf()            -> GNone()
    GNode(l, v, w, r)  -> match gcmp(k, v)
      GLt() -> lookup(k, l)
      GEq() -> GSome(w)
      GGt() -> lookup(k, r)

  ## `enter`: insert-or-update. On a hit the value is REPLACED; otherwise a new leaf is grown on the
  ## side the comparison dictates, preserving the search invariant.
  fn insert(k: GKey, val: Nat, t: GTree) -> GTree = match t
    GLeaf()            -> GNode(GLeaf(), k, val, GLeaf())
    GNode(l, v, w, r)  -> match gcmp(k, v)
      GLt() -> GNode(insert(k, val, l), v, w, r)
      GEq() -> GNode(l, v, val, r)
      GGt() -> GNode(l, v, w, insert(k, val, r))

  ## **LOOKUP AFTER ENTER RETURNS THE ENTERED VALUE.** `lookup(k, insert(k, val, t)) = Some(val)` —
  ## whatever the tree, entering `k ↦ val` and then looking `k` up yields `val`. `lookup` and
  ## `insert` steer by the same `gcmp(k, v)`, so at each node they descend together; on a hit
  ## `insert` writes `val` at exactly the node `lookup` reads. Casing `k` and each node key `v` (over
  ## the finite domain) makes every comparison reduce.
  fn lookup_insert_eq(k: GKey, val: Nat, t: GTree) -> Equivalent(GOpt, lookup(k, insert(k, val, t)), GSome(val)) = match t
    GLeaf()            -> match k
      GA() -> reflexive(GSome(val))
      GB() -> reflexive(GSome(val))
      GC() -> reflexive(GSome(val))
    GNode(l, v, w, r)  -> match k
      GA() -> match v
        GA() -> reflexive(GSome(val))
        GB() -> lookup_insert_eq(GA(), val, l)
        GC() -> lookup_insert_eq(GA(), val, l)
      GB() -> match v
        GA() -> lookup_insert_eq(GB(), val, r)
        GB() -> reflexive(GSome(val))
        GC() -> lookup_insert_eq(GB(), val, l)
      GC() -> match v
        GA() -> lookup_insert_eq(GC(), val, r)
        GB() -> lookup_insert_eq(GC(), val, r)
        GC() -> reflexive(GSome(val))

  ## **ENTERING A DIFFERENT KEY DOES NOT DISTURB A LOOKUP.** Given `gkeq(x, k) = BF` (i.e. `x ≠ k`),
  ## `lookup(x, insert(k, val, t)) = lookup(x, t)` — updating one key's value/presence is invisible
  ## to every other key's lookup. `insert` only rebuilds the subtree on `k`'s side (or updates `k`'s
  ## own value); since `x ≠ k`, `x`'s search either takes the untouched side (the lookup is
  ## unchanged — reflexive) or the same side `k` did (recurse — the induction hypothesis). Every
  ## same-key diagonal is impossible under the premise (`gkeq(x, x) = BT`, so `neq : BT = BF` is
  ## uninhabited — an empty `match neq`). 27-way `x`/`v`/`k` casing makes every comparison reduce.
  fn lookup_insert_neq(x: GKey, k: GKey, val: Nat, t: GTree, neq: Equivalent(GBit, gkeq(x, k), BF())) -> Equivalent(GOpt, lookup(x, insert(k, val, t)), lookup(x, t)) = match t
    GLeaf()            -> match x
      GA() -> match k
        GA() -> match neq
        GB() -> reflexive(GNone())
        GC() -> reflexive(GNone())
      GB() -> match k
        GA() -> reflexive(GNone())
        GB() -> match neq
        GC() -> reflexive(GNone())
      GC() -> match k
        GA() -> reflexive(GNone())
        GB() -> reflexive(GNone())
        GC() -> match neq
    GNode(l, v, w, r)  -> match x
      GA() -> match v
        GA() -> match k
          GA() -> match neq
          GB() -> reflexive(GSome(w))
          GC() -> reflexive(GSome(w))
        GB() -> match k
          GA() -> match neq
          GB() -> reflexive(lookup(GA(), l))
          GC() -> reflexive(lookup(GA(), l))
        GC() -> match k
          GA() -> match neq
          GB() -> lookup_insert_neq(GA(), GB(), val, l, neq)
          GC() -> reflexive(lookup(GA(), l))
      GB() -> match v
        GA() -> match k
          GA() -> reflexive(lookup(GB(), r))
          GB() -> match neq
          GC() -> lookup_insert_neq(GB(), GC(), val, r, neq)
        GB() -> match k
          GA() -> reflexive(GSome(w))
          GB() -> match neq
          GC() -> reflexive(GSome(w))
        GC() -> match k
          GA() -> lookup_insert_neq(GB(), GA(), val, l, neq)
          GB() -> match neq
          GC() -> reflexive(lookup(GB(), l))
      GC() -> match v
        GA() -> match k
          GA() -> reflexive(lookup(GC(), r))
          GB() -> lookup_insert_neq(GC(), GB(), val, r, neq)
          GC() -> match neq
        GB() -> match k
          GA() -> reflexive(lookup(GC(), r))
          GB() -> reflexive(lookup(GC(), r))
          GC() -> match neq
        GC() -> match k
          GA() -> reflexive(GSome(w))
          GB() -> reflexive(GSome(w))
          GC() -> match neq

  ## Three-way selector: `gsel(BT, a, b) = a`, `gsel(BF, a, b) = b` — the boolean conditional used
  ## to state the complete lookup law without a side condition.
  fn gsel(b: GBit, x: GOpt, y: GOpt) -> GOpt = match b
    BT() -> x
    BF() -> y

  ## **COMPLETE LOOKUP-AFTER-ENTER LAW (capstone).** `lookup(x, insert(k, val, t)) =
  ## if x = k then Some(val) else lookup(x, t)`. A single conditional statement that SUBSUMES both
  ## `lookup_insert_eq` (take `x = k`, so the guard is `BT`) and `lookup_insert_neq` (take `x ≠ k`,
  ## guard `BF`) — and needs NO premise, because the same-key case now returns `Some(val)` instead of
  ## being refuted. Same 27-way `x`/`v`/`k` casing: at `x = v` the read hits the root (`Some(val)` if
  ## `k` also hit, else the untouched `Some(w)`); an off-side descent leaves that subtree and the
  ## guard is `BF` so `gsel` picks the plain lookup (reflexive); a same-side descent is the induction
  ## hypothesis, whose `gsel` the kernel matches up to definitional equality.
  fn lookup_spec(x: GKey, k: GKey, val: Nat, t: GTree) -> Equivalent(GOpt, lookup(x, insert(k, val, t)), gsel(gkeq(x, k), GSome(val), lookup(x, t))) = match t
    GLeaf()            -> match x
      GA() -> match k
        GA() -> reflexive(GSome(val))
        GB() -> reflexive(GNone())
        GC() -> reflexive(GNone())
      GB() -> match k
        GA() -> reflexive(GNone())
        GB() -> reflexive(GSome(val))
        GC() -> reflexive(GNone())
      GC() -> match k
        GA() -> reflexive(GNone())
        GB() -> reflexive(GNone())
        GC() -> reflexive(GSome(val))
    GNode(l, v, w, r)  -> match x
      GA() -> match v
        GA() -> match k
          GA() -> reflexive(GSome(val))
          GB() -> reflexive(GSome(w))
          GC() -> reflexive(GSome(w))
        GB() -> match k
          GA() -> lookup_spec(GA(), GA(), val, l)
          GB() -> reflexive(lookup(GA(), l))
          GC() -> reflexive(lookup(GA(), l))
        GC() -> match k
          GA() -> lookup_spec(GA(), GA(), val, l)
          GB() -> lookup_spec(GA(), GB(), val, l)
          GC() -> reflexive(lookup(GA(), l))
      GB() -> match v
        GA() -> match k
          GA() -> reflexive(lookup(GB(), r))
          GB() -> lookup_spec(GB(), GB(), val, r)
          GC() -> lookup_spec(GB(), GC(), val, r)
        GB() -> match k
          GA() -> reflexive(GSome(w))
          GB() -> reflexive(GSome(val))
          GC() -> reflexive(GSome(w))
        GC() -> match k
          GA() -> lookup_spec(GB(), GA(), val, l)
          GB() -> lookup_spec(GB(), GB(), val, l)
          GC() -> reflexive(lookup(GB(), l))
      GC() -> match v
        GA() -> match k
          GA() -> reflexive(lookup(GC(), r))
          GB() -> lookup_spec(GC(), GB(), val, r)
          GC() -> lookup_spec(GC(), GC(), val, r)
        GB() -> match k
          GA() -> reflexive(lookup(GC(), r))
          GB() -> reflexive(lookup(GC(), r))
          GC() -> lookup_spec(GC(), GC(), val, r)
        GC() -> match k
          GA() -> reflexive(GSome(w))
          GB() -> reflexive(GSome(w))
          GC() -> reflexive(GSome(val))
end
