@group(:concurrency)
mod Std.Otp.GenEvent
  use Std.Equivalent
  ## GEN_EVENT — the event-manager behaviour (a new OTP behaviour, alongside gen_server /
  ## gen_statem / supervisor). An event MANAGER holds a list of installed HANDLERS; `notify(e)`
  ## BROADCASTS the event to every handler, and each handler either processes it (if the event is
  ## in its interface) or ignores it. Handlers are added/removed dynamically.
  ##
  ## The characteristic typed guarantee: a broadcast preserves the handler CONFIGURATION — WHO the
  ## handlers are and WHICH events each handles — while advancing only their internal state. So an
  ## event manager's shape is stable under the event stream: no handler is silently gained or lost
  ## by delivering an event. This is proved two ways: `notify_preserves_count` (the number of
  ## handlers) and `notify_preserves_ifaces` (their exact interface list), plus the Manager type is
  ## indexed by the interface list so `notify : Manager(ifaces) -> Manager(ifaces)` re-certifies it.

  type Event = EvA | EvB | EvC
  type B = F | T
  ## A handler's INTERFACE: which of the three events it processes.
  type EvSet = MkEvSet(B, B, B)
  fn member(e: Event, s: EvSet) -> B = match s
    MkEvSet(a, b, c) -> match e
      EvA() -> a
      EvB() -> b
      EvC() -> c

  ## Per-handler event processing: a handler whose interface contains `e` advances its state
  ## (`S(st)`); otherwise it ignores the event (`st`). Kept as a helper so `notify` below reduces
  ## STRUCTURALLY (the interface-match lives here, not blocking the manager recursion).
  fn step(e: Event, iface: EvSet, st: Nat) -> Nat = match member(e, iface)
    T() -> S(st)
    F() -> st

  ## An interface list types a manager: one `EvSet` per installed handler, in order.
  type IfaceList = INil | ICons(EvSet, IfaceList)
  ## An event manager, INDEXED by its handlers' interface list. `MCons` carries a handler's
  ## interface and its state; the index records the interface so the type tracks the configuration.
  type Manager indices (ifaces: IfaceList)
    MNil  : Manager(INil)
    MCons : (iface: EvSet) -> Nat -> Manager(rest) -> Manager(ICons(iface, rest))

  ## Install a handler at the front — the type records the extended interface list.
  fn add_handler(iface: EvSet, st: Nat, {ifaces: IfaceList}, mgr: Manager(ifaces)) -> Manager(ICons(iface, ifaces)) =
    MCons(iface, st, mgr)

  ## **BROADCAST.** Deliver `e` to every handler. Each keeps its interface and advances state via
  ## `step`; the manager keeps its exact shape — the type `Manager(ifaces) -> Manager(ifaces)`
  ## already certifies the interface list is preserved.
  fn notify(e: Event, {ifaces: IfaceList}, mgr: Manager(ifaces)) -> Manager(ifaces) = match mgr
    MNil()                 -> MNil()
    MCons(iface, st, rest) -> MCons(iface, step(e, iface, st), notify(e, rest))

  fn count({ifaces: IfaceList}, mgr: Manager(ifaces)) -> Nat = match mgr
    MNil()                 -> Z()
    MCons(iface, st, rest) -> S(count(rest))

  fn interfaces({ifaces: IfaceList}, mgr: Manager(ifaces)) -> IfaceList = match mgr
    MNil()                 -> INil()
    MCons(iface, st, rest) -> ICons(iface, interfaces(rest))

  fn snat_cong({a: Nat}, {b: Nat}, e: Equivalent(Nat, a, b)) -> Equivalent(Nat, S(a), S(b)) =
    rewrite e in reflexive(S(b))
  fn icons_cong(iface: EvSet, {a: IfaceList}, {b: IfaceList}, e: Equivalent(IfaceList, a, b)) -> Equivalent(IfaceList, ICons(iface, a), ICons(iface, b)) =
    rewrite e in reflexive(ICons(iface, b))

  ## **BROADCAST PRESERVES HANDLER COUNT.** Delivering an event never gains or loses a handler.
  fn notify_preserves_count(e: Event, {ifaces: IfaceList}, mgr: Manager(ifaces)) -> Equivalent(Nat, count(notify(e, mgr)), count(mgr)) = match mgr
    MNil()                 -> reflexive(Z())
    MCons(iface, st, rest) -> snat_cong(notify_preserves_count(e, rest))

  ## **BROADCAST PRESERVES THE INTERFACE LIST.** Stronger: every handler keeps its exact interface —
  ## the manager's whole configuration is stable under the event stream, only states advance.
  fn notify_preserves_ifaces(e: Event, {ifaces: IfaceList}, mgr: Manager(ifaces)) -> Equivalent(IfaceList, interfaces(notify(e, mgr)), interfaces(mgr)) = match mgr
    MNil()                 -> reflexive(INil())
    MCons(iface, st, rest) -> icons_cong(iface, notify_preserves_ifaces(e, rest))

  ## Uninstall the front handler — the type records the SHRUNK interface list. (Only `MCons` can
  ## have an `ICons` index, so the empty case is impossible and needs no clause.)
  fn remove_head({iface: EvSet}, {rest: IfaceList}, mgr: Manager(ICons(iface, rest))) -> Manager(rest) = match mgr
    MCons(i, st, r) -> r

  ## **INSTALL/REMOVE ARE INVERSE.** Installing a handler and immediately removing it restores the
  ## manager EXACTLY — `remove_head(add_handler(iface, st, mgr)) = mgr`. So dynamic handler
  ## management is well-behaved: a transient handler leaves no trace on the configuration.
  fn add_remove_inverse(iface: EvSet, st: Nat, {ifaces: IfaceList}, mgr: Manager(ifaces)) -> Equivalent(Manager(ifaces), remove_head(add_handler(iface, st, mgr)), mgr) =
    reflexive(mgr)

  ## Installing a handler increments the count; the interface list gains exactly the new entry.
  fn count_after_add(iface: EvSet, st: Nat, {ifaces: IfaceList}, mgr: Manager(ifaces)) -> Equivalent(Nat, count(add_handler(iface, st, mgr)), S(count(mgr))) =
    reflexive(S(count(mgr)))

  ## A POSITION into a (non-empty) interface list: the head (`Here`) or one deeper (`There`). The
  ## skipped interface / tail are carried explicitly so `delete_at` can name them (E2 workaround).
  type Pos indices (ifaces: IfaceList)
    Here  : (iface: EvSet) -> (rest: IfaceList) -> Pos(ICons(iface, rest))
    There : (iface: EvSet) -> Pos(rest) -> Pos(ICons(iface, rest))

  ## The interface list with the handler at `pos` deleted — the type-level effect of removal.
  fn delete_at({ifaces: IfaceList}, pos: Pos(ifaces)) -> IfaceList = match pos
    Here(iface, rest) -> rest
    There(iface, p)   -> ICons(iface, delete_at(p))

  ## **REMOVE A HANDLER AT AN ARBITRARY POSITION.** Uninstall the handler pointed at by `pos`; the
  ## result manager is typed by `delete_at(pos)` — the interface list with exactly that one entry
  ## gone, all others (before and after) preserved in order. A dependently-typed list-deletion: the
  ## `Pos` witness guarantees the position exists, so removal is total and can't drop the wrong
  ## handler. Recurses on the position and the manager together (`match evidence; match data`).
  fn remove_at({ifaces: IfaceList}, mgr: Manager(ifaces), pos: Pos(ifaces)) -> Manager(delete_at(pos)) = match pos
    Here(iface, rest) -> match mgr
      MCons(i, st, r) -> r
    There(iface, p)   -> match mgr
      MCons(i, st, r) -> MCons(i, st, remove_at(r, p))
end
