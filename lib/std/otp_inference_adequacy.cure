@group(:concurrency)
mod Std.Otp.InferenceAdequacy
  ## ADEQUACY of mailbox-type inference — `infer(behaviour)` tied to the OPERATIONAL
  ## metatheory, PROVED for the sequential first-order fragment (build-out map G9).
  ##
  ## This is the theorem the mailbox-types literature has only STATED: the statically
  ## inferred interface is preserved by the operational reduction of the behaviour it was
  ## inferred from, so a process typed by inference never delivers a message it cannot
  ## handle. The mechanized state of the art (Proof of Delivery, Rocq) mechanized the
  ## mailbox-type ALGEBRA but EXPLICITLY DEFERRED the operational preservation theorem;
  ## this module discharges that operational half and ties it to inference — for the
  ## sequential first-order fragment (`BNil`/`BRecv`/`BSend`), with no holes.
  ##
  ## Three parts, each with a matching shape (2026-07-17-adequacy-shape.md):
  ##   * `WTat(c, I)` = `config ⊨ interface` (Proof of Delivery's config⊨pattern relation,
  ##     tag-set fragment);
  ##   * `preservation_at` = subject reduction at the inferred interface (PLFA `preserve`;
  ##     `Std.Otp.Preservation` generalized from a fixed accepted-set to `infer(b)`);
  ##   * `coverage` + `adequacy` = the fundamental-theorem bridge (Actris's `ltyped`): a
  ##     behaviour's sends are covered by `infer(b)`, and every reachable config is
  ##     therefore well-typed at `infer(b)`.
  ##
  ## **Honest scope.** Sequential behaviours only. BRANCHING (`BSeq`) needs
  ## `append`-membership of the inferred interface, whose left operand `infer(l)` is an
  ## erased existential index — Cure rejects using it relevantly (`:erased_used_relevantly`);
  ## that case stays in the `inference_adequacy.cure` scaffold. RECURSION (`BRec`) needs the
  ## frontier `lfp` (also scaffolded). This is the first-order, sequential core proved end
  ## to end: inference → operational safety.

  type Tag = TA | TB | TC
  type TagList = TNil | TCons(Tag, TagList)

  ## Membership and `AllMember` — the `config ⊨ interface` relation (tag-set fragment).
  type Member indices (t: Tag, iface: TagList)
    MemHere  : Member(t, TCons(t, rest))
    MemThere : Member(t, rest) -> Member(t, TCons(y, rest))
  type AllMember indices (ts: TagList, iface: TagList)
    AMNil  : AllMember(TNil, iface)
    AMCons : Member(t, iface) -> AllMember(rest, iface) -> AllMember(TCons(t, rest), iface)

  type Config = MkConfig(TagList, TagList)
  ## `WTat(c, I)`: config `c` is well-typed at interface `I` (every message a member of `I`).
  type WTat indices (c: Config, iface: TagList)
    MkWTat : AllMember(e, iface) -> AllMember(m, iface) -> WTat(MkConfig(e, m), iface)

  ## The reduction typed at interface `I`: a send may only send an `I`-message.
  type StepAt indices (i: TagList, before: Config, after: Config)
    SSendAt   : Member(t, i) -> StepAt(i, MkConfig(e, m), MkConfig(TCons(t, e), m))
    SArriveAt : StepAt(i, MkConfig(TCons(t, e), m), MkConfig(e, TCons(t, m)))
    SRecvAt   : StepAt(i, MkConfig(e, TCons(t, m)), MkConfig(e, m))

  ## **PRESERVATION AT THE INFERRED INTERFACE.** A typed step preserves `config ⊨ I` —
  ## `Std.Otp.Preservation` generalized to an arbitrary interface. The operational half
  ## that Proof of Delivery deferred.
  fn preservation_at({i: TagList}, {b: Config}, {a: Config}, wt: WTat(b, i), s: StepAt(i, b, a)) -> WTat(a, i) = match s
    SSendAt(mem) -> match wt
      MkWTat(ae, am) -> MkWTat(AMCons(mem, ae), am)
    SArriveAt() -> match wt
      MkWTat(ae, am) -> match ae
        AMCons(at, ae2) -> MkWTat(ae2, AMCons(at, am))
    SRecvAt() -> match wt
      MkWTat(ae, am) -> match am
        AMCons(rat, am2) -> MkWTat(ae, am2)

  ## A sequential process BEHAVIOUR and its inferred interface (the constant-fold fragment).
  type Behaviour = BNil | BRecv(Tag, Behaviour) | BSend(Tag, Behaviour)
  fn infer(b: Behaviour) -> TagList = match b
    BNil()      -> TNil
    BRecv(t, k) -> TCons(t, infer(k))
    BSend(t, k) -> TCons(t, infer(k))

  ## `SendsIn(b, t)` — behaviour `b` has a send site for tag `t`.
  type SendsIn indices (b: Behaviour, t: Tag)
    SendHere  : SendsIn(BSend(t, k), t)
    SendRecvK : SendsIn(k, t) -> SendsIn(BRecv(y, k), t)
    SendSendK : SendsIn(k, t) -> SendsIn(BSend(y, k), t)

  ## **COVERAGE.** Every tag `b` sends is in `infer(b)` — the constraint generator's
  ## soundness, by induction on the send site.
  fn coverage({b: Behaviour}, {t: Tag}, sends: SendsIn(b, t)) -> Member(t, infer(b)) = match sends
    SendHere()    -> MemHere()
    SendRecvK(s2) -> MemThere(coverage(s2))
    SendSendK(s2) -> MemThere(coverage(s2))

  ## `Runs(b, c)` — config `c` is reachable by executing `b` (steps typed at `infer(b)`,
  ## which `coverage` justifies for `b`'s sends).
  type Runs indices (b: Behaviour, c: Config)
    RStart : Runs(b, MkConfig(TNil, TNil))
    RStep  : Runs(b, before) -> StepAt(infer(b), before, after) -> Runs(b, after)

  ## **ADEQUACY.** Every config reachable by running `b` is well-typed at `infer(b)`. By
  ## induction on the run: the empty config is trivially typed; each step preserves typing
  ## at `infer(b)` via `preservation_at`. The inferred type is operationally safe.
  fn adequacy(b: Behaviour, {c: Config}, run: Runs(b, c)) -> WTat(c, infer(b)) = match run
    RStart()          -> MkWTat(AMNil(), AMNil())
    RStep(prev, step) -> preservation_at(adequacy(b, prev), step)
end
