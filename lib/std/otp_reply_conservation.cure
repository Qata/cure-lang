@group(:concurrency)
mod Std.Otp.ReplyConservation
  use Std.Nat
  use Std.Proof

  ## The LINEAR reply capability's *consumed-exactly-once*, as an OPERATIONAL
  ## conservation law over the reduction — the last piece of obligation (1).
  ##
  ## `Std.Otp.Proof` proves the exactly-once discipline INTRINSICALLY (a reply
  ## capability has QTT grade 1, so a single handler consumes it on every path,
  ## never dropping or duplicating). This module states the DUAL, operational fact:
  ## over a *run* of the reduction, the reply capabilities are a CONSERVED resource —
  ## each outstanding capability is consumed to produce exactly one reply, so no
  ## capability is lost, none is answered twice, and a completed run answers exactly
  ## as many replies as it began with capabilities.
  ##
  ## **The model.** A configuration `MkConfig(pending, answered)` counts the
  ## outstanding reply capabilities and the replies already sent. The only reduction
  ## step, `LAnswer`, answers ONE outstanding capability:
  ##   * it REQUIRES `S(p)` pending — you cannot answer without holding a capability
  ##     (no reply without the linear right; the `no_answer_without_cap` absurdity);
  ##   * it CONSUMES that capability (`pending : S(p) → p`) and produces exactly one
  ##     reply (`answered : a → S(a)`) — used once, gone, never reusable.
  ##
  ## **Single-step conservation.** `total(c) = pending(c) + answered(c)` is invariant
  ## across a step: `plus(S(p), a) ≡ plus(p, S(a))`, proved with `Std.Proof.plus_succ_right`.
  ##
  ## **Run conservation (`total_invariant`).** By induction over the reflexive-transitive
  ## closure `LStar`, the total is invariant across a whole run.
  ##
  ## **Exactly-once (`drain`).** A COMPLETE run — from `MkConfig(n, Z)` (n capabilities
  ## outstanding, nothing answered) to `MkConfig(Z, m)` (all consumed, m answered) —
  ## forces `n ≡ m`: every capability produced exactly one reply, none lost, none
  ## duplicated. This is the operational statement of the linear reply discipline.
  ##
  ## Counts abstract the reply VALUES; their per-request typing is
  ## `Std.Otp.ReplyPreservation`. All lemmas reuse `Std.Nat`/`Std.Proof` cross-module.

  ## Propositional-equality transitivity (`x ≡ y → y ≡ z → x ≡ z`), by rewriting.
  fn trans({t: Type}, {x: t}, {y: t}, {z: t}, e1: Equivalent(t, x, y), e2: Equivalent(t, y, z)) -> Equivalent(t, x, z) =
    rewrite e1 in e2

  ## A ledger: `pending` outstanding reply-capabilities, `answered` replies sent.
  type Config = MkConfig(Nat, Nat)

  ## The reduction: answer one outstanding capability. Requires `S(p)` pending (no
  ## reply without a capability), consumes it, emits one reply. The step CARRIES the
  ## counts it acted on, so a `match` over a run recovers them.
  type LStep indices (before: Config, after: Config)
    LAnswer : (p: Nat) -> (a: Nat) -> LStep(MkConfig(S(p), a), MkConfig(p, S(a)))

  ## The conserved measure: capabilities still owed plus replies already made.
  fn total(c: Config) -> Nat = match c
    MkConfig(p, a) -> plus(p, a)

  ## **SINGLE-STEP CONSERVATION.** A step preserves the total: `plus(S(p), a) ≡
  ## plus(p, S(a))`. `plus(S(p), a)` reduces to `S(plus(p, a))`; `plus_succ_right(p, a)`
  ## rewrites `plus(p, S(a))` to `S(plus(p, a))`, closing by reflexivity. No capability
  ## is created or destroyed by answering — only moved into a reply.
  fn step_conserves(p: Nat, a: Nat, s: LStep(MkConfig(S(p), a), MkConfig(p, S(a)))) -> Equivalent(Nat, total(MkConfig(S(p), a)), total(MkConfig(p, S(a)))) =
    rewrite plus_succ_right(p, a) in reflexive(S(plus(p, a)))

  ## Runs: the reflexive-transitive closure of `LStep`.
  type LStar indices (before: Config, after: Config)
    LDone : LStar(c, c)
    LThen : LStep(x, y) -> LStar(y, z) -> LStar(x, z)

  ## **RUN CONSERVATION.** The total is invariant across a whole run. Induction on the
  ## closure: `LDone` is reflexive; `LThen` composes this step's conservation
  ## (`step_conserves`) with the tail's (`total_invariant`) by transitivity.
  fn total_invariant({b: Config}, {a2: Config}, r: LStar(b, a2)) -> Equivalent(Nat, total(b), total(a2)) = match r
    LDone() -> reflexive(total(b))
    LThen(st, rest) -> match st
      LAnswer(p, a) -> trans(step_conserves(p, a, st), total_invariant(rest))

  ## **EXACTLY-ONCE.** A complete run drains all `n` outstanding capabilities to `m`
  ## replies with `n ≡ m` — every capability answered exactly once. `total_invariant`
  ## gives `plus(n, Z) ≡ plus(Z, m)`; `plus(Z, m)` reduces to `m`, and
  ## `plus_zero_right(n)` rewrites `plus(n, Z)` to `n`, leaving `n ≡ m`.
  fn drain(n: Nat, m: Nat, r: LStar(MkConfig(n, Z), MkConfig(Z, m))) -> Equivalent(Nat, n, m) =
    rewrite plus_zero_right(n) in total_invariant(r)

  ## Non-vacuity: answering the sole capability of `MkConfig(S(Z), Z)`.
  fn a_step() -> LStep(MkConfig(S(Z), Z), MkConfig(Z, S(Z))) = LAnswer(Z, Z)

  ## **Linearity guard.** No step can originate from a zero-pending configuration:
  ## a reply is impossible without a capability. `LAnswer` demands `S(p)`, which
  ## cannot unify with the `Z` pending count, so the match is absurd (zero branches).
  type Void = |
  fn no_answer_without_cap({a: Nat}, {after: Config}, s: LStep(MkConfig(Z, a), after)) -> Void = match s
end
