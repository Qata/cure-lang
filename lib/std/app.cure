@group(:system)
mod Std.App
  use Std.Syntax
  use Std.ActorBehavior

  ## The structured application surface is source-defined.
  macro app <name: ModuleName>
    syntax family ApplicationDefinition
      root ModuleName
    accepts ApplicationDefinition
    expands with derive_application_family

  fn derive_application_family(name: ModuleNameSyntax, definition: ApplicationDefinitionSyntax) -> Syntax =
    let name_syntax: Syntax = name
    let module_name: SynLit = match name_syntax
      Leaf(_, _, SAtom(value)) -> SAtom(value)
      _ -> SStr("Cure.Generated.Application")
    let start_type = call("Effect", [variable("Tuple")])
    let stop_type = call("Effect", [variable("Atom")])
    let start_body = call("Std.Otp.start_supervisor", [definition.root])
    Std.ActorBehavior.application_module(module_name, [
      use_module("Std.Supervisor"),
      function("start", [parameter("kind", variable("t")), parameter("args", variable("a"))], start_type, start_body),
      function("stop", [parameter("state", variable("s"))], stop_type, quote :ok),
      function("start_phase", [parameter("phase", variable("Atom")), parameter("kind", variable("t")), parameter("args", variable("a"))], stop_type, quote :ok)
    ])
