@group(:text)
mod Std.Json
  use Std.String
  use Std.Result
  ## JSON encoder and decoder for Cure (v0.23.0).
  ##
  ## Runtime companion to the v0.21.0 `@derive(JSON)` extension. The
  ## decoder returns a `Std.Json.Value` ADT; encoders walk the ADT
  ## back out to a JSON string.
  ##
  ## ## Examples
  ##
  ## ```cure
  ## use Std.Json
  ##
  ## match decode("{\"x\": 1}")
  ##   Ok(v)    -> encode(v)                 # => "{\"x\":1}"
  ##   Error(_) -> ""
  ## ```
  ##
  ## ```cure
  ## use Std.Json
  ##
  ## let body = Obj([pair("status", Str("ok")), pair("count", num_of_int(3))])
  ## encode(body)                            # => {"status":"ok","count":3}
  ## ```

  ## Group tag consumed by `Cure.Stdlib.Preload`.
  ## Key/value pair inside a JSON object. Named rather than using a
  ## raw tuple type so the ADT surface stays simple.
  rec JsonPair
    key: String
    value: Value

  ## Tag-union representation for any parsed JSON document.
  ##
  ## - `Null`        <-> JSON `null`
  ## - `Bool(b)`     <-> JSON `true` / `false`
  ## - `Num(n)`      <-> JSON number (always a `Float` at runtime)
  ## - `Str(s)`      <-> JSON string
  ## - `Arr(xs)`     <-> JSON array
  ## - `Obj(kvs)`    <-> JSON object (ordered list of `JsonPair`)
  type Value =
    | Null
    | Bool(Bool)
    | Num(Float)
    | Str(String)
    | Arr(List(Value))
    | Obj(List(JsonPair))

  ## Values that have a canonical JSON representation. Record derivation
  ## publishes an ordinary implementation of this interface, so `to_json/1`
  ## resolves through the same dictionary machinery as authored code.
  interface JSON(t)
    fn to_json(value: t) -> String

  ## Encode a `Value` as a JSON string.
  @extern(:cure_std_json, :encode, 1)
  fn encode(v: Value) -> String

  ## Decode a JSON string into a `Value`. Returns `Error(msg)` on
  ## malformed input.
  @extern(:cure_std_json, :decode, 1)
  fn decode(src: String) -> Result(Value, String)

  # -- Construction helpers ----------------------------------------------------

  ## Widen a Cure `Int` to a JSON number `Value` via the integer path.
  @extern(:cure_std_json, :num_of_int, 1)
  fn num_of_int(n: Int) -> Value

  implementation JSON for Int
    fn to_json(value: Int) -> String = encode(num_of_int(value))

  implementation JSON for Float
    fn to_json(value: Float) -> String = encode(Num(value))

  implementation JSON for String
    fn to_json(value: String) -> String = encode(Str(value))

  implementation JSON for Bool
    fn to_json(value: Bool) -> String = encode(Bool(value))

  ## Build a `JsonPair` for use inside `Obj(...)`.
  fn pair(k: String, v: Value) -> JsonPair = JsonPair{key: k, value: v}
