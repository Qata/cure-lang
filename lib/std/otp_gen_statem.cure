@group(:concurrency)
mod Std.Otp.GenStatem
  use Std.Equivalent
  ## gen_statem EVENT POSTPONING (build-out map B8) — deferring an event never loses it.
  ##
  ## `gen_statem`'s defining feature over `gen_server` is `postpone`: a state handler may DEFER
  ## an event, and every postponed event is REDELIVERED after the next state change. The safety
  ## question this raises — and the one no paper types — is that postponing/redelivering never
  ## DROPS an event: the only way an event leaves the system is by being HANDLED.
  ##
  ## We model a machine's event bookkeeping as `MkSC(pending, postponed)` (both counts), and the
  ## three moves as an `SStep` relation: HANDLE consumes one pending event, POSTPONE moves one
  ## pending → postponed, REDELIVER (on state change) moves ALL postponed back to pending.
  ## `step_measure` proves the invariant: every step either CONSERVES the unprocessed count
  ## `pending + postponed` (postpone and redeliver — no event lost, just relocated) or PROGRESSES
  ## it down by exactly one (handle). So a `gen_statem` makes progress only by handling events,
  ## and postponing is never a leak. (Nat arithmetic proved here by the standard induction.)

  fn plus(m: Nat, n: Nat) -> Nat = match m
    Z()  -> n
    S(k) -> S(plus(k, n))
  fn plus_n_z(n: Nat) -> Equivalent(Nat, plus(n, Z()), n) = match n
    Z()  -> reflexive(Z())
    S(k) -> rewrite plus_n_z(k) in reflexive(S(k))
  fn plus_n_s(m: Nat, n: Nat) -> Equivalent(Nat, plus(m, S(n)), S(plus(m, n))) = match m
    Z()  -> reflexive(S(n))
    S(k) -> rewrite plus_n_s(k, n) in reflexive(S(S(plus(k, n))))
  fn plus_comm(m: Nat, n: Nat) -> Equivalent(Nat, plus(m, n), plus(n, m)) = match m
    Z()  -> rewrite plus_n_z(n) in reflexive(n)
    S(k) -> rewrite plus_n_s(n, k) in rewrite plus_comm(k, n) in reflexive(S(plus(n, k)))

  ## A machine's event bookkeeping: (events pending delivery, events postponed).
  type SConfig = MkSC(Nat, Nat)
  fn unproc(c: SConfig) -> Nat = match c
    MkSC(p, q) -> plus(p, q)

  ## The three event moves, as transitions on the bookkeeping config: HANDLE consumes one
  ## pending event, POSTPONE relocates one pending → postponed, REDELIVER (on state change)
  ## returns ALL postponed to pending.
  type SStep indices (before: SConfig, after: SConfig)
    SHandle    : SStep(MkSC(S(p), q), MkSC(p, q))
    SPostpone  : SStep(MkSC(S(p), q), MkSC(p, S(q)))
    SRedeliver : SStep(MkSC(p, q), MkSC(plus(q, p), Z))

  ## **POSTPONE SAFETY**, as the per-move conservation facts on the unprocessed count
  ## `pending + postponed`. HANDLE is the only move that makes progress (one fewer unprocessed
  ## event); POSTPONE and REDELIVER conserve the count exactly — a deferred event is relocated,
  ## never lost. So a `gen_statem` advances only by handling, and postponing cannot leak events.
  fn handle_progresses(p: Nat, q: Nat) -> Equivalent(Nat, unproc(MkSC(S(p), q)), S(unproc(MkSC(p, q)))) =
    reflexive(S(plus(p, q)))
  fn postpone_conserves(p: Nat, q: Nat) -> Equivalent(Nat, unproc(MkSC(S(p), q)), unproc(MkSC(p, S(q)))) =
    rewrite plus_n_s(p, q) in reflexive(S(plus(p, q)))
  fn redeliver_conserves(p: Nat, q: Nat) -> Equivalent(Nat, unproc(MkSC(p, q)), unproc(MkSC(plus(q, p), Z()))) =
    rewrite plus_n_z(plus(q, p)) in plus_comm(p, q)

  fn plus_assoc(a: Nat, b: Nat, c: Nat) -> Equivalent(Nat, plus(plus(a, b), c), plus(a, plus(b, c))) = match a
    Z()  -> reflexive(plus(b, c))
    S(k) -> rewrite plus_assoc(k, b, c) in reflexive(S(plus(k, plus(b, c))))
  fn plus_cong_r(a: Nat, {x: Nat}, {y: Nat}, e: Equivalent(Nat, x, y)) -> Equivalent(Nat, plus(a, x), plus(a, y)) =
    rewrite e in reflexive(plus(a, y))

  ## A RUN of event moves — the reflexive-transitive closure of `SStep`. A `gen_statem`'s whole
  ## trajectory is a chain of HANDLE / POSTPONE / REDELIVER moves.
  type SRun indices (before: SConfig, after: SConfig)
    SRDone : SRun(c, c)
    SRMore : SStep(c1, c2) -> SRun(c2, c3) -> SRun(c1, c3)

  ## How many events a move / a whole run HANDLES — the only move that is an event sink.
  fn step_handles({b: SConfig}, {a: SConfig}, s: SStep(b, a)) -> Nat = match s
    SHandle()    -> S(Z())
    SPostpone()  -> Z()
    SRedeliver() -> Z()
  fn handle_count({c1: SConfig}, {c2: SConfig}, run: SRun(c1, c2)) -> Nat = match run
    SRDone()        -> Z()
    SRMore(s, rest) -> plus(step_handles(s), handle_count(rest))

  ## Reachability is a PREORDER: a single move is a run, and runs COMPOSE (transitivity) — a
  ## `gen_statem` trajectory can be concatenated end to end.
  fn srun_single({c1: SConfig}, {c2: SConfig}, s: SStep(c1, c2)) -> SRun(c1, c2) =
    SRMore(s, SRDone())
  fn srun_trans({c1: SConfig}, {c2: SConfig}, {c3: SConfig}, r1: SRun(c1, c2), r2: SRun(c2, c3)) -> SRun(c1, c3) = match r1
    SRDone()        -> r2
    SRMore(s, rest) -> SRMore(s, srun_trans(rest, r2))

  ## **HANDLED-EVENT COUNT IS A MONOID HOMOMORPHISM.** `handle_count(srun_trans(r1, r2)) =
  ## handle_count(r1) + handle_count(r2)` — the events handled by concatenating two trajectories is
  ## the sum of what each handles. So counting handled events distributes over run composition
  ## (`SRun` composition ↦ `Nat` addition, mapping `SRDone ↦ 0`). By induction on `r1`: the empty
  ## run contributes `0`, and each leading move's handle-count factors out via `plus_assoc`.
  fn handle_count_trans({c1: SConfig}, {c2: SConfig}, {c3: SConfig}, r1: SRun(c1, c2), r2: SRun(c2, c3)) -> Equivalent(Nat, handle_count(srun_trans(r1, r2)), plus(handle_count(r1), handle_count(r2))) = match r1
    SRDone()        -> reflexive(handle_count(r2))
    SRMore(s, rest) -> trans(plus_cong_r(step_handles(s), handle_count_trans(rest, r2)), sym(plus_assoc(step_handles(s), handle_count(rest), handle_count(r2))))
end
