@group(:core)
@prelude
mod Std.Bounded
  ## Bounded natural indices.
  ##
  ## `Bounded(n)` is inhabited by values strictly less than `n`. It is the
  ## stdlib replacement for the traditional `Fin(n)` name and is used for
  ## length-safe indexing into `Std.Vector`.

  use Std.Nat

  @builtin(:bounded)
  type Bounded indices (n: Nat)
    First : Bounded(S(m))
    Next : Bounded(m) -> Bounded(S(m))

  ## Preserve a bounded value while extending its upper bound on the right.
  ## The recursion follows the value itself, so no unchecked conversion from
  ## `Nat` is involved.
  @reducible
  fn widen({n: Nat}, {extra: Nat}, value: Bounded(n)) -> Bounded(plus(n, extra)) = match value
    First() -> First()
    Next(previous) -> Next(widen(previous))

  ## Embed the left side of a disjoint `n + m` state space.
  @reducible
  fn inject_left({n: Nat}, {m: Nat}, value: Bounded(n)) -> Bounded(plus(n, m)) =
    widen(value)

  ## Embed the right side of a disjoint `n + m` state space. Each constructor
  ## in the left bound shifts the right value once, making the two images
  ## disjoint by construction.
  @reducible
  fn inject_right(n: Nat, {m: Nat}, value: Bounded(m)) -> Bounded(plus(n, m)) = match n
    Z() -> value
    S(previous) -> Next(inject_right(previous, value))

  ## Structural view of a value in a disjoint `n + m` state space. This is the
  ## elimination counterpart to `inject_left`/`inject_right`: callers learn
  ## which side owns the value and recover a value with that side's exact bound,
  ## without converting through an unchecked Nat.
  type BoundedSum indices (left: Nat, right: Nat)
    BoundedLeft : Bounded(left) -> BoundedSum(left, right)
    BoundedRight : Bounded(right) -> BoundedSum(left, right)

  @reducible
  fn split_sum(left: Nat, {right: Nat}, value: Bounded(plus(left, right))) -> BoundedSum(left, right) = match left
    Z() -> BoundedRight(value)
    S(previous) -> match value
      First() -> BoundedLeft(First())
      Next(rest) -> match split_sum(previous, rest)
        BoundedLeft(left_value) -> BoundedLeft(Next(left_value))
        BoundedRight(right_value) -> BoundedRight(right_value)

  @reducible
  fn fold_sum({left: Nat}, {right: Nat}, {a: Type}, side: BoundedSum(left, right), on_left: (Bounded(left)) -> a, on_right: (Bounded(right)) -> a) -> a = match side
    BoundedLeft(value) -> on_left(value)
    BoundedRight(value) -> on_right(value)
