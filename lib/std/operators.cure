@group(:core)
mod Std.Operators

# Declaration-driven successor to the static `Cure.Compiler.Parser.Precedence`
# table. Every built-in operator is declared here with the SAME relative binding
# power and associativity the legacy table gives it (precedence.ex:42-96), so a
# later Phase-3 task can flip the Pratt loop onto the assembled `FixityTable`
# without changing how any expression parses.
#
# Binding power rises with each `higher_than` link. Legacy binding powers, low
# to high (the numbers are illustrative; only the ORDER is significant):
#
#   5  = += -= *= /=   right   (builtin)
#   8  <-|             none    (builtin)   -- Melquiades send
#   10 |>              left    (builtin)
#   20 or              left
#   30 and             left
#   40 == != < > <= >= none
#   50 .. ..=          none    (builtin)
#   60 <>              right
#   70 + -   bor bxor bsl bsr   left
#   80 * / %   band            left
#   90 prefix - not bnot
#   100 .              left    (builtin)
#
# Operators marked `builtin` are fixed syntactic operators user code may not
# rebind (`.`, `|>`, `<-|`, `=`, augmented assigns, ranges).

precedencegroup Assignment
  associativity: right
precedencegroup Melquiades
  associativity: none
  higher_than: Assignment
precedencegroup Pipe
  associativity: left
  higher_than: Melquiades
precedencegroup LogicalOr
  associativity: left
  higher_than: Pipe
precedencegroup LogicalAnd
  associativity: left
  higher_than: LogicalOr
precedencegroup Comparison
  associativity: none
  higher_than: LogicalAnd
precedencegroup Range
  associativity: none
  higher_than: Comparison
precedencegroup Concat
  associativity: right
  higher_than: Range
precedencegroup Additive
  associativity: left
  higher_than: Concat
precedencegroup Multiplicative
  associativity: left
  higher_than: Additive
# Prefix operators are unary and do not chain associatively; the legacy table
# marks none of them non-associative, so this group is deliberately NOT `none`
# (that would spuriously flag infix `-`, which shares the `-` lexeme).
precedencegroup Prefix
  associativity: left
  higher_than: Multiplicative
precedencegroup Dot
  associativity: left
  higher_than: Prefix

# Assignment (BP 5, right, builtin)
builtin infix `=`  : Assignment
builtin infix `+=` : Assignment
builtin infix `-=` : Assignment
builtin infix `*=` : Assignment
builtin infix `/=` : Assignment

# Melquiades send (BP 8, none, builtin)
builtin infix `<-|` : Melquiades

# Pipe (BP 10, left, builtin)
builtin infix `|>` : Pipe

# Logical or / and (BP 20 / 30, left)
infix or  : LogicalOr
infix and : LogicalAnd

# Comparison (BP 40, none)
infix `==` : Comparison
infix `!=` : Comparison
infix `<`  : Comparison
infix `>`  : Comparison
infix `<=` : Comparison
infix `>=` : Comparison

# Range (BP 50, none, builtin)
builtin infix `..`  : Range
builtin infix `..=` : Range

# String concat (BP 60, right)
infix `<>` : Concat

# Additive (BP 70, left) -- arithmetic + Erlang-precedence bitwise
infix `+`  : Additive
infix `-`  : Additive
infix bor  : Additive
infix bxor : Additive
infix bsl  : Additive
infix bsr  : Additive

# Multiplicative (BP 80, left) -- arithmetic + Erlang-precedence `band`
infix `*`  : Multiplicative
infix `/`  : Multiplicative
infix `%`  : Multiplicative
infix band : Multiplicative

# Prefix (BP 90) -- negation, logical not, bitwise not
prefix `-`  : Prefix
prefix not  : Prefix
prefix bnot : Prefix

# Dot access (BP 100, left, builtin)
builtin infix `.` : Dot
