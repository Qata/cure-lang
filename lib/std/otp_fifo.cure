@group(:concurrency)
mod Std.Otp.Fifo
  ## FIFO-FAITHFUL mailbox ordering — discharging the "mailbox order abstracted" caveat
  ## carried by `Std.Otp.Preservation`/`Safety`/`System`/`Routing`.
  ##
  ## Those modules deliver `NARRIVE` by PREPENDING the message to the mailbox — sound
  ## (message-type safety is order-independent) but not order-faithful. Erlang's mailbox
  ## is a FIFO queue: `NARRIVE` appends to the END, and `receive` scans from the FRONT
  ## (oldest first). This module makes delivery FIFO-faithful and re-proves preservation,
  ## which needs exactly the one lemma those modules said it would: **appending an
  ## accepted message to an all-accepted mailbox keeps it all-accepted**
  ## (`all_accepted_snoc`, the `AllAccepted`-over-append lemma).
  ##
  ## So the order abstraction was indeed just an abstraction: FIFO delivery changes
  ## nothing about safety, and the proof obligation it introduces is discharged here once
  ## and for all.
  ##
  ## **Honest scope.** Single receiver (as `Std.Otp.Preservation`); this isolates the
  ## FIFO append + its snoc lemma. Ordered selective receive (scanning past the front) is
  ## `Std.Otp.SelectiveReceive`.

  type Tag = TInc | TDec | TQuery
  type TagList = TNil | TCons(Tag, TagList)

  type Accepted indices (t: Tag)
    AccInc   : Accepted(TInc)
    AccQuery : Accepted(TQuery)

  type AllAccepted indices (ts: TagList)
    AANil  : AllAccepted(TNil)
    AACons : Accepted(t) -> AllAccepted(rest) -> AllAccepted(TCons(t, rest))

  ## Append to the END of a list (snoc), so the mailbox is genuinely FIFO.
  fn snoc(ts: TagList, t: Tag) -> TagList = match ts
    TNil()         -> TCons(t, TNil)
    TCons(h, rest) -> TCons(h, snoc(rest, t))

  ## **THE SNOC LEMMA.** Appending an accepted tag to an all-accepted list stays
  ## all-accepted — the `AllAccepted`-over-append lemma the order-abstracted modules
  ## deferred. Induction on the list.
  fn all_accepted_snoc({ts: TagList}, {t: Tag}, all: AllAccepted(ts), acc: Accepted(t)) -> AllAccepted(snoc(ts, t)) = match all
    AANil()           -> AACons(acc, AANil)
    AACons(ah, arest) -> AACons(ah, all_accepted_snoc(arest, acc))

  type Config = MkConfig(TagList, TagList)
  type WT indices (c: Config)
    MkWT : AllAccepted(e) -> AllAccepted(m) -> WT(MkConfig(e, m))

  ## FIFO reduction: `SArrive` (NARRIVE) appends the delivered message to the END of the
  ## mailbox (arrival order preserved); `SRecv` (RECEIVE) consumes from the FRONT (oldest
  ## first). `SSend` puts an accepted tag in the ether.
  type Step indices (before: Config, after: Config)
    SSend   : Accepted(t) -> Step(MkConfig(e, m), MkConfig(TCons(t, e), m))
    SArrive : Step(MkConfig(TCons(t, e), m), MkConfig(e, snoc(m, t)))
    SRecv   : Step(MkConfig(e, TCons(t, m)), MkConfig(e, m))

  ## **PRESERVATION over the FIFO reduction.** `SArrive` now uses the snoc lemma to keep
  ## the mailbox all-accepted after appending to its end; the rest is as in
  ## `Std.Otp.Preservation`. FIFO order changes nothing about message-type safety.
  fn preservation({b: Config}, {a: Config}, wt: WT(b), s: Step(b, a)) -> WT(a) = match s
    SSend(acc) -> match wt
      MkWT(ae, am) -> MkWT(AACons(acc, ae), am)
    SArrive() -> match wt
      MkWT(ae, am) -> match ae
        AACons(at, ae2) -> MkWT(ae2, all_accepted_snoc(am, at))
    SRecv() -> match wt
      MkWT(ae, am) -> match am
        AACons(rat, am2) -> MkWT(ae, am2)
end
