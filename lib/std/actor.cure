@group(:concurrency)
mod Std.Actor
  use Std.Syntax
  use Std.List

  ## `actor` is a transparent standard-library macro. The base actor is an
  ## ordinary lifted GenServer module; message-code derivation and user
  ## handlers are layered on top of this floor.
  macro ActorContainers
    syntax actor <name: ModuleName> state <state_type: Type> derive <cast_body: Code until call> (call <call_body: Code>)? contextual computed by derive_actor

    syntax actor <name: ModuleName> state <state_type: Type> call <request_type: Type> returns <reply_type: Type> <call_body: delayed raw until dedent> contextual becomes lift module name
      use Std.Otp
      behaviour gen_server
      typealias State = state_type
      callback init(initial: State) returns Effect(Tuple(Atom, State)) = %[:ok, initial]
      callback handle_call(request: request_type, from: f, state: State) returns Effect(Tuple(Atom, reply_type, State)) = call_body
      callback handle_cast(message: m, state: State) returns Effect(Tuple(Atom, State)) = %[:noreply, state]
      callback handle_info(message: i, state: State) returns Effect(Tuple(Atom, State)) = %[:noreply, state]
      callback terminate(reason: e, state: State) returns Effect(Atom) = :ok
      callback code_change(old: v, state: State, extra: x) returns Effect(Tuple(Atom, State)) = %[:ok, state]
      fn start_link(initial: State) -> Effect(Tuple) = beam_ops start_link name initial

    syntax actor <name: ModuleName> state <state_type: Type> init <init_body: delayed raw until dedent> contextual becomes lift module name
      use Std.Otp
      behaviour gen_server
      typealias State = state_type
      callback init(initial: State) returns Effect(Tuple(Atom, State)) = init_body
      callback handle_call(request: r, from: f, state: State) returns Effect(Tuple(Atom, Atom, State)) = %[:reply, :ok, state]
      callback handle_cast(message: m, state: State) returns Effect(Tuple(Atom, State)) = %[:noreply, state]
      callback handle_info(message: i, state: State) returns Effect(Tuple(Atom, State)) = %[:noreply, state]
      callback terminate(reason: e, state: State) returns Effect(Atom) = :ok
      callback code_change(old: v, state: State, extra: x) returns Effect(Tuple(Atom, State)) = %[:ok, state]
      fn start_link(initial: State) -> Effect(Tuple) = beam_ops start_link name initial

    syntax actor <name: ModuleName> state <state_type: Type> terminate <terminate_body: delayed raw until dedent> contextual becomes lift module name
      use Std.Otp
      behaviour gen_server
      typealias State = state_type
      callback init(initial: State) returns Effect(Tuple(Atom, State)) = %[:ok, initial]
      callback handle_call(request: r, from: f, state: State) returns Effect(Tuple(Atom, Atom, State)) = %[:reply, :ok, state]
      callback handle_cast(message: m, state: State) returns Effect(Tuple(Atom, State)) = %[:noreply, state]
      callback handle_info(message: i, state: State) returns Effect(Tuple(Atom, State)) = %[:noreply, state]
      callback terminate(reason: e, state: State) returns Effect(Atom) = terminate_body
      callback code_change(old: v, state: State, extra: x) returns Effect(Tuple(Atom, State)) = %[:ok, state]
      fn start_link(initial: State) -> Effect(Tuple) = beam_ops start_link name initial

    syntax actor <name: ModuleName> state <state_type: Type> code_change <code_change_body: delayed raw until dedent> contextual becomes lift module name
      use Std.Otp
      behaviour gen_server
      typealias State = state_type
      callback init(initial: State) returns Effect(Tuple(Atom, State)) = %[:ok, initial]
      callback handle_call(request: r, from: f, state: State) returns Effect(Tuple(Atom, Atom, State)) = %[:reply, :ok, state]
      callback handle_cast(message: m, state: State) returns Effect(Tuple(Atom, State)) = %[:noreply, state]
      callback handle_info(message: i, state: State) returns Effect(Tuple(Atom, State)) = %[:noreply, state]
      callback terminate(reason: e, state: State) returns Effect(Atom) = :ok
      callback code_change(old: v, state: State, extra: x) returns Effect(Tuple(Atom, State)) = code_change_body
      fn start_link(initial: State) -> Effect(Tuple) = beam_ops start_link name initial

    syntax actor <name: ModuleName> state <state_type: Type> messages <message_type: Type> handle_cast <cast_body: delayed raw until dedent> contextual becomes lift module name
      use Std.Otp
      behaviour gen_server
      typealias State = state_type
      typealias Message = message_type
      callback init(initial: State) returns Effect(Tuple(Atom, State)) = %[:ok, initial]
      callback handle_call(request: r, from: f, state: State) returns Effect(Tuple(Atom, Atom, State)) = %[:reply, :ok, state]
      callback handle_cast(message: Message, state: State) returns Effect(Tuple(Atom, State)) = cast_body
      callback handle_info(message: Message, state: State) returns Effect(Tuple(Atom, State)) = %[:noreply, state]
      callback terminate(reason: e, state: State) returns Effect(Atom) = :ok
      callback code_change(old: v, state: State, extra: x) returns Effect(Tuple(Atom, State)) = %[:ok, state]
      fn start_link(initial: State) -> Effect(Tuple) = beam_ops start_link name initial

    syntax actor <name: ModuleName> state <state_type: Type> handle_cast <cast_body: delayed raw until dedent> contextual becomes lift module name
      use Std.Otp
      behaviour gen_server
      typealias State = state_type
      callback init(initial: State) returns Effect(Tuple(Atom, State)) = %[:ok, initial]
      callback handle_call(request: r, from: f, state: State) returns Effect(Tuple(Atom, Atom, State)) = %[:reply, :ok, state]
      callback handle_cast(message: m, state: State) returns Effect(Tuple(Atom, State)) = cast_body
      callback handle_info(message: i, state: State) returns Effect(Tuple(Atom, State)) = %[:noreply, state]
      callback terminate(reason: e, state: State) returns Effect(Atom) = :ok
      callback code_change(old: v, state: State, extra: x) returns Effect(Tuple(Atom, State)) = %[:ok, state]
      fn start_link(initial: State) -> Effect(Tuple) = beam_ops start_link name initial

    syntax actor <name: ModuleName> state <state_type: Type> initial <payload: Code> handle_cast <cast_body: delayed raw until dedent> contextual becomes lift module name
      use Std.Otp
      behaviour gen_server
      typealias State = state_type
      callback init(initial: State) returns Effect(Tuple(Atom, State)) = %[:ok, assert_type payload : State]
      callback handle_call(request: r, from: f, state: State) returns Effect(Tuple(Atom, Atom, State)) = %[:reply, :ok, state]
      callback handle_cast(message: m, state: State) returns Effect(Tuple(Atom, State)) = cast_body
      callback handle_info(message: m, state: State) returns Effect(Tuple(Atom, State)) = %[:noreply, state]
      callback terminate(reason: e, state: State) returns Effect(Atom) = :ok
      callback code_change(old: v, state: State, extra: x) returns Effect(Tuple(Atom, State)) = %[:ok, state]
      fn start_link() -> Effect(Tuple) = beam_ops start_link name [payload]

    syntax actor <name: ModuleName> state <state_type: Type> initial <payload: Code> messages <message_type: Type> handle_cast <cast_body: delayed raw until dedent> contextual becomes lift module name
      use Std.Otp
      behaviour gen_server
      typealias State = state_type
      typealias Message = message_type
      callback init(initial: State) returns Effect(Tuple(Atom, State)) = %[:ok, assert_type payload : State]
      callback handle_call(request: r, from: f, state: State) returns Effect(Tuple(Atom, Atom, State)) = %[:reply, :ok, state]
      callback handle_cast(message: Message, state: State) returns Effect(Tuple(Atom, State)) = cast_body
      callback handle_info(message: Message, state: State) returns Effect(Tuple(Atom, State)) = %[:noreply, state]
      callback terminate(reason: e, state: State) returns Effect(Atom) = :ok
      callback code_change(old: v, state: State, extra: x) returns Effect(Tuple(Atom, State)) = %[:ok, state]
      fn start_link() -> Effect(Tuple) = beam_ops start_link name [payload]

    syntax actor <name: ModuleName> initial <payload: Code> handle_cast <cast_body: delayed raw until dedent> contextual becomes lift module name
      use Std.Otp
      behaviour gen_server
      callback init(initial: p) returns Effect(Tuple(Atom, p)) = %[:ok, assert_type payload : p]
      callback handle_call(request: r, from: f, state: p) returns Effect(Tuple(Atom, Atom, p)) = %[:reply, :ok, state]
      callback handle_cast(message: m, state: p) returns Effect(Tuple(Atom, p)) = cast_body
      callback handle_info(message: m, state: p) returns Effect(Tuple(Atom, p)) = %[:noreply, state]
      callback terminate(reason: e, state: p) returns Effect(Atom) = :ok
      callback code_change(old: v, state: p, extra: x) returns Effect(Tuple(Atom, p)) = %[:ok, state]
      fn start_link() -> Effect(Tuple) = beam_ops start_link name [payload]

    syntax actor <name: ModuleName> handle_cast <cast_body: delayed raw until dedent> contextual becomes lift module name
      use Std.Otp
      behaviour gen_server
      callback init(initial: p) returns Effect(Tuple(Atom, p)) = %[:ok, initial]
      callback handle_call(request: r, from: f, state: p) returns Effect(Tuple(Atom, Atom, p)) = %[:reply, :ok, state]
      callback handle_cast(message: m, state: p) returns Effect(Tuple(Atom, p)) = cast_body
      callback handle_info(message: m, state: p) returns Effect(Tuple(Atom, p)) = %[:noreply, state]
      callback terminate(reason: e, state: p) returns Effect(Atom) = :ok
      callback code_change(old: v, state: p, extra: x) returns Effect(Tuple(Atom, p)) = %[:ok, state]
      fn start_link(initial: p) -> Effect(Tuple) = beam_ops start_link name initial

    syntax actor <name: ModuleName> state <state_type: Type> messages <message_type: Type> handle_info <info_body: delayed raw until dedent> contextual becomes lift module name
      use Std.Otp
      behaviour gen_server
      typealias State = state_type
      typealias Message = message_type
      callback init(initial: State) returns Effect(Tuple(Atom, State)) = %[:ok, initial]
      callback handle_call(request: r, from: f, state: State) returns Effect(Tuple(Atom, Atom, State)) = %[:reply, :ok, state]
      callback handle_cast(message: Message, state: State) returns Effect(Tuple(Atom, State)) = %[:noreply, state]
      callback handle_info(message: Message, state: State) returns Effect(Tuple(Atom, State)) = info_body
      callback terminate(reason: e, state: State) returns Effect(Atom) = :ok
      callback code_change(old: v, state: State, extra: x) returns Effect(Tuple(Atom, State)) = %[:ok, state]
      fn start_link(initial: State) -> Effect(Tuple) = beam_ops start_link name initial

    syntax actor <name: ModuleName> state <state_type: Type> handle_info <info_body: delayed raw until dedent> contextual becomes lift module name
      use Std.Otp
      behaviour gen_server
      typealias State = state_type
      callback init(initial: State) returns Effect(Tuple(Atom, State)) = %[:ok, initial]
      callback handle_call(request: r, from: f, state: State) returns Effect(Tuple(Atom, Atom, State)) = %[:reply, :ok, state]
      callback handle_cast(message: m, state: State) returns Effect(Tuple(Atom, State)) = %[:noreply, state]
      callback handle_info(message: i, state: State) returns Effect(Tuple(Atom, State)) = info_body
      callback terminate(reason: e, state: State) returns Effect(Atom) = :ok
      callback code_change(old: v, state: State, extra: x) returns Effect(Tuple(Atom, State)) = %[:ok, state]
      fn start_link(initial: State) -> Effect(Tuple) = beam_ops start_link name [initial]

    syntax actor <name: ModuleName> state <state_type: Type> with <payload: Code> <body: raw until dedent> becomes lift module name
      use Std.Otp
      behaviour gen_server
      typealias State = state_type
      callback init(initial: State) returns Effect(Tuple(Atom, State)) = %[:ok, initial]
      callback handle_call(request: r, from: f, state: State) returns Effect(Tuple(Atom, Atom, State)) = %[:reply, :ok, state]
      callback handle_cast(message: m, state: State) returns Effect(Tuple(Atom, State)) = %[:noreply, state]
      callback handle_info(message: i, state: State) returns Effect(Tuple(Atom, State)) = %[:noreply, state]
      callback terminate(reason: e, state: State) returns Effect(Atom) = :ok
      callback code_change(old: v, state: State, extra: x) returns Effect(Tuple(Atom, State)) = %[:ok, state]
      fn start_link() -> Effect(Tuple) = beam_ops start_link name payload
      body

    syntax actor <name: ModuleName> state <state_type: Type> <body: raw until dedent> becomes lift module name
      use Std.Otp
      behaviour gen_server
      typealias State = state_type
      callback init(initial: State) returns Tuple(Atom, State) = %[:ok, initial]
      callback handle_call(request: r, from: f, state: State) returns Tuple(Atom, Atom, State) = %[:reply, :ok, state]
      callback handle_cast(message: m, state: State) returns Tuple(Atom, State) = %[:noreply, state]
      callback handle_info(message: i, state: State) returns Tuple(Atom, State) = %[:noreply, state]
      callback terminate(reason: e, state: State) returns Atom = :ok
      callback code_change(old: v, state: State, extra: x) returns Tuple(Atom, State) = %[:ok, state]
      fn start_link(initial: State) -> Effect(Tuple) = beam_ops start_link name initial
      body

    syntax actor <name: ModuleName> with <payload: Code> <body: raw until dedent> becomes lift module name
      use Std.Otp
      behaviour gen_server
      callback init(initial: p) returns Effect(Tuple(Atom, p)) = %[:ok, initial]
      callback handle_call(request: r, from: f, state: p) returns Effect(Tuple(Atom, Atom, p)) = %[:reply, :ok, state]
      callback handle_cast(message: m, state: p) returns Effect(Tuple(Atom, p)) = %[:noreply, state]
      callback handle_info(message: i, state: p) returns Effect(Tuple(Atom, p)) = %[:noreply, state]
      callback terminate(reason: e, state: p) returns Effect(Atom) = :ok
      callback code_change(old: v, state: p, extra: x) returns Effect(Tuple(Atom, p)) = %[:ok, state]
      fn start_link() -> Effect(Tuple) = beam_ops start_link name payload
      body

    syntax actor <name: ModuleName> <body: raw until dedent> becomes lift module name
      use Std.Otp
      behaviour gen_server
      callback init(initial: p) returns Effect(Tuple(Atom, p)) = %[:ok, initial]
      callback handle_call(request: r, from: f, state: p) returns Effect(Tuple(Atom, Atom, p)) = %[:reply, :ok, state]
      callback handle_cast(message: m, state: p) returns Effect(Tuple(Atom, p)) = %[:noreply, state]
      callback handle_info(message: i, state: p) returns Effect(Tuple(Atom, p)) = %[:noreply, state]
      callback terminate(reason: e, state: p) returns Effect(Atom) = :ok
      callback code_change(old: v, state: p, extra: x) returns Effect(Tuple(Atom, p)) = %[:ok, state]
      fn start_link(initial: p) -> Effect(Tuple) = beam_ops start_link name initial
      body

  ## Adapt the state-valued body of an inferred actor handler to the ordinary
  ## GenServer callback result. This remains in the actor macro module: it is
  ## domain-specific syntax construction, not part of the generic reflection
  ## vocabulary.
  fn actor_handler(body: Syntax) -> Syntax = match tag(body) == :pattern_match
    true -> actor_handler_node(attrs(body), children(body))
    false -> body

  fn actor_handler_node(values: List(Attr), children: List(Syntax)) -> Syntax = match children
    [scrutinee | arms] -> Node(:pattern_match, values, [scrutinee | actor_handler_arms(arms)])
    _ -> Node(:pattern_match, values, children)

  fn actor_handler_arms(arms: List(Syntax)) -> List(Syntax) = match arms
    [] -> []
    [arm | rest] -> [actor_handler_arm(arm) | actor_handler_arms(rest)]

  fn actor_handler_arm(arm: Syntax) -> Syntax = match tag(arm) == :match_arm
    true -> actor_handler_arm_node(attrs(arm), children(arm))
    false -> arm

  fn actor_handler_arm_node(values: List(Attr), children: List(Syntax)) -> Syntax = match children
    [body] -> Node(:match_arm, values, [block([tuple([atom_literal(:noreply), body])])])
    _ -> Node(:match_arm, values, children)

  type ReplyInference = NoCall | CallContract(List(Syntax), Syntax) | InvalidCall(Atom)
  type ReplyTypeInference = ReplyType(Syntax, Atom) | InvalidReply(Atom)

  fn derive_actor(input: ActorSyntax) -> Syntax =
    let module_name: SynLit = match input.name
      Leaf(_, _, SAtom(name)) -> SAtom(name)
      _ -> SStr("Cure.Generated.Actor")
    let module_expr: Syntax = match input.name
      Leaf(_, _, SAtom(name)) -> atom_literal(name)
      _ -> atom_literal(:generated_actor)
    match derive_pattern_heads(input.cast_body)
      InvalidHeads(reason) -> Failure(reason, [])
      Heads(heads) ->
        match derive_reply_contract(input.call_body, input.state_type)
          NoCall -> emit_actor(input, module_name, module_expr, heads)
          InvalidCall(reason) -> Failure(reason, [])
          CallContract(request_heads, reply_type) -> emit_actor_call(input, module_name, module_expr, heads, request_heads, reply_type)

  fn derive_reply_contract(call_body: Syntax, state_type: Syntax) -> ReplyInference = match call_body
    Raw(_) -> NoCall
    _ -> match derive_pattern_heads(call_body)
      InvalidHeads(reason) -> InvalidCall(reason)
      Heads(request_heads) -> match infer_reply_type(call_body, state_type)
        ReplyType(reply_type, _) -> CallContract(request_heads, reply_type)
        InvalidReply(reason) -> InvalidCall(reason)

  fn infer_reply_type(body: Syntax, state_type: Syntax) -> ReplyTypeInference = match tag(body) == :pattern_match
    true -> match children(body)
      [_scrutinee | arms] -> infer_reply_arms(arms, state_type)
      _ -> InvalidReply(:reply_type_not_derivable)
    false -> InvalidReply(:reply_type_not_derivable)

  fn infer_reply_arms(arms: List(Syntax), state_type: Syntax) -> ReplyTypeInference = match arms
    [first | rest] -> match reply_arm_type(first, state_type)
      InvalidReply(reason) -> InvalidReply(reason)
      ReplyType(reply_type, reply_key) -> infer_reply_tail(rest, state_type, reply_type, reply_key)
    [] -> InvalidReply(:reply_type_not_derivable)

  fn infer_reply_tail(arms: List(Syntax), state_type: Syntax, reply_type: Syntax, reply_key: Atom) -> ReplyTypeInference = match arms
    [] -> ReplyType(reply_type, reply_key)
    [arm | rest] -> match reply_arm_type(arm, state_type)
      InvalidReply(reason) -> InvalidReply(reason)
      ReplyType(_, arm_key) -> match reply_key == arm_key
        true -> infer_reply_tail(rest, state_type, reply_type, reply_key)
        false -> InvalidReply(:inconsistent_reply_types)

  fn reply_arm_type(arm: Syntax, state_type: Syntax) -> ReplyTypeInference = match children(arm)
    [body] -> match tag(body) == :block
      true -> match children(body)
        [expression] -> reply_expr_type(expression, state_type)
        _ -> InvalidReply(:reply_type_not_derivable)
      false -> reply_expr_type(body, state_type)
    _ -> InvalidReply(:reply_type_not_derivable)

  fn reply_expr_type(expr: Syntax, state_type: Syntax) -> ReplyTypeInference = match expr
    _ -> match tag(expr) == :variable
      true -> match is_variable_named(expr, :state)
        true -> ReplyType(state_type, :state)
        false -> InvalidReply(:reply_type_not_derivable)
      false -> match tag(expr) == :literal
        true -> literal_reply_type(attrs(expr))
        false -> match tag(expr) == :tuple
          true -> ReplyType(variable("Tuple"), :tuple)
          false -> InvalidReply(:reply_type_not_derivable)

  fn literal_reply_type(values: List(Attr)) -> ReplyTypeInference = match attr(values, :subtype)
    _ -> match attr_atom_is(values, :subtype, :integer)
      true -> ReplyType(variable("Int"), :int)
      false -> match attr_atom_is(values, :subtype, :float)
        true -> ReplyType(variable("Float"), :float)
        false -> match attr_atom_is(values, :subtype, :symbol)
          true -> ReplyType(variable("Atom"), :atom)
          false -> match attr_atom_is(values, :subtype, :boolean)
            true -> ReplyType(variable("Bool"), :bool)
            false -> InvalidReply(:reply_type_not_derivable)

  fn emit_actor(input: ActorSyntax, module_name: SynLit, module_expr: Syntax, heads: List(Syntax)) -> Syntax =
        let message_type: Syntax = enum_type("ActorMessage", heads)
        let result_type: Syntax = call("Effect", [tuple_type([variable("Atom"), variable("State")])])
        let init_type: Syntax = call("Effect", [tuple_type([variable("Atom"), variable("State")])])
        let start_type: Syntax = call("Effect", [variable("Tuple")])
        let handler_body: Syntax = actor_handler(input.cast_body)
        let default_state: Syntax = tuple([atom_literal(:noreply), variable("state")])
        block([
          message_type,
          lift_module_isolated(module_name, :gen_server, [
            use_module("Std.Otp"),
            alias_node("State", input.state_type),
            alias_node("Message", variable("ActorMessage")),
            function("init", [parameter("initial", variable("State"))], init_type, tuple([atom_literal(:ok), variable("initial")])),
            function("handle_cast", [parameter("message", variable("Message")), parameter("state", variable("State"))], result_type, handler_body),
            function("handle_info", [parameter("message", variable("Message")), parameter("state", variable("State"))], result_type, default_state),
            function("terminate", [parameter("reason", variable("Atom")), parameter("state", variable("State"))], call("Effect", [variable("Atom")]), atom_literal(:ok)),
            function("code_change", [parameter("old", variable("Atom")), parameter("state", variable("State")), parameter("extra", variable("Atom"))], result_type, tuple([atom_literal(:ok), variable("state")])),
            function("start_link", [parameter("initial", variable("State"))], start_type, call("Std.Otp.start_link", [module_expr, variable("initial")]))
          ])
        ])

  fn emit_actor_call(input: ActorSyntax, module_name: SynLit, module_expr: Syntax, message_heads: List(Syntax), request_heads: List(Syntax), reply_type: Syntax) -> Syntax =
    let message_type: Syntax = enum_type("ActorMessage", message_heads)
    let request_type: Syntax = enum_type("ActorRequest", request_heads)
    let cast_result_type: Syntax = call("Effect", [tuple_type([variable("Atom"), variable("State")])])
    let init_type: Syntax = call("Effect", [tuple_type([variable("Atom"), variable("State")])])
    let start_type: Syntax = call("Effect", [variable("Tuple")])
    let cast_body: Syntax = actor_handler(input.cast_body)
    let call_body: Syntax = actor_call_handler(input.call_body)
    let default_state: Syntax = tuple([atom_literal(:noreply), variable("state")])
    block([
      message_type,
      request_type,
      lift_module_isolated(module_name, :gen_server, [
        use_module("Std.Otp"),
        alias_node("State", input.state_type),
        alias_node("Message", variable("ActorMessage")),
        alias_node("Request", variable("ActorRequest")),
        function("init", [parameter("initial", variable("State"))], init_type, tuple([atom_literal(:ok), variable("initial")])),
        function("handle_call", [parameter("request", variable("Request")), parameter_linear("from", call("Reply", [reply_type])), parameter("state", variable("State"))], cast_result_type, call_body),
        function("handle_cast", [parameter("message", variable("Message")), parameter("state", variable("State"))], cast_result_type, cast_body),
        function("handle_info", [parameter("message", variable("Message")), parameter("state", variable("State"))], cast_result_type, default_state),
        function("terminate", [parameter("reason", variable("Atom")), parameter("state", variable("State"))], call("Effect", [variable("Atom")]), atom_literal(:ok)),
        function("code_change", [parameter("old", variable("Atom")), parameter("state", variable("State")), parameter("extra", variable("Atom"))], cast_result_type, tuple([atom_literal(:ok), variable("state")])),
        function("start_link", [parameter("initial", variable("State"))], start_type, call("Std.Otp.start_link", [module_expr, variable("initial")]))
      ])
    ])

  fn actor_call_handler(body: Syntax) -> Syntax = match tag(body) == :pattern_match
    true -> actor_call_handler_node(attrs(body), children(body))
    false -> body

  fn actor_call_handler_node(values: List(Attr), children: List(Syntax)) -> Syntax = match children
    [scrutinee | arms] -> Node(:pattern_match, values, [scrutinee | actor_call_handler_arms(arms)])
    _ -> Node(:pattern_match, values, children)

  fn actor_call_handler_arms(arms: List(Syntax)) -> List(Syntax) = match arms
    [] -> []
    [arm | rest] -> [actor_call_handler_arm(arm) | actor_call_handler_arms(rest)]

  fn actor_call_handler_arm(arm: Syntax) -> Syntax = match tag(arm) == :match_arm
    true -> actor_call_handler_arm_node(attrs(arm), children(arm))
    false -> arm

  fn actor_call_handler_arm_node(values: List(Attr), children: List(Syntax)) -> Syntax = match children
    [body] -> Node(:match_arm, values, [block([
      let_binding("answered", call("Std.Otp.reply", [variable("from"), body])),
      tuple([atom_literal(:noreply), variable("state")])
    ])])
    _ -> Node(:match_arm, values, children)

  ## Typed-actor runtime operations: spawn, stop, send, introspect.
  ##
  ## Raw compatibility helpers for already-running process modules. New actor
  ## declarations use the transparent `actor` macro and `Std.Otp` algebra.
  ## Spawning captures the caller as the actor's `:caller`.
  ##
  ## ## Examples
  ##
  ## ```cure
  ## use Std.Actor
  ##
  ## let pid = Std.Otp.spawn(fn() -> unit())
  ## send(pid, %[:ping, :hello])
  ## is_alive(pid)                           # => true
  ## stop(pid)
  ## ```
  ##
  ## ```cure
  ## use Std.Actor
  ##
  ## # Name an actor so other processes can find it without passing a pid.
  ## let pid = spawn_named(:"MyApp.Cache", "main-cache")
  ## lookup("main-cache") == pid             # => true
  ## ```

  ## Group tag consumed by `Cure.Stdlib.Preload`.
  ## Spawn a new actor instance from a compiled actor module atom.
  ## The spawning process is recorded as the actor's caller
  ## automatically; lifecycle hooks can reach it via
  ## `Std.Actor.notify/1` (see the runtime docs).
  @extern(Elixir.Cure.Actor.Builtins, :actor_spawn, 1)
  fn spawn(actor_module: Atom) -> Pid

  ## Spawn an actor with an explicit initial payload.
  @extern(Elixir.Cure.Actor.Builtins, :actor_spawn_with_payload, 2)
  fn spawn_with_payload(actor_module: Atom, payload: Any) -> Pid

  ## Spawn a named actor. The `name` string is registered with the
  ## runtime so it can be found later via `lookup/1`.
  @extern(Elixir.Cure.Actor.Builtins, :actor_spawn_named, 2)
  fn spawn_named(actor_module: Atom, name: String) -> Pid

  ## Stop a running actor instance.
  @extern(Elixir.Cure.Actor.Builtins, :actor_stop, 1)
  fn stop(pid: Pid) -> Atom

  ## Send a message to an actor (cast semantics: fire-and-forget).
  ## This is the runtime counterpart of the Melquiades operator
  ## `<-|`; both lower to Erlang's `!` and return the sent message.
  @extern(Elixir.Cure.Actor.Builtins, :actor_send, 2)
  fn send(pid: Pid, message: Any) -> Any

  ## Fetch the actor's current user-visible payload.
  @extern(Elixir.Cure.Actor.Builtins, :actor_get_state, 1)
  fn get_state(pid: Pid) -> Any

  ## `true` when the actor pid is still alive.
  @extern(Elixir.Cure.Actor.Builtins, :actor_is_alive, 1)
  fn is_alive(pid: Pid) -> Bool

  ## Look up an actor by its registered name; returns its pid.
  @extern(Elixir.Cure.Actor.Builtins, :actor_lookup, 1)
  fn lookup(name: String) -> Pid
