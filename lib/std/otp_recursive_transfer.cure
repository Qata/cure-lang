@group(:concurrency)
mod Std.Otp.RecursiveTransfer
  ## RECURSIVE-behaviour interface transfer (build-out map B2 / BRec), the piece that turns
  ## the finite fixpoint machinery into an actual `infer(BRec)`.
  ##
  ## A recursive behaviour `μX. body` infers its interface as the LEAST FIXED POINT of the
  ## interface transfer `f(I) = tset(body, I)` — the tags `body` uses when its recursion
  ## variable `X` is assumed to have interface `I`. This module DERIVES that transfer from the
  ## body's syntax (`tset`), proves it MONOTONE generically by induction on the body
  ## (`tset_mono`) — the hypothesis the finite fixpoint theorem needs — and then reads off the
  ## fixed point from `Std.Otp.FiniteFixpoint.map_lfp_le`: applying the transfer to the inferred
  ## interface stays within it (`rec_fixed`). This is `infer(BRec)` proved operationally sound
  ## for the finite (3-tag) universe, with the transfer coming from syntax rather than assumed
  ## abstract — the honest content the mailbox-types literature left as "the fixed point exists."
  ##
  ## The lattice, order (`Sub`), `bot`, `iter`, `sub_refl`, and `map_lfp_le` are reused from
  ## `Std.Otp.FiniteFixpoint`; `Std.Otp.InterfaceBridge` carries the resulting `Sub` fixed point
  ## into `TagList` membership for the adequacy proof.

  use Std.Otp.FiniteFixpoint

  type Tag = TA | TB | TC

  ## Bit disjunction and its monotonicity (pointwise ⊑ is preserved by ∨).
  fn orb(p: B, q: B) -> B = match p
    F() -> q
    T() -> T
  fn orb_mono({p: B}, {p2: B}, {q: B}, {q2: B}, ip: Imp(p, p2), iq: Imp(q, q2)) -> Imp(orb(p, q), orb(p2, q2)) = match ip
    ImpFF() -> iq
    ImpFT() -> match iq
      ImpFF() -> ImpFT()
      ImpFT() -> ImpFT()
      ImpTT() -> ImpTT()
    ImpTT() -> ImpTT()

  ## Pointwise join (interface union) and its monotonicity.
  fn join(x: IF, y: IF) -> IF = match x
    MkIF(a, b, c) -> match y
      MkIF(a2, b2, c2) -> MkIF(orb(a, a2), orb(b, b2), orb(c, c2))
  fn join_mono(x: IF, y: IF, x2: IF, y2: IF, s1: Sub(x, x2), s2: Sub(y, y2)) -> Sub(join(x, y), join(x2, y2)) = match s1
    MkSub(ia, ib, ic) -> match s2
      MkSub(ja, jb, jc) -> MkSub(orb_mono(ia, ja), orb_mono(ib, jb), orb_mono(ic, jc))

  ## Force one tag's bit on, and its monotonicity (setting a bit preserves ⊑).
  fn setbit(t: Tag, x: IF) -> IF = match x
    MkIF(a, b, c) -> match t
      TA() -> MkIF(T, b, c)
      TB() -> MkIF(a, T, c)
      TC() -> MkIF(a, b, T)
  fn setbit_mono(t: Tag, x: IF, y: IF, s: Sub(x, y)) -> Sub(setbit(t, x), setbit(t, y)) = match t
    TA() -> match s
      MkSub(ia, ib, ic) -> MkSub(ImpTT(), ib, ic)
    TB() -> match s
      MkSub(ia, ib, ic) -> MkSub(ia, ImpTT(), ic)
    TC() -> match s
      MkSub(ia, ib, ic) -> MkSub(ia, ib, ImpTT())

  ## A recursive behaviour body with a single recursion variable `RVar` (= `X`). First-order
  ## send/recv/sequencing — the fragment the sequential+branching adequacy already covers, now
  ## closed under recursion.
  type RBody = RNil | RVar | RSend(Tag, RBody) | RRecv(Tag, RBody) | RSeq(RBody, RBody)

  ## **THE TRANSFER, DERIVED FROM SYNTAX.** `tset(body, I)` = the interface of `body` when the
  ## recursion variable is assumed to have interface `I`. `RVar` contributes `I`; a send/recv of
  ## `t` adds `t`; a sequence unions the branches.
  fn tset(body: RBody, i: IF) -> IF = match body
    RNil()       -> bot()
    RVar()       -> i
    RSend(t, k)  -> setbit(t, tset(k, i))
    RRecv(t, k)  -> setbit(t, tset(k, i))
    RSeq(l, r)   -> join(tset(l, i), tset(r, i))

  ## **MONOTONICITY, GENERIC OVER SYNTAX.** The transfer of any body is monotone — a larger
  ## assumed interface yields a larger inferred one. By induction on the body: `RNil` is
  ## constant, `RVar` is the identity, send/recv reuse `setbit_mono`, sequencing `join_mono`.
  ## This is the hypothesis `map_lfp_le` requires, discharged for every syntactic body.
  fn tset_mono(body: RBody, x: IF, y: IF, s: Sub(x, y)) -> Sub(tset(body, x), tset(body, y)) = match body
    RNil()       -> sub_refl(bot())
    RVar()       -> s
    RSend(t, k)  -> setbit_mono(t, tset(k, x), tset(k, y), tset_mono(k, x, y, s))
    RRecv(t, k)  -> setbit_mono(t, tset(k, x), tset(k, y), tset_mono(k, x, y, s))
    RSeq(l, r)   -> join_mono(tset(l, x), tset(r, x), tset(l, y), tset(r, y),
                              tset_mono(l, x, y, s), tset_mono(r, x, y, s))

  ## **infer(BRec).** The inferred interface of `μX. body` is `f⁴(⊥)` with `f = tset(body, -)`;
  ## by finite-height stabilization this is the least fixed point.
  fn rec_infer(body: RBody) -> IF = iter(fn(i) -> tset(body, i), S(S(S(S(Z())))))

  ## **THE FIXED-POINT PROPERTY for a syntactic recursive behaviour.** Applying the derived
  ## transfer to the inferred interface stays within it — recursion adds nothing new past the
  ## fixed point. `map_lfp_le` instantiated at the syntactic transfer and its generic
  ## monotonicity. This is `infer(BRec)`'s operational soundness for the finite universe.
  fn rec_fixed(body: RBody) -> Sub(tset(body, rec_infer(body)), rec_infer(body)) =
    map_lfp_le(fn(i) -> tset(body, i),
               fn(x) -> fn(y) -> fn(s) -> tset_mono(body, x, y, s))
end
