@group(:concurrency)
mod Std.Otp.RecursiveRun
  ## RECURSIVE-behaviour ADEQUACY (build-out map B2 / BRec, operational half). Coverage
  ## (`Std.Otp.RecursiveAdequacy.brec_handles`) is the fundamental-theorem half — a recursive
  ## behaviour's sends are members of its inferred interface. This module discharges the
  ## OPERATIONAL half: every configuration reachable by RUNNING a recursive behaviour is
  ## well-typed at that inferred interface, so a process typed by recursive inference never
  ## delivers a message it cannot handle.
  ##
  ## The operational core (`preservation_at`, `adequacy_at`) is proved generically at an
  ## ARBITRARY interface `i` — subject reduction plus induction over a run — exactly mirroring
  ## `Std.Otp.InferenceAdequacy` but over the shared bridge membership (`Handles`/`AllHandled`).
  ## The recursion-specific content is the tie-in: `rec_send_step` witnesses that a recursive
  ## behaviour's send is a valid step at its inferred interface (justified by `brec_handles`),
  ## and `rec_adequacy` instantiates the generic adequacy at `denote(rec_infer(body))`. Together
  ## with coverage this is `infer(BRec)` proved operationally sound for the finite universe.

  use Std.Otp.FiniteFixpoint
  use Std.Otp.InterfaceBridge
  use Std.Otp.RecursiveTransfer
  use Std.Otp.RecursiveAdequacy

  ## A mailbox configuration: tags still to be emitted, and tags already received.
  type Config = MkConfig(TagList, TagList)

  ## `WTat(c, I)` — every tag in `c` (pending or received) is a member of interface `I`.
  type WTat indices (c: Config, iface: TagList)
    MkWTat : AllHandled(e, iface) -> AllHandled(m, iface) -> WTat(MkConfig(e, m), iface)

  ## The reduction typed at interface `I`: a send may only emit an `I`-message; arrival and
  ## receive shuffle the mailbox without introducing new tags.
  type StepAt indices (i: TagList, before: Config, after: Config)
    SSendAt   : Handles(t, i) -> StepAt(i, MkConfig(e, m), MkConfig(TCons(t, e), m))
    SArriveAt : StepAt(i, MkConfig(TCons(t, e), m), MkConfig(e, TCons(t, m)))
    SRecvAt   : StepAt(i, MkConfig(e, TCons(t, m)), MkConfig(e, m))

  ## **PRESERVATION.** A typed step preserves `config ⊨ I`. Subject reduction at an arbitrary
  ## interface (the operational lemma the mailbox-types literature deferred), reused verbatim
  ## for the recursive case.
  fn preservation_at({i: TagList}, {b: Config}, {a: Config}, wt: WTat(b, i), s: StepAt(i, b, a)) -> WTat(a, i) = match s
    SSendAt(mem) -> match wt
      MkWTat(ae, am) -> MkWTat(AHCons(mem, ae), am)
    SArriveAt() -> match wt
      MkWTat(ae, am) -> match ae
        AHCons(at, ae2) -> MkWTat(ae2, AHCons(at, am))
    SRecvAt() -> match wt
      MkWTat(ae, am) -> match am
        AHCons(rat, am2) -> MkWTat(ae, am2)

  ## `RunsAt(I, c)` — config `c` is reachable by executing steps typed at interface `I`.
  type RunsAt indices (i: TagList, c: Config)
    RAStart : RunsAt(i, MkConfig(TNil, TNil))
    RAStep  : RunsAt(i, before) -> StepAt(i, before, after) -> RunsAt(i, after)

  ## The empty run at an explicit interface — a checking-mode entry point for `RAStart`, whose
  ## interface index is otherwise undetermined in nested constructor position.
  fn ra_start(i: TagList) -> RunsAt(i, MkConfig(TNil, TNil)) = RAStart()

  ## **ADEQUACY (generic).** Every config reachable by a run typed at `I` is well-typed at `I`.
  ## Induction over the run: the empty config is trivially typed; each step preserves typing.
  fn adequacy_at({i: TagList}, {c: Config}, run: RunsAt(i, c)) -> WTat(c, i) = match run
    RAStart()          -> MkWTat(AHNil(), AHNil())
    RAStep(prev, step) -> preservation_at(adequacy_at(prev), step)

  ## **RECURSIVE SEND STEP.** A tag a recursive behaviour sends is a valid emission at its
  ## inferred interface — the recursion analogue of a well-typed send, justified by coverage
  ## (`brec_handles`). This is what makes a recursive behaviour's run CONSTRUCTIBLE at
  ## `denote(rec_infer(body))`.
  fn rec_send_step({e: TagList}, {m: TagList}, body: RBody, t: Tag, sends: RSendsIn(body, t)) -> StepAt(denote(rec_infer(body)), MkConfig(e, m), MkConfig(TCons(t, e), m)) =
    SSendAt(brec_handles(body, t, sends))

  ## **BREC ADEQUACY.** Every config reachable by running a recursive behaviour is well-typed
  ## at its inferred fixed-point interface. The generic adequacy instantiated at
  ## `denote(rec_infer(body))` — recursive inference is operationally safe.
  fn rec_adequacy(body: RBody, {c: Config}, run: RunsAt(denote(rec_infer(body)), c)) -> WTat(c, denote(rec_infer(body))) =
    adequacy_at(run)
end
