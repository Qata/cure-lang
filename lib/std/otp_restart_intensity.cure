@group(:concurrency)
mod Std.Otp.RestartIntensity
  use Std.Equivalent
  ## RESTART INTENSITY — the `max_restarts` bound completing `Std.Otp.Supervisor` (build-out
  ## map supervision depth).
  ##
  ## `Std.Otp.Supervisor` typed the STRUCTURAL invariant (restart preserves the child specs);
  ## it left the restart-INTENSITY limit as "an operational bound not modelled". This module
  ## types that bound: a supervisor carries a restart BUDGET (its `max_restarts`, a `Std.Nat`
  ## index), each child failure it absorbs consumes one, and when the budget is exhausted the
  ## NEXT failure shuts the supervisor down instead of restarting. So a supervisor can restart
  ## at most `budget` times — "a supervisor restarts beyond its intensity" is unconstructible:
  ## `FRestart` REQUIRES `S(n)` budget, and a zero-budget failure has only `FShutdown`.
  ## `on_fail` is total: every failure of a running supervisor either restarts or shuts down.
  ##
  ## The bounded-run LIVENESS theorem `eventually_down` — from budget `n`, `n` restarts then one
  ## shutdown reach `Down`, i.e. a supervisor tolerates EXACTLY `budget` failures — is proved
  ## below by induction on the budget. (It was formerly blocked by the E6 elaborator gap — a
  ## constructor field whose index is fixed only by a sibling argument; that is now fixed, so
  ## the theorem elaborates and compiles here directly, no longer a probe.)
  ##
  ## **Honest scope.** The sliding TIME window (`max_seconds`) is abstracted — the budget is a
  ## plain count, as if all failures fall in one window (the worst case the bound guards).

  type Phase = Up | Down

  ## A supervisor indexed by its remaining restart budget and phase. `Alive(n)` is running with
  ## `n` restarts left; `Stopped` has exhausted its budget and shut down.
  type Sup indices (budget: Nat, phase: Phase)
    Alive   : Sup(n, Up)
    Stopped : Sup(Z, Down)

  ## One child failure: with budget `S(n)` the supervisor RESTARTS (budget → `n`, stays `Up`);
  ## with budget `Z` it SHUTS DOWN (→ `Down`). There is no restart from zero budget.
  type Fail indices (b1: Nat, p1: Phase, b2: Nat, p2: Phase)
    FRestart  : Fail(S(n), Up, n, Up)
    FShutdown : Fail(Z, Up, Z, Down)

  ## Absorbing a failure transitions the supervisor per its budget. Total: every failure of a
  ## running supervisor either restarts (budget remaining) or shuts down (budget zero). The
  ## `FRestart` case can only fire with `S(n)` budget, so the intensity bound is enforced.
  fn on_fail({b1: Nat}, {p1: Phase}, {b2: Nat}, {p2: Phase}, sup: Sup(b1, p1), f: Fail(b1, p1, b2, p2)) -> Sup(b2, p2) = match f
    FRestart()  -> Alive()
    FShutdown() -> Stopped()

  ## A RUN of successive failures, chaining the single-failure transitions.
  type FailRun indices (b1: Nat, p1: Phase, b2: Nat, p2: Phase)
    FRDone : FailRun(b, p, b, p)
    FRMore : Fail(b1, p1, bm, pm) -> FailRun(bm, pm, b2, p2) -> FailRun(b1, p1, b2, p2)

  ## **RESTART-INTENSITY LIVENESS.** From any starting budget `n`, `n` restarts followed by one
  ## shutdown drive the supervisor to `Down`: it tolerates EXACTLY `budget` failures, then
  ## terminates. By induction on the budget — spend each unit on a restart, then the final
  ## zero-budget failure shuts it down.
  fn eventually_down(n: Nat) -> FailRun(n, Up, Z, Down) = match n
    Z()  -> FRMore(FShutdown(), FRDone())
    S(k) -> FRMore(FRestart(), eventually_down(k))

  ## The NUMBER of failures a run absorbs — its length as a chain of transitions.
  fn run_len({b1: Nat}, {p1: Phase}, {b2: Nat}, {p2: Phase}, run: FailRun(b1, p1, b2, p2)) -> Nat = match run
    FRDone()        -> Z()
    FRMore(f, rest) -> S(run_len(rest))

  fn snat_cong({a: Nat}, {b: Nat}, e: Equivalent(Nat, a, b)) -> Equivalent(Nat, S(a), S(b)) =
    rewrite e in reflexive(S(b))

  ## **RESTART INTENSITY IS EXACT.** The canonical failure run from budget `n` has length `S(n)`:
  ## a supervisor tolerates EXACTLY `n + 1` failures — `n` restarts spending the budget, then one
  ## final zero-budget shutdown — before reaching `Down`. This sharpens `eventually_down` (which only
  ## says `Down` is reached) into a precise count, by induction on the budget: the base run is one
  ## shutdown (`S(Z)`), and each extra unit of budget prepends one restart (`snat_cong` on the IH).
  fn eventually_down_len(n: Nat) -> Equivalent(Nat, run_len(eventually_down(n)), S(n)) = match n
    Z()  -> reflexive(S(Z()))
    S(k) -> snat_cong(eventually_down_len(k))
end
