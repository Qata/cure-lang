mod Std.Equal
  ## Legacy equality-token combinators.
  ##
  ## Core has internal `Eq`/`refl`/`rewrite` support, but this stdlib
  ## module is still the compatibility surface: every function returns
  ## the runtime atom `:cure_refl` and has an `Atom` return type.
  ## These values are not trusted kernel proofs yet.
  ##
  ## ## Examples
  ##
  ## ```cure
  ## use Std.Equal
  ##
  ## refl(42)                                # => :cure_refl
  ## trans(refl(1), refl(1))                 # => :cure_refl
  ## ```

  ## Group tag consumed by `Cure.Stdlib.Preload`.
  fn __group__() -> Atom = :core

  ## Reflexivity token. Produces the runtime witness `:cure_refl`.
  fn refl(_x: T) -> Atom = :cure_refl

  ## Symmetry token. Returns `:cure_refl`.
  fn sym(_eq: Atom) -> Atom = :cure_refl

  ## Transitivity token.
  fn trans(_p: Atom, _q: Atom) -> Atom = :cure_refl

  ## Congruence token.
  fn cong(_f: T -> U, _eq: Atom) -> Atom = :cure_refl
