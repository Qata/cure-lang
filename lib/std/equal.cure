mod Std.Equal
  ## Propositional equality combinators over the inductive identity type
  ## `Eq(a, x, y)` (spec 2026-07-04-identity-type-as-inductive).
  ##
  ## These are GENUINE proofs, not runtime tokens: each is checked by the
  ## dependent kernel. The proofs work by matching on the single `Eq`
  ## constructor `refl` — once `refl()` is matched the two endpoints are
  ## definitionally identified, so the goal collapses to reflexivity. This is
  ## the same technique Agda's `Relation.Binary.PropositionalEquality` uses.
  ##
  ## ## Examples
  ##
  ## ```cure
  ## use Std.Equal
  ##
  ## # given  p : Eq(a, x, y)
  ## sym(p)              # : Eq(a, y, x)
  ## trans(p, q)         # : Eq(a, x, z)   when  q : Eq(a, y, z)
  ## cong(f, p)          # : Eq(b, f(x), f(y))
  ## ```

  ## Group tag consumed by `Cure.Stdlib.Preload`.
  fn __group__() -> Atom = :core

  ## Reflexivity: `x` equals itself. (A thin wrapper over the built-in `refl`
  ## constructor, provided so the whole toolkit reads uniformly.)
  fn refl_({a: Type}, {x: a}) -> Eq(a, x, x) = refl(x)

  ## Symmetry: from `x = y` derive `y = x`.
  fn sym({a: Type}, {x: a}, {y: a}, p: Eq(a, x, y)) -> Eq(a, y, x) = match p
    refl() -> refl(x)

  ## Transitivity: from `x = y` and `y = z` derive `x = z`.
  fn trans({a: Type}, {x: a}, {y: a}, {z: a}, p: Eq(a, x, y), q: Eq(a, y, z)) -> Eq(a, x, z) = match p
    refl() -> q

  ## Congruence: equal inputs give equal `f`-outputs.
  fn cong({a: Type}, {b: Type}, {x: a}, {y: a}, f: (a) -> b, p: Eq(a, x, y)) -> Eq(b, f(x), f(y)) = match p
    refl() -> refl(f(x))
