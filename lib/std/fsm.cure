@group(:concurrency)
mod Std.Fsm
  use Std.Syntax
  use Std.List

  ## The structured FSM surface reuses the generic family parser. Legacy forms
  ## in FsmContainers remain available through ordinary grammar fallback.
  macro fsm <name: ModuleName>
    syntax family FsmDefinition
      state Type
      events Cases
      optional event_type Type
    accepts FsmDefinition
    expands with derive_fsm_family

  fn derive_fsm_family(name: ModuleNameSyntax, definition: FsmDefinitionSyntax) -> Syntax =
    let body = Node(:pattern_match, [], [variable("event") | children(definition.events)])
    let name_syntax: Syntax = name
    match derive_pattern_heads(body)
      InvalidHeads(reason) -> Failure(reason, [])
      Heads(heads) ->
        let event_type = match definition.event_type
          None() -> variable("FsmEvent")
          Some(value) -> value
        let event_declarations = match definition.event_type
          None() -> [enum_type("FsmEvent", heads)]
          Some(_) -> []
        emit_fsm_parts(name_syntax, definition.state, event_type, event_declarations, fsm_handler(body))

  ## `fsm` is a transparent standard-library macro. The base state-machine is
  ## an ordinary lifted GenStatem module; transition derivation and handlers
  ## are layered on top of this floor.
  macro FsmContainers
    syntax transition <from: Code> <event: Code> <to: Code> becomes Std.Fsm.transition(from, event, to)

    syntax fsm <name: ModuleName> state <state_type: Type> derive <event_body: Code> contextual computed by derive_fsm

    syntax fsm <name: ModuleName> state <state_type: Type> transitions <table: Code> contextual becomes lift module name
      use Std.Otp
      use Std.Fsm
      behaviour gen_statem
      typealias State = state_type
      callback callback_mode() returns Atom = :handle_event_function
      callback init(initial: State) returns Effect(Tuple(Atom, Atom, State)) = %[:ok, Std.Fsm.first_state(table), initial]
      callback handle_event(event_type: Atom, event: Atom, state: Atom, data: State) returns Effect(Tuple(Atom, Atom, State)) = Std.Fsm.dispatch_atom(table, state, event, data)
      fn start_link(initial: State) -> Effect(Tuple) = beam_ops start_statem name initial

    syntax fsm <name: ModuleName> state <state_type: Type> init <init_body: delayed raw until dedent> contextual becomes lift module name
      use Std.Otp
      behaviour gen_statem
      typealias State = state_type
      callback callback_mode() returns Atom = :handle_event_function
      callback init(initial: State) returns Effect(Tuple(Atom, Atom, State)) = init_body
      callback handle_event(event_type: Atom, event: e, state: s, data: State) returns Effect(Atom) = :keep_state_and_data
      fn start_link(initial: State) -> Effect(Tuple) = beam_ops start_statem name initial

    syntax fsm <name: ModuleName> state <state_type: Type> terminate <terminate_body: delayed raw until dedent> contextual becomes lift module name
      use Std.Otp
      behaviour gen_statem
      typealias State = state_type
      callback callback_mode() returns Atom = :handle_event_function
      callback init(initial: State) returns Effect(Tuple(Atom, Atom, State)) = %[:ok, :initial, initial]
      callback handle_event(event_type: Atom, event: e, state: s, data: State) returns Effect(Atom) = :keep_state_and_data
      callback terminate(reason: r, state: s, data: State) returns Effect(Atom) = terminate_body
      fn start_link(initial: State) -> Effect(Tuple) = beam_ops start_statem name initial

    syntax fsm <name: ModuleName> state <state_type: Type> code_change <code_change_body: delayed raw until dedent> contextual becomes lift module name
      use Std.Otp
      behaviour gen_statem
      typealias State = state_type
      callback callback_mode() returns Atom = :handle_event_function
      callback init(initial: State) returns Effect(Tuple(Atom, Atom, State)) = %[:ok, :initial, initial]
      callback handle_event(event_type: Atom, event: e, state: s, data: State) returns Effect(Atom) = :keep_state_and_data
      callback code_change(old: v, state: s, data: State, extra: x) returns Effect(Tuple(Atom, Atom, State)) = code_change_body
      fn start_link(initial: State) -> Effect(Tuple) = beam_ops start_statem name initial

    syntax fsm <name: ModuleName> state <state_type: Type> events <event_type: Type> handle_event <event_body: delayed raw until dedent> contextual becomes lift module name
      use Std.Otp
      behaviour gen_statem
      typealias State = state_type
      typealias Event = event_type
      callback callback_mode() returns Atom = :handle_event_function
      callback init(initial: State) returns Effect(Tuple(Atom, Atom, State)) = %[:ok, :initial, initial]
      callback handle_event(event_type: Atom, event: Event, state: s, data: State) returns Effect(Atom) = event_body
      fn start_link(initial: State) -> Effect(Tuple) = beam_ops start_statem name initial

    syntax fsm <name: ModuleName> state <state_type: Type> initial <initial_state: Code> events <event_type: Type> transition <transition_body: delayed raw until dedent> contextual becomes lift module name
      use Std.Otp
      behaviour gen_statem
      typealias State = state_type
      typealias Event = event_type
      callback callback_mode() returns Atom = :handle_event_function
      callback init(initial: State) returns Effect(Tuple(Atom, Atom, State)) = %[:ok, initial_state, initial]
      callback handle_event(event_type: Atom, event: Event, state: Atom, data: State) returns Effect(Tuple(Atom, Atom, State)) = transition_body
      fn start_link(initial: State) -> Effect(Tuple) = beam_ops start_statem name initial

    syntax fsm <name: ModuleName> state <state_type: Type> handle_event <event_body: delayed raw until dedent> contextual becomes lift module name
      use Std.Otp
      behaviour gen_statem
      typealias State = state_type
      callback callback_mode() returns Atom = :handle_event_function
      callback init(initial: State) returns Effect(Tuple(Atom, Atom, State)) = %[:ok, :initial, initial]
      callback handle_event(event_type: Atom, event: e, state: s, data: State) returns Effect(Atom) = event_body
      fn start_link(initial: State) -> Effect(Tuple) = beam_ops start_statem name initial

    syntax fsm <name: ModuleName> state <state_type: Type> with <payload: Code> <body: raw until dedent> becomes lift module name
      use Std.Otp
      behaviour gen_statem
      typealias State = state_type
      callback callback_mode() returns Atom = :handle_event_function
      callback init(initial: State) returns Effect(Tuple(Atom, Atom, State)) = %[:ok, :initial, initial]
      callback handle_event(event_type: Atom, event: e, state: s, data: State) returns Effect(Atom) = :keep_state_and_data
      fn start_link() -> Effect(Tuple) = beam_ops start_statem name payload
      body

    syntax fsm <name: ModuleName> state <state_type: Type> <body: raw until dedent> becomes lift module name
      use Std.Otp
      behaviour gen_statem
      typealias State = state_type
      callback callback_mode() returns Atom = :handle_event_function
      callback init(initial: State) returns Effect(Tuple(Atom, Atom, State)) = %[:ok, :initial, initial]
      callback handle_event(event_type: Atom, event: e, state: s, data: State) returns Effect(Atom) = :keep_state_and_data
      fn start_link(initial: State) -> Effect(Tuple) = beam_ops start_statem name initial
      body

    syntax fsm <name: ModuleName> with <payload: Code> <body: raw until dedent> becomes lift module name
      use Std.Otp
      behaviour gen_statem
      callback callback_mode() returns Atom = :handle_event_function
      callback init(initial: p) returns Effect(Tuple(Atom, Atom, p)) = %[:ok, :initial, initial]
      callback handle_event(event_type: Atom, event: e, state: s, data: p) returns Effect(Atom) = :keep_state_and_data
      fn start_link() -> Effect(Tuple) = beam_ops start_statem name payload
      body

    syntax fsm <name: ModuleName> <body: raw until dedent> becomes lift module name
      use Std.Otp
      behaviour gen_statem
      callback callback_mode() returns Atom = :handle_event_function
      callback init(initial: p) returns Effect(Tuple(Atom, Atom, p)) = %[:ok, :initial, initial]
      callback handle_event(event_type: Atom, event: e, state: s, data: p) returns Effect(Atom) = :keep_state_and_data
      fn start_link(initial: p) -> Effect(Tuple) = beam_ops start_statem name initial
      body

  type Transition(state, event) = Row(state, event, state)
  typealias AtomTransition = Transition(Atom, Atom)

  fn emit_fsm(input: FsmSyntax, event_body: Syntax) -> Syntax =
    match derive_pattern_heads(event_body)
      InvalidHeads(reason) -> Failure(reason, [])
      Heads(heads) -> emit_fsm_parts(input.name, input.state_type, variable("FsmEvent"), [enum_type("FsmEvent", heads)], event_body)

  fn emit_fsm_parts(name_syntax: Syntax, state_type: Syntax, event_type: Syntax, event_declarations: List(Syntax), event_body: Syntax) -> Syntax =
    let module_name = match name_syntax
      Leaf(_, _, SAtom(name)) -> SAtom(name)
      _ -> SStr("Cure.Generated.Fsm")
    let module_expr = match name_syntax
      Leaf(_, _, SAtom(name)) -> atom_literal(name)
      _ -> atom_literal(:generated_fsm)
    match derive_pattern_heads(event_body)
      InvalidHeads(reason) -> Failure(reason, [])
      Heads(heads) ->
        let result_type = call("Effect", [variable("Atom")])
        let init_type = call("Effect", [tuple_type([variable("Atom"), variable("Atom"), variable("State")])])
        let start_type = call("Effect", [variable("Tuple")])
        block(append(event_declarations, [
          lift_module_isolated(module_name, :gen_statem, [
            use_module("Std.Otp"),
            alias_node("State", state_type),
            alias_node("Event", event_type),
            function("callback_mode", [], variable("Atom"), quote :handle_event_function),
            function("init", [parameter("initial", variable("State"))], init_type, quote %[:ok, :initial, initial]),
            function("handle_event", [parameter("event_type", variable("Atom")), parameter("event", variable("Event")), parameter("state", variable("Atom")), parameter("data", variable("State"))], result_type, event_body),
            function("start_link", [parameter("initial", variable("State"))], start_type, call("Std.Otp.start_statem", [module_expr, variable("initial")]))
          ])
        ]))

  fn derive_fsm(input: FsmSyntax) -> Syntax =
    emit_fsm(input, input.event_body)

  ## Family cases contain plain expression bodies. Lifted callbacks consume a
  ## checked block, so normalize each arm here in ordinary source-level syntax.
  fn fsm_handler(body: Syntax) -> Syntax = match tag(body) == :pattern_match
    true -> fsm_handler_node(attrs(body), children(body))
    false -> body

  fn fsm_handler_node(values: List(Attr), children: List(Syntax)) -> Syntax = match children
    [scrutinee | arms] -> Node(:pattern_match, values, [scrutinee | fsm_handler_arms(arms)])
    _ -> Node(:pattern_match, values, children)

  fn fsm_handler_arms(arms: List(Syntax)) -> List(Syntax) = match arms
    [] -> []
    [arm | rest] -> [fsm_handler_arm(arm) | fsm_handler_arms(rest)]

  fn fsm_handler_arm(arm: Syntax) -> Syntax = match tag(arm) == :match_arm
    true -> fsm_handler_arm_node(attrs(arm), children(arm))
    false -> arm

  fn fsm_handler_arm_node(values: List(Attr), children: List(Syntax)) -> Syntax = match children
    [body] -> Node(:match_arm, values, [block([body])])
    _ -> Node(:match_arm, values, children)

  ## A transition row is ordinary data. The macro surface above expands rows to
  ## this checked ADT so users can compose, inspect, and transform tables with
  ## normal Cure functions.
  fn transition({s: Type}, {e: Type}, from: s, event: e, to: s) -> Transition(s, e) =
    Row(from, event, to)

  ## Compatibility helper for the original atom-labelled transition-table
  ## macro. Typed callers use `first_state_or`, whose fallback has the same
  ## state type as the table.
  fn first_state(transitions: List(Transition(Atom, Atom))) -> Atom =
    match transitions
      [] -> :initial
      [Row(from, _, _) | _] -> from

  fn first_state_or({s: Type}, {e: Type}, transitions: List(Transition(s, e)), fallback: s) -> s =
    match transitions
      [] -> fallback
      [Row(from, _, _) | _] -> from

  fn dispatch({s: Type}, {e: Type}, transitions: List(Transition(s, e)), state: s, event: e, data: a) -> Tuple(Atom, s, a) where Equatable(s), Equatable(e) =
    match transitions
      [] -> %[:next_state, state, data]
      [Row(from, expected, next) | rest] -> match state == from
        true -> match event == expected
          true -> %[:next_state, next, data]
          false -> dispatch(rest, state, event, data)
        false -> dispatch(rest, state, event, data)

  ## Exact compatibility encoder used by the legacy atom-labelled table macro.
  ## Keeping it separate lets the ordinary `dispatch` algebra remain generic.
  fn dispatch_atom(transitions: List(Transition(Atom, Atom)), state: Atom, event: Atom, data: a) -> Tuple(Atom, Atom, a) =
    match transitions
      [] -> %[:next_state, state, data]
      [Row(from, expected, next) | rest] -> match state == from
        true -> match event == expected
          true -> %[:next_state, next, data]
          false -> dispatch_atom(rest, state, event, data)
        false -> dispatch_atom(rest, state, event, data)
