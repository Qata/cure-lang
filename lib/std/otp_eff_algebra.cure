@group(:concurrency)
mod Std.Otp.EffAlgebra
  ## ALGEBRAIC OTP EFFECTS (build-out map B7). The kernel `Effect(T)` former is inert
  ## (sequencing via `bind`, no laws exposed); this module builds a USER-level effect algebra
  ## and proves the LAWS a sound effect handler relies on.
  ##
  ## The OTP message operations (`OSend`/`ORecv`/`OSpawn`) carry NO result value, so an effectful
  ## program is a finite SEQUENCE of commands, and sequential composition is APPEND. The effect
  ## algebra is therefore a MONOID: `(Eff, seq, ENil)` with `seq` associative and `ENil` its
  ## unit. The three laws below (left/right identity, associativity) certify it, so effectful OTP
  ## programs can be reassociated and unit-simplified without changing meaning — exactly the
  ## rewrites an effect handler / optimiser performs. For value-LESS ops the monoid is the honest
  ## structure; the VALUE-RETURNING free monad (`HEff`/`hbind`, at the foot of the module) sits
  ## beside it now that its two former blockers are closed — a guarded-lambda `hbind` certifies
  ## total (size-change fix), and its left-identity law places a `fn`-literal continuation in a
  ## dependent `Equivalent` index (E10a: a function argument in an index position now lowers and
  ## reduces).

  type Tag = TA | TB | TC
  type Op = OSend(Tag) | ORecv(Tag) | OSpawn
  type Eff = ENil | ECons(Op, Eff)

  ## Sequential composition of effect programs = append the command sequences.
  fn seq(m: Eff, n: Eff) -> Eff = match m
    ENil()       -> n
    ECons(op, k) -> ECons(op, seq(k, n))

  ## **LEFT IDENTITY.** `ENil ; n ≡ n` — holds definitionally (`seq` recurses on its first arg).
  fn seq_nil_l(n: Eff) -> Equivalent(Eff, seq(ENil(), n), n) = reflexive(n)

  ## **RIGHT IDENTITY.** `m ; ENil ≡ m` — induction on the command sequence.
  fn seq_nil_r(m: Eff) -> Equivalent(Eff, seq(m, ENil()), m) = match m
    ENil()       -> reflexive(ENil())
    ECons(op, k) -> rewrite seq_nil_r(k) in reflexive(ECons(op, k))

  ## **ASSOCIATIVITY.** `(a ; b) ; c ≡ a ; (b ; c)` — induction on `a`; a leading command is
  ## pushed out of both regroupings, so the tail follows from the IH.
  fn seq_assoc(a: Eff, b: Eff, c: Eff) -> Equivalent(Eff, seq(seq(a, b), c), seq(a, seq(b, c))) = match a
    ENil()       -> reflexive(seq(b, c))
    ECons(op, k) -> rewrite seq_assoc(k, b, c) in reflexive(ECons(op, seq(k, seq(b, c))))

  ## **EFFECT HANDLERS.** A handler INTERPRETS an effect program into a result. Its correctness
  ## is that it respects the algebra: it is a MONOID HOMOMORPHISM from `(Eff, seq, ENil)` to the
  ## result monoid, so handling a composed program equals composing the handlings — an effect
  ## handler / interpreter can be run compositionally. Here the handler counts `OSend` operations
  ## (interpreting into `(Nat, plus, 0)`); `count_hom` proves the homomorphism law.
  fn plus(m: Nat, n: Nat) -> Nat = match m
    Z()  -> n
    S(k) -> S(plus(k, n))
  fn count_sends(e: Eff) -> Nat = match e
    ENil()       -> Z()
    ECons(op, k) -> match op
      OSend(t) -> S(count_sends(k))
      ORecv(t) -> count_sends(k)
      OSpawn() -> count_sends(k)
  fn count_hom(a: Eff, b: Eff) -> Equivalent(Nat, count_sends(seq(a, b)), plus(count_sends(a), count_sends(b))) = match a
    ENil()       -> reflexive(count_sends(b))
    ECons(op, k) -> match op
      OSend(t) -> rewrite count_hom(k, b) in reflexive(S(plus(count_sends(k), count_sends(b))))
      ORecv(t) -> count_hom(k, b)
      OSpawn() -> count_hom(k, b)

  ## **VALUE-RETURNING FREE MONAD.** The monoid above models value-LESS command sequences. A
  ## program that RETURNS a value is the free monad over the same command alphabet: `HPure(x)`
  ## returns `x`, and `HBind(e, g)` performs command `e` then continues with `g` applied to the
  ## result. `hbind` threads a continuation `(Tag) -> HEff`, so its recursive self-call sits under
  ## an unapplied `fn(y)` — guarded-lambda recursion, certified total by the size-change checker.
  type HEff = HPure(Tag) | HBind(Tag, (Tag) -> HEff)
  fn hbind(m: HEff, f: (Tag) -> HEff) -> HEff = match m
    HPure(x)    -> f(x)
    HBind(e, g) -> HBind(e, fn(y) -> hbind(g(y), f))

  ## **LEFT IDENTITY (free monad).** `hbind(HPure x, k) ≡ k x` — holds definitionally: `hbind`'s
  ## first arm returns `f(x)`, and applying the inline continuation `fn(z) -> k(z)` to `x`
  ## β-reduces to `k(x)`. The `fn(z) -> k(z)` continuation sits in the `Equivalent` INDEX — a
  ## function argument in a dependent index position, the case E10a unblocks.
  fn hbind_left_id(x: Tag, k: (Tag) -> HEff) -> Equivalent(HEff, hbind(HPure(x), fn(z) -> k(z)), k(x)) = reflexive(k(x))

  ## **INTERPRETING EITHER CARRIER (type-directed overload).** `render` interprets
  ## an effect program into a `Nat` measure — the command count for the valueless
  ## `Eff` monoid, and the top-level shape for the `HEff` free monad. It is a single
  ## bare name OVERLOADED across the two carriers, discriminated by argument type;
  ## a use site resolves by the type of what it is handed. The two laws below place
  ## that overloaded name inside an `Equivalent` INDEX — a dependent position — and
  ## the elaborator resolves it there exactly as in term position (E11: type-directed
  ## overloading reaches into type/index positions; before the fix a same-module
  ## overload in an index mis-resolved to an ambient provider and crashed the kernel).
  fn render(e: Eff) -> Nat = count_sends(e)
  fn render(h: HEff) -> Nat = match h
    HPure(x)    -> Z()
    HBind(e, g) -> S(Z())

  ## The empty program measures to zero — `render` here resolves to the `Eff` member
  ## because `ENil()` is an `Eff`.
  fn render_eff_nil() -> Equivalent(Nat, render(ENil()), Z()) = reflexive(Z())
  ## A pure free-monad program measures to zero — `render` here resolves to the
  ## `HEff` member because `HPure(t)` is an `HEff`.
  fn render_heff_pure(t: Tag) -> Equivalent(Nat, render(HPure(t)), Z()) = reflexive(Z())
end
