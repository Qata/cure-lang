@group(:collections)
mod Std.Optic
  ## Statically-typed optics: lenses, affine traversals, and traversals.
  ##
  ## An optic is a first-class, composable "path" into a data structure. Unlike the
  ## deleted `Std.Access` — which leaned on `believe_me` and runtime `is_map`/
  ## `is_tuple` dispatch over an opaque `Any` — every optic here is checked by the
  ## dependent kernel. The kind of an optic (how many foci it has, whether focusing
  ## can fail) is a STATIC index `k : OpticKind`, so `view` on a lens is total,
  ## `preview` on an affine returns `Option`, and a traversal rebuilds a structure
  ## from EXACTLY the foci it produced (a length-indexed `Vector`, so the rebuild
  ## can never be given the wrong number of elements).
  ##
  ## The representation is a single GADT family `Optic(s, a, k)` — one constructor
  ## per kind, each carrying an extraction function `s -> <focus bundle>` (the focus
  ## value(s) plus a total rebuilder back to `s`). Because the kind is a constructor
  ## index, a `match` on an optic refines `k`, so the eliminators below are written
  ## once, kind-polymorphically, and stay total at each kind. (The extraction
  ## functions are wrapped in per-kind newtypes because an arrow type does not parse
  ## directly in a GADT `indices`-form constructor field, only in an inline one.)

  use Std.Nat
  use Std.Vector
  use Std.Sigma
  use Std.Option
  use Std.List

  # ---- kinds --------------------------------------------------------------

  ## The kind of an optic, used as a static index. `LensKind` focuses exactly one
  ## value; `AffineKind` focuses zero-or-one; `TraversalKind` focuses any number.
  type OpticKind = LensKind | AffineKind | TraversalKind

  ## The least-upper-bound of two kinds under composition: composing optics of
  ## kinds `k1` and `k2` yields an optic of kind `join(k1, k2)`. A lens composed
  ## with a lens stays a lens; anything touching a traversal becomes a traversal;
  ## anything touching an affine (but no traversal) becomes an affine.
  fn join(k1: OpticKind, k2: OpticKind) -> OpticKind = match k1
    LensKind -> k2
    AffineKind -> match k2
      TraversalKind -> TraversalKind
      other -> AffineKind
    TraversalKind -> TraversalKind

  # ---- focus bundles (post-extraction) ------------------------------------

  ## A lens focus bundle: the focus value `a`, and a total rebuilder `a -> s` that
  ## puts a (possibly new) focus back into the original structure.
  type LensRep(a: Type, s: Type) = MkLensRep(a, (a) -> s)

  ## An affine focus bundle: a lens bundle if the focus is present, else nothing
  ## (the structure has no focus, e.g. the missing key of a map).
  type AffineRep(a: Type, s: Type) = MkAffineRep(Option(LensRep(a, s)))

  ## A traversal focus bundle: existentially, SOME count `n`, a `Vector` of exactly
  ## `n` foci, and a rebuilder that consumes exactly `n` replacements to rebuild the
  ## structure. The length index is what makes the rebuild total — it can only be
  ## applied to a vector of the same length it produced.
  # NOTE the parentheses around the rebuilder's domain `(Vector(a, n))`: a bare
  # `Vector(a, n) -> s` is mis-parsed as `Function(a, n, s)` (the parser splices the
  # type application's arguments into the arrow's domain list), and `n : Nat` is not
  # a type, so it fails as `:not_a_type`. Parenthesising the domain keeps it one type.
  type TravRep(a: Type, s: Type) =
    MkTravRep(Sigma(n: Nat, Sigma(v: Vector(a, n), (Vector(a, n)) -> s)))

  # ---- extraction newtypes (hide the arrow from the GADT field) -----------

  ## `s -> LensRep(a, s)`, wrapped. The wrap is only to keep an arrow out of the
  ## GADT constructor field below (arrows parse in an inline ctor field, not a
  ## GADT `indices`-form one); `MkLensExt`/`f` peel it back in one step.
  type LensExt(s: Type, a: Type) = MkLensExt((s) -> LensRep(a, s))
  type AffineExt(s: Type, a: Type) = MkAffineExt((s) -> AffineRep(a, s))
  type TravExt(s: Type, a: Type) = MkTravExt((s) -> TravRep(a, s))

  # ---- the optic family ---------------------------------------------------

  ## `Optic(s, a, k)` is the optic type for kind `k` over structure `s` with focus
  ## `a`. It is a single GADT indexed by the kind, with one constructor per kind;
  ## matching an optic value therefore refines `k`, which is what lets the
  ## eliminators dispatch on the kind while staying precisely typed at each one.
  type Optic(s: Type, a: Type) indices (k: OpticKind)
    MkLensO : LensExt(s, a) -> Optic(s, a, LensKind)
    MkAffineO : AffineExt(s, a) -> Optic(s, a, AffineKind)
    MkTravO : TravExt(s, a) -> Optic(s, a, TraversalKind)

  ## `Lens(s, a)` — an optic focusing exactly one `a` inside `s`.
  fn Lens(s: Type, a: Type) -> Type = Optic(s, a, LensKind)

  ## `Affine(s, a)` — an optic focusing zero-or-one `a` inside `s`.
  fn Affine(s: Type, a: Type) -> Type = Optic(s, a, AffineKind)

  ## `Traversal(s, a)` — an optic focusing any number of `a`s inside `s`.
  fn Traversal(s: Type, a: Type) -> Type = Optic(s, a, TraversalKind)

  # ---- lens: constructor --------------------------------------------------

  ## Build a lens from a getter and a setter. `get(x)` reads the focus; `put(y)(x)`
  ## writes `y` as the new focus of `x`.
  fn lens({s: Type}, {a: Type}, get: (s) -> a, put: (a) -> (s) -> s) -> Optic(s, a, LensKind) =
    MkLensO(MkLensExt(fn(x) -> MkLensRep(get(x), fn(y) -> put(y)(x))))

  # ---- eliminators (each total at its kind, dispatching on the static k) --

  ## Read the focus of a lens. Total: a lens always has exactly one focus — this is
  ## the concrete win over an `Access`-style getter that returns `nil`/`Option`.
  fn view({s: Type}, {a: Type}, o: Optic(s, a, LensKind), x: s) -> a =
    match o
      MkLensO(le) -> match le
        MkLensExt(f) -> match f(x)
          MkLensRep(focus, rebuild) -> focus

  ## The first focus of any optic, or `None` if it has none. Total at every kind.
  fn preview({s: Type}, {a: Type}, {k: OpticKind}, o: Optic(s, a, k), x: s) -> Option(a) =
    match o
      MkLensO(le) -> match le
        MkLensExt(f) -> match f(x)
          MkLensRep(focus, rebuild) -> Some(focus)
      MkAffineO(ae) -> match ae
        MkAffineExt(f) -> match f(x)
          MkAffineRep(opt) -> match opt
            Some(lr) -> match lr
              MkLensRep(focus, rebuild) -> Some(focus)
            None() -> None()
      MkTravO(te) -> match te
        MkTravExt(f) -> match f(x)
          MkTravRep(sig) -> match sig
            mk_pair(n, rest) -> match rest
              mk_pair(v, rebuild) -> match v
                empty() -> None()
                prepend(h, tl) -> Some(h)

  ## Transform every focus of an optic by applying `g`, rebuilding the structure.
  fn over({s: Type}, {a: Type}, {k: OpticKind}, o: Optic(s, a, k), g: (a) -> a, x: s) -> s =
    match o
      MkLensO(le) -> match le
        MkLensExt(f) -> match f(x)
          MkLensRep(focus, rebuild) -> rebuild(g(focus))
      MkAffineO(ae) -> match ae
        MkAffineExt(f) -> match f(x)
          MkAffineRep(opt) -> match opt
            Some(lr) -> match lr
              MkLensRep(focus, rebuild) -> rebuild(g(focus))
            None() -> x
      MkTravO(te) -> match te
        MkTravExt(f) -> match f(x)
          MkTravRep(sig) -> match sig
            mk_pair(n, rest) -> match rest
              mk_pair(v, rebuild) -> rebuild(Std.Vector.map(v, g))

  ## Replace every focus of an optic with `new`. `over` with a constant transform:
  ## the inline `fn(ignored) -> new` ignores the old focus. (Its `(a) -> a` domain
  ## is fixed by the later `x` argument, so it elaborates in checking mode.)
  fn set({s: Type}, {a: Type}, {k: OpticKind}, o: Optic(s, a, k), new: a, x: s) -> s =
    over(o, fn(ignored) -> new, x)

  # ---- affine: constructor ------------------------------------------------

  ## The extraction behind `affine`, factored out of the constructor lambda so its
  ## `match` body is an ordinary function (a `match` directly inside the stored
  ## lambda does not lower). `pre(x)` decides whether the focus is present; when it
  ## is, the setter `fn(new) -> put(new)(x)` is closed over `x` exactly as `lens`
  ## closes over its structure.
  fn affine_ext({s: Type}, {a: Type}, pre: (s) -> Option(a), put: (a) -> (s) -> s, x: s) -> AffineRep(a, s) =
    match pre(x)
      Some(v) -> MkAffineRep(Some(MkLensRep(v, fn(new) -> put(new)(x))))
      None() -> MkAffineRep(None())

  ## Build an affine (zero-or-one focus) from a partial getter `pre : s -> Option(a)`
  ## and a setter `put : a -> s -> s`. When `pre(x)` is `None`, `over`/`set` leave the
  ## structure untouched and `preview` yields `None`; this is the total, statically-
  ## kinded replacement for an `Access`-style "maybe this key exists" path.
  fn affine({s: Type}, {a: Type}, pre: (s) -> Option(a), put: (a) -> (s) -> s) -> Optic(s, a, AffineKind) =
    MkAffineO(MkAffineExt(fn(x) -> affine_ext(pre, put, x)))

  # ---- to_list_of: collect every focus ------------------------------------

  ## Every focus of an optic, in order, as an ordinary `List`. Total at every kind:
  ## a lens yields a one-element list, an affine zero-or-one, a traversal the whole
  ## `Vector` of foci flattened to a list. The kind-polymorphic counterpart to
  ## `preview` (which keeps only the first).
  fn to_list_of({s: Type}, {a: Type}, {k: OpticKind}, o: Optic(s, a, k), x: s) -> List(a) =
    match o
      MkLensO(le) -> match le
        MkLensExt(f) -> match f(x)
          MkLensRep(focus, rebuild) -> [focus]
      MkAffineO(ae) -> match ae
        MkAffineExt(f) -> match f(x)
          MkAffineRep(opt) -> match opt
            Some(lr) -> match lr
              MkLensRep(focus, rebuild) -> [focus]
            None() -> []
      MkTravO(te) -> match te
        MkTravExt(f) -> match f(x)
          MkTravRep(sig) -> match sig
            mk_pair(n, rest) -> match rest
              mk_pair(v, rebuild) -> Std.Vector.to_list(v)

  ## Common tuple lenses exposed through the `lens` syntax macro. The macro is
  ## only surface sugar; these are ordinary typed Std.Optic functions.
  fn first_get_int(x: Tuple(Int, Int)) -> Int = x.1
  fn first_put_int(y: Int) -> (Tuple(Int, Int)) -> Tuple(Int, Int) = fn(x) -> %[y, x.2]
  fn second_get_int(x: Tuple(Int, Int)) -> Int = x.2
  fn second_put_int(y: Int) -> (Tuple(Int, Int)) -> Tuple(Int, Int) = fn(x) -> %[x.1, y]

  fn first_lens() -> Optic(Tuple(Int, Int), Int, LensKind) =
    lens(first_get_int, first_put_int)

  fn second_lens() -> Optic(Tuple(Int, Int), Int, LensKind) =
    lens(second_get_int, second_put_int)

  macro TupleLenses
    syntax lens first becomes __optic_lens_first()
      example lens first expands first_lens()
    syntax lens second becomes __optic_lens_second()
      example lens second expands second_lens()
end
