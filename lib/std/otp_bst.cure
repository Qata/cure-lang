@group(:concurrency)
mod Std.Otp.Bst
  use Std.Equivalent
  ## ERLANG `gb_trees` / `gb_sets` — the ORDERED binary search tree OTP uses for logarithmic-time
  ## sorted maps and sets. Keys live at every node; the search invariant is that everything in the
  ## left subtree compares LESS than the node key and everything in the right compares GREATER, so
  ## `member` and `insert` can steer by a single comparison at each node instead of scanning.
  ##
  ## Keys are drawn from a fixed finite domain `KA < KB < KC` with a total `kcmp`. Working over a
  ## concrete domain lets `kcmp(k, v)` REDUCE at proof time, so the search-tree laws hold by
  ## computation and 9-way key casing rather than needing abstract order lemmas — the same technique
  ## the `Std.Otp.Set` membership proofs use.

  type Key = KA | KB | KC
  type Cmp = KLt | KEq | KGt
  type B = F | T

  ## The total order on keys: KA < KB < KC.
  fn kcmp(a: Key, b: Key) -> Cmp = match a
    KA() -> match b
      KA() -> KEq()
      KB() -> KLt()
      KC() -> KLt()
    KB() -> match b
      KA() -> KGt()
      KB() -> KEq()
      KC() -> KLt()
    KC() -> match b
      KA() -> KGt()
      KB() -> KGt()
      KC() -> KEq()

  type Tree = Leaf | Node(Tree, Key, Tree)

  ## Membership steers by the comparison: go left when smaller, right when larger, hit at equal.
  fn member(k: Key, t: Tree) -> B = match t
    Leaf()        -> F()
    Node(l, v, r) -> match kcmp(k, v)
      KLt() -> member(k, l)
      KEq() -> T()
      KGt() -> member(k, r)

  ## Insert steers the same way, so the search invariant is preserved: a new key lands on the side
  ## its comparison dictates, and re-inserting an existing key is a no-op.
  fn insert(k: Key, t: Tree) -> Tree = match t
    Leaf()        -> Node(Leaf(), k, Leaf())
    Node(l, v, r) -> match kcmp(k, v)
      KLt() -> Node(insert(k, l), v, r)
      KEq() -> Node(l, v, r)
      KGt() -> Node(l, v, insert(k, r))

  ## The empty tree has no members — the base of every search.
  fn member_leaf(k: Key) -> Equivalent(B, member(k, Leaf()), F()) = reflexive(F())

  ## **A SEARCH-TREE INSERT MAKES THE KEY FINDABLE.** `member(k, insert(k, t)) = T` — after inserting
  ## `k`, a subsequent search for `k` succeeds, no matter the tree's shape. `member` and `insert`
  ## steer by the SAME `kcmp(k, v)`, so at each node they take matching branches: on a hit (`k = v`)
  ## both stop and membership is `T`; on `KLt`/`KGt` both descend the same subtree and the induction
  ## hypothesis carries. Casing `k` and each node key `v` over the finite domain makes every
  ## comparison reduce.
  fn insert_member(k: Key, t: Tree) -> Equivalent(B, member(k, insert(k, t)), T()) = match t
    Leaf()        -> match k
      KA() -> reflexive(T())
      KB() -> reflexive(T())
      KC() -> reflexive(T())
    Node(l, v, r) -> match k
      KA() -> match v
        KA() -> reflexive(T())
        KB() -> insert_member(KA(), l)
        KC() -> insert_member(KA(), l)
      KB() -> match v
        KA() -> insert_member(KB(), r)
        KB() -> reflexive(T())
        KC() -> insert_member(KB(), l)
      KC() -> match v
        KA() -> insert_member(KC(), r)
        KB() -> insert_member(KC(), r)
        KC() -> reflexive(T())

  ## **INSERT PRESERVES EVERY OTHER MEMBER.** `member(x, t) = T ⟹ member(x, insert(k, t)) = T` — a
  ## search-tree insert never evicts a key already present, whatever `k` is. `insert` keeps the root
  ## key `v` at every node (it only rebuilds one subtree), so `member(x, insert(k, t))` steers by the
  ## SAME `kcmp(x, v)` as `member(x, t)`: on a hit (`x = v`) the result is `T` immediately; otherwise
  ## `x` descends to its fixed side, and either `k` went the same way (recurse — the induction
  ## hypothesis) or `k` touched the other side / the root and that subtree is untouched (the premise
  ## `e` carries verbatim). Casing `x`, the node key `v`, and `k` (27-way) makes every comparison
  ## reduce. At a `Leaf` the premise is `member(x, Leaf) = F = T`, uninhabited — an empty `match e`.
  fn insert_preserves(x: Key, k: Key, t: Tree, e: Equivalent(B, member(x, t), T())) -> Equivalent(B, member(x, insert(k, t)), T()) = match t
    Leaf()        -> match e
    Node(l, v, r) -> match x
      KA() -> match v
        KA() -> match k
          KA() -> reflexive(T())
          KB() -> reflexive(T())
          KC() -> reflexive(T())
        KB() -> match k
          KA() -> insert_preserves(KA(), KA(), l, e)
          KB() -> e
          KC() -> e
        KC() -> match k
          KA() -> insert_preserves(KA(), KA(), l, e)
          KB() -> insert_preserves(KA(), KB(), l, e)
          KC() -> e
      KB() -> match v
        KA() -> match k
          KA() -> e
          KB() -> insert_preserves(KB(), KB(), r, e)
          KC() -> insert_preserves(KB(), KC(), r, e)
        KB() -> match k
          KA() -> reflexive(T())
          KB() -> reflexive(T())
          KC() -> reflexive(T())
        KC() -> match k
          KA() -> insert_preserves(KB(), KA(), l, e)
          KB() -> insert_preserves(KB(), KB(), l, e)
          KC() -> e
      KC() -> match v
        KA() -> match k
          KA() -> e
          KB() -> insert_preserves(KC(), KB(), r, e)
          KC() -> insert_preserves(KC(), KC(), r, e)
        KB() -> match k
          KA() -> e
          KB() -> e
          KC() -> insert_preserves(KC(), KC(), r, e)
        KC() -> match k
          KA() -> reflexive(T())
          KB() -> reflexive(T())
          KC() -> reflexive(T())

  ## Key equality and boolean OR, to state the COMPLETE insert law.
  fn keq(x: Key, k: Key) -> B = match x
    KA() -> match k
      KA() -> T()
      KB() -> F()
      KC() -> F()
    KB() -> match k
      KA() -> F()
      KB() -> T()
      KC() -> F()
    KC() -> match k
      KA() -> F()
      KB() -> F()
      KC() -> T()
  fn orb(a: B, b: B) -> B = match a
    F() -> b
    T() -> T()

  ## **INSERT ADDS EXACTLY THE KEY (complete characterization).** `member(x, insert(k, t)) =
  ## keq(x, k) or member(x, t)` — after inserting `k`, `x` is a member iff `x` IS `k` or `x` was
  ## already there. This single law subsumes `insert_member` (take `x = k`) and `insert_preserves`
  ## (take `member(x, t) = T`), and also settles the remaining case (`x ≠ k`, `x ∉ t` ⟹ still
  ## absent). `insert` keeps each root key, so `member` steers by the same `kcmp(x, v)` on both
  ## sides; casing `x`/`v`/`k` reduces every comparison — a hit gives `T`, an off-side descent
  ## leaves that subtree untouched (and `keq(x, k) = F`, so `orb` is the identity there), and a
  ## same-side descent is the induction hypothesis.
  fn insert_spec(x: Key, k: Key, t: Tree) -> Equivalent(B, member(x, insert(k, t)), orb(keq(x, k), member(x, t))) = match t
    Leaf()        -> match x
      KA() -> match k
        KA() -> reflexive(T())
        KB() -> reflexive(F())
        KC() -> reflexive(F())
      KB() -> match k
        KA() -> reflexive(F())
        KB() -> reflexive(T())
        KC() -> reflexive(F())
      KC() -> match k
        KA() -> reflexive(F())
        KB() -> reflexive(F())
        KC() -> reflexive(T())
    Node(l, v, r) -> match x
      KA() -> match v
        KA() -> match k
          KA() -> reflexive(T())
          KB() -> reflexive(T())
          KC() -> reflexive(T())
        KB() -> match k
          KA() -> insert_spec(KA(), KA(), l)
          KB() -> reflexive(member(KA(), l))
          KC() -> reflexive(member(KA(), l))
        KC() -> match k
          KA() -> insert_spec(KA(), KA(), l)
          KB() -> insert_spec(KA(), KB(), l)
          KC() -> reflexive(member(KA(), l))
      KB() -> match v
        KA() -> match k
          KA() -> reflexive(member(KB(), r))
          KB() -> insert_spec(KB(), KB(), r)
          KC() -> insert_spec(KB(), KC(), r)
        KB() -> match k
          KA() -> reflexive(T())
          KB() -> reflexive(T())
          KC() -> reflexive(T())
        KC() -> match k
          KA() -> insert_spec(KB(), KA(), l)
          KB() -> insert_spec(KB(), KB(), l)
          KC() -> reflexive(member(KB(), l))
      KC() -> match v
        KA() -> match k
          KA() -> reflexive(member(KC(), r))
          KB() -> insert_spec(KC(), KB(), r)
          KC() -> insert_spec(KC(), KC(), r)
        KB() -> match k
          KA() -> reflexive(member(KC(), r))
          KB() -> reflexive(member(KC(), r))
          KC() -> insert_spec(KC(), KC(), r)
        KC() -> match k
          KA() -> reflexive(T())
          KB() -> reflexive(T())
          KC() -> reflexive(T())

  ## `orb` congruence in its second argument, and the swap law `a or (b or c) = b or (a or c)` — the
  ## boolean algebra needed to reorder two independent `keq` guards.
  fn orb_cong_r(a: B, {b: B}, {b2: B}, e: Equivalent(B, b, b2)) -> Equivalent(B, orb(a, b), orb(a, b2)) =
    rewrite e in reflexive(orb(a, b2))
  fn orb_swap(a: B, b: B, c: B) -> Equivalent(B, orb(a, orb(b, c)), orb(b, orb(a, c))) = match a
    F() -> reflexive(orb(b, c))
    T() -> match b
      F() -> reflexive(T())
      T() -> reflexive(T())

  ## **INSERTS COMMUTE (at the membership level).** `member(x, insert(j, insert(k, t))) = member(x,
  ## insert(k, insert(j, t)))` — inserting two keys in either order yields the SAME membership set,
  ## even though the two trees differ structurally. Derived entirely from the capstone `insert_spec`:
  ## each side unfolds to `keq(x, j) or (keq(x, k) or member(x, t))` (modulo `orb` congruence), and
  ## the two guard orders are interchanged by `orb_swap`. No tree casing — a purely algebraic
  ## consequence of "insert adds exactly one key".
  fn insert_comm(x: Key, j: Key, k: Key, t: Tree) -> Equivalent(B, member(x, insert(j, insert(k, t))), member(x, insert(k, insert(j, t)))) =
    trans(insert_spec(x, j, insert(k, t)),
      trans(orb_cong_r(keq(x, j), insert_spec(x, k, t)),
        trans(orb_swap(keq(x, j), keq(x, k), member(x, t)),
          trans(orb_cong_r(keq(x, k), sym(insert_spec(x, j, t))),
            sym(insert_spec(x, k, insert(j, t)))))))
end
