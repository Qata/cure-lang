@group(:concurrency)
mod Std.Supervisor
  use Std.Syntax
  use Std.Otp.Raw

  ## The structured supervisor surface is source-defined.
  macro sup <name: ModuleName>
    syntax family SupervisorDefinition
      children Code
    accepts SupervisorDefinition
    expands with derive_supervisor_family

  fn derive_supervisor_family(name: ModuleNameSyntax, definition: SupervisorDefinitionSyntax) -> Syntax =
    let name_syntax: Syntax = name
    let module_name: SynLit = match name_syntax
      Leaf(_, _, SAtom(value)) -> SAtom(value)
      _ -> SStr("Cure.Generated.Supervisor")
    let module_expr: Syntax = match name_syntax
      Leaf(_, _, SAtom(value)) -> atom_literal(value)
      _ -> atom_literal(:generated_supervisor)
    let strategy = call("supervision_strategy", [call("one_for_one", []), int_literal(3), call("more", [int_literal(4)])])
    let init_body = quote %[:ok, %[$(strategy), $(definition.children)]]
    let strategy_type = tuple_type([variable("Atom"), variable("Nat"), variable("Nat")])
    let init_type = call("Effect", [tuple_type([variable("Atom"), tuple_type([strategy_type, call("List", [variable("ChildSpec")])])])])
    lift_module_isolated(module_name, :supervisor, [
      use_module("Std.Otp"),
      use_module("Std.Beam"),
      use_module("Std.Supervisor"),
      function("init", [parameter("arg", call("List", [variable("p")]))], init_type, init_body),
      function("start_link", [], call("Effect", [variable("Tuple")]), call("Std.Otp.start_supervisor", [module_expr]))
    ])

  ## `sup` is a transparent standard-library macro. The empty supervisor floor
  ## is a normal lifted module; child-spec declarations are added as checked
  ## syntax in the next algebra slice.
  macro SupervisorContainers
    syntax child_spec <module: ModuleName> <id: Atom> raw with <args: Code> contextual becomes Std.Supervisor.child_with_raw_args(module, id, args, Std.Supervisor.permanent(), Std.Supervisor.shutdown_after(5000), Std.Supervisor.worker())
    syntax child_spec <module: ModuleName> <id: Atom> with <args: Code> contextual becomes Std.Supervisor.child_with_typed_args(module, id, args, Std.Supervisor.permanent(), Std.Supervisor.shutdown_after(5000), Std.Supervisor.worker())
    syntax child_spec <module: ModuleName> <id: Atom> becomes Std.Supervisor.child(module, id)


  type Restart = Permanent | Temporary | Transient
  type Shutdown = Brutal | Timeout(Nat)
  type ChildType = Worker | Supervisor
  type Strategy = OneForOne | OneForAll | RestForOne
  type Positive = One | More(Nat)

  typealias StrategySpec = Tuple(Atom, Nat, Nat)
  typealias ChildSpec = Tuple(RawTerm, Tuple(Atom, Atom, List(RawTerm)), Atom, Nat, Atom, List(Atom))

  fn permanent() -> Restart = Permanent()
  fn temporary() -> Restart = Temporary()
  fn transient() -> Restart = Transient()

  fn brutal_shutdown() -> Shutdown = Brutal()
  fn shutdown_after(timeout: Nat) -> Shutdown = Timeout(timeout)

  fn worker() -> ChildType = Worker()
  fn supervisor() -> ChildType = Supervisor()

  fn one_for_one() -> Strategy = OneForOne()
  fn one_for_all() -> Strategy = OneForAll()
  fn rest_for_one() -> Strategy = RestForOne()

  fn one() -> Positive = One()
  fn more(n: Nat) -> Positive = More(n)

  ## Convert the closed strategy vocabulary to the ordinary supervisor tuple.
  ## The strategy itself cannot be an arbitrary atom at a checked call site.
  ## OTP permits zero restart intensity, but its restart period must be
  ## strictly positive. `Positive` encodes that distinction without an
  ## assertion or unchecked integer conversion.
  local fn positive_nat(period: Positive) -> Nat =
    match period
      One() -> S(Z())
      More(n) -> S(n)

  fn supervision_strategy(strategy: Strategy, intensity: Nat, period: Positive) -> StrategySpec =
    match strategy
      OneForOne() -> %[:one_for_one, intensity, positive_nat(period)]
      OneForAll() -> %[:one_for_all, intensity, positive_nat(period)]
      RestForOne() -> %[:rest_for_one, intensity, positive_nat(period)]

  local fn restart_atom(restart: Restart) -> Atom =
    match restart
      Permanent() -> :permanent
      Temporary() -> :temporary
      Transient() -> :transient

  local fn shutdown_value(shutdown: Shutdown) -> Nat =
    match shutdown
      Brutal() -> Z()
      Timeout(timeout) -> timeout

  local fn child_type_atom(child_type: ChildType) -> Atom =
    match child_type
      Worker() -> :worker
      Supervisor() -> :supervisor

  ## The MFA argument list is polymorphic for direct homogeneous child specs.
  ## Heterogeneous supervisor lists still require the raw BEAM term boundary.
  fn child_with_args({a: Type}, module: Atom, id: Atom, args: List(a), restart: Restart, shutdown: Shutdown, child_type: ChildType) -> Tuple(RawTerm, Tuple(Atom, Atom, List(a)), Atom, Nat, Atom, List(Atom)) =
    %[raw_arg(id), %[module, :start_link, args], restart_atom(restart), shutdown_value(shutdown), child_type_atom(child_type), [module]]

  local fn raw_args({a: Type}, args: List(a)) -> List(RawTerm) =
    match args
      [] -> []
      [head | tail] -> [raw_arg(head) | raw_args(tail)]

  fn child_with_typed_args({a: Type}, module: Atom, id: Atom, args: List(a), restart: Restart, shutdown: Shutdown, child_type: ChildType) -> ChildSpec =
    child_with_raw_args(module, id, raw_args(args), restart, shutdown, child_type)

  ## Explicit raw-term child arguments for a heterogeneous BEAM MFA list.
  ## Every element must cross `raw_arg/1` at the call site; no typed value is
  ## silently widened by this constructor.
  fn raw_arg({a: Type}, value: a) -> RawTerm = raw_term(1, %[value, :raw_term])

  fn child_with_raw_args(module: Atom, id: Atom, args: List(RawTerm), restart: Restart, shutdown: Shutdown, child_type: ChildType) -> ChildSpec =
    %[raw_arg(id), %[module, :start_link, args], restart_atom(restart), shutdown_value(shutdown), child_type_atom(child_type), [module]]

  fn child_with(module: Atom, id: Atom, restart: Restart, shutdown: Shutdown, child_type: ChildType) -> ChildSpec =
    %[raw_arg(id), %[module, :start_link, assert_type [] : List(RawTerm)], restart_atom(restart), shutdown_value(shutdown), child_type_atom(child_type), [module]]

  fn child(module: Atom, id: Atom) -> ChildSpec =
    child_with(module, id, permanent(), shutdown_after(5000), worker())

  ## Preferred typed-ID boundary. The caller resolves `BeamEncode(id)` and passes
  ## the resulting opaque term here; macro expansion itself carries no hidden
  ## dictionary argument. At runtime the term is the exact supervisor child ID.
  fn encoded_child(module: Atom, id: RawTerm) -> ChildSpec =
    %[id, %[module, :start_link, assert_type [] : List(RawTerm)], restart_atom(permanent()), shutdown_value(shutdown_after(5000)), child_type_atom(worker()), [module]]

  ## Replace the compatibility atom ID in an otherwise checked child spec. This
  ## lets `child_spec Module :placeholder` continue to perform ModuleName
  ## reflection while the preferred identity comes from `BeamEncode`.
  @extern(:erlang, :setelement, 3)
  local fn replace_child_id(index: Int, spec: ChildSpec, id: RawTerm) -> ChildSpec

  fn with_encoded_id(spec: ChildSpec, id: RawTerm) -> ChildSpec =
    replace_child_id(1, spec, id)
