@group(:concurrency)
mod Std.Supervisor
  ## `sup` is a transparent standard-library macro. The empty supervisor floor
  ## is a normal lifted module; child-spec declarations are added as checked
  ## syntax in the next algebra slice.
  macro SupervisorContainers
    syntax child_spec <module: ModuleName> <id: Atom> with <args: Code> contextual becomes Std.Supervisor.child_with_args(module, id, args, Std.Supervisor.permanent(), Std.Supervisor.shutdown_after(5000), Std.Supervisor.worker())
    syntax child_spec <module: ModuleName> <id: Atom> becomes Std.Supervisor.child(module, id)

    syntax sup <name: ModuleName> children <children: Code> contextual becomes lift module name
      use Std.Otp
      use Std.Supervisor
      behaviour supervisor
      callback init(arg: List(p)) returns Effect(Tuple(Atom, Tuple(Tuple(Atom, Nat, Nat), List(ChildSpec)))) = %[:ok, %[supervision_strategy(one_for_one(), 3, more(4)), children]]
      fn start_link() -> Effect(Tuple) = beam_ops start_supervisor name

    syntax sup <name: ModuleName> with <payload: Code> <body: raw until dedent> becomes lift module name
      use Std.Otp
      use Std.Supervisor
      behaviour supervisor
      callback init(arg: List(p)) returns Effect(Tuple(Atom, Tuple(Tuple(Atom, Nat, Nat), List(Atom)))) = %[:ok, %[supervision_strategy(one_for_one(), 3, more(4)), assert_type [] : List(Atom)]]
      fn start_link() -> Effect(Tuple) = beam_ops start_supervisor name [payload]
      body

    syntax sup <name: ModuleName> <body: raw until dedent> becomes lift module name
      use Std.Otp
      use Std.Supervisor
      behaviour supervisor
      callback init(arg: List(p)) returns Effect(Tuple(Atom, Tuple(Tuple(Atom, Nat, Nat), List(Atom)))) = %[:ok, %[supervision_strategy(one_for_one(), 3, more(4)), assert_type [] : List(Atom)]]
      fn start_link() -> Effect(Tuple) = beam_ops start_supervisor name
      body

  type Restart = Permanent | Temporary | Transient
  type Shutdown = Brutal | Timeout(Nat)
  type ChildType = Worker | Supervisor
  type Strategy = OneForOne | OneForAll | RestForOne
  type Positive = One | More(Nat)

  typealias StrategySpec = Tuple(Atom, Nat, Nat)
  typealias ChildSpec = Tuple(Atom, Tuple(Atom, Atom, List(Atom)), Atom, Nat, Atom, List(Atom))

  fn permanent() -> Restart = Permanent()
  fn temporary() -> Restart = Temporary()
  fn transient() -> Restart = Transient()

  fn brutal_shutdown() -> Shutdown = Brutal()
  fn shutdown_after(timeout: Nat) -> Shutdown = Timeout(timeout)

  fn worker() -> ChildType = Worker()
  fn supervisor() -> ChildType = Supervisor()

  fn one_for_one() -> Strategy = OneForOne()
  fn one_for_all() -> Strategy = OneForAll()
  fn rest_for_one() -> Strategy = RestForOne()

  fn one() -> Positive = One()
  fn more(n: Nat) -> Positive = More(n)

  ## Convert the closed strategy vocabulary to the ordinary supervisor tuple.
  ## The strategy itself cannot be an arbitrary atom at a checked call site.
  ## OTP permits zero restart intensity, but its restart period must be
  ## strictly positive. `Positive` encodes that distinction without an
  ## assertion or unchecked integer conversion.
  local fn positive_nat(period: Positive) -> Nat =
    match period
      One() -> S(Z())
      More(n) -> S(n)

  fn supervision_strategy(strategy: Strategy, intensity: Nat, period: Positive) -> StrategySpec =
    match strategy
      OneForOne() -> %[:one_for_one, intensity, positive_nat(period)]
      OneForAll() -> %[:one_for_all, intensity, positive_nat(period)]
      RestForOne() -> %[:rest_for_one, intensity, positive_nat(period)]

  local fn restart_atom(restart: Restart) -> Atom =
    match restart
      Permanent() -> :permanent
      Temporary() -> :temporary
      Transient() -> :transient

  local fn shutdown_value(shutdown: Shutdown) -> Nat =
    match shutdown
      Brutal() -> Z()
      Timeout(timeout) -> timeout

  local fn child_type_atom(child_type: ChildType) -> Atom =
    match child_type
      Worker() -> :worker
      Supervisor() -> :supervisor

  ## The MFA argument list is polymorphic for direct homogeneous child specs.
  ## Heterogeneous supervisor lists still require the raw BEAM term boundary.
  fn child_with_args({a: Type}, module: Atom, id: Atom, args: List(a), restart: Restart, shutdown: Shutdown, child_type: ChildType) -> Tuple(Atom, Tuple(Atom, Atom, List(a)), Atom, Nat, Atom, List(Atom)) =
    %[id, %[module, :start_link, args], restart_atom(restart), shutdown_value(shutdown), child_type_atom(child_type), [module]]

  fn child_with(module: Atom, id: Atom, restart: Restart, shutdown: Shutdown, child_type: ChildType) -> ChildSpec =
    %[id, %[module, :start_link, assert_type [] : List(Atom)], restart_atom(restart), shutdown_value(shutdown), child_type_atom(child_type), [module]]

  fn child(module: Atom, id: Atom) -> ChildSpec =
    child_with(module, id, permanent(), shutdown_after(5000), worker())

  ## Start, stop, and introspect Cure supervisor trees.
  ##
  ## Each Cure `sup` declaration compiles to a loaded BEAM module that
  ## implements the `:supervisor` behaviour. New declarations start through
  ## the transparent `beam_ops start_supervisor` operation.
  ##
  ## ## Examples
  ##
  ## ```cure
  ## use Std.Supervisor
  ##
  ## beam_ops start_supervisor :"MyApp.Root"
  ## ```

  ## Group tag consumed by `Cure.Stdlib.Preload`.
  ## Start a compiled Cure supervisor module. Returns the top-level
  ## supervisor pid on success.
  @extern(Elixir.Cure.Sup.Builtins, :sup_start, 1)
  fn start(sup_module: Atom) -> Pid

  ## Start a compiled Cure supervisor with an explicit initial
  ## argument that is threaded into its `init/1` callback.
  @extern(Elixir.Cure.Sup.Builtins, :sup_start_with, 2)
  fn start_with({a: Type}, sup_module: Atom, init: a) -> Pid

  ## Stop a running supervisor tree.
  @extern(Elixir.Cure.Sup.Builtins, :sup_stop, 1)
  fn stop(sup_module: Atom) -> Atom

  ## Return the list of `%[id, child_pid, type, modules]` tuples for
  ## the supervisor's direct children.
  @extern(Elixir.Cure.Sup.Builtins, :sup_which_children, 1)
  fn which_children(sup_module: Atom) -> List(Tuple)

  ## Count children grouped by type, as `%{type => count}`.
  @extern(Elixir.Cure.Sup.Builtins, :sup_count_children, 1)
  fn count_children(sup_module: Atom) -> Map

  ## Look up a running supervisor's pid by its compiled module atom.
  ## Returns `nil` when no such tree is running.
  @extern(Elixir.Cure.Sup.Builtins, :sup_lookup, 1)
  fn lookup(sup_module: Atom) -> Pid

  ## List every supervisor tree the runtime is currently tracking.
  @extern(Elixir.Cure.Sup.Builtins, :sup_list, 0)
  fn list() -> List(Atom)
