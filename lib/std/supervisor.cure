@group(:concurrency)
mod Std.Supervisor
  ## `sup` is a transparent standard-library macro. The empty supervisor floor
  ## is a normal lifted module; child-spec declarations are added as checked
  ## syntax in the next algebra slice.
  macro SupervisorContainers
    syntax sup <name: ModuleName> children <children: Code> contextual becomes lift module name
      use Std.Otp
      use Std.Supervisor
      behaviour supervisor
      callback init(arg: List(p)) returns Tuple(Atom, Tuple(Tuple(Atom, Int, Int), List(ChildSpec))) = %[:ok, %[Std.Supervisor.supervision_strategy(Std.Supervisor.one_for_one(), 3, 5), children]]
      fn start_link() -> Effect(Tuple) = Std.Otp.start_supervisor(name)

    syntax sup <name: ModuleName> with <payload: Code> <body: raw until dedent> becomes lift module name
      use Std.Otp
      use Std.Supervisor
      behaviour supervisor
      callback init(arg: List(p)) returns Tuple(Atom, Tuple(Tuple(Atom, Int, Int), List(Atom))) = %[:ok, %[Std.Supervisor.supervision_strategy(Std.Supervisor.one_for_one(), 3, 5), assert_type [] : List(Atom)]]
      fn start_link() -> Effect(Tuple) = Std.Otp.start_supervisor_with(name, [payload])
      body

    syntax sup <name: ModuleName> <body: raw until dedent> becomes lift module name
      use Std.Otp
      use Std.Supervisor
      behaviour supervisor
      callback init(arg: List(p)) returns Tuple(Atom, Tuple(Tuple(Atom, Int, Int), List(Atom))) = %[:ok, %[Std.Supervisor.supervision_strategy(Std.Supervisor.one_for_one(), 3, 5), assert_type [] : List(Atom)]]
      fn start_link() -> Effect(Tuple) = Std.Otp.start_supervisor(name)
      body

  type Restart = Permanent | Temporary | Transient
  type Shutdown = Brutal | Timeout(Int)
  type ChildType = Worker | Supervisor
  type Strategy = OneForOne | OneForAll | RestForOne

  typealias StrategySpec = Tuple(Atom, Int, Int)
  typealias ChildSpec = Tuple(Atom, Tuple(Atom, Atom, List(Atom)), Atom, Int, Atom, List(Atom))

  fn permanent() -> Restart = Permanent()
  fn temporary() -> Restart = Temporary()
  fn transient() -> Restart = Transient()

  fn brutal_shutdown() -> Shutdown = Brutal()
  fn shutdown_after(timeout: Int) -> Shutdown = Timeout(timeout)

  fn worker() -> ChildType = Worker()
  fn supervisor() -> ChildType = Supervisor()

  fn one_for_one() -> Strategy = OneForOne()
  fn one_for_all() -> Strategy = OneForAll()
  fn rest_for_one() -> Strategy = RestForOne()

  ## Convert the closed strategy vocabulary to the ordinary supervisor tuple.
  ## The strategy itself cannot be an arbitrary atom at a checked call site.
  fn supervision_strategy(strategy: Strategy, intensity: Int, period: Int) -> StrategySpec =
    match strategy
      OneForOne() -> %[:one_for_one, intensity, period]
      OneForAll() -> %[:one_for_all, intensity, period]
      RestForOne() -> %[:rest_for_one, intensity, period]

  local fn restart_atom(restart: Restart) -> Atom =
    match restart
      Permanent() -> :permanent
      Temporary() -> :temporary
      Transient() -> :transient

  local fn shutdown_value(shutdown: Shutdown) -> Int =
    match shutdown
      Brutal() -> 0
      Timeout(timeout) -> timeout

  local fn child_type_atom(child_type: ChildType) -> Atom =
    match child_type
      Worker() -> :worker
      Supervisor() -> :supervisor

  fn child_with(module: Atom, id: Atom, restart: Restart, shutdown: Shutdown, child_type: ChildType) -> ChildSpec =
    %[id, %[module, :start_link, []], restart_atom(restart), shutdown_value(shutdown), child_type_atom(child_type), [module]]

  fn child(module: Atom, id: Atom) -> ChildSpec =
    child_with(module, id, permanent(), shutdown_after(5000), worker())

  ## Start, stop, and introspect Cure supervisor trees.
  ##
  ## Each Cure `sup` container compiles to a loaded BEAM module that
  ## implements the `:supervisor` behaviour. The functions below
  ## delegate to `Cure.Sup.Runtime`, which wraps `:supervisor` with
  ## a tiny ETS registry so a tree can be reached by its compiled
  ## module atom without threading pids through user code.
  ##
  ## ## Examples
  ##
  ## ```cure
  ## use Std.Supervisor
  ##
  ## start(:"Cure.Sup.MyRoot")
  ## which_children(:"Cure.Sup.MyRoot")
  ## stop(:"Cure.Sup.MyRoot")
  ## ```

  ## Group tag consumed by `Cure.Stdlib.Preload`.
  ## Start a compiled Cure supervisor module. Returns the top-level
  ## supervisor pid on success.
  @extern(Elixir.Cure.Sup.Builtins, :sup_start, 1)
  fn start(sup_module: Atom) -> Pid

  ## Start a compiled Cure supervisor with an explicit initial
  ## argument that is threaded into its `init/1` callback.
  @extern(Elixir.Cure.Sup.Builtins, :sup_start_with, 2)
  fn start_with(sup_module: Atom, init: Any) -> Pid

  ## Stop a running supervisor tree.
  @extern(Elixir.Cure.Sup.Builtins, :sup_stop, 1)
  fn stop(sup_module: Atom) -> Atom

  ## Return the list of `%[id, child_pid, type, modules]` tuples for
  ## the supervisor's direct children.
  @extern(Elixir.Cure.Sup.Builtins, :sup_which_children, 1)
  fn which_children(sup_module: Atom) -> List(Tuple)

  ## Count children grouped by type, as `%{type => count}`.
  @extern(Elixir.Cure.Sup.Builtins, :sup_count_children, 1)
  fn count_children(sup_module: Atom) -> Map

  ## Look up a running supervisor's pid by its compiled module atom.
  ## Returns `nil` when no such tree is running.
  @extern(Elixir.Cure.Sup.Builtins, :sup_lookup, 1)
  fn lookup(sup_module: Atom) -> Pid

  ## List every supervisor tree the runtime is currently tracking.
  @extern(Elixir.Cure.Sup.Builtins, :sup_list, 0)
  fn list() -> List(Atom)
