@group(:text)
mod Std.Regex.Proof
  use Std.Regex

  ## Structural execution law for the evidence VM. Thompson constructors append
  ## their own evidence instructions to child routines; this view recovers the
  ## exact intermediate evidence/capture state and both checked executions.
  type AppendedRoutineExecution indices (left: List(EvidenceInstruction), right: List(EvidenceInstruction), input_evidence: List(Evidence), input_captures: List(CaptureFrame), output_evidence: List(Evidence), output_captures: List(CaptureFrame))
    AppendedRoutineExecuted : (middle_evidence: List(Evidence)) -> (middle_captures: List(CaptureFrame)) -> (left_execution: RoutineExecution(left, input_evidence, input_captures, middle_evidence, middle_captures)) -> (right_execution: RoutineExecution(right, middle_evidence, middle_captures, output_evidence, output_captures)) -> AppendedRoutineExecution(left, right, input_evidence, input_captures, output_evidence, output_captures)

  fn split_appended_routine_execution(left: List(EvidenceInstruction), right: List(EvidenceInstruction), input_evidence: List(Evidence), input_captures: List(CaptureFrame), {output_evidence: List(Evidence)}, {output_captures: List(CaptureFrame)}, execution: RoutineExecution(append_routine(left, right), input_evidence, input_captures, output_evidence, output_captures)) -> AppendedRoutineExecution(left, right, input_evidence, input_captures, output_evidence, output_captures) = match left
    Nil() -> AppendedRoutineExecuted(input_evidence, input_captures, RoutineDone(), execution)
    Cons(instruction, rest) -> match execution
      RoutineStep(_, suffix) -> match split_appended_routine_execution(rest, right, executed_evidence(execute_instruction(instruction, input_evidence, input_captures)), executed_captures(execute_instruction(instruction, input_evidence, input_captures)), suffix)
        AppendedRoutineExecuted(middle_evidence, middle_captures, left_execution, right_execution) -> AppendedRoutineExecuted(middle_evidence, middle_captures, RoutineStep(instruction, left_execution), right_execution)

  fn left_marker_execution_encodes({left: ShapeCode}, {right: ShapeCode}, {branch_evidence: List(Evidence)}, {rest: List(Evidence)}, {captures: List(CaptureFrame)}, @erased branch: Encodes(left, branch_evidence, rest), execution: RoutineExecution(Cons(EmitLeft(), Nil()), branch_evidence, captures, Cons(LeftEvidence(), branch_evidence), captures)) -> Encodes(ChoiceC(left, right), Cons(LeftEvidence(), branch_evidence), rest) = match execution
    RoutineStep(_, suffix) -> match suffix
      RoutineDone() -> EncodesLeft(branch)

  fn right_marker_execution_encodes({left: ShapeCode}, {right: ShapeCode}, {branch_evidence: List(Evidence)}, {rest: List(Evidence)}, {captures: List(CaptureFrame)}, @erased branch: Encodes(right, branch_evidence, rest), execution: RoutineExecution(Cons(EmitRight(), Nil()), branch_evidence, captures, Cons(RightEvidence(), branch_evidence), captures)) -> Encodes(ChoiceC(left, right), Cons(RightEvidence(), branch_evidence), rest) = match execution
    RoutineStep(_, suffix) -> match suffix
      RoutineDone() -> EncodesRight(branch)

  ## The proof-relevant core of MachineAcceptance. The replay certificate is an
  ## execution artifact; Thompson induction needs only the checked initial edge,
  ## its routine execution, and the accepting path that follows it.
  typealias AcceptancePath(n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), after_input: List(Char), final_evidence: List(Evidence)) = Sigma(destination: MachineState(n), Sigma(initial_evidence: List(Evidence), Sigma(initial_captures: List(CaptureFrame), Sigma(path_routine: List(ExtendedInstruction), Sigma(edge: ListMember(MachineState(n), destination, initial_machine_destinations(n, machine, position, input, after_input)), Sigma(execution: RoutineExecution(machine_state_routine(n, destination), Nil(), Nil(), initial_evidence, initial_captures), AcceptingFrom(n, machine, input, after_input, machine_state_thread(n, destination), initial_evidence, initial_captures, final_evidence, path_routine)))))))

  fn machine_acceptance_path(n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), after_input: List(Char), {final_evidence: List(Evidence)}, {routine: List(ExtendedInstruction)}, acceptance: MachineAcceptance(n, machine, position, input, after_input, final_evidence, routine)) -> AcceptancePath(n, machine, position, input, after_input, final_evidence) = match acceptance
    MachineAccepted(destination, initial_evidence, initial_captures, path_routine, edge, execution, _, path) -> %[destination, initial_evidence, initial_captures, path_routine, edge, execution, path]

  ## The atomic case of the thesis's generalized Thompson theorem. It is
  ## independent of the NFA and of any evidence/captures already in the VM.
  fn predicate_transition_routine_encodes(char: Char, {input_evidence: List(Evidence)}, {input_captures: List(CaptureFrame)}, {output_evidence: List(Evidence)}, {output_captures: List(CaptureFrame)}, execution: ExtendedEvidenceRoutineExecution(transition_routine(char, Cons(EmitChar(char), Nil())), input_evidence, input_captures, output_evidence, output_captures)) -> Encodes(CharC, output_evidence, input_evidence) = match execution
    ExtendedEvidenceObserve(_, after_observe) -> match after_observe
      ExtendedEvidenceRegular(_, after_emit) -> match after_emit
        ExtendedEvidenceDone() -> EncodesCharacter(char)

  ## Grouping discards the inner evidence program and replaces it with the text
  ## observed by the capture frame. This one-transition lemma pins the crucial
  ## compositional boundary: even though EmitChar mutates the temporary evidence,
  ## EndCapture restores the saved suffix before emitting StringEvidence.
  fn group_character_routine_encodes(char: Char, {input_evidence: List(Evidence)}, {input_captures: List(CaptureFrame)}, {output_evidence: List(Evidence)}, {output_captures: List(CaptureFrame)}, execution: ExtendedEvidenceRoutineExecution(Cons(Regular(BeginCapture()), transition_routine(char, Cons(EmitChar(char), Cons(EndCapture(), Nil())))), input_evidence, input_captures, output_evidence, output_captures)) -> Encodes(StringC, output_evidence, input_evidence) = match execution
    ExtendedEvidenceRegular(_, after_begin) -> match after_begin
      ExtendedEvidenceObserve(_, after_observe) -> match after_observe
        ExtendedEvidenceRegular(_, after_emit) -> match after_emit
          ExtendedEvidenceRegular(_, after_end) -> match after_end
            ExtendedEvidenceDone() -> EncodesString(Std.String.from_characters(Cons(char, Nil())))

  type PredicateRoutineView indices (char: Char, routine: List(ExtendedInstruction))
    PredicateRoutineExact : PredicateRoutineView(char, transition_routine(char, Cons(EmitChar(char), Nil())))

  type PredicatePathView indices (char: Char, final_evidence: List(Evidence), routine: List(ExtendedInstruction))
    PredicatePathExact : PredicatePathView(char, Cons(CharacterEvidence(char), Nil()), transition_routine(char, Cons(EmitChar(char), Nil())))

  type PredicateEvidenceView indices (char: Char, evidence: List(Evidence), captures: List(CaptureFrame))
    PredicateEvidenceExact : PredicateEvidenceView(char, Cons(CharacterEvidence(char), Nil()), Nil())

  type PredicateDestinationsView indices (test: Char -> Bool, char: Char, boundary: Boundary, destinations: List(MachineState(S(Z()))))
    PredicateRejects : PredicateDestinationsView(test, char, boundary, Nil())
    PredicateAccepts : PredicateDestinationsView(test, char, boundary, Cons(predicate_accepting_destination(char), Nil()))

  type PredicateStartsView indices (starts: List(MachineState(S(Z()))))
    PredicateStartsExact : PredicateStartsView(Cons(predicate_machine_start(), Nil()))

  @reducible
  fn boundary_accepting_destination() -> MachineState(Z()) =
    let routine: List(EvidenceInstruction) = Cons(EmitUnit(), Nil())
    let constraints: List(BoundaryConstraint) = Nil()
    Accepted(routine, constraints)

  type BoundaryStartsView indices (holds: Bool, starts: List(MachineState(Z())))
    BoundaryStartsUnavailable : BoundaryStartsView(false, Nil())
    BoundaryStartsExact : BoundaryStartsView(true, Cons(boundary_accepting_destination(), Nil()))

  @reducible
  fn predicate_concat_machine(left: Char -> Bool, right: Char -> Bool) -> PatternMachine(plus(S(Z()), S(Z()))) =
    let right_starts: List(MachineState(S(Z()))) = Cons(predicate_machine_start(), Nil())
    let starts: List(MachineState(plus(S(Z()), S(Z())))) = continue_with_right(S(Z()), Cons(predicate_machine_start(), Nil()), right_starts)
    MkPatternMachine(starts, concat_machine_next(S(Z()), predicate_machine_next(left), right_starts, predicate_machine_next(right)))

  @reducible
  fn predicate_concat_start() -> MachineState(plus(S(Z()), S(Z()))) =
    Active(First(), Nil(), Nil())

  @reducible
  fn predicate_concat_middle(char: Char) -> MachineState(plus(S(Z()), S(Z()))) =
    Active(1, Cons(EmitChar(char), Nil()), Nil())

  @reducible
  fn predicate_concat_start_thread() -> ThreadState(plus(S(Z()), S(Z()))) =
    machine_state_thread(plus(S(Z()), S(Z())), predicate_concat_start())

  @reducible
  fn predicate_concat_middle_thread() -> ThreadState(plus(S(Z()), S(Z()))) =
    ThreadActive(Next(First()))

  @reducible
  fn predicate_concat_accepting(char: Char) -> MachineState(plus(S(Z()), S(Z()))) =
    Accepted(Cons(EmitChar(char), Cons(EmitPair(), Nil())), Nil())

  type PredicateConcatStartsView indices (starts: List(MachineState(plus(S(Z()), S(Z())))))
    PredicateConcatStartsExact : PredicateConcatStartsView(Cons(predicate_concat_start(), Nil()))

  type PredicateConcatInitialDestinationView indices (destination: MachineState(plus(S(Z()), S(Z()))))
    PredicateConcatInitialDestinationExact : PredicateConcatInitialDestinationView(predicate_concat_start())

  type PredicateConcatFirstView indices (holds: Bool, char: Char, destinations: List(MachineState(plus(S(Z()), S(Z())))))
    PredicateConcatFirstRejects : PredicateConcatFirstView(false, char, Nil())
    PredicateConcatFirstAccepts : PredicateConcatFirstView(true, char, Cons(predicate_concat_middle(char), Nil()))

  type PredicateConcatSecondView indices (holds: Bool, char: Char, destinations: List(MachineState(plus(S(Z()), S(Z())))))
    PredicateConcatSecondRejects : PredicateConcatSecondView(false, char, Nil())
    PredicateConcatSecondAccepts : PredicateConcatSecondView(true, char, Cons(predicate_concat_accepting(char), Nil()))

  type PredicateConcatAcceptedEdgeView indices (char: Char, regular: List(EvidenceInstruction), constraints: List(BoundaryConstraint))
    PredicateConcatAcceptedEdgeExact : PredicateConcatAcceptedEdgeView(char, Cons(EmitChar(char), Cons(EmitPair(), Nil())), Nil())

  type PredicateConcatActiveEdgeView indices (char: Char, destination: Bounded(plus(S(Z()), S(Z()))), regular: List(EvidenceInstruction), constraints: List(BoundaryConstraint))
    PredicateConcatActiveEdgeExact : PredicateConcatActiveEdgeView(char, 1, Cons(EmitChar(char), Nil()), Nil())

  fn impossible_list_member({item_type: Type}, {item: item_type}, {result: Type}, membership: ListMember(item_type, item, Nil())) -> result = match membership

  type AcceptedPathView(n: Nat, machine: PatternMachine(n), after_input: List(Char)) indices (input: List(Char), current_evidence: List(Evidence), captures: List(CaptureFrame), final_evidence: List(Evidence), routine: List(ExtendedInstruction))
    AcceptedPathNow : AcceptedPathView(n, machine, after_input, Nil(), evidence, captures, evidence, Nil())

  fn accepted_path_view(n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), @erased current_evidence: List(Evidence), @erased captures: List(CaptureFrame), @erased final_evidence: List(Evidence), @erased routine: List(ExtendedInstruction), path: AcceptingFrom(n, machine, input, after_input, ThreadAccepted(), current_evidence, captures, final_evidence, routine)) -> AcceptedPathView(n, machine, after_input, input, current_evidence, captures, final_evidence, routine) = match path
    AcceptingNow() -> AcceptedPathNow()
    AcceptingNextActive(_, _, _, _, _, _, edge, _, _) -> impossible_list_member(edge)
    AcceptingNextAccepted(_, _, _, _, _, edge, _, _) -> impossible_list_member(edge)

  @reducible
  fn empty_evidence() -> List(Evidence) = Nil()

  @reducible
  fn empty_characters() -> List(Char) = Nil()

  fn encodes_character_empty(char: Char) -> Encodes(CharC, Cons(CharacterEvidence(char), empty_evidence()), empty_evidence()) = EncodesCharacter(char)

  fn encodes_character_on(char: Char, @erased rest: List(Evidence)) -> Encodes(CharC, Cons(CharacterEvidence(char), rest), rest) = EncodesCharacter(char)

  fn encodes_character_pair(left_char: Char, right_char: Char) -> Encodes(PairC(CharC, CharC), Cons(PairEvidence(), Cons(CharacterEvidence(right_char), Cons(CharacterEvidence(left_char), empty_evidence()))), empty_evidence()) =
    EncodesPair(encodes_character_on(right_char, Cons(CharacterEvidence(left_char), empty_evidence())), encodes_character_empty(left_char))

  fn encodes_many_characters_empty() -> EncodesMany(CharC, Cons(BeginListEvidence(), empty_evidence()), empty_evidence()) = EncodesManyEmpty()

  fn encodes_character_list_empty() -> Encodes(ListC(CharC), Cons(EndListEvidence(), Cons(BeginListEvidence(), empty_evidence())), empty_evidence()) = EncodesList(encodes_many_characters_empty())

  fn predicate_execution_view(char: Char, {evidence: List(Evidence)}, {captures: List(CaptureFrame)}, execution: RoutineExecution(Cons(EmitChar(char), Nil()), Nil(), Nil(), evidence, captures)) -> PredicateEvidenceView(char, evidence, captures) = match execution
    RoutineStep(_, suffix) -> match suffix
      RoutineDone() -> PredicateEvidenceExact()

  fn predicate_starts_view(test: Char -> Bool, position: InitialPosition, input: List(Char), after_input: List(Char)) -> PredicateStartsView(initial_machine_destinations(S(Z()), predicate_pattern_machine(test), position, input, after_input)) = PredicateStartsExact()

  fn predicate_concat_starts_view(left: Char -> Bool, right: Char -> Bool, position: InitialPosition, input: List(Char), after_input: List(Char)) -> PredicateConcatStartsView(initial_machine_destinations(plus(S(Z()), S(Z())), predicate_concat_machine(left, right), position, input, after_input)) = PredicateConcatStartsExact()

  fn predicate_concat_initial_destination_view(left: Char -> Bool, right: Char -> Bool, position: InitialPosition, input: List(Char), after_input: List(Char), destination: MachineState(plus(S(Z()), S(Z()))), edge: ListMember(MachineState(plus(S(Z()), S(Z()))), destination, initial_machine_destinations(plus(S(Z()), S(Z())), predicate_concat_machine(left, right), position, input, after_input))) -> PredicateConcatInitialDestinationView(destination) = match predicate_concat_starts_view(left, right, position, input, after_input)
    PredicateConcatStartsExact() -> match edge
      ListMemberHere() -> PredicateConcatInitialDestinationExact()
      ListMemberThere(prior) -> impossible_list_member(prior)

  fn predicate_concat_first_view(left: Char -> Bool, right: Char -> Bool, char: Char, boundary: Boundary) -> PredicateConcatFirstView(left(char), char, machine_destinations(plus(S(Z()), S(Z())), predicate_concat_machine(left, right), predicate_concat_start_thread(), char, boundary)) = match left(char)
    False() -> PredicateConcatFirstRejects()
    True() -> PredicateConcatFirstAccepts()

  fn predicate_concat_second_view(left: Char -> Bool, right: Char -> Bool, char: Char, boundary: Boundary) -> PredicateConcatSecondView(right(char), char, machine_destinations(plus(S(Z()), S(Z())), predicate_concat_machine(left, right), predicate_concat_middle_thread(), char, boundary)) = match right(char)
    False() -> PredicateConcatSecondRejects()
    True() -> PredicateConcatSecondAccepts()

  fn boundary_starts_view(constraint: BoundaryConstraint, position: InitialPosition, after_input: List(Char)) -> BoundaryStartsView(constraints_hold(Cons(constraint, Nil()), initial_position_boundary(position, after_input)), initial_machine_destinations(Z(), boundary_pattern_machine(constraint), position, empty_characters(), after_input)) = match constraints_hold(Cons(constraint, Nil()), initial_position_boundary(position, after_input))
    False() -> BoundaryStartsUnavailable()
    True() -> BoundaryStartsExact()

  ## The nullable base case of the generalized Thompson theorem.  Unlike the
  ## predicate case, its evidence is emitted by the initial accepting edge and
  ## the accepting path consumes no input.
  fn empty_machine_acceptance_encodes(position: InitialPosition, after_input: List(Char), input_evidence: List(Evidence), input_captures: List(CaptureFrame), {final_evidence: List(Evidence)}, {routine: List(ExtendedInstruction)}, {output_evidence: List(Evidence)}, {output_captures: List(CaptureFrame)}, acceptance: MachineAcceptance(Z(), empty_pattern_machine(), position, Nil(), after_input, final_evidence, routine), execution: ExtendedEvidenceRoutineExecution(routine, input_evidence, input_captures, output_evidence, output_captures)) -> Encodes(UnitC, output_evidence, input_evidence) = match acceptance
    MachineAccepted(_, _, _, _, edge, _, _, path) -> match edge
      ListMemberHere() -> match path
        AcceptingNow() -> match execution
          ExtendedEvidenceRegular(_, suffix) -> match suffix
            ExtendedEvidenceDone() -> EncodesUnit()
      ListMemberThere(prior) -> impossible_list_member(prior)

  fn boundary_machine_acceptance_encodes(constraint: BoundaryConstraint, position: InitialPosition, after_input: List(Char), @erased final_evidence: List(Evidence), @erased routine: List(ExtendedInstruction), acceptance: MachineAcceptance(Z(), boundary_pattern_machine(constraint), position, empty_characters(), after_input, final_evidence, routine)) -> Encodes(UnitC, final_evidence, empty_evidence()) = match acceptance
    MachineAccepted(_, _, _, _, edge, initial_execution, _, path) -> match boundary_starts_view(constraint, position, after_input)
      BoundaryStartsUnavailable() -> impossible_list_member(edge)
      BoundaryStartsExact() -> match edge
        ListMemberHere() -> match path
          AcceptingNow() -> match initial_execution
            RoutineStep(_, after_emit) -> match after_emit
              RoutineDone() -> EncodesUnit()
        ListMemberThere(prior) -> impossible_list_member(prior)

  fn empty_machine_arbitrary_acceptance_encodes(input: List(Char), after_input: List(Char), position: InitialPosition, @erased final_evidence: List(Evidence), @erased routine: List(ExtendedInstruction), acceptance: MachineAcceptance(Z(), empty_pattern_machine(), position, input, after_input, final_evidence, routine)) -> Encodes(UnitC, final_evidence, empty_evidence()) = match acceptance
    MachineAccepted(_, initial_evidence, initial_captures, path_routine, edge, initial_execution, _, path) -> match edge
      ListMemberHere() -> match initial_execution
        RoutineStep(_, after_emit) -> match after_emit
          RoutineDone() -> match accepted_path_view(Z(), empty_pattern_machine(), input, after_input, initial_evidence, initial_captures, final_evidence, path_routine, path)
            AcceptedPathNow() -> EncodesUnit()
      ListMemberThere(prior) -> impossible_list_member(prior)

  fn boundary_machine_arbitrary_acceptance_encodes(constraint: BoundaryConstraint, input: List(Char), after_input: List(Char), position: InitialPosition, @erased final_evidence: List(Evidence), @erased routine: List(ExtendedInstruction), acceptance: MachineAcceptance(Z(), boundary_pattern_machine(constraint), position, input, after_input, final_evidence, routine)) -> Encodes(UnitC, final_evidence, empty_evidence()) = match acceptance
    MachineAccepted(_, initial_evidence, initial_captures, path_routine, edge, initial_execution, _, path) -> match boundary_starts_view(constraint, position, append_characters(input, after_input))
      BoundaryStartsUnavailable() -> impossible_list_member(edge)
      BoundaryStartsExact() -> match edge
        ListMemberHere() -> match initial_execution
          RoutineStep(_, after_emit) -> match after_emit
            RoutineDone() -> match accepted_path_view(Z(), boundary_pattern_machine(constraint), input, after_input, initial_evidence, initial_captures, final_evidence, path_routine, path)
              AcceptedPathNow() -> EncodesUnit()
        ListMemberThere(prior) -> impossible_list_member(prior)

  fn predicate_destinations_view(test: Char -> Bool, char: Char, boundary: Boundary) -> PredicateDestinationsView(test, char, boundary, machine_destinations(S(Z()), predicate_pattern_machine(test), predicate_machine_thread(), char, boundary)) = match test(char)
    False() -> PredicateRejects()
    True() -> PredicateAccepts()

  fn predicate_path_routine_encodes(test: Char -> Bool, char: Char, after_input: List(Char), input_evidence: List(Evidence), input_captures: List(CaptureFrame), {path_evidence: List(Evidence)}, {path_captures: List(CaptureFrame)}, {path_final_evidence: List(Evidence)}, {routine: List(ExtendedInstruction)}, {output_evidence: List(Evidence)}, {output_captures: List(CaptureFrame)}, path: AcceptingFrom(S(Z()), predicate_pattern_machine(test), Cons(char, Nil()), after_input, predicate_machine_thread(), path_evidence, path_captures, path_final_evidence, routine), execution: ExtendedEvidenceRoutineExecution(routine, input_evidence, input_captures, output_evidence, output_captures)) -> Encodes(CharC, output_evidence, input_evidence) =
    match predicate_path_routine_view(test, char, after_input, path)
      PredicateRoutineExact() -> predicate_transition_routine_encodes(char, execution)

  fn predicate_exact_path_view(test: Char -> Bool, char: Char, after_input: List(Char), {final_evidence: List(Evidence)}, path: AcceptingFrom(S(Z()), predicate_pattern_machine(test), Cons(char, Nil()), after_input, predicate_machine_thread(), Nil(), Nil(), final_evidence, transition_routine(char, Cons(EmitChar(char), Nil())))) -> PredicatePathView(char, final_evidence, transition_routine(char, Cons(EmitChar(char), Nil()))) = match path
    AcceptingNextActive(_, _, _, _, _, _, edge, _, _) -> match predicate_destinations_view(test, char, transition_boundary_before(char, [], after_input))
      PredicateRejects() -> impossible_list_member(edge)
      PredicateAccepts() -> match edge
        ListMemberThere(prior) -> impossible_list_member(prior)
    AcceptingNextAccepted(_, _, _, _, _, edge, execution, suffix) -> match predicate_destinations_view(test, char, transition_boundary_before(char, [], after_input))
      PredicateRejects() -> impossible_list_member(edge)
      PredicateAccepts() -> match edge
        ListMemberHere() -> match predicate_execution_view(char, execution)
          PredicateEvidenceExact() -> match suffix
            AcceptingNow() -> PredicatePathExact()
        ListMemberThere(prior) -> impossible_list_member(prior)

  fn predicate_path_view(test: Char -> Bool, char: Char, after_input: List(Char), @erased final_evidence: List(Evidence), @erased routine: List(ExtendedInstruction), path: AcceptingFrom(S(Z()), predicate_pattern_machine(test), Cons(char, Nil()), after_input, predicate_machine_thread(), Nil(), Nil(), final_evidence, routine)) -> PredicatePathView(char, final_evidence, routine) = match predicate_path_routine_view(test, char, after_input, path)
    PredicateRoutineExact() -> predicate_exact_path_view(test, char, after_input, path)

  fn predicate_initial_path_view(test: Char -> Bool, char: Char, after_input: List(Char), position: InitialPosition, destination: MachineState(S(Z())), {initial_evidence: List(Evidence)}, {initial_captures: List(CaptureFrame)}, @erased final_evidence: List(Evidence), @erased path_routine: List(ExtendedInstruction), edge: ListMember(MachineState(S(Z())), destination, initial_machine_destinations(S(Z()), predicate_pattern_machine(test), position, Cons(char, Nil()), after_input)), initial_execution: RoutineExecution(machine_state_routine(S(Z()), destination), Nil(), Nil(), initial_evidence, initial_captures), path: AcceptingFrom(S(Z()), predicate_pattern_machine(test), Cons(char, Nil()), after_input, machine_state_thread(S(Z()), destination), initial_evidence, initial_captures, final_evidence, path_routine)) -> PredicatePathView(char, final_evidence, path_routine) = match predicate_starts_view(test, position, [char], after_input)
    PredicateStartsExact() -> match edge
      ListMemberHere() -> match initial_execution
        RoutineDone() -> match path
          AcceptingNextActive(_, _, _, _, _, _, path_edge, _, _) -> match predicate_destinations_view(test, char, transition_boundary_before(char, [], after_input))
            PredicateRejects() -> impossible_list_member(path_edge)
            PredicateAccepts() -> match path_edge
              ListMemberThere(prior) -> impossible_list_member(prior)
          AcceptingNextAccepted(_, _, _, _, _, path_edge, execution, suffix) -> match predicate_destinations_view(test, char, transition_boundary_before(char, [], after_input))
            PredicateRejects() -> impossible_list_member(path_edge)
            PredicateAccepts() -> match path_edge
              ListMemberHere() -> match predicate_execution_view(char, execution)
                PredicateEvidenceExact() -> match suffix
                  AcceptingNow() -> PredicatePathExact()
              ListMemberThere(prior) -> impossible_list_member(prior)
      ListMemberThere(prior) -> impossible_list_member(prior)

  fn predicate_machine_acceptance_encodes(test: Char -> Bool, char: Char, after_input: List(Char), position: InitialPosition, @erased final_evidence: List(Evidence), @erased routine: List(ExtendedInstruction), acceptance: MachineAcceptance(S(Z()), predicate_pattern_machine(test), position, Cons(char, empty_characters()), after_input, final_evidence, routine)) -> Encodes(CharC, final_evidence, empty_evidence()) = match acceptance
    MachineAccepted(destination, initial_evidence, initial_captures, path_routine, edge, initial_execution, routine_certificate, path) ->
      match predicate_initial_path_view(test, char, after_input, position, destination, final_evidence, path_routine, edge, initial_execution, path)
        PredicatePathExact() -> encodes_character_empty(char)

  fn predicate_arbitrary_path_encodes(test: Char -> Bool, input: List(Char), after_input: List(Char), @erased final_evidence: List(Evidence), @erased routine: List(ExtendedInstruction), path: AcceptingFrom(S(Z()), predicate_pattern_machine(test), input, after_input, predicate_machine_thread(), empty_evidence(), Nil(), final_evidence, routine)) -> Encodes(CharC, final_evidence, empty_evidence()) = match input
    Nil() -> match path
      AcceptingNow() -> impossible
      AcceptingNextActive(_, _, _, _, _, _, _, _, _) -> impossible
      AcceptingNextAccepted(_, _, _, _, _, _, _, _) -> impossible
    Cons(char, rest) -> match path
      AcceptingNow() -> impossible
      AcceptingNextActive(_, _, _, _, _, _, edge, _, _) -> match predicate_destinations_view(test, char, transition_boundary_before(char, rest, after_input))
        PredicateRejects() -> impossible_list_member(edge)
        PredicateAccepts() -> match edge
          ListMemberThere(prior) -> impossible_list_member(prior)
      AcceptingNextAccepted(_, _, destination_evidence, destination_captures, suffix_routine, edge, execution, suffix) -> match predicate_destinations_view(test, char, transition_boundary_before(char, rest, after_input))
        PredicateRejects() -> impossible_list_member(edge)
        PredicateAccepts() -> match edge
          ListMemberHere() -> match predicate_execution_view(char, execution)
            PredicateEvidenceExact() -> match accepted_path_view(S(Z()), predicate_pattern_machine(test), rest, after_input, destination_evidence, destination_captures, final_evidence, suffix_routine, suffix)
              AcceptedPathNow() -> encodes_character_empty(char)
          ListMemberThere(prior) -> impossible_list_member(prior)

  fn predicate_machine_arbitrary_acceptance_encodes(test: Char -> Bool, input: List(Char), after_input: List(Char), position: InitialPosition, @erased final_evidence: List(Evidence), @erased routine: List(ExtendedInstruction), acceptance: MachineAcceptance(S(Z()), predicate_pattern_machine(test), position, input, after_input, final_evidence, routine)) -> Encodes(CharC, final_evidence, empty_evidence()) = match acceptance
    MachineAccepted(_, _, _, path_routine, edge, initial_execution, _, path) -> match predicate_starts_view(test, position, input, after_input)
      PredicateStartsExact() -> match edge
        ListMemberHere() -> match initial_execution
          RoutineDone() -> predicate_arbitrary_path_encodes(test, input, after_input, final_evidence, path_routine, path)
        ListMemberThere(prior) -> impossible_list_member(prior)

  ## Invert the two list transformations used by Thompson alternation.  The
  ## result retains the exact child edge and records whether the combined state
  ## is an injected active state or an accepting state whose routine has the
  ## branch marker appended.  Recursive path projection uses these relations
  ## instead of guessing from a combined state's runtime representation.
  type AppendMemberOrigin(n: Nat, left: List(MachineState(n)), right: List(MachineState(n))) indices (value: MachineState(n))
    AppendMemberLeft : (edge: ListMember(MachineState(n), value, left)) -> AppendMemberOrigin(n, left, right, value)
    AppendMemberRight : (edge: ListMember(MachineState(n), value, right)) -> AppendMemberOrigin(n, left, right, value)

  fn append_member_left({n: Nat}, left: List(MachineState(n)), right: List(MachineState(n)), value: MachineState(n), edge: ListMember(MachineState(n), value, left)) -> AppendMemberOrigin(n, left, right, value) = AppendMemberLeft(edge)

  fn append_member_right({n: Nat}, left: List(MachineState(n)), right: List(MachineState(n)), value: MachineState(n), edge: ListMember(MachineState(n), value, right)) -> AppendMemberOrigin(n, left, right, value) = AppendMemberRight(edge)

  fn append_member_origin(n: Nat, left: List(MachineState(n)), right: List(MachineState(n)), value: MachineState(n), edge: ListMember(MachineState(n), value, append_machine_states(n, left, right))) -> AppendMemberOrigin(n, left, right, value) = match left
    Nil() -> append_member_right(left, right, value, edge)
    Cons(head, rest) -> match edge
      ListMemberHere() -> append_member_left(left, right, value, member_here(head, rest))
      ListMemberThere(prior) -> match append_member_origin(n, rest, right, value, prior)
        AppendMemberLeft(origin) -> append_member_left(left, right, value, member_there(head, origin))
        AppendMemberRight(origin) -> append_member_right(left, right, value, origin)

  type FilteredAppendMemberOrigin(n: Nat, left: List(MachineState(n)), right: List(MachineState(n))) indices (value: MachineState(n))
    FilteredAppendMemberLeft : (edge: ListMember(MachineState(n), value, left)) -> FilteredAppendMemberOrigin(n, left, right, value)
    FilteredAppendMemberRight : (edge: ListMember(MachineState(n), value, right)) -> FilteredAppendMemberOrigin(n, left, right, value)

  fn filtered_append_member_left({n: Nat}, left: List(MachineState(n)), right: List(MachineState(n)), value: MachineState(n), edge: ListMember(MachineState(n), value, left)) -> FilteredAppendMemberOrigin(n, left, right, value) = FilteredAppendMemberLeft(edge)

  fn filtered_append_member_right({n: Nat}, left: List(MachineState(n)), right: List(MachineState(n)), value: MachineState(n), edge: ListMember(MachineState(n), value, right)) -> FilteredAppendMemberOrigin(n, left, right, value) = FilteredAppendMemberRight(edge)

  fn prepend_filtered_append_member({n: Nat}, head: MachineState(n), left: List(MachineState(n)), right: List(MachineState(n)), value: MachineState(n), origin: FilteredAppendMemberOrigin(n, left, right, value)) -> FilteredAppendMemberOrigin(n, Cons(head, left), right, value) = match origin
    FilteredAppendMemberLeft(edge) -> filtered_append_member_left(Cons(head, left), right, value, member_there(head, edge))
    FilteredAppendMemberRight(edge) -> filtered_append_member_right(Cons(head, left), right, value, edge)

  fn filtered_append_active_true_origin(n: Nat, state: Bounded(n), routine: List(EvidenceInstruction), rest: List(MachineState(n)), right: List(MachineState(n)), boundary: Boundary, value: MachineState(n), edge: ListMember(MachineState(n), value, Cons(Active(state, routine, Nil()), filter_machine_states(n, append_machine_states(n, rest, right), boundary)))) -> FilteredAppendMemberOrigin(n, Cons(Active(state, routine, Nil()), filter_machine_states(n, rest, boundary)), filter_machine_states(n, right, boundary), value) = match edge
    ListMemberHere() -> filtered_append_member_left(Cons(Active(state, routine, Nil()), filter_machine_states(n, rest, boundary)), filter_machine_states(n, right, boundary), value, member_here(Active(state, routine, Nil()), filter_machine_states(n, rest, boundary)))
    ListMemberThere(prior) -> prepend_filtered_append_member(Active(state, routine, Nil()), filter_machine_states(n, rest, boundary), filter_machine_states(n, right, boundary), value, filtered_append_member_origin(n, rest, right, boundary, value, prior))

  fn filtered_append_accepted_true_origin(n: Nat, routine: List(EvidenceInstruction), rest: List(MachineState(n)), right: List(MachineState(n)), boundary: Boundary, value: MachineState(n), edge: ListMember(MachineState(n), value, Cons(Accepted(routine, Nil()), filter_machine_states(n, append_machine_states(n, rest, right), boundary)))) -> FilteredAppendMemberOrigin(n, Cons(Accepted(routine, Nil()), filter_machine_states(n, rest, boundary)), filter_machine_states(n, right, boundary), value) = match edge
    ListMemberHere() -> filtered_append_member_left(Cons(Accepted(routine, Nil()), filter_machine_states(n, rest, boundary)), filter_machine_states(n, right, boundary), value, member_here(Accepted(routine, Nil()), filter_machine_states(n, rest, boundary)))
    ListMemberThere(prior) -> prepend_filtered_append_member(Accepted(routine, Nil()), filter_machine_states(n, rest, boundary), filter_machine_states(n, right, boundary), value, filtered_append_member_origin(n, rest, right, boundary, value, prior))

  fn filtered_append_member_origin(n: Nat, left: List(MachineState(n)), right: List(MachineState(n)), boundary: Boundary, value: MachineState(n), edge: ListMember(MachineState(n), value, filter_machine_states(n, append_machine_states(n, left, right), boundary))) -> FilteredAppendMemberOrigin(n, filter_machine_states(n, left, boundary), filter_machine_states(n, right, boundary), value) = match left
    Nil() -> filtered_append_member_right(filter_machine_states(n, left, boundary), filter_machine_states(n, right, boundary), value, edge)
    Cons(Active(state, routine, constraints), rest) -> with constraints_hold(constraints, boundary)
      True() -> filtered_append_active_true_origin(n, state, routine, rest, right, boundary, value, edge)
      False() -> filtered_append_member_origin(n, rest, right, boundary, value, edge)
    Cons(Accepted(routine, constraints), rest) -> with constraints_hold(constraints, boundary)
      True() -> filtered_append_accepted_true_origin(n, routine, rest, right, boundary, value, edge)
      False() -> filtered_append_member_origin(n, rest, right, boundary, value, edge)

  type LeftMarkedStateOrigin(left_count: Nat, right_count: Nat, marker: EvidenceInstruction, states: List(MachineState(left_count))) indices (combined: MachineState(plus(left_count, right_count)))
    LeftMarkedActiveOrigin : (state: Bounded(left_count)) -> (routine: List(EvidenceInstruction)) -> (constraints: List(BoundaryConstraint)) -> (edge: ListMember(MachineState(left_count), Active(state, routine, constraints), states)) -> LeftMarkedStateOrigin(left_count, right_count, marker, states, Active(inject_alternate_left(left_count, right_count, state), routine, constraints))
    LeftMarkedAcceptedOrigin : (routine: List(EvidenceInstruction)) -> (constraints: List(BoundaryConstraint)) -> (edge: ListMember(MachineState(left_count), Accepted(routine, constraints), states)) -> LeftMarkedStateOrigin(left_count, right_count, marker, states, Accepted(append_branch_marker(routine, marker), constraints))

  type RightMarkedStateOrigin(left_count: Nat, right_count: Nat, marker: EvidenceInstruction, states: List(MachineState(right_count))) indices (combined: MachineState(plus(left_count, right_count)))
    RightMarkedActiveOrigin : (state: Bounded(right_count)) -> (routine: List(EvidenceInstruction)) -> (constraints: List(BoundaryConstraint)) -> (edge: ListMember(MachineState(right_count), Active(state, routine, constraints), states)) -> RightMarkedStateOrigin(left_count, right_count, marker, states, Active(inject_alternate_right(left_count, right_count, state), routine, constraints))
    RightMarkedAcceptedOrigin : (routine: List(EvidenceInstruction)) -> (constraints: List(BoundaryConstraint)) -> (edge: ListMember(MachineState(right_count), Accepted(routine, constraints), states)) -> RightMarkedStateOrigin(left_count, right_count, marker, states, Accepted(append_branch_marker(routine, marker), constraints))

  fn left_marked_state_origin(left_count: Nat, right_count: Nat, states: List(MachineState(left_count)), marker: EvidenceInstruction, combined: MachineState(plus(left_count, right_count)), edge: ListMember(MachineState(plus(left_count, right_count)), combined, alternate_left_states(left_count, right_count, states, marker))) -> LeftMarkedStateOrigin(left_count, right_count, marker, states, combined) = match states
    Nil() -> impossible_list_member(edge)
    Cons(Active(state, routine, constraints), rest) -> match edge
      ListMemberHere() -> LeftMarkedActiveOrigin(state, routine, constraints, ListMemberHere())
      ListMemberThere(prior) -> match left_marked_state_origin(left_count, right_count, rest, marker, combined, prior)
        LeftMarkedActiveOrigin(origin_state, origin_routine, origin_constraints, origin_edge) -> LeftMarkedActiveOrigin(origin_state, origin_routine, origin_constraints, ListMemberThere(origin_edge))
        LeftMarkedAcceptedOrigin(origin_routine, origin_constraints, origin_edge) -> LeftMarkedAcceptedOrigin(origin_routine, origin_constraints, ListMemberThere(origin_edge))
    Cons(Accepted(routine, constraints), rest) -> match edge
      ListMemberHere() -> LeftMarkedAcceptedOrigin(routine, constraints, ListMemberHere())
      ListMemberThere(prior) -> match left_marked_state_origin(left_count, right_count, rest, marker, combined, prior)
        LeftMarkedActiveOrigin(origin_state, origin_routine, origin_constraints, origin_edge) -> LeftMarkedActiveOrigin(origin_state, origin_routine, origin_constraints, ListMemberThere(origin_edge))
        LeftMarkedAcceptedOrigin(origin_routine, origin_constraints, origin_edge) -> LeftMarkedAcceptedOrigin(origin_routine, origin_constraints, ListMemberThere(origin_edge))

  fn right_marked_state_origin(left_count: Nat, right_count: Nat, states: List(MachineState(right_count)), marker: EvidenceInstruction, combined: MachineState(plus(left_count, right_count)), edge: ListMember(MachineState(plus(left_count, right_count)), combined, alternate_right_states(left_count, right_count, states, marker))) -> RightMarkedStateOrigin(left_count, right_count, marker, states, combined) = match states
    Nil() -> impossible_list_member(edge)
    Cons(Active(state, routine, constraints), rest) -> match edge
      ListMemberHere() -> RightMarkedActiveOrigin(state, routine, constraints, ListMemberHere())
      ListMemberThere(prior) -> match right_marked_state_origin(left_count, right_count, rest, marker, combined, prior)
        RightMarkedActiveOrigin(origin_state, origin_routine, origin_constraints, origin_edge) -> RightMarkedActiveOrigin(origin_state, origin_routine, origin_constraints, ListMemberThere(origin_edge))
        RightMarkedAcceptedOrigin(origin_routine, origin_constraints, origin_edge) -> RightMarkedAcceptedOrigin(origin_routine, origin_constraints, ListMemberThere(origin_edge))
    Cons(Accepted(routine, constraints), rest) -> match edge
      ListMemberHere() -> RightMarkedAcceptedOrigin(routine, constraints, ListMemberHere())
      ListMemberThere(prior) -> match right_marked_state_origin(left_count, right_count, rest, marker, combined, prior)
        RightMarkedActiveOrigin(origin_state, origin_routine, origin_constraints, origin_edge) -> RightMarkedActiveOrigin(origin_state, origin_routine, origin_constraints, ListMemberThere(origin_edge))
        RightMarkedAcceptedOrigin(origin_routine, origin_constraints, origin_edge) -> RightMarkedAcceptedOrigin(origin_routine, origin_constraints, ListMemberThere(origin_edge))

  type FilteredLeftMarkedStateOrigin(left_count: Nat, right_count: Nat, marker: EvidenceInstruction) indices (filtered_states: List(MachineState(left_count)), combined: MachineState(plus(left_count, right_count)))
    FilteredLeftActiveOrigin : (state: Bounded(left_count)) -> (routine: List(EvidenceInstruction)) -> (edge: ListMember(MachineState(left_count), Active(state, routine, Nil()), filtered_states)) -> FilteredLeftMarkedStateOrigin(left_count, right_count, marker, filtered_states, Active(inject_alternate_left(left_count, right_count, state), routine, Nil()))
    FilteredLeftAcceptedOrigin : (routine: List(EvidenceInstruction)) -> (edge: ListMember(MachineState(left_count), Accepted(routine, Nil()), filtered_states)) -> FilteredLeftMarkedStateOrigin(left_count, right_count, marker, filtered_states, Accepted(append_branch_marker(routine, marker), Nil()))

  type FilteredRightMarkedStateOrigin(left_count: Nat, right_count: Nat, marker: EvidenceInstruction) indices (filtered_states: List(MachineState(right_count)), combined: MachineState(plus(left_count, right_count)))
    FilteredRightActiveOrigin : (state: Bounded(right_count)) -> (routine: List(EvidenceInstruction)) -> (edge: ListMember(MachineState(right_count), Active(state, routine, Nil()), filtered_states)) -> FilteredRightMarkedStateOrigin(left_count, right_count, marker, filtered_states, Active(inject_alternate_right(left_count, right_count, state), routine, Nil()))
    FilteredRightAcceptedOrigin : (routine: List(EvidenceInstruction)) -> (edge: ListMember(MachineState(right_count), Accepted(routine, Nil()), filtered_states)) -> FilteredRightMarkedStateOrigin(left_count, right_count, marker, filtered_states, Accepted(append_branch_marker(routine, marker), Nil()))

  fn filtered_left_active_origin(left_count: Nat, right_count: Nat, marker: EvidenceInstruction, states: List(MachineState(left_count)), state: Bounded(left_count), routine: List(EvidenceInstruction), edge: ListMember(MachineState(left_count), Active(state, routine, Nil()), states)) -> FilteredLeftMarkedStateOrigin(left_count, right_count, marker, states, Active(inject_alternate_left(left_count, right_count, state), routine, Nil())) =
    FilteredLeftActiveOrigin(state, routine, edge)

  fn filtered_left_accepted_origin(left_count: Nat, right_count: Nat, marker: EvidenceInstruction, states: List(MachineState(left_count)), routine: List(EvidenceInstruction), edge: ListMember(MachineState(left_count), Accepted(routine, Nil()), states)) -> FilteredLeftMarkedStateOrigin(left_count, right_count, marker, states, Accepted(append_branch_marker(routine, marker), Nil())) =
    FilteredLeftAcceptedOrigin(routine, edge)

  fn filtered_right_active_origin(left_count: Nat, right_count: Nat, marker: EvidenceInstruction, states: List(MachineState(right_count)), state: Bounded(right_count), routine: List(EvidenceInstruction), edge: ListMember(MachineState(right_count), Active(state, routine, Nil()), states)) -> FilteredRightMarkedStateOrigin(left_count, right_count, marker, states, Active(inject_alternate_right(left_count, right_count, state), routine, Nil())) =
    FilteredRightActiveOrigin(state, routine, edge)

  fn filtered_right_accepted_origin(left_count: Nat, right_count: Nat, marker: EvidenceInstruction, states: List(MachineState(right_count)), routine: List(EvidenceInstruction), edge: ListMember(MachineState(right_count), Accepted(routine, Nil()), states)) -> FilteredRightMarkedStateOrigin(left_count, right_count, marker, states, Accepted(append_branch_marker(routine, marker), Nil())) =
    FilteredRightAcceptedOrigin(routine, edge)

  fn prepend_filtered_left_origin(left_count: Nat, right_count: Nat, marker: EvidenceInstruction, head: MachineState(left_count), tail: List(MachineState(left_count)), combined: MachineState(plus(left_count, right_count)), origin: FilteredLeftMarkedStateOrigin(left_count, right_count, marker, tail, combined)) -> FilteredLeftMarkedStateOrigin(left_count, right_count, marker, Cons(head, tail), combined) = match origin
    FilteredLeftActiveOrigin(state, routine, edge) -> filtered_left_active_origin(left_count, right_count, marker, Cons(head, tail), state, routine, member_there(head, edge))
    FilteredLeftAcceptedOrigin(routine, edge) -> filtered_left_accepted_origin(left_count, right_count, marker, Cons(head, tail), routine, member_there(head, edge))

  fn prepend_filtered_right_origin(left_count: Nat, right_count: Nat, marker: EvidenceInstruction, head: MachineState(right_count), tail: List(MachineState(right_count)), combined: MachineState(plus(left_count, right_count)), origin: FilteredRightMarkedStateOrigin(left_count, right_count, marker, tail, combined)) -> FilteredRightMarkedStateOrigin(left_count, right_count, marker, Cons(head, tail), combined) = match origin
    FilteredRightActiveOrigin(state, routine, edge) -> filtered_right_active_origin(left_count, right_count, marker, Cons(head, tail), state, routine, member_there(head, edge))
    FilteredRightAcceptedOrigin(routine, edge) -> filtered_right_accepted_origin(left_count, right_count, marker, Cons(head, tail), routine, member_there(head, edge))

  fn filtered_left_active_true_origin(left_count: Nat, right_count: Nat, state: Bounded(left_count), routine: List(EvidenceInstruction), rest: List(MachineState(left_count)), marker: EvidenceInstruction, boundary: Boundary, combined: MachineState(plus(left_count, right_count)), edge: ListMember(MachineState(plus(left_count, right_count)), combined, Cons(Active(inject_alternate_left(left_count, right_count, state), routine, Nil()), filter_machine_states(plus(left_count, right_count), alternate_left_states(left_count, right_count, rest, marker), boundary)))) -> FilteredLeftMarkedStateOrigin(left_count, right_count, marker, Cons(Active(state, routine, Nil()), filter_machine_states(left_count, rest, boundary)), combined) = match edge
    ListMemberHere() -> filtered_left_active_origin(left_count, right_count, marker, Cons(Active(state, routine, Nil()), filter_machine_states(left_count, rest, boundary)), state, routine, member_here(Active(state, routine, Nil()), filter_machine_states(left_count, rest, boundary)))
    ListMemberThere(prior) -> prepend_filtered_left_origin(left_count, right_count, marker, Active(state, routine, Nil()), filter_machine_states(left_count, rest, boundary), combined, filtered_left_marked_state_origin(left_count, right_count, rest, marker, boundary, combined, prior))

  fn filtered_left_accepted_true_origin(left_count: Nat, right_count: Nat, routine: List(EvidenceInstruction), rest: List(MachineState(left_count)), marker: EvidenceInstruction, boundary: Boundary, combined: MachineState(plus(left_count, right_count)), edge: ListMember(MachineState(plus(left_count, right_count)), combined, Cons(Accepted(append_branch_marker(routine, marker), Nil()), filter_machine_states(plus(left_count, right_count), alternate_left_states(left_count, right_count, rest, marker), boundary)))) -> FilteredLeftMarkedStateOrigin(left_count, right_count, marker, Cons(Accepted(routine, Nil()), filter_machine_states(left_count, rest, boundary)), combined) = match edge
    ListMemberHere() -> filtered_left_accepted_origin(left_count, right_count, marker, Cons(Accepted(routine, Nil()), filter_machine_states(left_count, rest, boundary)), routine, member_here(Accepted(routine, Nil()), filter_machine_states(left_count, rest, boundary)))
    ListMemberThere(prior) -> prepend_filtered_left_origin(left_count, right_count, marker, Accepted(routine, Nil()), filter_machine_states(left_count, rest, boundary), combined, filtered_left_marked_state_origin(left_count, right_count, rest, marker, boundary, combined, prior))

  fn filtered_right_active_true_origin(left_count: Nat, right_count: Nat, state: Bounded(right_count), routine: List(EvidenceInstruction), rest: List(MachineState(right_count)), marker: EvidenceInstruction, boundary: Boundary, combined: MachineState(plus(left_count, right_count)), edge: ListMember(MachineState(plus(left_count, right_count)), combined, Cons(Active(inject_alternate_right(left_count, right_count, state), routine, Nil()), filter_machine_states(plus(left_count, right_count), alternate_right_states(left_count, right_count, rest, marker), boundary)))) -> FilteredRightMarkedStateOrigin(left_count, right_count, marker, Cons(Active(state, routine, Nil()), filter_machine_states(right_count, rest, boundary)), combined) = match edge
    ListMemberHere() -> filtered_right_active_origin(left_count, right_count, marker, Cons(Active(state, routine, Nil()), filter_machine_states(right_count, rest, boundary)), state, routine, member_here(Active(state, routine, Nil()), filter_machine_states(right_count, rest, boundary)))
    ListMemberThere(prior) -> prepend_filtered_right_origin(left_count, right_count, marker, Active(state, routine, Nil()), filter_machine_states(right_count, rest, boundary), combined, filtered_right_marked_state_origin(left_count, right_count, rest, marker, boundary, combined, prior))

  fn filtered_right_accepted_true_origin(left_count: Nat, right_count: Nat, routine: List(EvidenceInstruction), rest: List(MachineState(right_count)), marker: EvidenceInstruction, boundary: Boundary, combined: MachineState(plus(left_count, right_count)), edge: ListMember(MachineState(plus(left_count, right_count)), combined, Cons(Accepted(append_branch_marker(routine, marker), Nil()), filter_machine_states(plus(left_count, right_count), alternate_right_states(left_count, right_count, rest, marker), boundary)))) -> FilteredRightMarkedStateOrigin(left_count, right_count, marker, Cons(Accepted(routine, Nil()), filter_machine_states(right_count, rest, boundary)), combined) = match edge
    ListMemberHere() -> filtered_right_accepted_origin(left_count, right_count, marker, Cons(Accepted(routine, Nil()), filter_machine_states(right_count, rest, boundary)), routine, member_here(Accepted(routine, Nil()), filter_machine_states(right_count, rest, boundary)))
    ListMemberThere(prior) -> prepend_filtered_right_origin(left_count, right_count, marker, Accepted(routine, Nil()), filter_machine_states(right_count, rest, boundary), combined, filtered_right_marked_state_origin(left_count, right_count, rest, marker, boundary, combined, prior))

  fn filtered_left_marked_state_origin(left_count: Nat, right_count: Nat, states: List(MachineState(left_count)), marker: EvidenceInstruction, boundary: Boundary, combined: MachineState(plus(left_count, right_count)), edge: ListMember(MachineState(plus(left_count, right_count)), combined, filter_machine_states(plus(left_count, right_count), alternate_left_states(left_count, right_count, states, marker), boundary))) -> FilteredLeftMarkedStateOrigin(left_count, right_count, marker, filter_machine_states(left_count, states, boundary), combined) = match states
    Nil() -> impossible_list_member(edge)
    Cons(Active(state, routine, constraints), rest) -> with constraints_hold(constraints, boundary)
      True() -> filtered_left_active_true_origin(left_count, right_count, state, routine, rest, marker, boundary, combined, edge)
      False() -> filtered_left_marked_state_origin(left_count, right_count, rest, marker, boundary, combined, edge)
    Cons(Accepted(routine, constraints), rest) -> with constraints_hold(constraints, boundary)
      True() -> filtered_left_accepted_true_origin(left_count, right_count, routine, rest, marker, boundary, combined, edge)
      False() -> filtered_left_marked_state_origin(left_count, right_count, rest, marker, boundary, combined, edge)

  fn filtered_right_marked_state_origin(left_count: Nat, right_count: Nat, states: List(MachineState(right_count)), marker: EvidenceInstruction, boundary: Boundary, combined: MachineState(plus(left_count, right_count)), edge: ListMember(MachineState(plus(left_count, right_count)), combined, filter_machine_states(plus(left_count, right_count), alternate_right_states(left_count, right_count, states, marker), boundary))) -> FilteredRightMarkedStateOrigin(left_count, right_count, marker, filter_machine_states(right_count, states, boundary), combined) = match states
    Nil() -> impossible_list_member(edge)
    Cons(Active(state, routine, constraints), rest) -> with constraints_hold(constraints, boundary)
      True() -> filtered_right_active_true_origin(left_count, right_count, state, routine, rest, marker, boundary, combined, edge)
      False() -> filtered_right_marked_state_origin(left_count, right_count, rest, marker, boundary, combined, edge)
    Cons(Accepted(routine, constraints), rest) -> with constraints_hold(constraints, boundary)
      True() -> filtered_right_accepted_true_origin(left_count, right_count, routine, rest, marker, boundary, combined, edge)
      False() -> filtered_right_marked_state_origin(left_count, right_count, rest, marker, boundary, combined, edge)

  ## Once an alternate thread is known to inhabit one injection image, every
  ## outgoing edge comes from that same child machine. The Bounded inverse laws
  ## rewrite the combined source before the transition is classified; no raw-Nat
  ## comparison or unchecked projection is involved.
  fn alternate_left_destinations_equivalent(left_count: Nat, left_starts: List(MachineState(left_count)), left_next: (Bounded(left_count)) -> Char -> List(MachineState(left_count)), right_count: Nat, right_starts: List(MachineState(right_count)), right_next: (Bounded(right_count)) -> Char -> List(MachineState(right_count)), prefer_right: Bool, source: Bounded(left_count), char: Char, boundary: Boundary) -> Equivalent(List(MachineState(plus(left_count, right_count))), machine_destinations(plus(left_count, right_count), alternate_pattern_machine(left_count, MkPatternMachine(left_starts, left_next), right_count, MkPatternMachine(right_starts, right_next), prefer_right), ThreadActive(inject_alternate_left(left_count, right_count, source)), char, boundary), filter_machine_states(plus(left_count, right_count), alternate_left_states(left_count, right_count, left_next(source, char), EmitLeft()), boundary)) =
    rewrite split_injected_left_at(right_count, source) in reflexive(filter_machine_states(plus(left_count, right_count), alternate_left_states(left_count, right_count, left_next(source, char), EmitLeft()), boundary))

  fn alternate_right_destinations_equivalent(left_count: Nat, left_starts: List(MachineState(left_count)), left_next: (Bounded(left_count)) -> Char -> List(MachineState(left_count)), right_count: Nat, right_starts: List(MachineState(right_count)), right_next: (Bounded(right_count)) -> Char -> List(MachineState(right_count)), prefer_right: Bool, source: Bounded(right_count), char: Char, boundary: Boundary) -> Equivalent(List(MachineState(plus(left_count, right_count))), machine_destinations(plus(left_count, right_count), alternate_pattern_machine(left_count, MkPatternMachine(left_starts, left_next), right_count, MkPatternMachine(right_starts, right_next), prefer_right), ThreadActive(inject_alternate_right(left_count, right_count, source)), char, boundary), filter_machine_states(plus(left_count, right_count), alternate_right_states(left_count, right_count, right_next(source, char), EmitRight()), boundary)) =
    rewrite split_injected_right(left_count, source) in reflexive(filter_machine_states(plus(left_count, right_count), alternate_right_states(left_count, right_count, right_next(source, char), EmitRight()), boundary))

  fn transport_alternate_edge({n: Nat}, {value: MachineState(n)}, {source: List(MachineState(n))}, {target: List(MachineState(n))}, equality: Equivalent(List(MachineState(n)), source, target), edge: ListMember(MachineState(n), value, source)) -> ListMember(MachineState(n), value, target) = match equality
    reflexive() -> edge

  fn alternate_left_transition_origin(left_count: Nat, left_starts: List(MachineState(left_count)), left_next: (Bounded(left_count)) -> Char -> List(MachineState(left_count)), right_count: Nat, right_starts: List(MachineState(right_count)), right_next: (Bounded(right_count)) -> Char -> List(MachineState(right_count)), prefer_right: Bool, source: Bounded(left_count), char: Char, boundary: Boundary, combined: MachineState(plus(left_count, right_count)), edge: ListMember(MachineState(plus(left_count, right_count)), combined, machine_destinations(plus(left_count, right_count), alternate_pattern_machine(left_count, MkPatternMachine(left_starts, left_next), right_count, MkPatternMachine(right_starts, right_next), prefer_right), ThreadActive(inject_alternate_left(left_count, right_count, source)), char, boundary))) -> FilteredLeftMarkedStateOrigin(left_count, right_count, EmitLeft(), filter_machine_states(left_count, left_next(source, char), boundary), combined) =
    filtered_left_marked_state_origin(left_count, right_count, left_next(source, char), EmitLeft(), boundary, combined, transport_alternate_edge(alternate_left_destinations_equivalent(left_count, left_starts, left_next, right_count, right_starts, right_next, prefer_right, source, char, boundary), edge))

  fn alternate_right_transition_origin(left_count: Nat, left_starts: List(MachineState(left_count)), left_next: (Bounded(left_count)) -> Char -> List(MachineState(left_count)), right_count: Nat, right_starts: List(MachineState(right_count)), right_next: (Bounded(right_count)) -> Char -> List(MachineState(right_count)), prefer_right: Bool, source: Bounded(right_count), char: Char, boundary: Boundary, combined: MachineState(plus(left_count, right_count)), edge: ListMember(MachineState(plus(left_count, right_count)), combined, machine_destinations(plus(left_count, right_count), alternate_pattern_machine(left_count, MkPatternMachine(left_starts, left_next), right_count, MkPatternMachine(right_starts, right_next), prefer_right), ThreadActive(inject_alternate_right(left_count, right_count, source)), char, boundary))) -> FilteredRightMarkedStateOrigin(left_count, right_count, EmitRight(), filter_machine_states(right_count, right_next(source, char), boundary), combined) =
    filtered_right_marked_state_origin(left_count, right_count, right_next(source, char), EmitRight(), boundary, combined, transport_alternate_edge(alternate_right_destinations_equivalent(left_count, left_starts, left_next, right_count, right_starts, right_next, prefer_right, source, char, boundary), edge))

  ## Projection of a complete path that is already inside the left injection.
  ## The child path ends immediately before the alternate's final EmitLeft; the
  ## marker execution then pins the combined path's exact final evidence.
  typealias AlternateLeftPathProjection(left_count: Nat, left_machine: PatternMachine(left_count), input: List(Char), after_input: List(Char), source: Bounded(left_count), current_evidence: List(Evidence), captures: List(CaptureFrame), final_evidence: List(Evidence)) = Sigma(child_final_evidence: List(Evidence), Sigma(child_routine: List(ExtendedInstruction), Sigma(child_path: AcceptingFrom(left_count, left_machine, input, after_input, ThreadActive(source), current_evidence, captures, child_final_evidence, child_routine), Equivalent(List(Evidence), final_evidence, Cons(LeftEvidence(), child_final_evidence)))))

  fn project_alternate_left_path(left_count: Nat, left_machine: PatternMachine(left_count), right_count: Nat, right_machine: PatternMachine(right_count), prefer_right: Bool, input: List(Char), after_input: List(Char), source: Bounded(left_count), current_evidence: List(Evidence), captures: List(CaptureFrame), {final_evidence: List(Evidence)}, {routine: List(ExtendedInstruction)}, path: AcceptingFrom(plus(left_count, right_count), alternate_pattern_machine(left_count, left_machine, right_count, right_machine, prefer_right), input, after_input, ThreadActive(inject_alternate_left(left_count, right_count, source)), current_evidence, captures, final_evidence, routine)) -> AlternateLeftPathProjection(left_count, left_machine, input, after_input, source, current_evidence, captures, final_evidence) = match input
    Nil() -> match path
      AcceptingNow() -> impossible
      AcceptingNextActive(_, _, _, _, _, _, _, _, _) -> impossible
      AcceptingNextAccepted(_, _, _, _, _, _, _, _) -> impossible
    Cons(char, rest) -> match left_machine
      MkPatternMachine(left_starts, left_next) -> match right_machine
        MkPatternMachine(right_starts, right_next) -> match path
          AcceptingNextActive(destination, regular, constraints, destination_evidence, destination_captures, suffix_routine, edge, execution, suffix) -> match alternate_left_transition_origin(left_count, left_starts, left_next, right_count, right_starts, right_next, prefer_right, source, char, transition_boundary_before(char, rest, after_input), Active(destination, regular, constraints), edge)
            FilteredLeftActiveOrigin(child_destination, child_regular, child_edge) -> match project_alternate_left_path(left_count, MkPatternMachine(left_starts, left_next), right_count, MkPatternMachine(right_starts, right_next), prefer_right, rest, after_input, child_destination, destination_evidence, destination_captures, suffix)
              mk_pair(child_final_evidence, mk_pair(child_suffix_routine, mk_pair(child_suffix, final_is_marked))) -> %[child_final_evidence, append_extended_routines(transition_routine(char, child_regular), child_suffix_routine), AcceptingNextActive(child_destination, child_regular, Nil(), destination_evidence, destination_captures, child_suffix_routine, child_edge, execution, child_suffix), final_is_marked]
          AcceptingNextAccepted(regular, constraints, destination_evidence, destination_captures, suffix_routine, edge, execution, suffix) -> match alternate_left_transition_origin(left_count, left_starts, left_next, right_count, right_starts, right_next, prefer_right, source, char, transition_boundary_before(char, rest, after_input), Accepted(regular, constraints), edge)
            FilteredLeftAcceptedOrigin(child_regular, child_edge) -> match accepted_path_view(plus(left_count, right_count), alternate_pattern_machine(left_count, MkPatternMachine(left_starts, left_next), right_count, MkPatternMachine(right_starts, right_next), prefer_right), rest, after_input, destination_evidence, destination_captures, final_evidence, suffix_routine, suffix)
              AcceptedPathNow() -> match split_appended_routine_execution(child_regular, Cons(EmitLeft(), Nil()), current_evidence, record_capture_char(captures, char), execution)
                AppendedRoutineExecuted(child_final_evidence, child_final_captures, child_execution, marker_execution) -> match marker_execution
                  RoutineStep(_, marker_suffix) -> match marker_suffix
                    RoutineDone() -> %[child_final_evidence, append_extended_routines(transition_routine(char, child_regular), Nil()), AcceptingNextAccepted(child_regular, Nil(), child_final_evidence, child_final_captures, Nil(), child_edge, child_execution, AcceptingNow()), reflexive(Cons(LeftEvidence(), child_final_evidence))]

  typealias AlternateRightPathProjection(right_count: Nat, right_machine: PatternMachine(right_count), input: List(Char), after_input: List(Char), source: Bounded(right_count), current_evidence: List(Evidence), captures: List(CaptureFrame), final_evidence: List(Evidence)) = Sigma(child_final_evidence: List(Evidence), Sigma(child_routine: List(ExtendedInstruction), Sigma(child_path: AcceptingFrom(right_count, right_machine, input, after_input, ThreadActive(source), current_evidence, captures, child_final_evidence, child_routine), Equivalent(List(Evidence), final_evidence, Cons(RightEvidence(), child_final_evidence)))))

  fn project_alternate_right_path(left_count: Nat, left_machine: PatternMachine(left_count), right_count: Nat, right_machine: PatternMachine(right_count), prefer_right: Bool, input: List(Char), after_input: List(Char), source: Bounded(right_count), current_evidence: List(Evidence), captures: List(CaptureFrame), {final_evidence: List(Evidence)}, {routine: List(ExtendedInstruction)}, path: AcceptingFrom(plus(left_count, right_count), alternate_pattern_machine(left_count, left_machine, right_count, right_machine, prefer_right), input, after_input, ThreadActive(inject_alternate_right(left_count, right_count, source)), current_evidence, captures, final_evidence, routine)) -> AlternateRightPathProjection(right_count, right_machine, input, after_input, source, current_evidence, captures, final_evidence) = match input
    Nil() -> match path
      AcceptingNow() -> impossible
      AcceptingNextActive(_, _, _, _, _, _, _, _, _) -> impossible
      AcceptingNextAccepted(_, _, _, _, _, _, _, _) -> impossible
    Cons(char, rest) -> match left_machine
      MkPatternMachine(left_starts, left_next) -> match right_machine
        MkPatternMachine(right_starts, right_next) -> match path
          AcceptingNextActive(destination, regular, constraints, destination_evidence, destination_captures, suffix_routine, edge, execution, suffix) -> match alternate_right_transition_origin(left_count, left_starts, left_next, right_count, right_starts, right_next, prefer_right, source, char, transition_boundary_before(char, rest, after_input), Active(destination, regular, constraints), edge)
            FilteredRightActiveOrigin(child_destination, child_regular, child_edge) -> match project_alternate_right_path(left_count, MkPatternMachine(left_starts, left_next), right_count, MkPatternMachine(right_starts, right_next), prefer_right, rest, after_input, child_destination, destination_evidence, destination_captures, suffix)
              mk_pair(child_final_evidence, mk_pair(child_suffix_routine, mk_pair(child_suffix, final_is_marked))) -> %[child_final_evidence, append_extended_routines(transition_routine(char, child_regular), child_suffix_routine), AcceptingNextActive(child_destination, child_regular, Nil(), destination_evidence, destination_captures, child_suffix_routine, child_edge, execution, child_suffix), final_is_marked]
          AcceptingNextAccepted(regular, constraints, destination_evidence, destination_captures, suffix_routine, edge, execution, suffix) -> match alternate_right_transition_origin(left_count, left_starts, left_next, right_count, right_starts, right_next, prefer_right, source, char, transition_boundary_before(char, rest, after_input), Accepted(regular, constraints), edge)
            FilteredRightAcceptedOrigin(child_regular, child_edge) -> match accepted_path_view(plus(left_count, right_count), alternate_pattern_machine(left_count, MkPatternMachine(left_starts, left_next), right_count, MkPatternMachine(right_starts, right_next), prefer_right), rest, after_input, destination_evidence, destination_captures, final_evidence, suffix_routine, suffix)
              AcceptedPathNow() -> match split_appended_routine_execution(child_regular, Cons(EmitRight(), Nil()), current_evidence, record_capture_char(captures, char), execution)
                AppendedRoutineExecuted(child_final_evidence, child_final_captures, child_execution, marker_execution) -> match marker_execution
                  RoutineStep(_, marker_suffix) -> match marker_suffix
                    RoutineDone() -> %[child_final_evidence, append_extended_routines(transition_routine(char, child_regular), Nil()), AcceptingNextAccepted(child_regular, Nil(), child_final_evidence, child_final_captures, Nil(), child_edge, child_execution, AcceptingNow()), reflexive(Cons(RightEvidence(), child_final_evidence))]

  typealias AlternateLeftAcceptanceProjection(left_count: Nat, left_machine: PatternMachine(left_count), position: InitialPosition, input: List(Char), after_input: List(Char), final_evidence: List(Evidence)) = Sigma(child_final_evidence: List(Evidence), Sigma(child_acceptance: AcceptancePath(left_count, left_machine, position, input, after_input, child_final_evidence), Equivalent(List(Evidence), final_evidence, Cons(LeftEvidence(), child_final_evidence))))

  fn project_alternate_left_acceptance(left_count: Nat, left_machine: PatternMachine(left_count), right_count: Nat, right_machine: PatternMachine(right_count), prefer_right: Bool, position: InitialPosition, input: List(Char), after_input: List(Char), destination: MachineState(plus(left_count, right_count)), initial_evidence: List(Evidence), initial_captures: List(CaptureFrame), path_routine: List(ExtendedInstruction), {final_evidence: List(Evidence)}, origin: FilteredLeftMarkedStateOrigin(left_count, right_count, EmitLeft(), initial_machine_destinations(left_count, left_machine, position, input, after_input), destination), execution: RoutineExecution(machine_state_routine(plus(left_count, right_count), destination), Nil(), Nil(), initial_evidence, initial_captures), path: AcceptingFrom(plus(left_count, right_count), alternate_pattern_machine(left_count, left_machine, right_count, right_machine, prefer_right), input, after_input, machine_state_thread(plus(left_count, right_count), destination), initial_evidence, initial_captures, final_evidence, path_routine)) -> AlternateLeftAcceptanceProjection(left_count, left_machine, position, input, after_input, final_evidence) = match left_machine
    MkPatternMachine(left_starts, left_next) -> match right_machine
      MkPatternMachine(right_starts, right_next) -> match origin
        FilteredLeftActiveOrigin(source, regular, child_edge) -> match project_alternate_left_path(left_count, MkPatternMachine(left_starts, left_next), right_count, MkPatternMachine(right_starts, right_next), prefer_right, input, after_input, source, initial_evidence, initial_captures, path)
          mk_pair(child_final_evidence, mk_pair(child_routine, mk_pair(child_path, final_is_marked))) -> %[child_final_evidence, %[Active(source, regular, Nil()), initial_evidence, initial_captures, child_routine, child_edge, execution, child_path], final_is_marked]
        FilteredLeftAcceptedOrigin(regular, child_edge) -> match accepted_path_view(plus(left_count, right_count), alternate_pattern_machine(left_count, MkPatternMachine(left_starts, left_next), right_count, MkPatternMachine(right_starts, right_next), prefer_right), input, after_input, initial_evidence, initial_captures, final_evidence, path_routine, path)
          AcceptedPathNow() -> match split_appended_routine_execution(regular, Cons(EmitLeft(), Nil()), Nil(), Nil(), execution)
            AppendedRoutineExecuted(child_final_evidence, child_final_captures, child_execution, marker_execution) -> match marker_execution
              RoutineStep(_, marker_suffix) -> match marker_suffix
                RoutineDone() -> %[child_final_evidence, %[Accepted(regular, Nil()), child_final_evidence, child_final_captures, Nil(), child_edge, child_execution, AcceptingNow()], reflexive(Cons(LeftEvidence(), child_final_evidence))]

  typealias AlternateRightAcceptanceProjection(right_count: Nat, right_machine: PatternMachine(right_count), position: InitialPosition, input: List(Char), after_input: List(Char), final_evidence: List(Evidence)) = Sigma(child_final_evidence: List(Evidence), Sigma(child_acceptance: AcceptancePath(right_count, right_machine, position, input, after_input, child_final_evidence), Equivalent(List(Evidence), final_evidence, Cons(RightEvidence(), child_final_evidence))))

  fn project_alternate_right_acceptance(left_count: Nat, left_machine: PatternMachine(left_count), right_count: Nat, right_machine: PatternMachine(right_count), prefer_right: Bool, position: InitialPosition, input: List(Char), after_input: List(Char), destination: MachineState(plus(left_count, right_count)), initial_evidence: List(Evidence), initial_captures: List(CaptureFrame), path_routine: List(ExtendedInstruction), {final_evidence: List(Evidence)}, origin: FilteredRightMarkedStateOrigin(left_count, right_count, EmitRight(), initial_machine_destinations(right_count, right_machine, position, input, after_input), destination), execution: RoutineExecution(machine_state_routine(plus(left_count, right_count), destination), Nil(), Nil(), initial_evidence, initial_captures), path: AcceptingFrom(plus(left_count, right_count), alternate_pattern_machine(left_count, left_machine, right_count, right_machine, prefer_right), input, after_input, machine_state_thread(plus(left_count, right_count), destination), initial_evidence, initial_captures, final_evidence, path_routine)) -> AlternateRightAcceptanceProjection(right_count, right_machine, position, input, after_input, final_evidence) = match left_machine
    MkPatternMachine(left_starts, left_next) -> match right_machine
      MkPatternMachine(right_starts, right_next) -> match origin
        FilteredRightActiveOrigin(source, regular, child_edge) -> match project_alternate_right_path(left_count, MkPatternMachine(left_starts, left_next), right_count, MkPatternMachine(right_starts, right_next), prefer_right, input, after_input, source, initial_evidence, initial_captures, path)
          mk_pair(child_final_evidence, mk_pair(child_routine, mk_pair(child_path, final_is_marked))) -> %[child_final_evidence, %[Active(source, regular, Nil()), initial_evidence, initial_captures, child_routine, child_edge, execution, child_path], final_is_marked]
        FilteredRightAcceptedOrigin(regular, child_edge) -> match accepted_path_view(plus(left_count, right_count), alternate_pattern_machine(left_count, MkPatternMachine(left_starts, left_next), right_count, MkPatternMachine(right_starts, right_next), prefer_right), input, after_input, initial_evidence, initial_captures, final_evidence, path_routine, path)
          AcceptedPathNow() -> match split_appended_routine_execution(regular, Cons(EmitRight(), Nil()), Nil(), Nil(), execution)
            AppendedRoutineExecuted(child_final_evidence, child_final_captures, child_execution, marker_execution) -> match marker_execution
              RoutineStep(_, marker_suffix) -> match marker_suffix
                RoutineDone() -> %[child_final_evidence, %[Accepted(regular, Nil()), child_final_evidence, child_final_captures, Nil(), child_edge, child_execution, AcceptingNow()], reflexive(Cons(RightEvidence(), child_final_evidence))]

  type AlternateInitialOrigin(left_count: Nat, right_count: Nat, left_states: List(MachineState(left_count)), right_states: List(MachineState(right_count))) indices (combined: MachineState(plus(left_count, right_count)))
    AlternateInitialFromLeft : (origin: FilteredLeftMarkedStateOrigin(left_count, right_count, EmitLeft(), left_states, combined)) -> AlternateInitialOrigin(left_count, right_count, left_states, right_states, combined)
    AlternateInitialFromRight : (origin: FilteredRightMarkedStateOrigin(left_count, right_count, EmitRight(), right_states, combined)) -> AlternateInitialOrigin(left_count, right_count, left_states, right_states, combined)

  fn alternate_initial_from_left({left_count: Nat}, {right_count: Nat}, left_states: List(MachineState(left_count)), right_states: List(MachineState(right_count)), combined: MachineState(plus(left_count, right_count)), origin: FilteredLeftMarkedStateOrigin(left_count, right_count, EmitLeft(), left_states, combined)) -> AlternateInitialOrigin(left_count, right_count, left_states, right_states, combined) = AlternateInitialFromLeft(origin)

  fn alternate_initial_from_right({left_count: Nat}, {right_count: Nat}, left_states: List(MachineState(left_count)), right_states: List(MachineState(right_count)), combined: MachineState(plus(left_count, right_count)), origin: FilteredRightMarkedStateOrigin(left_count, right_count, EmitRight(), right_states, combined)) -> AlternateInitialOrigin(left_count, right_count, left_states, right_states, combined) = AlternateInitialFromRight(origin)

  fn filtered_alternate_starts_right_order(left_count: Nat, left_starts: List(MachineState(left_count)), right_count: Nat, right_starts: List(MachineState(right_count)), boundary: Boundary) -> Equivalent(List(MachineState(plus(left_count, right_count))), filter_machine_states(plus(left_count, right_count), append_machine_states(plus(left_count, right_count), alternate_right_states(left_count, right_count, right_starts, EmitRight()), alternate_left_states(left_count, right_count, left_starts, EmitLeft())), boundary), filter_machine_states(plus(left_count, right_count), alternate_machine_starts(left_count, left_starts, right_starts, True()), boundary)) =
    reflexive(filter_machine_states(plus(left_count, right_count), append_machine_states(plus(left_count, right_count), alternate_right_states(left_count, right_count, right_starts, EmitRight()), alternate_left_states(left_count, right_count, left_starts, EmitLeft())), boundary))

  fn filtered_alternate_starts_left_order(left_count: Nat, left_starts: List(MachineState(left_count)), right_count: Nat, right_starts: List(MachineState(right_count)), boundary: Boundary) -> Equivalent(List(MachineState(plus(left_count, right_count))), filter_machine_states(plus(left_count, right_count), append_machine_states(plus(left_count, right_count), alternate_left_states(left_count, right_count, left_starts, EmitLeft()), alternate_right_states(left_count, right_count, right_starts, EmitRight())), boundary), filter_machine_states(plus(left_count, right_count), alternate_machine_starts(left_count, left_starts, right_starts, False()), boundary)) =
    reflexive(filter_machine_states(plus(left_count, right_count), append_machine_states(plus(left_count, right_count), alternate_left_states(left_count, right_count, left_starts, EmitLeft()), alternate_right_states(left_count, right_count, right_starts, EmitRight())), boundary))

  fn transport_right_initial_edge({right_count: Nat}, left_count: Nat, left_starts: List(MachineState(left_count)), right_starts: List(MachineState(right_count)), boundary: Boundary, combined: MachineState(plus(left_count, right_count)), equality: Equivalent(List(MachineState(plus(left_count, right_count))), filter_machine_states(plus(left_count, right_count), append_machine_states(plus(left_count, right_count), alternate_right_states(left_count, right_count, right_starts, EmitRight()), alternate_left_states(left_count, right_count, left_starts, EmitLeft())), boundary), filter_machine_states(plus(left_count, right_count), alternate_machine_starts(left_count, left_starts, right_starts, True()), boundary)), edge: ListMember(MachineState(plus(left_count, right_count)), combined, filter_machine_states(plus(left_count, right_count), alternate_machine_starts(left_count, left_starts, right_starts, True()), boundary))) -> ListMember(MachineState(plus(left_count, right_count)), combined, filter_machine_states(plus(left_count, right_count), append_machine_states(plus(left_count, right_count), alternate_right_states(left_count, right_count, right_starts, EmitRight()), alternate_left_states(left_count, right_count, left_starts, EmitLeft())), boundary)) = match equality
    reflexive() -> edge

  fn transport_left_initial_edge({right_count: Nat}, left_count: Nat, left_starts: List(MachineState(left_count)), right_starts: List(MachineState(right_count)), boundary: Boundary, combined: MachineState(plus(left_count, right_count)), equality: Equivalent(List(MachineState(plus(left_count, right_count))), filter_machine_states(plus(left_count, right_count), append_machine_states(plus(left_count, right_count), alternate_left_states(left_count, right_count, left_starts, EmitLeft()), alternate_right_states(left_count, right_count, right_starts, EmitRight())), boundary), filter_machine_states(plus(left_count, right_count), alternate_machine_starts(left_count, left_starts, right_starts, False()), boundary)), edge: ListMember(MachineState(plus(left_count, right_count)), combined, filter_machine_states(plus(left_count, right_count), alternate_machine_starts(left_count, left_starts, right_starts, False()), boundary))) -> ListMember(MachineState(plus(left_count, right_count)), combined, filter_machine_states(plus(left_count, right_count), append_machine_states(plus(left_count, right_count), alternate_left_states(left_count, right_count, left_starts, EmitLeft()), alternate_right_states(left_count, right_count, right_starts, EmitRight())), boundary)) = match equality
    reflexive() -> edge

  fn alternate_initial_right_preferred(left_count: Nat, left_starts: List(MachineState(left_count)), right_count: Nat, right_starts: List(MachineState(right_count)), boundary: Boundary, combined: MachineState(plus(left_count, right_count)), edge: ListMember(MachineState(plus(left_count, right_count)), combined, filter_machine_states(plus(left_count, right_count), alternate_machine_starts(left_count, left_starts, right_starts, True()), boundary))) -> AlternateInitialOrigin(left_count, right_count, filter_machine_states(left_count, left_starts, boundary), filter_machine_states(right_count, right_starts, boundary), combined) = match filtered_append_member_origin(plus(left_count, right_count), alternate_right_states(left_count, right_count, right_starts, EmitRight()), alternate_left_states(left_count, right_count, left_starts, EmitLeft()), boundary, combined, transport_right_initial_edge(left_count, left_starts, right_starts, boundary, combined, filtered_alternate_starts_right_order(left_count, left_starts, right_count, right_starts, boundary), edge))
    FilteredAppendMemberLeft(right_edge) -> alternate_initial_from_right(filter_machine_states(left_count, left_starts, boundary), filter_machine_states(right_count, right_starts, boundary), combined, filtered_right_marked_state_origin(left_count, right_count, right_starts, EmitRight(), boundary, combined, right_edge))
    FilteredAppendMemberRight(left_edge) -> alternate_initial_from_left(filter_machine_states(left_count, left_starts, boundary), filter_machine_states(right_count, right_starts, boundary), combined, filtered_left_marked_state_origin(left_count, right_count, left_starts, EmitLeft(), boundary, combined, left_edge))

  fn alternate_initial_left_preferred(left_count: Nat, left_starts: List(MachineState(left_count)), right_count: Nat, right_starts: List(MachineState(right_count)), boundary: Boundary, combined: MachineState(plus(left_count, right_count)), edge: ListMember(MachineState(plus(left_count, right_count)), combined, filter_machine_states(plus(left_count, right_count), alternate_machine_starts(left_count, left_starts, right_starts, False()), boundary))) -> AlternateInitialOrigin(left_count, right_count, filter_machine_states(left_count, left_starts, boundary), filter_machine_states(right_count, right_starts, boundary), combined) = match filtered_append_member_origin(plus(left_count, right_count), alternate_left_states(left_count, right_count, left_starts, EmitLeft()), alternate_right_states(left_count, right_count, right_starts, EmitRight()), boundary, combined, transport_left_initial_edge(left_count, left_starts, right_starts, boundary, combined, filtered_alternate_starts_left_order(left_count, left_starts, right_count, right_starts, boundary), edge))
    FilteredAppendMemberLeft(left_edge) -> alternate_initial_from_left(filter_machine_states(left_count, left_starts, boundary), filter_machine_states(right_count, right_starts, boundary), combined, filtered_left_marked_state_origin(left_count, right_count, left_starts, EmitLeft(), boundary, combined, left_edge))
    FilteredAppendMemberRight(right_edge) -> alternate_initial_from_right(filter_machine_states(left_count, left_starts, boundary), filter_machine_states(right_count, right_starts, boundary), combined, filtered_right_marked_state_origin(left_count, right_count, right_starts, EmitRight(), boundary, combined, right_edge))

  fn alternate_initial_origin(left_count: Nat, left_starts: List(MachineState(left_count)), right_count: Nat, right_starts: List(MachineState(right_count)), prefer_right: Bool, boundary: Boundary, combined: MachineState(plus(left_count, right_count)), edge: ListMember(MachineState(plus(left_count, right_count)), combined, filter_machine_states(plus(left_count, right_count), alternate_machine_starts(left_count, left_starts, right_starts, prefer_right), boundary))) -> AlternateInitialOrigin(left_count, right_count, filter_machine_states(left_count, left_starts, boundary), filter_machine_states(right_count, right_starts, boundary), combined) = with prefer_right proof order_eq
    True() -> alternate_initial_right_preferred(left_count, left_starts, right_count, right_starts, boundary, combined, edge)
    False() -> alternate_initial_left_preferred(left_count, left_starts, right_count, right_starts, boundary, combined, edge)

  type CertifiedPatternMachine = CertifiedEmptyMachine | CertifiedBoundaryMachine(BoundaryConstraint) | CertifiedPredicateMachine(Char -> Bool)

  @reducible
  fn certified_pattern_shape(certified: CertifiedPatternMachine) -> ShapeCode = match certified
    CertifiedEmptyMachine() -> UnitC()
    CertifiedBoundaryMachine(_) -> UnitC()
    CertifiedPredicateMachine(_) -> CharC()

  @reducible
  fn certified_pattern_state_count(certified: CertifiedPatternMachine) -> Nat = match certified
    CertifiedEmptyMachine() -> Z()
    CertifiedBoundaryMachine(_) -> Z()
    CertifiedPredicateMachine(_) -> S(Z())

  @reducible
  fn certified_pattern_machine(certified: CertifiedPatternMachine) -> PatternMachine(certified_pattern_state_count(certified)) = match certified
    CertifiedEmptyMachine() -> empty_pattern_machine()
    CertifiedBoundaryMachine(constraint) -> boundary_pattern_machine(constraint)
    CertifiedPredicateMachine(test) -> predicate_pattern_machine(test)

  @reducible
  fn certify_empty_pattern_machine() -> CertifiedPatternMachine = CertifiedEmptyMachine()

  @reducible
  fn certify_boundary_pattern_machine(constraint: BoundaryConstraint) -> CertifiedPatternMachine = CertifiedBoundaryMachine(constraint)

  @reducible
  fn certify_predicate_pattern_machine(test: Char -> Bool) -> CertifiedPatternMachine =
    CertifiedPredicateMachine(test)

  fn certified_pattern_acceptance_encodes(certified: CertifiedPatternMachine, input: List(Char), after_input: List(Char), position: InitialPosition, @erased final_evidence: List(Evidence), @erased routine: List(ExtendedInstruction), acceptance: MachineAcceptance(certified_pattern_state_count(certified), certified_pattern_machine(certified), position, input, after_input, final_evidence, routine)) -> Encodes(certified_pattern_shape(certified), final_evidence, empty_evidence()) = match certified
    CertifiedEmptyMachine() -> empty_machine_arbitrary_acceptance_encodes(input, after_input, position, final_evidence, routine, acceptance)
    CertifiedBoundaryMachine(constraint) -> boundary_machine_arbitrary_acceptance_encodes(constraint, input, after_input, position, final_evidence, routine, acceptance)
    CertifiedPredicateMachine(test) -> predicate_machine_arbitrary_acceptance_encodes(test, input, after_input, position, final_evidence, routine, acceptance)

  ## Group's Thompson clause brackets the inner machine with a capture frame.
  ## This first complete instance proves the atomic inner machine end-to-end:
  ## construction, accepted path, capture execution, and String evidence.
  type GroupedPredicateStartsView indices (starts: List(MachineState(S(Z()))))
    GroupedPredicateStartsExact : GroupedPredicateStartsView(Cons(Active(First(), Cons(BeginCapture(), Nil()), Nil()), Nil()))

  type GroupedPredicateDestinationsView indices (holds: Bool, char: Char, destinations: List(MachineState(S(Z()))))
    GroupedPredicateRejects : GroupedPredicateDestinationsView(false, char, Nil())
    GroupedPredicateAccepts : GroupedPredicateDestinationsView(true, char, Cons(Accepted(Cons(EmitChar(char), Cons(EndCapture(), Nil())), Nil()), Nil()))

  type GroupedPredicateInitialView indices (evidence: List(Evidence), captures: List(CaptureFrame))
    GroupedPredicateInitialExact : GroupedPredicateInitialView(Nil(), Cons(CaptureFrame(Nil(), Nil()), Nil()))

  @reducible
  fn single_character_string(char: Char) -> String = Std.String.from_characters(Cons(char, Nil()))

  fn grouped_predicate_starts_view(test: Char -> Bool, position: InitialPosition, input: List(Char), after_input: List(Char)) -> GroupedPredicateStartsView(initial_machine_destinations(S(Z()), group_pattern_machine(S(Z()), Cons(predicate_machine_start(), Nil()), predicate_machine_next(test)), position, input, after_input)) = GroupedPredicateStartsExact()

  fn grouped_predicate_destinations_view(test: Char -> Bool, char: Char, boundary: Boundary) -> GroupedPredicateDestinationsView(test(char), char, machine_destinations(S(Z()), group_pattern_machine(S(Z()), Cons(predicate_machine_start(), Nil()), predicate_machine_next(test)), ThreadActive(First()), char, boundary)) = match test(char)
    False() -> GroupedPredicateRejects()
    True() -> GroupedPredicateAccepts()

  fn grouped_predicate_initial_view({evidence: List(Evidence)}, {captures: List(CaptureFrame)}, execution: RoutineExecution(Cons(BeginCapture(), Nil()), Nil(), Nil(), evidence, captures)) -> GroupedPredicateInitialView(evidence, captures) = match execution
    RoutineStep(_, suffix) -> match suffix
      RoutineDone() -> GroupedPredicateInitialExact()

  fn grouped_predicate_active_impossible({a: Type}, test: Char -> Bool, char: Char, boundary: Boundary, {state: Bounded(S(Z()))}, {regular: List(EvidenceInstruction)}, {constraints: List(BoundaryConstraint)}, edge: ListMember(MachineState(S(Z())), Active(state, regular, constraints), machine_destinations(S(Z()), group_pattern_machine(S(Z()), Cons(predicate_machine_start(), Nil()), predicate_machine_next(test)), ThreadActive(First()), char, boundary))) -> a = with grouped_predicate_destinations_view(test, char, boundary)
    GroupedPredicateRejects() -> impossible_list_member(edge)
    GroupedPredicateAccepts() -> match edge
      ListMemberThere(prior) -> impossible_list_member(prior)

  fn transport_encodes_output({shape: ShapeCode}, {left: List(Evidence)}, {right: List(Evidence)}, {rest: List(Evidence)}, equality: Equivalent(List(Evidence), left, right), encoded: Encodes(shape, left, rest)) -> Encodes(shape, right, rest) = match equality
    reflexive() -> encoded

  fn grouped_predicate_final_encodes(char: Char) -> Encodes(StringC, executed_evidence(execute_instruction(EndCapture(), Cons(CharacterEvidence(char), Nil()), record_capture_char(Cons(CaptureFrame(Nil(), Nil()), Nil()), char))), empty_evidence()) =
    have final_evidence_exact = proof chain
      Cons(StringEvidence(Std.String.from_characters(evidence_reverse_chars(Cons(char, Nil())))), Nil()) == executed_evidence(execute_instruction(EndCapture(), Cons(CharacterEvidence(char), Nil()), record_capture_char(Cons(CaptureFrame(Nil(), Nil()), Nil()), char)))
      because simplify
    transport_encodes_output(final_evidence_exact, EncodesString(Std.String.from_characters(evidence_reverse_chars(Cons(char, Nil())))))

  fn grouped_predicate_accepted_encodes(test: Char -> Bool, char: Char, after_input: List(Char), {regular: List(EvidenceInstruction)}, {constraints: List(BoundaryConstraint)}, {destination_evidence: List(Evidence)}, {destination_captures: List(CaptureFrame)}, {suffix_routine: List(ExtendedInstruction)}, {final_evidence: List(Evidence)}, edge: ListMember(MachineState(S(Z())), Accepted(regular, constraints), machine_destinations(S(Z()), group_pattern_machine(S(Z()), Cons(predicate_machine_start(), Nil()), predicate_machine_next(test)), ThreadActive(First()), char, transition_boundary_before(char, Nil(), after_input))), execution: RoutineExecution(regular, Nil(), record_capture_char(Cons(CaptureFrame(Nil(), Nil()), Nil()), char), destination_evidence, destination_captures), suffix: AcceptingFrom(S(Z()), group_pattern_machine(S(Z()), Cons(predicate_machine_start(), Nil()), predicate_machine_next(test)), Nil(), after_input, ThreadAccepted(), destination_evidence, destination_captures, final_evidence, suffix_routine)) -> Encodes(StringC, final_evidence, empty_evidence()) = with grouped_predicate_destinations_view(test, char, transition_boundary_before(char, Nil(), after_input))
    GroupedPredicateRejects() -> impossible_list_member(edge)
    GroupedPredicateAccepts() -> match edge
      ListMemberHere() -> match execution
        RoutineStep(_, after_emit) -> match after_emit
          RoutineStep(_, after_end) -> match after_end
            RoutineDone() -> match suffix
              AcceptingNow() -> grouped_predicate_final_encodes(char)
      ListMemberThere(prior) -> impossible_list_member(prior)

  fn grouped_predicate_path_encodes(test: Char -> Bool, char: Char, after_input: List(Char), @erased final_evidence: List(Evidence), @erased routine: List(ExtendedInstruction), path: AcceptingFrom(S(Z()), group_pattern_machine(S(Z()), Cons(predicate_machine_start(), Nil()), predicate_machine_next(test)), Cons(char, Nil()), after_input, ThreadActive(First()), Nil(), Cons(CaptureFrame(Nil(), Nil()), Nil()), final_evidence, routine)) -> Encodes(StringC, final_evidence, empty_evidence()) = match path
    AcceptingNextActive(_, _, _, _, _, _, edge, _, _) -> grouped_predicate_active_impossible(test, char, transition_boundary_before(char, Nil(), after_input), edge)
    AcceptingNextAccepted(_, _, _, _, _, edge, execution, suffix) -> grouped_predicate_accepted_encodes(test, char, after_input, edge, execution, suffix)

  fn grouped_predicate_initial_path_encodes(test: Char -> Bool, char: Char, after_input: List(Char), position: InitialPosition, destination: MachineState(S(Z())), {initial_evidence: List(Evidence)}, {initial_captures: List(CaptureFrame)}, @erased final_evidence: List(Evidence), @erased routine: List(ExtendedInstruction), edge: ListMember(MachineState(S(Z())), destination, initial_machine_destinations(S(Z()), group_pattern_machine(S(Z()), Cons(predicate_machine_start(), Nil()), predicate_machine_next(test)), position, Cons(char, empty_characters()), after_input)), initial_execution: RoutineExecution(machine_state_routine(S(Z()), destination), Nil(), Nil(), initial_evidence, initial_captures), path: AcceptingFrom(S(Z()), group_pattern_machine(S(Z()), Cons(predicate_machine_start(), Nil()), predicate_machine_next(test)), Cons(char, Nil()), after_input, machine_state_thread(S(Z()), destination), initial_evidence, initial_captures, final_evidence, routine)) -> Encodes(StringC, final_evidence, empty_evidence()) = match grouped_predicate_starts_view(test, position, Cons(char, empty_characters()), after_input)
    GroupedPredicateStartsExact() -> match edge
      ListMemberHere() -> match grouped_predicate_initial_view(initial_execution)
        GroupedPredicateInitialExact() -> grouped_predicate_path_encodes(test, char, after_input, final_evidence, routine, path)
      ListMemberThere(prior) -> impossible_list_member(prior)

  fn grouped_predicate_machine_acceptance_encodes(test: Char -> Bool, char: Char, after_input: List(Char), position: InitialPosition, @erased final_evidence: List(Evidence), @erased routine: List(ExtendedInstruction), acceptance: MachineAcceptance(S(Z()), group_pattern_machine(S(Z()), Cons(predicate_machine_start(), Nil()), predicate_machine_next(test)), position, Cons(char, empty_characters()), after_input, final_evidence, routine)) -> Encodes(StringC, final_evidence, empty_evidence()) = match acceptance
    MachineAccepted(destination, initial_evidence, initial_captures, path_routine, edge, initial_execution, _, path) -> grouped_predicate_initial_path_encodes(test, char, after_input, position, destination, final_evidence, path_routine, edge, initial_execution, path)

  fn predicate_concat_right_execution_encodes(left: Char -> Bool, right: Char -> Bool, left_char: Char, right_char: Char, after_input: List(Char), destination_evidence: List(Evidence), destination_captures: List(CaptureFrame), suffix_routine: List(ExtendedInstruction), @erased final_evidence: List(Evidence), execution: RoutineExecution(Cons(EmitChar(right_char), Cons(EmitPair(), Nil())), Cons(CharacterEvidence(left_char), empty_evidence()), record_capture_char(Nil(), right_char), destination_evidence, destination_captures), suffix: AcceptingFrom(plus(S(Z()), S(Z())), predicate_concat_machine(left, right), empty_characters(), after_input, ThreadAccepted(), destination_evidence, destination_captures, final_evidence, suffix_routine)) -> Encodes(PairC(CharC, CharC), final_evidence, empty_evidence()) = match execution
    RoutineStep(_, after_right) -> match after_right
      RoutineStep(_, after_pair) -> match after_pair
        RoutineDone() -> match suffix
          AcceptingNow() -> encodes_character_pair(left_char, right_char)

  fn impossible_concat_accepted_tail(regular: List(EvidenceInstruction), constraints: List(BoundaryConstraint), {result: Type}, prior: ListMember(MachineState(plus(S(Z()), S(Z()))), Accepted(regular, constraints), Nil())) -> result = match prior

  fn impossible_concat_active_tail(destination: Bounded(plus(S(Z()), S(Z()))), regular: List(EvidenceInstruction), constraints: List(BoundaryConstraint), {result: Type}, prior: ListMember(MachineState(plus(S(Z()), S(Z()))), Active(destination, regular, constraints), Nil())) -> result = match prior

  fn impossible_predicate_concat_first_accepted(left: Char -> Bool, right: Char -> Bool, char: Char, boundary: Boundary, regular: List(EvidenceInstruction), constraints: List(BoundaryConstraint), {result: Type}, edge: ListMember(MachineState(plus(S(Z()), S(Z()))), Accepted(regular, constraints), machine_destinations(plus(S(Z()), S(Z())), predicate_concat_machine(left, right), predicate_concat_start_thread(), char, boundary))) -> result = match predicate_concat_first_view(left, right, char, boundary)
    PredicateConcatFirstRejects() -> impossible_concat_accepted_tail(regular, constraints, edge)
    PredicateConcatFirstAccepts() -> match edge
      ListMemberThere(prior) -> impossible_concat_accepted_tail(regular, constraints, prior)

  fn predicate_concat_accepted_edge_view(char: Char, regular: List(EvidenceInstruction), constraints: List(BoundaryConstraint), edge: ListMember(MachineState(plus(S(Z()), S(Z()))), Accepted(regular, constraints), Cons(predicate_concat_accepting(char), Nil()))) -> PredicateConcatAcceptedEdgeView(char, regular, constraints) = match edge
    ListMemberHere() -> PredicateConcatAcceptedEdgeExact()
    ListMemberThere(prior) -> impossible_concat_accepted_tail(regular, constraints, prior)

  fn predicate_concat_active_edge_view(char: Char, destination: Bounded(plus(S(Z()), S(Z()))), regular: List(EvidenceInstruction), constraints: List(BoundaryConstraint), edge: ListMember(MachineState(plus(S(Z()), S(Z()))), Active(destination, regular, constraints), Cons(predicate_concat_middle(char), Nil()))) -> PredicateConcatActiveEdgeView(char, destination, regular, constraints) = match edge
    ListMemberHere() -> PredicateConcatActiveEdgeExact()
    ListMemberThere(prior) -> impossible_concat_active_tail(destination, regular, constraints, prior)

  fn predicate_concat_right_path_encodes(left: Char -> Bool, right: Char -> Bool, left_char: Char, right_char: Char, after_input: List(Char), @erased final_evidence: List(Evidence), @erased routine: List(ExtendedInstruction), path: AcceptingFrom(plus(S(Z()), S(Z())), predicate_concat_machine(left, right), Cons(right_char, empty_characters()), after_input, predicate_concat_middle_thread(), Cons(CharacterEvidence(left_char), empty_evidence()), Nil(), final_evidence, routine)) -> Encodes(PairC(CharC, CharC), final_evidence, empty_evidence()) = match path
    AcceptingNextActive(_, _, _, _, _, _, edge, _, _) -> match predicate_concat_second_view(left, right, right_char, transition_boundary_before(right_char, empty_characters(), after_input))
      PredicateConcatSecondRejects() -> impossible_list_member(edge)
      PredicateConcatSecondAccepts() -> match edge
        ListMemberThere(prior) -> impossible_list_member(prior)
    AcceptingNextAccepted(regular, constraints, _, _, _, edge, execution, suffix) -> match predicate_concat_second_view(left, right, right_char, transition_boundary_before(right_char, empty_characters(), after_input))
      PredicateConcatSecondRejects() -> impossible_list_member(edge)
      PredicateConcatSecondAccepts() -> match predicate_concat_accepted_edge_view(right_char, regular, constraints, edge)
        PredicateConcatAcceptedEdgeExact() -> match execution
          RoutineStep(_, after_right) -> match after_right
            RoutineStep(_, after_pair) -> match after_pair
              RoutineDone() -> match suffix
                AcceptingNow() -> encodes_character_pair(left_char, right_char)

  fn predicate_concat_start_path_encodes(left: Char -> Bool, right: Char -> Bool, left_char: Char, right_char: Char, after_input: List(Char), @erased final_evidence: List(Evidence), @erased routine: List(ExtendedInstruction), path: AcceptingFrom(plus(S(Z()), S(Z())), predicate_concat_machine(left, right), Cons(left_char, Cons(right_char, empty_characters())), after_input, predicate_concat_start_thread(), Nil(), Nil(), final_evidence, routine)) -> Encodes(PairC(CharC, CharC), final_evidence, empty_evidence()) = match path
    AcceptingNextActive(first_destination, first_regular, first_constraints, _, _, first_suffix_routine, first_edge, first_execution, first_suffix) -> match predicate_concat_first_view(left, right, left_char, transition_boundary_before(left_char, Cons(right_char, empty_characters()), after_input))
      PredicateConcatFirstRejects() -> impossible_list_member(first_edge)
      PredicateConcatFirstAccepts() -> match predicate_concat_active_edge_view(left_char, first_destination, first_regular, first_constraints, first_edge)
        PredicateConcatActiveEdgeExact() -> match first_execution
          RoutineStep(_, after_left) -> match after_left
            RoutineDone() -> predicate_concat_right_path_encodes(left, right, left_char, right_char, after_input, final_evidence, first_suffix_routine, first_suffix)
    AcceptingNextAccepted(regular, constraints, _, _, _, first_edge, _, _) -> impossible_predicate_concat_first_accepted(left, right, left_char, transition_boundary_before(left_char, Cons(right_char, empty_characters()), after_input), regular, constraints, first_edge)

  ## The first compositional Thompson case. Reverse the two-state concatenation
  ## path transition-by-transition, recovering the left and right predicate
  ## paths and the final EmitPair marker from the only possible memberships.
  fn predicate_concat_machine_acceptance_encodes(left: Char -> Bool, right: Char -> Bool, left_char: Char, right_char: Char, after_input: List(Char), position: InitialPosition, @erased final_evidence: List(Evidence), @erased routine: List(ExtendedInstruction), acceptance: MachineAcceptance(plus(S(Z()), S(Z())), predicate_concat_machine(left, right), position, Cons(left_char, Cons(right_char, empty_characters())), after_input, final_evidence, routine)) -> Encodes(PairC(CharC, CharC), final_evidence, empty_evidence()) = match acceptance
    MachineAccepted(destination, _, _, _, initial_edge, initial_execution, _, path) -> match predicate_concat_initial_destination_view(left, right, position, Cons(left_char, Cons(right_char, empty_characters())), after_input, destination, initial_edge)
      PredicateConcatInitialDestinationExact() -> match initial_execution
        RoutineDone() -> predicate_concat_start_path_encodes(left, right, left_char, right_char, after_input, final_evidence, routine, path)

  ## Alternate preserves the chosen branch in the evidence stream. This atomic
  ## instance proves both injected halves of the finite-state sum, including the
  ## right-hand state shift and the final EmitLeft/EmitRight marker.
  @reducible
  fn predicate_alternate_mode_machine(left: Char -> Bool, right: Char -> Bool, prefer_right: Bool) -> PatternMachine(plus(S(Z()), S(Z()))) =
    alternate_pattern_machine(S(Z()), predicate_pattern_machine(left), S(Z()), predicate_pattern_machine(right), prefer_right)

  @reducible
  fn predicate_alternate_machine(left: Char -> Bool, right: Char -> Bool) -> PatternMachine(plus(S(Z()), S(Z()))) = predicate_alternate_mode_machine(left, right, false)

  @reducible
  fn predicate_alternate_left_start() -> MachineState(plus(S(Z()), S(Z()))) = Active(First(), Nil(), Nil())

  @reducible
  fn predicate_alternate_right_start() -> MachineState(plus(S(Z()), S(Z()))) = Active(Next(First()), Nil(), Nil())

  type PredicateAlternateStartsView indices (prefer_right: Bool, starts: List(MachineState(plus(S(Z()), S(Z())))))
    PredicateAlternateStartsLeftFirst : PredicateAlternateStartsView(false, Cons(predicate_alternate_left_start(), Cons(predicate_alternate_right_start(), Nil())))
    PredicateAlternateStartsRightFirst : PredicateAlternateStartsView(true, Cons(predicate_alternate_right_start(), Cons(predicate_alternate_left_start(), Nil())))

  type PredicateAlternateInitialView indices (prefer_right: Bool, destination: MachineState(plus(S(Z()), S(Z()))))
    PredicateAlternateInitialLeft : PredicateAlternateInitialView(prefer_right, predicate_alternate_left_start())
    PredicateAlternateInitialRight : PredicateAlternateInitialView(prefer_right, predicate_alternate_right_start())

  type PredicateAlternateLeftDestinationsView indices (holds: Bool, char: Char, destinations: List(MachineState(plus(S(Z()), S(Z())))))
    PredicateAlternateLeftRejects : PredicateAlternateLeftDestinationsView(false, char, Nil())
    PredicateAlternateLeftAccepts : PredicateAlternateLeftDestinationsView(true, char, Cons(Accepted(Cons(EmitChar(char), Cons(EmitLeft(), Nil())), Nil()), Nil()))

  type PredicateAlternateRightDestinationsView indices (holds: Bool, char: Char, destinations: List(MachineState(plus(S(Z()), S(Z())))))
    PredicateAlternateRightRejects : PredicateAlternateRightDestinationsView(false, char, Nil())
    PredicateAlternateRightAccepts : PredicateAlternateRightDestinationsView(true, char, Cons(Accepted(Cons(EmitChar(char), Cons(EmitRight(), Nil())), Nil()), Nil()))

  fn predicate_alternate_starts_view(left: Char -> Bool, right: Char -> Bool, prefer_right: Bool, position: InitialPosition, input: List(Char), after_input: List(Char)) -> PredicateAlternateStartsView(prefer_right, initial_machine_destinations(plus(S(Z()), S(Z())), predicate_alternate_mode_machine(left, right, prefer_right), position, input, after_input)) = match prefer_right
    False() -> PredicateAlternateStartsLeftFirst()
    True() -> PredicateAlternateStartsRightFirst()

  fn predicate_alternate_initial_view(left: Char -> Bool, right: Char -> Bool, prefer_right: Bool, position: InitialPosition, input: List(Char), after_input: List(Char), destination: MachineState(plus(S(Z()), S(Z()))), edge: ListMember(MachineState(plus(S(Z()), S(Z()))), destination, initial_machine_destinations(plus(S(Z()), S(Z())), predicate_alternate_mode_machine(left, right, prefer_right), position, input, after_input))) -> PredicateAlternateInitialView(prefer_right, destination) = match predicate_alternate_starts_view(left, right, prefer_right, position, input, after_input)
    PredicateAlternateStartsLeftFirst() -> match edge
      ListMemberHere() -> PredicateAlternateInitialLeft()
      ListMemberThere(prior) -> match prior
        ListMemberHere() -> PredicateAlternateInitialRight()
        ListMemberThere(impossible) -> impossible_list_member(impossible)
    PredicateAlternateStartsRightFirst() -> match edge
      ListMemberHere() -> PredicateAlternateInitialRight()
      ListMemberThere(prior) -> match prior
        ListMemberHere() -> PredicateAlternateInitialLeft()
        ListMemberThere(impossible) -> impossible_list_member(impossible)

  fn predicate_alternate_left_destinations_view(left: Char -> Bool, right: Char -> Bool, prefer_right: Bool, char: Char, boundary: Boundary) -> PredicateAlternateLeftDestinationsView(left(char), char, machine_destinations(plus(S(Z()), S(Z())), predicate_alternate_mode_machine(left, right, prefer_right), ThreadActive(First()), char, boundary)) = match left(char)
    False() -> PredicateAlternateLeftRejects()
    True() -> PredicateAlternateLeftAccepts()

  fn predicate_alternate_right_destinations_view(left: Char -> Bool, right: Char -> Bool, prefer_right: Bool, char: Char, boundary: Boundary) -> PredicateAlternateRightDestinationsView(right(char), char, machine_destinations(plus(S(Z()), S(Z())), predicate_alternate_mode_machine(left, right, prefer_right), ThreadActive(Next(First())), char, boundary)) = match right(char)
    False() -> PredicateAlternateRightRejects()
    True() -> PredicateAlternateRightAccepts()

  fn predicate_alternate_left_path_encodes(left: Char -> Bool, right: Char -> Bool, prefer_right: Bool, char: Char, after_input: List(Char), @erased final_evidence: List(Evidence), @erased routine: List(ExtendedInstruction), path: AcceptingFrom(plus(S(Z()), S(Z())), predicate_alternate_mode_machine(left, right, prefer_right), Cons(char, Nil()), after_input, ThreadActive(First()), Nil(), Nil(), final_evidence, routine)) -> Encodes(ChoiceC(CharC, CharC), final_evidence, empty_evidence()) = match path
    AcceptingNextActive(_, _, _, _, _, _, edge, _, _) -> match predicate_alternate_left_destinations_view(left, right, prefer_right, char, transition_boundary_before(char, Nil(), after_input))
      PredicateAlternateLeftRejects() -> impossible_list_member(edge)
      PredicateAlternateLeftAccepts() -> match edge
        ListMemberThere(prior) -> impossible_list_member(prior)
    AcceptingNextAccepted(_, _, _, _, _, edge, execution, suffix) -> match predicate_alternate_left_destinations_view(left, right, prefer_right, char, transition_boundary_before(char, Nil(), after_input))
      PredicateAlternateLeftRejects() -> impossible_list_member(edge)
      PredicateAlternateLeftAccepts() -> match edge
        ListMemberHere() -> match execution
          RoutineStep(_, after_char) -> match after_char
            RoutineStep(_, after_marker) -> match after_marker
              RoutineDone() -> match suffix
                AcceptingNow() -> EncodesLeft(encodes_character_empty(char))
        ListMemberThere(prior) -> impossible_list_member(prior)

  fn predicate_alternate_right_path_encodes(left: Char -> Bool, right: Char -> Bool, prefer_right: Bool, char: Char, after_input: List(Char), @erased final_evidence: List(Evidence), @erased routine: List(ExtendedInstruction), path: AcceptingFrom(plus(S(Z()), S(Z())), predicate_alternate_mode_machine(left, right, prefer_right), Cons(char, Nil()), after_input, ThreadActive(Next(First())), Nil(), Nil(), final_evidence, routine)) -> Encodes(ChoiceC(CharC, CharC), final_evidence, empty_evidence()) = match path
    AcceptingNextActive(_, _, _, _, _, _, edge, _, _) -> match predicate_alternate_right_destinations_view(left, right, prefer_right, char, transition_boundary_before(char, Nil(), after_input))
      PredicateAlternateRightRejects() -> impossible_list_member(edge)
      PredicateAlternateRightAccepts() -> match edge
        ListMemberThere(prior) -> impossible_list_member(prior)
    AcceptingNextAccepted(_, _, _, _, _, edge, execution, suffix) -> match predicate_alternate_right_destinations_view(left, right, prefer_right, char, transition_boundary_before(char, Nil(), after_input))
      PredicateAlternateRightRejects() -> impossible_list_member(edge)
      PredicateAlternateRightAccepts() -> match edge
        ListMemberHere() -> match execution
          RoutineStep(_, after_char) -> match after_char
            RoutineStep(_, after_marker) -> match after_marker
              RoutineDone() -> match suffix
                AcceptingNow() -> EncodesRight(encodes_character_empty(char))
        ListMemberThere(prior) -> impossible_list_member(prior)

  fn predicate_alternate_initial_path_encodes(left: Char -> Bool, right: Char -> Bool, prefer_right: Bool, char: Char, after_input: List(Char), position: InitialPosition, destination: MachineState(plus(S(Z()), S(Z()))), {initial_evidence: List(Evidence)}, {initial_captures: List(CaptureFrame)}, @erased final_evidence: List(Evidence), @erased path_routine: List(ExtendedInstruction), edge: ListMember(MachineState(plus(S(Z()), S(Z()))), destination, initial_machine_destinations(plus(S(Z()), S(Z())), predicate_alternate_mode_machine(left, right, prefer_right), position, Cons(char, Nil()), after_input)), initial_execution: RoutineExecution(machine_state_routine(plus(S(Z()), S(Z())), destination), Nil(), Nil(), initial_evidence, initial_captures), path: AcceptingFrom(plus(S(Z()), S(Z())), predicate_alternate_mode_machine(left, right, prefer_right), Cons(char, Nil()), after_input, machine_state_thread(plus(S(Z()), S(Z())), destination), initial_evidence, initial_captures, final_evidence, path_routine)) -> Encodes(ChoiceC(CharC, CharC), final_evidence, empty_evidence()) = match predicate_alternate_initial_view(left, right, prefer_right, position, Cons(char, Nil()), after_input, destination, edge)
    PredicateAlternateInitialLeft() -> match initial_execution
      RoutineDone() -> predicate_alternate_left_path_encodes(left, right, prefer_right, char, after_input, final_evidence, path_routine, path)
    PredicateAlternateInitialRight() -> match initial_execution
      RoutineDone() -> predicate_alternate_right_path_encodes(left, right, prefer_right, char, after_input, final_evidence, path_routine, path)

  fn predicate_alternate_mode_machine_acceptance_encodes(left: Char -> Bool, right: Char -> Bool, prefer_right: Bool, char: Char, after_input: List(Char), position: InitialPosition, @erased final_evidence: List(Evidence), @erased routine: List(ExtendedInstruction), acceptance: MachineAcceptance(plus(S(Z()), S(Z())), predicate_alternate_mode_machine(left, right, prefer_right), position, Cons(char, Nil()), after_input, final_evidence, routine)) -> Encodes(ChoiceC(CharC, CharC), final_evidence, empty_evidence()) = match acceptance
    MachineAccepted(destination, initial_evidence, initial_captures, path_routine, edge, initial_execution, _, path) -> predicate_alternate_initial_path_encodes(left, right, prefer_right, char, after_input, position, destination, final_evidence, path_routine, edge, initial_execution, path)

  fn predicate_alternate_machine_acceptance_encodes(left: Char -> Bool, right: Char -> Bool, char: Char, after_input: List(Char), position: InitialPosition, @erased final_evidence: List(Evidence), @erased routine: List(ExtendedInstruction), acceptance: MachineAcceptance(plus(S(Z()), S(Z())), predicate_alternate_machine(left, right), position, Cons(char, Nil()), after_input, final_evidence, routine)) -> Encodes(ChoiceC(CharC, CharC), final_evidence, empty_evidence()) = predicate_alternate_mode_machine_acceptance_encodes(left, right, false, char, after_input, position, final_evidence, routine, acceptance)

  ## Repeat carries an intrinsic EncodesMany prefix alongside the accepting path.
  ## Every consuming transition extends that prefix by one character; the sole
  ## accepting transition closes it with EndList. The proof is structural in the
  ## path and is independent of greedy/lazy ordering.
  @reducible
  fn predicate_repeat_machine(test: Char -> Bool, lazy: Bool) -> PatternMachine(S(Z())) =
    MkPatternMachine(
      repeat_machine_starts(Cons(predicate_machine_start(), Nil()), lazy),
      repeat_machine_next(Cons(predicate_machine_start(), Nil()), lazy, predicate_machine_next(test))
    )

  type PredicateRepeatInitialView indices (lazy: Bool, destination: MachineState(S(Z())))
    PredicateRepeatInitialActive : PredicateRepeatInitialView(lazy, Active(First(), Cons(BeginList(), Nil()), Nil()))
    PredicateRepeatInitialAccepted : PredicateRepeatInitialView(lazy, Accepted(Cons(BeginList(), Cons(EndList(), Nil())), Nil()))

  type PredicateRepeatDestinationView indices (lazy: Bool, holds: Bool, char: Char, destination: MachineState(S(Z())))
    PredicateRepeatContinues : PredicateRepeatDestinationView(lazy, true, char, Active(First(), Cons(EmitChar(char), Nil()), Nil()))
    PredicateRepeatFinishes : PredicateRepeatDestinationView(lazy, true, char, Accepted(Cons(EmitChar(char), Cons(EndList(), Nil())), Nil()))

  type PredicateRepeatDestinationsView indices (lazy: Bool, holds: Bool, char: Char, destinations: List(MachineState(S(Z()))))
    PredicateRepeatRejects : PredicateRepeatDestinationsView(lazy, false, char, Nil())
    PredicateRepeatGreedy : PredicateRepeatDestinationsView(false, true, char, Cons(Active(First(), Cons(EmitChar(char), Nil()), Nil()), Cons(Accepted(Cons(EmitChar(char), Cons(EndList(), Nil())), Nil()), Nil())))
    PredicateRepeatLazy : PredicateRepeatDestinationsView(true, true, char, Cons(Accepted(Cons(EmitChar(char), Cons(EndList(), Nil())), Nil()), Cons(Active(First(), Cons(EmitChar(char), Nil()), Nil()), Nil())))

  fn predicate_repeat_initial_view(test: Char -> Bool, lazy: Bool, position: InitialPosition, input: List(Char), after_input: List(Char), destination: MachineState(S(Z())), edge: ListMember(MachineState(S(Z())), destination, initial_machine_destinations(S(Z()), predicate_repeat_machine(test, lazy), position, input, after_input))) -> PredicateRepeatInitialView(lazy, destination) = match lazy
    False() -> match edge
      ListMemberHere() -> PredicateRepeatInitialActive()
      ListMemberThere(prior) -> match prior
        ListMemberHere() -> PredicateRepeatInitialAccepted()
        ListMemberThere(impossible) -> impossible_list_member(impossible)
    True() -> match edge
      ListMemberHere() -> PredicateRepeatInitialAccepted()
      ListMemberThere(prior) -> match prior
        ListMemberHere() -> PredicateRepeatInitialActive()
        ListMemberThere(impossible) -> impossible_list_member(impossible)

  fn predicate_repeat_destinations_view(test: Char -> Bool, lazy: Bool, char: Char, boundary: Boundary) -> PredicateRepeatDestinationsView(lazy, test(char), char, machine_destinations(S(Z()), predicate_repeat_machine(test, lazy), ThreadActive(First()), char, boundary)) = match test(char)
    False() -> PredicateRepeatRejects()
    True() -> match lazy
      False() -> PredicateRepeatGreedy()
      True() -> PredicateRepeatLazy()

  fn predicate_repeat_destination_view(test: Char -> Bool, lazy: Bool, char: Char, boundary: Boundary, destination: MachineState(S(Z())), edge: ListMember(MachineState(S(Z())), destination, machine_destinations(S(Z()), predicate_repeat_machine(test, lazy), ThreadActive(First()), char, boundary))) -> PredicateRepeatDestinationView(lazy, test(char), char, destination) = match predicate_repeat_destinations_view(test, lazy, char, boundary)
    PredicateRepeatRejects() -> impossible_list_member(edge)
    PredicateRepeatGreedy() -> match edge
        ListMemberHere() -> PredicateRepeatContinues()
        ListMemberThere(prior) -> match prior
          ListMemberHere() -> PredicateRepeatFinishes()
          ListMemberThere(impossible) -> impossible_list_member(impossible)
    PredicateRepeatLazy() -> match edge
        ListMemberHere() -> PredicateRepeatFinishes()
        ListMemberThere(prior) -> match prior
          ListMemberHere() -> PredicateRepeatContinues()
          ListMemberThere(impossible) -> impossible_list_member(impossible)

  fn predicate_repeat_path_encodes(test: Char -> Bool, lazy: Bool, input: List(Char), after_input: List(Char), @erased current_evidence: List(Evidence), @erased prior: EncodesMany(CharC, current_evidence, empty_evidence()), @erased final_evidence: List(Evidence), @erased routine: List(ExtendedInstruction), path: AcceptingFrom(S(Z()), predicate_repeat_machine(test, lazy), input, after_input, ThreadActive(First()), current_evidence, Nil(), final_evidence, routine)) -> Encodes(ListC(CharC), final_evidence, empty_evidence()) = match input
    Nil() -> match path
      AcceptingNow() -> impossible
      AcceptingNextActive(_, _, _, _, _, _, _, _, _) -> impossible
      AcceptingNextAccepted(_, _, _, _, _, _, _, _) -> impossible
    Cons(char, rest) -> match path
      AcceptingNow() -> impossible
      AcceptingNextActive(destination, regular, constraints, destination_evidence, _, suffix_routine, edge, execution, suffix) -> match predicate_repeat_destination_view(test, lazy, char, transition_boundary_before(char, rest, after_input), Active(destination, regular, constraints), edge)
        PredicateRepeatContinues() -> match execution
          RoutineStep(_, after_char) -> match after_char
            RoutineDone() -> predicate_repeat_path_encodes(test, lazy, rest, after_input, destination_evidence, EncodesManyItem(encodes_character_on(char, current_evidence), prior), final_evidence, suffix_routine, suffix)
        PredicateRepeatFinishes() -> impossible
      AcceptingNextAccepted(regular, constraints, destination_evidence, destination_captures, suffix_routine, edge, execution, suffix) -> match predicate_repeat_destination_view(test, lazy, char, transition_boundary_before(char, rest, after_input), Accepted(regular, constraints), edge)
        PredicateRepeatContinues() -> impossible
        PredicateRepeatFinishes() -> match execution
          RoutineStep(_, after_char) -> match after_char
            RoutineStep(_, after_end) -> match after_end
              RoutineDone() -> match accepted_path_view(S(Z()), predicate_repeat_machine(test, lazy), rest, after_input, destination_evidence, destination_captures, final_evidence, suffix_routine, suffix)
                AcceptedPathNow() -> EncodesList(EncodesManyItem(encodes_character_on(char, current_evidence), prior))

  fn predicate_repeat_initial_path_encodes(test: Char -> Bool, lazy: Bool, input: List(Char), after_input: List(Char), position: InitialPosition, destination: MachineState(S(Z())), {initial_evidence: List(Evidence)}, {initial_captures: List(CaptureFrame)}, @erased final_evidence: List(Evidence), @erased path_routine: List(ExtendedInstruction), edge: ListMember(MachineState(S(Z())), destination, initial_machine_destinations(S(Z()), predicate_repeat_machine(test, lazy), position, input, after_input)), initial_execution: RoutineExecution(machine_state_routine(S(Z()), destination), Nil(), Nil(), initial_evidence, initial_captures), path: AcceptingFrom(S(Z()), predicate_repeat_machine(test, lazy), input, after_input, machine_state_thread(S(Z()), destination), initial_evidence, initial_captures, final_evidence, path_routine)) -> Encodes(ListC(CharC), final_evidence, empty_evidence()) = match predicate_repeat_initial_view(test, lazy, position, input, after_input, destination, edge)
    PredicateRepeatInitialActive() -> match initial_execution
      RoutineStep(_, after_begin) -> match after_begin
        RoutineDone() -> predicate_repeat_path_encodes(test, lazy, input, after_input, initial_evidence, encodes_many_characters_empty(), final_evidence, path_routine, path)
    PredicateRepeatInitialAccepted() -> match initial_execution
      RoutineStep(_, after_begin) -> match after_begin
        RoutineStep(_, after_end) -> match after_end
          RoutineDone() -> match accepted_path_view(S(Z()), predicate_repeat_machine(test, lazy), input, after_input, initial_evidence, initial_captures, final_evidence, path_routine, path)
            AcceptedPathNow() -> encodes_character_list_empty()

  fn predicate_repeat_machine_acceptance_encodes(test: Char -> Bool, lazy: Bool, input: List(Char), after_input: List(Char), position: InitialPosition, @erased final_evidence: List(Evidence), @erased routine: List(ExtendedInstruction), acceptance: MachineAcceptance(S(Z()), predicate_repeat_machine(test, lazy), position, input, after_input, final_evidence, routine)) -> Encodes(ListC(CharC), final_evidence, empty_evidence()) = match acceptance
    MachineAccepted(destination, initial_evidence, initial_captures, path_routine, edge, initial_execution, _, path) -> predicate_repeat_initial_path_encodes(test, lazy, input, after_input, position, destination, final_evidence, path_routine, edge, initial_execution, path)

  fn predicate_path_routine_view(test: Char -> Bool, char: Char, after_input: List(Char), {path_evidence: List(Evidence)}, {path_captures: List(CaptureFrame)}, {path_final_evidence: List(Evidence)}, {routine: List(ExtendedInstruction)}, path: AcceptingFrom(S(Z()), predicate_pattern_machine(test), Cons(char, Nil()), after_input, predicate_machine_thread(), path_evidence, path_captures, path_final_evidence, routine)) -> PredicateRoutineView(char, routine) = match path
    AcceptingNextActive(_, _, _, _, _, _, edge, _, _) -> match predicate_destinations_view(test, char, transition_boundary_before(char, [], after_input))
      PredicateRejects() -> impossible_list_member(edge)
      PredicateAccepts() -> match edge
        ListMemberThere(prior) -> impossible_list_member(prior)
    AcceptingNextAccepted(_, _, _, _, _, edge, _, suffix) -> match predicate_destinations_view(test, char, transition_boundary_before(char, [], after_input))
      PredicateRejects() -> impossible_list_member(edge)
      PredicateAccepts() -> match edge
        ListMemberHere() -> match suffix
          AcceptingNow() -> PredicateRoutineExact()
        ListMemberThere(prior) -> impossible_list_member(prior)
