@group(:concurrency)
mod Std.Otp.MultipartySession
  ## MULTIPARTY SESSION TYPES (build-out map B3, session extension). A GLOBAL type describes a
  ## whole protocol as a sequence of interactions `from → to : tag`, from a bird's-eye view.
  ## Each role obtains its LOCAL type by PROJECTION — keeping the messages it sends/receives and
  ## skipping the ones it isn't party to. The central well-formedness result (Honda–Yoshida–
  ## Carbone): the projections COHERE — for a two-role protocol, the projections onto the two
  ## roles are DUAL, so the endpoints can safely communicate (`Std.Otp.Session`'s duality, now
  ## derived from a global protocol rather than assumed).
  ##
  ## `project(G, r)` computes role `r`'s local type; `projection_duality` proves that a two-party
  ## global (`TwoParty`) projects to dual endpoints, so global well-formedness yields local
  ## communication safety.

  type Role = RA | RB
  type Tag = TA | TB | TC
  type B = F | T
  fn role_eq(x: Role, y: Role) -> B = match x
    RA() -> match y
      RA() -> T
      RB() -> F
    RB() -> match y
      RA() -> F
      RB() -> T

  ## A global protocol: `GMsg(from, to, tag, continuation)` — role `from` sends `tag` to `to`.
  type Global = GEnd | GMsg(Role, Role, Tag, Global)
  ## A local (endpoint) type: send/receive/end.
  type Local = LEnd | LSend(Tag, Local) | LRecv(Tag, Local)

  fn dual(l: Local) -> Local = match l
    LEnd()      -> LEnd()
    LSend(t, k) -> LRecv(t, dual(k))
    LRecv(t, k) -> LSend(t, dual(k))

  ## Project a global protocol onto one role: it SENDS the messages it originates, RECEIVES the
  ## ones addressed to it, and skips the rest.
  fn project(g: Global, r: Role) -> Local = match g
    GEnd()              -> LEnd()
    GMsg(from, to, t, k) -> match role_eq(from, r)
      T() -> LSend(t, project(k, r))
      F() -> match role_eq(to, r)
        T() -> LRecv(t, project(k, r))
        F() -> project(k, r)

  ## A well-formed TWO-PARTY global: every message is between `RA` and `RB` (in either
  ## direction). The tag is carried explicitly so the coherence proof can name it.
  type TwoParty indices (g: Global)
    TPEnd : TwoParty(GEnd)
    TPAB  : (t: Tag) -> TwoParty(k) -> TwoParty(GMsg(RA, RB, t, k))
    TPBA  : (t: Tag) -> TwoParty(k) -> TwoParty(GMsg(RB, RA, t, k))

  fn lsend_cong(t: Tag, {a: Local}, {b: Local}, e: Equivalent(Local, a, b)) -> Equivalent(Local, LSend(t, a), LSend(t, b)) =
    rewrite e in reflexive(LSend(t, b))
  fn lrecv_cong(t: Tag, {a: Local}, {b: Local}, e: Equivalent(Local, a, b)) -> Equivalent(Local, LRecv(t, a), LRecv(t, b)) =
    rewrite e in reflexive(LRecv(t, b))

  ## **PROJECTION COHERENCE.** A two-party global protocol projects to DUAL endpoints:
  ## `project(G, RA) = dual(project(G, RB))`. So a well-formed global guarantees its two
  ## participants have compatible (dual) local types — global well-formedness ⟹ endpoint safety.
  ## Induction on the two-party well-formedness derivation; each message is a send for one role
  ## and the receive for the other, and duality swaps them.
  fn projection_duality({g: Global}, wf: TwoParty(g)) -> Equivalent(Local, project(g, RA), dual(project(g, RB))) = match wf
    TPEnd()       -> reflexive(LEnd())
    TPAB(t, wf2)  -> lsend_cong(t, projection_duality(wf2))
    TPBA(t, wf2)  -> lrecv_cong(t, projection_duality(wf2))

  ## A global protocol REDUCES by firing its head interaction: the message is exchanged and the
  ## protocol advances to the continuation.
  type GStep indices (g: Global, g2: Global)
    GFire : GStep(GMsg(from, to, t, k), k)

  ## **GLOBAL SUBJECT REDUCTION.** Firing the head interaction of a well-formed two-party
  ## protocol yields a well-formed two-party protocol — so (with `projection_duality`) the
  ## projected endpoints stay coherent through every step of the protocol's execution.
  fn twoparty_preserved({g: Global}, {g2: Global}, wf: TwoParty(g), st: GStep(g, g2)) -> TwoParty(g2) = match st
    GFire() -> match wf
      TPAB(t, wf2) -> wf2
      TPBA(t, wf2) -> wf2

  ## A well-formed global protocol is either FINISHED (`GEnd`) or has a head interaction ready to
  ## FIRE. Both index shapes are fixed by the scrutinee, so nothing floats during construction.
  type GProgress indices (g: Global)
    GPDone : GProgress(GEnd)
    GPFire : GProgress(GMsg(from, to, t, k))

  ## **GLOBAL PROGRESS.** A two-party protocol never deadlocks: it is either complete or its head
  ## interaction can fire. Case analysis on the well-formedness derivation. With
  ## `twoparty_preserved` this is full safety for the global protocol — it always either finishes
  ## or makes progress, and firing keeps it well-formed (so projections stay coherent throughout).
  fn global_progress({g: Global}, wf: TwoParty(g)) -> GProgress(g) = match wf
    TPEnd()      -> GPDone()
    TPAB(t, wf2) -> GPFire()
    TPBA(t, wf2) -> GPFire()

  ## A whole global RUN: the reflexive-transitive closure of head-firings.
  type GRun indices (g: Global, g2: Global)
    GRDone : GRun(g, g)
    GRStep : GStep(g, gm) -> GRun(gm, g2) -> GRun(g, g2)

  ## Prepend one head-firing to a completing run. The explicit `tail` argument pins `GRStep`'s
  ## intermediate index (the continuation `k`), so the nullary `GFire` is checked against a
  ## concrete type — the explicit-`tail` pattern that sidesteps the floating-target E6-residual.
  fn grun_fire(from: Role, to: Role, t: Tag, {k: Global}, tail: GRun(k, GEnd)) -> GRun(GMsg(from, to, t, k), GEnd) =
    GRStep(GFire(), tail)

  ## **GLOBAL NORMALISATION.** Every well-formed two-party protocol runs all the way to `GEnd`:
  ## there is a full `GRun` from `g` to `GEnd`. Structural induction on the well-formedness
  ## derivation, firing the head interaction at each step; since `Global` is finite the run is
  ## finite. With `global_progress` and `twoparty_preserved` this is full safety for the global
  ## protocol — it never deadlocks, stays well-formed, and always terminates.
  fn twoparty_terminates({g: Global}, wf: TwoParty(g)) -> GRun(g, GEnd) = match wf
    TPEnd()      -> GRDone()
    TPAB(t, wf2) -> grun_fire(RA, RB, t, twoparty_terminates(wf2))
    TPBA(t, wf2) -> grun_fire(RB, RA, t, twoparty_terminates(wf2))
end
