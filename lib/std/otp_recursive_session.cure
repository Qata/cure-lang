@group(:concurrency)
mod Std.Otp.RecursiveSession
  ## RECURSIVE SESSION TYPES (build-out map B3, session extension). Real protocols loop — a
  ## server repeatedly offers a request/response — which needs RECURSIVE session types `μX. S`.
  ## The subtlety recursion adds is that DUALITY must commute with UNFOLDING: the dual of a
  ## recursive session, unfolded, is the unfolding of the dualized session. Without that, the two
  ## endpoints of a looping protocol could drift out of duality across iterations.
  ##
  ## `RSType` is a session type with a single recursion variable `RVar` and binder `RMu`. `subst`
  ## substitutes the variable, `unfold(μX.S) = S[μX.S/X]`, `rdual` dualizes (swapping send/recv).
  ## The theorems: `rdual_involution` (dual is still an involution), `subst_dual` (dual distributes
  ## over substitution), and the headline `dual_unfold_commute` — `dual(unfold(μX.S)) =
  ## unfold(μX.dual(S))` — so a recursive protocol's endpoints stay dual through every unfolding.

  type Tag = TA | TB | TC
  type RSType = REnd | RSend(Tag, RSType) | RRecv(Tag, RSType) | RVar | RMu(RSType)

  ## Substitute the recursion variable `RVar` with `u`. A nested `RMu` rebinds the variable, so
  ## substitution stops there (single-variable, capture-avoiding).
  fn subst(s: RSType, u: RSType) -> RSType = match s
    REnd()      -> REnd()
    RSend(t, k) -> RSend(t, subst(k, u))
    RRecv(t, k) -> RRecv(t, subst(k, u))
    RVar()      -> u
    RMu(body)   -> RMu(body)

  ## Unfold a recursive session one step: `μX.S ↦ S[μX.S/X]`. Identity on non-recursive heads.
  fn unfold(m: RSType) -> RSType = match m
    REnd()      -> REnd()
    RSend(t, k) -> RSend(t, k)
    RRecv(t, k) -> RRecv(t, k)
    RVar()      -> RVar()
    RMu(body)   -> subst(body, RMu(body))

  ## Dual: swap send/receive; recurse under the binder; the variable is self-dual.
  fn rdual(s: RSType) -> RSType = match s
    REnd()      -> REnd()
    RSend(t, k) -> RRecv(t, rdual(k))
    RRecv(t, k) -> RSend(t, rdual(k))
    RVar()      -> RVar()
    RMu(body)   -> RMu(rdual(body))

  ## **DUALITY IS AN INVOLUTION** (recursive case included).
  fn rdual_involution(s: RSType) -> Equivalent(RSType, rdual(rdual(s)), s) = match s
    REnd()      -> reflexive(REnd())
    RSend(t, k) -> rewrite rdual_involution(k) in reflexive(RSend(t, k))
    RRecv(t, k) -> rewrite rdual_involution(k) in reflexive(RRecv(t, k))
    RVar()      -> reflexive(RVar())
    RMu(body)   -> rewrite rdual_involution(body) in reflexive(RMu(body))

  ## **DUAL DISTRIBUTES OVER SUBSTITUTION.** `dual(S[u/X]) = dual(S)[dual(u)/X]`.
  fn subst_dual(s: RSType, u: RSType) -> Equivalent(RSType, rdual(subst(s, u)), subst(rdual(s), rdual(u))) = match s
    REnd()      -> reflexive(REnd())
    RSend(t, k) -> rewrite subst_dual(k, u) in reflexive(RRecv(t, subst(rdual(k), rdual(u))))
    RRecv(t, k) -> rewrite subst_dual(k, u) in reflexive(RSend(t, subst(rdual(k), rdual(u))))
    RVar()      -> reflexive(rdual(u))
    RMu(body)   -> reflexive(RMu(rdual(body)))

  ## **DUALITY COMMUTES WITH UNFOLDING.** `dual(unfold(μX.S)) = unfold(μX.dual(S))` — the
  ## endpoints of a recursive protocol stay dual across every unfolding. A direct corollary of
  ## `subst_dual` at the self-substitution.
  fn dual_unfold_commute(body: RSType) -> Equivalent(RSType, rdual(unfold(RMu(body))), unfold(RMu(rdual(body)))) =
    subst_dual(body, RMu(body))

  ## **DUALITY COMMUTES WITH UNFOLDING — GENERAL FORM.** `dual(unfold(S)) = unfold(dual(S))` for
  ## EVERY session shape, recursive or not. On a non-recursive head `unfold` is the identity and
  ## `rdual` commutes structurally; on `RMu` it is exactly `subst_dual` at the self-substitution.
  ## `dual_unfold_commute` above is the `RMu` instance of this law.
  fn rdual_unfold(s: RSType) -> Equivalent(RSType, rdual(unfold(s)), unfold(rdual(s))) = match s
    REnd()      -> reflexive(REnd())
    RSend(t, k) -> reflexive(RRecv(t, rdual(k)))
    RRecv(t, k) -> reflexive(RSend(t, rdual(k)))
    RVar()      -> reflexive(RVar())
    RMu(body)   -> subst_dual(body, RMu(body))
end
