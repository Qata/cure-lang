@group(:concurrency)
mod Std.Otp.Queue
  use Std.Equivalent
  ## ERLANG `:queue` — the amortized TWO-LIST functional queue OTP reaches for everywhere (message
  ## buffers, work lists). A queue is a FRONT list (dequeue end, in order) and a BACK list (enqueue
  ## end, REVERSED); its logical FIFO sequence is `front ++ reverse(back)`. Enqueue pushes onto the
  ## back in O(1); dequeue pops the front, reversing the back onto it only when the front runs dry —
  ## so the representation is not unique, and correctness is exactly that every operation preserves
  ## the logical sequence.
  ##
  ## The headline law: ENQUEUE APPENDS — `to_list(enqueue(x, q)) = to_list(q) ++ [x]`. So the
  ## two-list encoding faithfully realizes a FIFO queue: an element pushed on the back really lands
  ## at the end of the logical order, no matter how front/back are currently split.

  type QList = QNil | QCons(Nat, QList)

  fn append(xs: QList, ys: QList) -> QList = match xs
    QNil()       -> ys
    QCons(h, t)  -> QCons(h, append(t, ys))

  ## Reverse via the standard `append`-based definition; `reverse(QCons(x, xs)) = reverse(xs) ++ [x]`
  ## holds definitionally, which is exactly what the enqueue proof needs.
  fn reverse(xs: QList) -> QList = match xs
    QNil()       -> QNil()
    QCons(h, t)  -> append(reverse(t), QCons(h, QNil()))

  fn cons_cong(h: Nat, {a: QList}, {b: QList}, e: Equivalent(QList, a, b)) -> Equivalent(QList, QCons(h, a), QCons(h, b)) =
    rewrite e in reflexive(QCons(h, b))

  ## `append` is associative — the list lemma the enqueue proof turns on.
  fn append_assoc(xs: QList, ys: QList, zs: QList) -> Equivalent(QList, append(append(xs, ys), zs), append(xs, append(ys, zs))) = match xs
    QNil()       -> reflexive(append(ys, zs))
    QCons(h, t)  -> cons_cong(h, append_assoc(t, ys, zs))

  ## A queue: `MkQ(front, back)` with logical sequence `front ++ reverse(back)`.
  type Q = MkQ(QList, QList)
  ## The logical FIFO sequence a queue denotes.
  fn to_list(q: Q) -> QList = match q
    MkQ(f, b) -> append(f, reverse(b))
  ## Enqueue: push onto the back (O(1)); the back stays reversed.
  fn enqueue(x: Nat, q: Q) -> Q = match q
    MkQ(f, b) -> MkQ(f, QCons(x, b))

  ## **ENQUEUE APPENDS.** `to_list(enqueue(x, q)) = to_list(q) ++ [x]`. Pushing onto the reversed
  ## back places `x` at the END of the logical sequence: `reverse(QCons(x, b)) = reverse(b) ++ [x]`
  ## (definitional), then `append_assoc` re-associates `f ++ (reverse(b) ++ [x])` into
  ## `(f ++ reverse(b)) ++ [x] = to_list(q) ++ [x]`. So the two-list encoding is a faithful FIFO.
  fn enqueue_appends(x: Nat, q: Q) -> Equivalent(QList, to_list(enqueue(x, q)), append(to_list(q), QCons(x, QNil()))) = match q
    MkQ(f, b) -> sym(append_assoc(f, reverse(b), QCons(x, QNil())))

  ## `QNil` is a right unit for `append` — needed for the reversal case of dequeue.
  fn append_nil_r(xs: QList) -> Equivalent(QList, append(xs, QNil()), xs) = match xs
    QNil()      -> reflexive(QNil())
    QCons(h, t) -> cons_cong(h, append_nil_r(t))

  ## The result of a dequeue: the queue was empty, or its oldest element `x` came off leaving `q2`.
  type QOut = QEmpty | Out(Nat, Q)

  ## Pop the head off a bare list. Defined BEFORE `dequeue` so it is certified-total first —
  ## otherwise `dequeue` (which calls it) is not certified and won't δ-reduce.
  fn deq_list(xs: QList) -> QOut = match xs
    QNil()      -> QEmpty()
    QCons(h, t) -> Out(h, MkQ(t, QNil()))

  ## **DEQUEUE.** Pop the oldest element (front of the logical sequence). If the front list is
  ## non-empty, take its head in O(1); if it is empty, REVERSE the back onto the front and pop that
  ## (the amortization) — the front-empty case is exactly `deq_list(reverse(b))`. Both empty ⇒ the
  ## queue is empty.
  fn dequeue(q: Q) -> QOut = match q
    MkQ(f, b) -> match f
      QCons(h, f2) -> Out(h, MkQ(f2, b))
      QNil()       -> deq_list(reverse(b))

  ## Reassemble a dequeue result back into a logical sequence: nothing, or the head consed onto the
  ## remaining queue's sequence.
  fn reassemble(o: QOut) -> QList = match o
    QEmpty()   -> QNil()
    Out(x, q2) -> QCons(x, to_list(q2))

  ## Splitting the head off a bare list and reassembling is the identity — the reversal case of
  ## dequeue in isolation.
  fn deq_list_reassembles(xs: QList) -> Equivalent(QList, reassemble(deq_list(xs)), xs) = match xs
    QNil()      -> reflexive(QNil())
    QCons(h, t) -> cons_cong(h, append_nil_r(t))

  ## **DEQUEUE SPLITS OFF THE HEAD (losing nothing).** `reassemble(dequeue(q)) = to_list(q)` — a
  ## dequeue removes exactly the oldest element and the remaining queue denotes exactly the tail, in
  ## BOTH the fast (non-empty front) and the amortized (front-empty, back-reversed) cases. So the
  ## amortization is correct: reversing the back to refill the front preserves the FIFO sequence.
  fn dequeue_reassembles(q: Q) -> Equivalent(QList, reassemble(dequeue(q)), to_list(q)) = match q
    MkQ(f, b) -> match f
      QCons(h, f2) -> reflexive(QCons(h, append(f2, reverse(b))))
      QNil()       -> deq_list_reassembles(reverse(b))

  fn append_cong(c: QList, {a: QList}, {b: QList}, e: Equivalent(QList, a, b)) -> Equivalent(QList, append(a, c), append(b, c)) =
    rewrite e in reflexive(append(b, c))

  ## **REPRESENTATION INDEPENDENCE.** The two-list split is NOT unique — many `(front, back)` pairs
  ## denote the same logical sequence. The operations are well-defined on that sequence: if `q1` and
  ## `q2` have the same `to_list`, then so do `enqueue(x, q1)` and `enqueue(x, q2)` (`enqueue_respects`,
  ## via `enqueue_appends` + `append` congruence), and a dequeue from either observes the same result
  ## (`dequeue_respects`, via `dequeue_reassembles`: `reassemble(dequeue(qi)) = to_list(qi)`). So the
  ## amortized queue is a faithful implementation of the abstract FIFO — the internal split is
  ## invisible to a client.
  fn enqueue_respects(x: Nat, q1: Q, q2: Q, e: Equivalent(QList, to_list(q1), to_list(q2))) -> Equivalent(QList, to_list(enqueue(x, q1)), to_list(enqueue(x, q2))) =
    trans(enqueue_appends(x, q1), trans(append_cong(QCons(x, QNil()), e), sym(enqueue_appends(x, q2))))
  fn dequeue_respects(q1: Q, q2: Q, e: Equivalent(QList, to_list(q1), to_list(q2))) -> Equivalent(QList, reassemble(dequeue(q1)), reassemble(dequeue(q2))) =
    trans(dequeue_reassembles(q1), trans(e, sym(dequeue_reassembles(q2))))

  ## PEEK — inspect the oldest element without removing it (Erlang `queue:peek`). An optional Nat.
  type QOpt = QNone | QSome(Nat)
  fn peek_list(xs: QList) -> QOpt = match xs
    QNil()      -> QNone()
    QCons(h, t) -> QSome(h)
  fn peek(q: Q) -> QOpt = match q
    MkQ(f, b) -> match f
      QCons(h, f2) -> QSome(h)
      QNil()       -> peek_list(reverse(b))
  ## The head that a dequeue would remove.
  fn head_of(o: QOut) -> QOpt = match o
    QEmpty()   -> QNone()
    Out(x, q2) -> QSome(x)

  ## **PEEK AGREES WITH DEQUEUE.** `peek(q) = head_of(dequeue(q))` — looking at the front observes
  ## exactly the element a dequeue would pop, in both the fast and the amortized case. `peek` mirrors
  ## `dequeue`'s front/back split structurally, so the fast case is reflexive and the front-empty case
  ## reduces to `peek_list(reverse(b)) = head_of(deq_list(reverse(b)))`.
  fn peek_list_deq(xs: QList) -> Equivalent(QOpt, peek_list(xs), head_of(deq_list(xs))) = match xs
    QNil()      -> reflexive(QNone())
    QCons(h, t) -> reflexive(QSome(h))
  fn peek_dequeue(q: Q) -> Equivalent(QOpt, peek(q), head_of(dequeue(q))) = match q
    MkQ(f, b) -> match f
      QCons(h, f2) -> reflexive(QSome(h))
      QNil()       -> peek_list_deq(reverse(b))

  ## IS_EMPTY — the O(1) structural test (both lists empty), as Erlang `queue:is_empty` does it.
  type B = F | T
  fn qnull(xs: QList) -> B = match xs
    QNil()      -> T()
    QCons(h, t) -> F()
  fn andb(a: B, b: B) -> B = match a
    F() -> F()
    T() -> b
  fn is_empty(q: Q) -> B = match q
    MkQ(f, b) -> andb(qnull(f), qnull(b))

  ## `qnull` is invariant under `reverse` (reversing doesn't create or destroy elements): appending a
  ## singleton is never null, and `reverse` of a cons ends in exactly such an append.
  fn qnull_append_cons(xs: QList, h: Nat) -> Equivalent(B, qnull(append(xs, QCons(h, QNil()))), F()) = match xs
    QNil()      -> reflexive(F())
    QCons(a, t) -> reflexive(F())
  fn qnull_reverse(xs: QList) -> Equivalent(B, qnull(reverse(xs)), qnull(xs)) = match xs
    QNil()      -> reflexive(T())
    QCons(h, t) -> qnull_append_cons(reverse(t), h)

  ## **IS_EMPTY REFLECTS THE LOGICAL SEQUENCE.** `is_empty(q) = null(to_list(q))` — the cheap
  ## both-lists-empty test agrees with the queue actually denoting the empty sequence, even for
  ## `{[], [a]}`-style states where the front is empty but the back is not (there `is_empty` is
  ## `null(b)`, matched by `null(reverse(b)) = null(to_list)` via `qnull_reverse`).
  fn is_empty_reflects(q: Q) -> Equivalent(B, is_empty(q), qnull(to_list(q))) = match q
    MkQ(f, b) -> match f
      QCons(h, f2) -> reflexive(F())
      QNil()       -> sym(qnull_reverse(b))
end
