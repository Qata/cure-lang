@group(:text)
mod Std.String
  ## Value-surface string operations: length, concat, split, trim,
  ## case conversion, and integer/float/atom parsing.
  ##
  ## A `String` is a `List(Char)` — the charlist of Unicode code points a
  ## string literal `"hi"` elaborates to. You can pattern-match, fold, and
  ## `map` it like any other list; the functions here are the string-flavoured
  ## conveniences.
  ##
  ## Each function tolerates either representation of its input — the
  ## dependent-surface charlist *or* a raw BEAM binary handed in from OTP — by
  ## normalising through `:unicode.characters_to_list/1` before it touches a
  ## list-only BIF. Producers (`concat`, `from_int`, `reverse`, …) always yield
  ## the value-surface `List(Char)`. Use `Std.Binary.to_binary`/`from_binary`
  ## only when you must hand a raw BEAM binary back to OTP.
  ##
  ## ## Examples
  ##
  ## ```cure
  ## use Std.String
  ##
  ## length("hello")                         # => 5   (code points, not bytes)
  ## concat("foo", "bar")                    # => "foobar"
  ## upcase("cafe")                          # => "CAFE"
  ## split("a,b,c", ",")                     # => ["a", "b,c"]  (splits once)
  ## repeat("ab", 3)                         # => "ababab"
  ## ```
  ##
  ## ```cure
  ## use Std.String
  ##
  ## from_int(42)                            # => "42"
  ## to_int(trim("  -17 "))                  # => -17
  ## ```

  use Std.Char
  use Std.Atom
  use Std.Option

  ## `String` is the value-surface charlist of Unicode code points. `@prelude`
  ## makes the bare `String` name resolve in every module without `use Std.String`
  ## — `List`/`Char` are already ambient, so the alias is all that is needed.
  @prelude
  typealias String = List(Char)

  # -- Input adapter ----------------------------------------------------------

  ## Normalise any chardata (a value-surface charlist or a raw BEAM binary) to a
  ## flat `List(Char)`. Every function that feeds a list-only BIF routes its
  ## input through here first, so both representations are accepted.
  @extern(:unicode, :characters_to_list, 1)
  local fn as_charlist(s: String) -> String

  # -- Basic operations -------------------------------------------------------

  ## `:erlang.length/1` on a normalised charlist.
  @extern(:erlang, :length, 1)
  local fn list_length(s: String) -> Int

  ## Number of code points in `s`. Unlike a byte-length, this counts
  ## characters: a multi-byte code point is one.
  fn length(s: String) -> Int = list_length(as_charlist(s))

  ## `true` when `s` is the empty string. Written with the `int_eq` primitive
  ## directly (not `==`): `Std.String` is inside the `@prelude` bootstrap closure,
  ## so it elaborates with no ambient `Equatable` and cannot `use Std.Equatable`
  ## (that would cycle, since `Std.Equatable` uses `Std.String`).
  fn is_empty(s: String) -> Bool = Std.Builtin.int_eq(length(s), 0)

  ## `:lists.append/2` on two normalised charlists.
  @extern(:lists, :append, 2)
  local fn append_cl(a: String, b: String) -> String

  ## Concatenate two strings; yields a `List(Char)`.
  fn concat(a: String, b: String) -> String = append_cl(as_charlist(a), as_charlist(b))

  # -- Case conversion --------------------------------------------------------

  ## Lower-case `s` using Unicode case folding (`:string.lowercase/1`).
  ## Representation-preserving: a charlist maps to a charlist.
  @extern(:string, :lowercase, 1)
  fn downcase(s: String) -> String

  ## Upper-case `s` using Unicode case folding (`:string.uppercase/1`).
  @extern(:string, :uppercase, 1)
  fn upcase(s: String) -> String

  ## Swift-style spellings retained alongside the original Cure names.
  fn lowercased(s: String) -> String = downcase(s)
  fn uppercased(s: String) -> String = upcase(s)

  # -- Inspection -------------------------------------------------------------

  fn has_prefix(s: String, prefix: String) -> Bool = has_prefix_chars(as_charlist(s), as_charlist(prefix))

  local fn has_prefix_chars(s: String, prefix: String) -> Bool =
    match prefix
      [] -> true
      [wanted | wanted_rest] ->
        match s
          [] -> false
          [actual | actual_rest] ->
            match Std.Char.same(actual, wanted)
              true -> has_prefix_chars(actual_rest, wanted_rest)
              false -> false

  fn has_suffix(s: String, suffix: String) -> Bool =
    has_prefix_chars(reverse_cl(as_charlist(s)), reverse_cl(as_charlist(suffix)))

  fn contains(s: String, wanted: Char) -> Bool = contains_char(as_charlist(s), wanted)

  local fn contains_char(s: String, wanted: Char) -> Bool =
    match s
      [] -> false
      [head | rest] ->
        match Std.Char.same(head, wanted)
          true -> true
          false -> contains_char(rest, wanted)

  fn first(s: String) -> Option(Char) =
    match as_charlist(s)
      [] -> None()
      [head | _] -> Some(head)

  fn last(s: String) -> Option(Char) = last_char(as_charlist(s))

  local fn last_char(s: String) -> Option(Char) =
    match s
      [] -> None()
      [head] -> Some(head)
      [_ | rest] -> last_char(rest)

  fn prefix(s: String, count: Int) -> String = take_chars(as_charlist(s), count)

  local fn take_chars(s: String, count: Int) -> String =
    match Std.Builtin.int_lt(0, count)
      false -> []
      true ->
        match s
          [] -> []
          [head | rest] -> [head | take_chars(rest, Std.Builtin.int_sub(count, 1))]

  fn drop_first(s: String, count: Int) -> String = drop_chars(as_charlist(s), count)

  local fn drop_chars(s: String, count: Int) -> String =
    match Std.Builtin.int_lt(0, count)
      false -> s
      true ->
        match s
          [] -> []
          [_ | rest] -> drop_chars(rest, Std.Builtin.int_sub(count, 1))

  fn suffix(s: String, count: Int) -> String = reverse_cl(take_chars(reverse_cl(as_charlist(s)), count))

  fn drop_last(s: String, count: Int) -> String = reverse_cl(drop_chars(reverse_cl(as_charlist(s)), count))

  # -- Trim -------------------------------------------------------------------

  ## Private helper: `:string.trim/2` with an explicit direction atom.
  ## Representation-preserving.
  @extern(:string, :trim, 2)
  local fn trim_dir(s: String, where: Atom) -> String

  ## Strip leading and trailing whitespace.
  fn trim(s: String) -> String = trim_dir(s, :both)

  ## Strip leading whitespace only.
  fn trim_leading(s: String) -> String = trim_dir(s, :leading)

  ## Strip trailing whitespace only.
  fn trim_trailing(s: String) -> String = trim_dir(s, :trailing)

  # -- Conversion -------------------------------------------------------------

  ## Render an `Int` as its canonical decimal string (a `List(Char)`).
  @extern(:erlang, :integer_to_list, 1)
  fn from_int(n: Int) -> String

  ## Render a `Float` as its string form (`:erlang.float_to_list/1`).
  @extern(:erlang, :float_to_list, 1)
  fn from_float(f: Float) -> String

  ## Render an `Atom` as its name; no `:` prefix is added.
  @extern(:erlang, :atom_to_list, 1)
  fn from_atom(a: Atom) -> String

  ## `:erlang.list_to_integer/1` on a normalised charlist.
  @extern(:erlang, :list_to_integer, 1)
  local fn cl_to_int(s: String) -> Int

  ## Parse `s` as a base-10 integer. Raises on bad input.
  fn to_int(s: String) -> Int = cl_to_int(as_charlist(s))

  ## `:erlang.list_to_float/1` on a normalised charlist.
  @extern(:erlang, :list_to_float, 1)
  local fn cl_to_float(s: String) -> Float

  ## Parse `s` as a float. Raises on bad input.
  fn to_float(s: String) -> Float = cl_to_float(as_charlist(s))

  ## `:erlang.list_to_existing_atom/1` on a normalised charlist. This never
  ## grows the VM atom table, but raises when the atom is not already interned.
  @extern(:erlang, :list_to_existing_atom, 1)
  local fn cl_to_existing_atom(s: String) -> Atom

  ## Convert `s` to an atom that already exists in the VM atom table.
  ## Raises when no such atom exists; importantly, arbitrary input cannot grow
  ## the permanent atom table.
  fn to_existing_atom(s: String) -> Atom = cl_to_existing_atom(as_charlist(s))

  ## `:erlang.list_to_atom/1` on a normalised charlist. This is the explicit
  ## raw escape hatch for callers that really intend to intern a new atom.
  @extern(:erlang, :list_to_atom, 1)
  local fn cl_to_atom(s: String) -> Atom

  ## UNSAFE: intern `s` as a permanent VM atom. Never pass attacker-controlled
  ## or otherwise unbounded input; atoms are not garbage-collected.
  fn unsafe_to_atom(s: String) -> Atom = cl_to_atom(as_charlist(s))

  # -- Split / Repeat / Reverse -----------------------------------------------

  ## Private helper: `:string.split/3` splitting on the first occurrence.
  ## Representation-preserving.
  @extern(:string, :split, 3)
  local fn split_first(s: String, sep: String, where: Atom) -> List(String)

  ## Split `s` on the first occurrence of `sep`.
  fn split(s: String, sep: String) -> List(String) = split_first(s, sep, :leading)

  ## Split on every occurrence of one character, following Swift's default of
  ## omitting empty subsequences.
  fn split_on(s: String, separator: Char) -> List(String) =
    omit_empty(split_all(as_charlist(s), [separator], :all))

  @extern(:string, :split, 3)
  local fn split_all(s: String, sep: String, where: Atom) -> List(String)

  local fn omit_empty(parts: List(String)) -> List(String) =
    match parts
      [] -> []
      [head | rest] ->
        match is_empty(head)
          true -> omit_empty(rest)
          false -> [head | omit_empty(rest)]

  ## `:string.copies/2` on a normalised charlist.
  @extern(:string, :copies, 2)
  local fn copies_cl(s: String, n: Int) -> String

  ## Return `s` concatenated with itself `n` times.
  fn repeat(s: String, n: Int) -> String = copies_cl(as_charlist(s), n)

  ## `:lists.reverse/1` on a normalised charlist.
  @extern(:lists, :reverse, 1)
  local fn reverse_cl(s: String) -> String

  ## Reverse `s` by code point.
  fn reverse(s: String) -> String = reverse_cl(as_charlist(s))
