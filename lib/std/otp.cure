@group(:concurrency)
mod Std.Otp
  use Std.Otp.Raw
  use Std.Bool

  ## Transparent process-operation syntax. Each rule produces ordinary Cure
  ## syntax; the checked algebra remains the only semantic implementation.
  macro BeamOps
    syntax beam_ops start_statem <module: Code> <args: Code> contextual becomes Std.Otp.start_statem(module, args)
    syntax beam_ops start_supervisor <module: Code> contextual becomes Std.Otp.start_supervisor(module)
    syntax beam_ops start_supervisor <module: Code> <args: Code> contextual becomes Std.Otp.start_supervisor_with(module, args)
    syntax beam_ops self contextual becomes Std.Otp.self()

    syntax beam_ops tell <dest: Code> <message: Code> contextual becomes Std.Otp.tell(dest, message)
    syntax beam_ops send <dest: Code> <message: Code> contextual becomes Std.Otp.tell(dest, message)
    syntax beam_ops call <server: Code> <request: Code> contextual becomes Std.Otp.call(server, request)
    syntax beam_ops cast <server: Code> <request: Code> contextual becomes Std.Otp.cast(server, request)
    syntax beam_ops spawn <thunk: Code> contextual becomes Std.Otp.spawn(thunk)
    syntax beam_ops spawn_link <thunk: Code> contextual becomes Std.Otp.spawn_link(thunk)
    syntax beam_ops start_link <module: Code> <args: Code> contextual becomes Std.Otp.start_link(module, args)
    syntax beam_ops stop <pid: Code> contextual becomes Std.Otp.stop(pid)
    syntax beam_ops send_after <delay: Code> <pid: Code> <message: Code> contextual becomes Std.Otp.send_after(delay, pid, message)
    syntax beam_ops cancel_timer <ref: Code> contextual becomes Std.Otp.cancel_timer(ref)
    syntax beam_ops monitor <kind: Code> <pid: Code> contextual becomes Std.Otp.monitor(kind, pid)
    syntax beam_ops demonitor <ref: Code> contextual becomes Std.Otp.demonitor(ref)
    syntax beam_ops link <pid: Code> contextual becomes Std.Otp.link(pid)
    syntax beam_ops unlink <pid: Code> contextual becomes Std.Otp.unlink(pid)

  ## The typed BEAM process algebra — the sanctioned concurrency surface.
  ##
  ## Two typed handles, both opaque phantoms erased to a raw `erlang:pid()` at
  ## runtime; their whole job is static — using a process at the WRONG message or
  ## reply type is a COMPILE error, the guarantee `Std.Otp.Raw`'s untyped `Pid`
  ## cannot give (design 2026-07-10-checked-beam-concurrency §2,
  ## 2026-07-09-typed-beam-process-algebra):
  ##
  ##   * `Pid(m)`            — a plain process accepting messages of type `m`
  ##                          (raw `erlang:send`, one-way).
  ##   * `GenServer(q, r)`   — a `gen_server` taking requests `q`; a synchronous
  ##                          `call` returns a reply `r`. The reply type rides on
  ##                          the SERVER'S type, so `call` needs no return-only
  ##                          implicit (which does not resolve through an effectful
  ##                          extern) — a wrong request AND a wrong reply are both
  ##                          caught.
  ##
  ## Every operation performs a BEAM side effect, so it returns `Effect(T)`: the
  ## effect discipline forbids duplicating, dropping, or reordering a
  ## `tell`/`call`/`cast`. Messages are POLYMORPHIC (the narrow point for a message
  ## set), never `Any`.
  ##
  ## The typed layer calls the raw externs through ordinary qualified Cure
  ## definitions. The only foreign declarations are in `Std.Otp.Raw`; the
  ## imported opaque carrier preserves erased runtime identity while the public
  ## aliases below attach message and request/reply indices.

  ## A typed process handle accepting messages of type `m`.
  typealias Pid(m) = RawPid(m, m)

  ## A typed `gen_server` taking requests `q`, replying `r`.
  typealias GenServer(q, r) = RawPid(q, r)

  ## A process message set. The first algebra floor stores tag and arity
  ## shapes; typed ADT payload derivation is added by the transparent macro
  ## phase once callback syntax is available.
  type MessageCode = Empty | Shape(Atom, Int, MessageCode)

  ## A single message shape constructor, convenient for macro-generated codes.
  fn message_code(tag: Atom, arity: Int) -> MessageCode = Shape(tag, arity, Empty)

  local fn same_shape(left_tag: Atom, left_arity: Int, right_tag: Atom, right_arity: Int) -> Bool =
    `and`(left_tag == right_tag, left_arity == right_arity)

  ## Does `code` accept a message tag with the given payload arity?
  fn handles(code: MessageCode, tag: Atom, arity: Int) -> Bool =
    match code
      Empty -> false
      Shape(found_tag, found_arity, rest) ->
        match same_shape(found_tag, found_arity, tag, arity)
          true -> true
          false -> handles(rest, tag, arity)

  ## Is every shape in `narrow` also accepted by `wide`?
  fn subset(narrow: MessageCode, wide: MessageCode) -> Bool =
    match narrow
      Empty -> true
      Shape(tag, arity, rest) -> `and`(handles(wide, tag, arity), subset(rest, wide))

  local fn remove_shape(code: MessageCode, tag: Atom, arity: Int) -> MessageCode =
    match code
      Empty -> Empty
      Shape(found_tag, found_arity, rest) ->
        match same_shape(found_tag, found_arity, tag, arity)
          true -> remove_shape(rest, tag, arity)
          false -> Shape(found_tag, found_arity, remove_shape(rest, tag, arity))

  ## Union two codes, preserving the first code's order and removing duplicate
  ## tag/arity shapes from the second code.
  fn union(left: MessageCode, right: MessageCode) -> MessageCode =
    match left
      Empty -> right
      Shape(tag, arity, rest) -> Shape(tag, arity, union(rest, remove_shape(right, tag, arity)))

  ## The calling process's own typed pid; the erased message index is supplied
  ## by the enclosing expected result at each use site.
  fn self({m: Type}) -> Effect(Pid(m)) = raw_self()

  ## Spawn a nullary process function and return its indexed handle.
  fn spawn({m: Type}, thunk: () -> Unit) -> Effect(Pid(m)) = raw_spawn(thunk)

  ## Spawn and link a nullary process function to the calling process.
  fn spawn_link({m: Type}, thunk: () -> Unit) -> Effect(Pid(m)) = raw_spawn_link(thunk)

  ## Start a gen_server callback module. The generic floor preserves OTP's
  ## result tuple; transparent behavior macros provide the typed specialization.
  fn start_link({a: Type}, module: Atom, args: List(a)) -> Effect(Tuple) =
    raw_start_link(%[:local, module], module, args, assert_type [] : List(Atom))

  fn start_statem({a: Type}, module: Atom, args: List(a)) -> Effect(Tuple) =
    raw_statem_start_link(%[:local, module], module, args, assert_type [] : List(Atom))

  fn start_supervisor(module: Atom) -> Effect(Tuple) =
    raw_supervisor_start_link(%[:local, module], module, assert_type [] : List(Atom))

  fn start_supervisor_with({a: Type}, module: Atom, args: List(a)) -> Effect(Tuple) =
    raw_supervisor_start_link(%[:local, module], module, args)

  ## Send a well-typed message: `msg : m` must match `dest`'s accepted type `m`,
  ## so a `Pid(Command)` can never be sent a `Telemetry`. (Named `tell`, not
  ## `send`: `send` is the reserved Melquiades keyword — a later macro can reclaim
  ## the `p ! msg` surface and lower it to this.)
  fn tell({m: Type}, dest: Pid(m), msg: m) -> Effect(Unit) = raw_send(dest, msg)

  ## Synchronous `gen_server` call: send request `q`, block for reply `r`. Both the
  ## request AND the reply are checked against the server's type.
  fn call({q: Type}, {r: Type}, server: GenServer(q, r), request: q) -> Effect(r) =
    raw_call(server, request)

  ## Asynchronous `gen_server` cast — a typed fire-and-forget request (no reply).
  fn cast({q: Type}, {r: Type}, server: GenServer(q, r), request: q) -> Effect(Unit) =
    raw_cast(server, request)

  ## Typed lifecycle and observation wrappers over the raw effect boundary.
  typealias MonitorRef = Ref
  typealias TimerRef = Ref

  fn stop({m: Type}, pid: Pid(m)) -> Effect(Unit) = raw_stop(pid)

  fn send_after({m: Type}, delay: Int, pid: Pid(m), msg: m) -> Effect(Ref) =
    raw_send_after(delay, pid, msg)

  fn cancel_timer(ref: Ref) -> Effect(Unit) = raw_cancel_timer(ref)

  fn monitor({m: Type}, kind: Atom, pid: Pid(m)) -> Effect(Ref) = raw_monitor(kind, pid)

  fn demonitor(ref: Ref) -> Effect(Unit) = raw_demonitor(ref)

  fn link({m: Type}, pid: Pid(m)) -> Effect(Unit) = raw_link(pid)

  fn unlink({m: Type}, pid: Pid(m)) -> Effect(Unit) = raw_unlink(pid)

  fn exit({m: Type}, {r: Type}, pid: Pid(m), reason: r) -> Effect(Unit) = raw_exit(pid, reason)

  fn is_alive({m: Type}, pid: Pid(m)) -> Effect(Bool) = raw_is_alive(pid)

  fn register({m: Type}, name: Atom, pid: Pid(m)) -> Effect(Unit) = raw_register(name, pid)

  fn unregister(name: Atom) -> Effect(Unit) = raw_unregister(name)

  fn whereis({m: Type}, name: Atom) -> Effect(Pid(m)) = raw_whereis(name)
end
