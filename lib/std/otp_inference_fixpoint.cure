@group(:concurrency)
mod Std.Otp.InferenceFixpoint
  ## FIXPOINT metatheory for mailbox-type inference over RECURSIVE behaviours (build-out map
  ## G9 / BRec). The inferred interface of a recursive behaviour is the LEAST FIXED POINT of
  ## its monotone interface transfer `f` (Knaster-Tarski / Kleene). This module proves the
  ## PRINCIPALITY direction — the PRE-FIXPOINT BOUND — for the tag-set interface order:
  ##
  ##   `lfp_le` :  f monotone,  f(a) ⊆ a  ⟹  every Kleene iterate `f^n(⊥) ⊆ a`.
  ##
  ## This is the direction that makes inference PRINCIPAL: the inferred interface is contained
  ## in every self-consistent interface, so it never over-approximates. It needs NO finite-
  ## height stabilization argument — pure induction on the iteration count — so it is proved
  ## here end to end, no holes.
  ##
  ## **Honest scope.** The DUAL half — that some iterate IS a fixed point (`f(lfp) ≈ lfp`),
  ## which BRec *coverage* needs — requires the finite-height STABILIZATION argument (interface
  ## size ≤ |Tag|, strict-increase-or-fixed, up to set-equality). That, and the full `lfp`
  ## construction, stay in `scaffolds/inference_fixpoint.cure` (`?map_lfp`/`?is_least`). See the
  ## ledger `2026-07-17-otp-formalisation-ledger.md` (B2) and shape doc
  ## `2026-07-17-mailbox-inference-fixpoint-shape.md`.
  ##
  ## `f` is an abstract monotone transfer (deriving `f` from a behaviour's syntax is the open
  ## problem ABOVE this shape); everything about the fixpoint is provable with `f` a parameter
  ## carrying a monotonicity hypothesis — mirroring mathlib's `OrderHom`.

  type Tag = TA | TB | TC
  type TagList = TNil | TCons(Tag, TagList)

  ## Membership and the interface SUBTYPING order `AllHandled(s, iface)` = `s ⊆ iface`.
  type Handles indices (t: Tag, iface: TagList)
    HHere  : Handles(t, TCons(t, rest))
    HThere : Handles(t, rest) -> Handles(t, TCons(y, rest))
  type AllHandled indices (s: TagList, iface: TagList)
    AHNil  : AllHandled(TNil, iface)
    AHCons : Handles(t, iface) -> AllHandled(rest, iface) -> AllHandled(TCons(t, rest), iface)

  type Nat = Z | S(Nat)

  ## Constructive KLEENE ITERATION `f^n(x)`.
  fn iterate(f: (TagList) -> TagList, x: TagList, n: Nat) -> TagList = match n
    Z()  -> x
    S(k) -> f(iterate(f, x, k))

  ## Subtyping transitivity, inlined (cross-module reuse of `Std.Otp.InferenceLaws.weaken` is
  ## blocked by E3/task #15): a tag handled by `y`, with `y ⊆ z`, is handled by `z`.
  fn handles_weaken({t: Tag}, {y: TagList}, {z: TagList}, h: Handles(t, y), sub: AllHandled(y, z)) -> Handles(t, z) = match h
    HHere()    -> match sub
      AHCons(ht, srest) -> ht
    HThere(h2) -> match sub
      AHCons(hh, srest) -> handles_weaken(h2, srest)

  fn all_handled_trans({x: TagList}, {y: TagList}, {z: TagList}, xy: AllHandled(x, y), yz: AllHandled(y, z)) -> AllHandled(x, z) = match xy
    AHNil()            -> AHNil()
    AHCons(hx, xrest)  -> AHCons(handles_weaken(hx, yz), all_handled_trans(xrest, yz))

  ## **PRE-FIXPOINT BOUND (principality direction of Knaster-Tarski).** With `f` monotone and
  ## `a` a pre-fixed point (`f(a) ⊆ a`), every Kleene iterate from bottom is `⊆ a`. Induction on
  ## `n`: `⊥ ⊆ a` trivially; the step composes monotonicity (`iterate_k ⊆ a ⟹ f(iterate_k) ⊆
  ## f(a)`) with the pre-fixpoint (`f(a) ⊆ a`) by transitivity.
  fn lfp_le(
      f: (TagList) -> TagList,
      mono: (x: TagList) -> (y: TagList) -> (AllHandled(x, y)) -> AllHandled(f(x), f(y)),
      a: TagList,
      pre: AllHandled(f(a), a),
      n: Nat
    ) -> AllHandled(iterate(f, TNil, n), a) = match n
    Z()  -> AHNil()
    S(k) -> all_handled_trans(mono(iterate(f, TNil, k), a, lfp_le(f, mono, a, pre, k)), pre)
end
