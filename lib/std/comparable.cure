@group(:core)
mod Std.Comparable
  ## `Std.Char` supplies `code_point` (Char -> Int) for the `Char` instance's
  ## code-point ordering; `Std.String` makes `String` the transparent
  ## `List(Char)` synonym the lexicographic `String` comparison folds over.
  use Std.Char
  use Std.String
  ## `use Std.Bool` supplies `` `not` `` for the derived `` `<=` ``/`` `>=` ``;
  ## `use Std.Equatable` provides the `Equatable(t)` superinterface required by
  ## `Comparable(t)`.
  use Std.Bool
  use Std.Equatable
  ## Total-ordering interface on a minimal basis.
  ##
  ## The sole primitive obligation is `` `<` ``; `` `<=` ``, `` `>` ``,
  ## `` `>=` `` and the three-way `compare` (returning an `Ordering`) are derived
  ## `where Comparable(t)` top-level functions, each expressed with `` `<` ``
  ## alone (a total order is trichotomous in `` `<` ``). `Comparable(t)` requires
  ## `Equatable(t)`, so every comparable type is also equatable.
  ##
  ## The derived operations are standalone `where`-constrained functions rather
  ## than interface defaults: an instance-specialised default re-dispatching a
  ## sibling method at a concrete operand cannot be elaborated for every leaf
  ## today, whereas a `where`-constrained function stays polymorphic and is
  ## resolved per call site (the same idiom `Std.Equatable.` `` `!=` `` uses).
  ##
  ## ## Examples
  ##
  ## ```cure
  ## use Std.Comparable
  ##
  ## compare(1, 2)                           # => LessThan
  ## `<`('a', 'b')                           # => true
  ## `<`("ada", "grace")                     # => true
  ## ```

  ## Group tag consumed by `Cure.Stdlib.Preload`.
  ## Three-way ordering result.
  type Ordering = LessThan | EqualTo | GreaterThan

  ## Total ordering over `t`. Requires `Equatable(t)` so every comparable type
  ## is equatable; the ordering itself is generated from `` `<` `` alone.
  interface Comparable(t) requires Equatable(t)
    ## Strict less-than. Sole primitive obligation of the class.
    fn `<`(a: t, b: t) -> Bool

  ## `Comparable` impl for `Int`.
  implementation Comparable for Int
    ## Primitive integer less-than (matches `build_binop`'s `int_lt` lowering).
    fn `<`(a: Int, b: Int) -> Bool = Std.Builtin.int_lt(a, b)

  ## `Comparable` impl for `Float`.
  implementation Comparable for Float
    ## Primitive float less-than (matches `build_binop`'s `float_lt` lowering).
    fn `<`(a: Float, b: Float) -> Bool = Std.Builtin.float_lt(a, b)

  ## `Comparable` impl for `Char`: compare Unicode code points. `code_point` is
  ## the `Char -> Int` coercion (Char erases to its code point), so this is an
  ## `Int` comparison — no method dispatch, works on both pipelines.
  implementation Comparable for Char
    ## Character less-than on code points.
    fn `<`(a: Char, b: Char) -> Bool = Std.Builtin.int_lt(code_point(a), code_point(b))

  ## Lexicographic strict less-than over `String = List(Char)`: compare heads by
  ## code point, and on a tie recurse into the tails. A prefix sorts before its
  ## extension (`"ad" < "ada"`). Written as a plain top-level recursion (not a
  ## self-recursive interface method) so the impl body carries no nested method
  ## dispatch.
  fn string_lt(a: String, b: String) -> Bool =
    match a
      [] ->
        match b
          []      -> False()
          [_ | _] -> True()
      [ha | ta] ->
        match b
          []        -> False()
          [hb | tb] ->
            pickup
              Std.Builtin.int_lt(code_point(ha), code_point(hb)) -> True()
              Std.Builtin.int_lt(code_point(hb), code_point(ha)) -> False()
              else                                               -> string_lt(ta, tb)

  ## `Comparable` impl for `String`. Delegates to lexicographic `string_lt`.
  implementation Comparable for String
    ## String less-than, character by character.
    fn `<`(a: String, b: String) -> Bool = string_lt(a, b)

  ## `` `<=` `` derived: `a <= b` iff `not (b < a)`.
  fn `<=`(a: t, b: t) -> Bool where Comparable(t) = Std.Bool.`not`(`<`(b, a))

  ## `` `>` `` derived by flipping the operands: `a > b` iff `b < a`.
  fn `>`(a: t, b: t) -> Bool where Comparable(t) = `<`(b, a)

  ## `` `>=` `` derived: `a >= b` iff `not (a < b)`.
  fn `>=`(a: t, b: t) -> Bool where Comparable(t) = Std.Bool.`not`(`<`(a, b))

  ## Derived tripartite `compare`, generated from `` `<` `` alone (trichotomy of
  ## a total order). Kept present and named `compare` so `compare_op_call` and
  ## `min`/`max`/`clamp` (which dispatch to `compare`) keep working.
  fn compare(a: t, b: t) -> Ordering where Comparable(t) =
    pickup
      `<`(a, b) -> LessThan
      `<`(b, a) -> GreaterThan
      else      -> EqualTo
