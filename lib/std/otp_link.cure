@group(:concurrency)
mod Std.Otp.Link
  ## TYPED LINKS and the `trap_exit` dispatch (build-out map G3, the bidirectional
  ## companion to `Std.Otp.Monitor`).
  ##
  ## In OTP, `link(pid)` creates a BIDIRECTIONAL link: when a linked process dies, the
  ## peer is sent an exit signal. What happens next depends on the peer's `trap_exit`
  ## flag — the gate no published type system models:
  ##   * **trapping**: the exit becomes an `{'EXIT', from, reason}` MESSAGE in the peer's
  ##     mailbox — so the peer's message type must accept `EXIT`;
  ##   * **not trapping**: the peer itself EXITS (propagation) — it is not a message at
  ##     all, the process terminates.
  ##
  ## The novel content over monitors (`Std.Otp.Monitor`, which is unidirectional and
  ## always a message) is exactly this trap-flag DISPATCH: the same event (`SExitTrap`
  ## vs `SExitProp`) has a message outcome or a death outcome depending on the flag, and
  ## **preservation holds for BOTH** — a trapping process gets a well-typed `EXIT`, a
  ## non-trapping process reaches the (vacuously well-typed) `Dead` state. No ill-typed
  ## state arises either way.
  ##
  ## The typing rule for a trapping link mirrors the monitor rule: `LinkTrap :
  ## Accepted(TExit) -> Link(Trapping)` — a trapping linked process must be able to
  ## receive `EXIT`, and `trap_accepts` reads that evidence back out.
  ##
  ## **Honest scope.** Single link, `EXIT` as a bare tag (from/reason payload
  ## abstracted), `Dead` as a terminal state (death propagation is not itself further
  ## reduced — a full liveness account of cascading exits is the next step). Composes
  ## with `Std.Otp.Safety`/`Std.Otp.Monitor` as another typed signal discipline.

  ## Message vocabulary including the EXIT signal a trapping linked process receives.
  type Tag = TInc | TQuery | TExit
  type TagList = TNil | TCons(Tag, TagList)

  type Accepted indices (t: Tag)
    AccInc   : Accepted(TInc)
    AccQuery : Accepted(TQuery)
    AccExit  : Accepted(TExit)

  type AllAccepted indices (ts: TagList)
    AANil  : AllAccepted(TNil)
    AACons : Accepted(t) -> AllAccepted(rest) -> AllAccepted(TCons(t, rest))

  ## Whether a process traps exits — the gate distinguishing a delivered EXIT *message*
  ## from death *propagation*.
  type Trap = Trapping | NotTrapping

  ## A process: alive (ether, mailbox, trap flag) or dead (propagated exit).
  type Proc = Alive(TagList, TagList, Trap) | Dead

  ## WELL-TYPED process: alive with all-accepted ether+mailbox, or dead (vacuously ok).
  type WTP indices (p: Proc)
    WTAlive : AllAccepted(e) -> AllAccepted(m) -> WTP(Alive(e, m, tr))
    WTDead  : WTP(Dead)

  ## A LINK to a peer, indexed by this process's trap flag. A TRAPPING link carries the
  ## proof that the process accepts `EXIT` (the typing rule); a non-trapping link does
  ## not — its peer's death will terminate this process instead.
  type Link indices (tr: Trap)
    LinkTrap   : Accepted(TExit) -> Link(Trapping)
    LinkNoTrap : Link(NotTrapping)

  ## The reduction on a linked peer's death, dispatched by the trap flag:
  ##   SExitTrap — trapping: `EXIT` is delivered as a message into the ether;
  ##   SExitProp — not trapping: the process itself exits (propagation) → `Dead`.
  type Step indices (before: Proc, after: Proc)
    SExitTrap : Accepted(TExit) -> Step(Alive(e, m, Trapping), Alive(TCons(TExit, e), m, Trapping))
    SExitProp : Step(Alive(e, m, NotTrapping), Dead)

  ## **PRESERVATION.** Either outcome of a peer's death keeps the process well-typed:
  ## trapping delivers a well-typed `EXIT` (from the accepted proof), not trapping dies
  ## (`Dead` is well-typed vacuously). The trap flag decides message-vs-death, and
  ## neither branch reaches an ill-typed state.
  fn preservation({b: Proc}, {a: Proc}, wt: WTP(b), s: Step(b, a)) -> WTP(a) = match s
    SExitTrap(accexit) -> match wt
      WTAlive(ae, am) -> WTAlive(AACons(accexit, ae), am)
    SExitProp() -> WTDead

  ## Holding a trapping link PROVES the process accepts `EXIT` (reads the evidence out).
  fn trap_accepts(l: Link(Trapping)) -> Accepted(TExit) = match l
    LinkTrap(a) -> a

  ## Non-vacuity: both a trapping and a non-trapping link can be established.
  fn establish_trap() -> Link(Trapping) = LinkTrap(AccExit)
  fn establish_notrap() -> Link(NotTrapping) = LinkNoTrap
end
