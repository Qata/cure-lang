mod Compiler.Kernel.Tests.Core.ExprTest
  use Std.Test
  use Compiler.Kernel.Core.Name
  use Compiler.Kernel.Core.Level
  use Compiler.Kernel.Core.Expr
  
  fn test_expr_universe_mvar() -> Atom =
    assert(expr_has_univ_mvar(Sort(mk_univ_mvar(mk_simple("u")))))
  
  fn test_kvmap_insert_find() -> Atom =
    match kvmap_find(kvmap_insert(kvmap_empty(), mk_simple("tag"), DataBool(true)), mk_simple("tag"))
      Some(DataBool(true)) -> :ok
      _ -> assert(false)
