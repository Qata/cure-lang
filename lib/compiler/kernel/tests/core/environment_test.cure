mod Compiler.Kernel.Tests.Core.EnvironmentTest
  use Std.Test
  use Compiler.Kernel.Core.Name
  use Compiler.Kernel.Core.Level
  use Compiler.Kernel.Core.Expr
  use Compiler.Kernel.Core.Declaration
  use Compiler.Kernel.Core.Environment
  use Compiler.Kernel.Core.LocalContext
  use Compiler.Kernel.Core.TypeChecker
  
  fn test_quot_adds_all_constants() -> Atom =
    match environment_add(empty_environment(), QuotDecl(), false)
      Ok(env) ->
        assert(
          Std.List.length(environment_for_each_constant(env)) == 4
        )
      Error(_) -> assert(false)
  
  fn test_duplicate_rejected() -> Atom =
    let name = mk_simple("A")
    let decl = AxiomDecl(AxiomVal(ConstantVal(name, [], Sort(LevelZero())), false))
    match environment_add(empty_environment(), decl, false)
      Ok(env) ->
        match environment_add(env, decl, false)
          Error(_) -> :ok
          Ok(_) -> assert(false)
      Error(_) -> assert(false)
  
  fn test_mutual_inductive_rec_flag_is_shared() -> Atom =
    let a = mk_simple("A")
    let b = mk_simple("B")
    let ctor_a = str(a, "mk")
    let ctor_b = str(b, "mk")
    let a_ctor_type = Pi(mk_simple("x"), BinderDefault(), Const(b, []), Const(a, []))
    let b_ctor_type = Const(b, [])
    let decl = InductiveDecl([], 0, [InductiveType(a, Sort(LevelZero()), [Constructor(ctor_a, a_ctor_type)]), InductiveType(b, Sort(LevelZero()), [Constructor(ctor_b, b_ctor_type)])], false)
    match environment_add(empty_environment(), decl, false)
      Ok(env) ->
        match environment_find(env, b)
          Some(InductiveInfo(InductiveVal(_, _, _, _, _, _, is_rec, _, _))) -> assert(is_rec)
          _ -> assert(false)
      Error(_) -> assert(false)
  
  fn test_checked_inductive_rejects_wrong_constructor_return() -> Atom =
    let a = mk_simple("A")
    let b = mk_simple("B")
    let ctor_a = str(a, "mk")
    let decl = InductiveDecl([], 0, [InductiveType(a, Sort(LevelZero()), [Constructor(ctor_a, Const(b, []))]), InductiveType(b, Sort(LevelZero()), [])], false)
    match environment_add(empty_environment(), decl, true)
      Error(_) -> :ok
      Ok(_) -> assert(false)
  
  fn test_checked_inductive_rejects_negative_occurrence() -> Atom =
    let bad = mk_simple("Bad")
    let ctor = str(bad, "mk")
    let negative_domain = Pi(mk_simple("x"), BinderDefault(), Const(bad, []), Const(bad, []))
    let ctor_type = Pi(mk_simple("f"), BinderDefault(), negative_domain, Const(bad, []))
    let decl = InductiveDecl([], 0, [InductiveType(bad, Sort(LevelZero()), [Constructor(ctor, ctor_type)])], false)
    match environment_add(empty_environment(), decl, true)
      Error(_) -> :ok
      Ok(_) -> assert(false)
  
  fn test_checked_inductive_rejects_missing_declared_parameter() -> Atom =
    let family = mk_simple("Family")
    let ctor = str(family, "mk")
    let decl = InductiveDecl([], 1, [InductiveType(family, Sort(LevelZero()), [Constructor(ctor, Const(family, []))])], false)
    match environment_add(empty_environment(), decl, true)
      Error(_) -> :ok
      Ok(_) -> assert(false)
  
  fn test_checked_mutual_inductives_reject_universe_mismatch() -> Atom =
    let a = mk_simple("UniverseA")
    let b = mk_simple("UniverseB")
    let ctor_a = str(a, "mk")
    let ctor_b = str(b, "mk")
    let decl = InductiveDecl([], 0, [InductiveType(a, Sort(LevelZero()), [Constructor(ctor_a, Const(a, []))]), InductiveType(b, Sort(LevelSucc(LevelZero())), [Constructor(ctor_b, Const(b, []))])], false)
    match environment_add(empty_environment(), decl, true)
      Error(_) -> :ok
      Ok(_) -> assert(false)
  
  fn test_prop_singleton_inductive_marks_k_recursor() -> Atom =
    let proof_name = mk_simple("Proof")
    let ctor = str(proof_name, "intro")
    let decl = InductiveDecl([], 0, [InductiveType(proof_name, Sort(LevelZero()), [Constructor(ctor, Const(proof_name, []))])], false)
    match environment_add(empty_environment(), decl, false)
      Ok(env) ->
        match environment_find(env, name_append_core(proof_name, mk_simple("rec")))
          Some(RecursorInfo(RecursorVal(_, _, _, _, _, _, _, k, _))) -> assert(k)
          _ -> assert(false)
      Error(_) -> assert(false)
  
  fn test_simple_recursor_iota_reduces_to_matching_minor() -> Atom =
    let bool_name = mk_simple("Boolish")
    let false_name = str(bool_name, "false")
    let true_name = str(bool_name, "true")
    let rec_name = name_append_core(bool_name, mk_simple("rec"))
    let decl = InductiveDecl([], 0, [InductiveType(bool_name, Sort(LevelZero()), [Constructor(false_name, Const(bool_name, [])), Constructor(true_name, Const(bool_name, []))])], false)
    match environment_add(empty_environment(), decl, false)
      Ok(env) ->
        let motive = Sort(LevelZero())
        let false_branch = Sort(LevelZero())
        let true_branch = Sort(LevelSucc(LevelZero()))
        let rec_app = App(App(App(App(Const(rec_name, []), motive), false_branch), true_branch), Const(true_name, []))
        match whnf(mk_type_checker(env, empty_local_context(), DefinitionSafe()), rec_app)
          Ok(result) -> assert(expr_eq(result, true_branch))
          Error(_) -> assert(false)
      Error(_) -> assert(false)
  
  fn test_simple_recursor_type_matches_lean_shape() -> Atom =
    let bool_name = mk_simple("BoolishTy")
    let false_name = str(bool_name, "false")
    let true_name = str(bool_name, "true")
    let rec_name = name_append_core(bool_name, mk_simple("rec"))
    let decl = InductiveDecl([], 0, [InductiveType(bool_name, Sort(LevelZero()), [Constructor(false_name, Const(bool_name, [])), Constructor(true_name, Const(bool_name, []))])], false)
    match environment_add(empty_environment(), decl, false)
      Ok(env) ->
        match environment_find(env, rec_name)
          Some(RecursorInfo(RecursorVal(ConstantVal(_, level_params, type_expr), _, _, _, _, _, _, _, _))) ->
            assert(level_params == [])
            match type_expr
              Pi(_, _, motive_type, Pi(_, _, false_minor_type, Pi(_, _, true_minor_type, Pi(_, _, major_type, body)))) ->
                assert(expr_eq(motive_type, Pi(mk_simple("_motive_arg"), BinderDefault(), Const(bool_name, []), Sort(LevelZero()))))
                assert(expr_eq(false_minor_type, App(BVar(0), Const(false_name, []))))
                assert(expr_eq(true_minor_type, App(BVar(1), Const(true_name, []))))
                assert(expr_eq(major_type, Const(bool_name, [])))
                assert(expr_eq(body, App(BVar(3), BVar(0))))
              _ -> assert(false)
          _ -> assert(false)
      Error(_) -> assert(false)
  
  fn test_simple_recursor_type_checks() -> Atom =
    let bool_name = mk_simple("BoolishTypeChecks")
    let false_name = str(bool_name, "false")
    let true_name = str(bool_name, "true")
    let rec_name = name_append_core(bool_name, mk_simple("rec"))
    let decl = InductiveDecl([], 0, [InductiveType(bool_name, Sort(LevelZero()), [Constructor(false_name, Const(bool_name, [])), Constructor(true_name, Const(bool_name, []))])], false)
    match environment_add(empty_environment(), decl, false)
      Ok(env) ->
        match environment_find(env, rec_name)
          Some(RecursorInfo(RecursorVal(ConstantVal(_, level_params, type_expr), _, _, _, _, _, _, _, _))) ->
            match check(mk_type_checker(env, empty_local_context(), DefinitionSafe()), type_expr, level_params)
              Ok(_) -> :ok
              Error(_) -> assert(false)
          _ -> assert(false)
      Error(_) -> assert(false)
  
  fn test_parameterized_recursor_type_matches_lean_shape() -> Atom =
    let phantom_name = mk_simple("PhantomTy")
    let ctor_name = str(phantom_name, "mk")
    let rec_name = name_append_core(phantom_name, mk_simple("rec"))
    let type_expr = Pi(mk_simple("A"), BinderDefault(), Sort(LevelSucc(LevelZero())), Sort(LevelSucc(LevelZero())))
    let ctor_type = Pi(mk_simple("A"), BinderDefault(), Sort(LevelSucc(LevelZero())), App(Const(phantom_name, []), BVar(0)))
    let decl = InductiveDecl([], 1, [InductiveType(phantom_name, type_expr, [Constructor(ctor_name, ctor_type)])], false)
    match environment_add(empty_environment(), decl, false)
      Ok(env) ->
        match environment_find(env, rec_name)
          Some(RecursorInfo(RecursorVal(ConstantVal(_, level_params, rec_type), _, _, _, _, _, _, _, _))) ->
            assert(level_params == [mk_simple("u")])
            match rec_type
              Pi(_, _, param_type, Pi(_, _, motive_type, Pi(_, _, minor_type, Pi(_, _, major_type, body)))) ->
                assert(expr_eq(param_type, Sort(LevelSucc(LevelZero()))))
                assert(expr_eq(motive_type, Pi(mk_simple("_motive_arg"), BinderDefault(), App(Const(phantom_name, []), BVar(0)), Sort(LevelParam(mk_simple("u"))))))
                assert(expr_eq(minor_type, App(BVar(0), App(Const(ctor_name, []), BVar(1)))))
                assert(expr_eq(major_type, App(Const(phantom_name, []), BVar(2))))
                assert(expr_eq(body, App(BVar(2), BVar(0))))
              _ -> assert(false)
          _ -> assert(false)
      Error(_) -> assert(false)
  
