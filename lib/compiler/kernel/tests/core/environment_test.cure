  fn test_parameterized_recursor_iota_reduces_after_parameter() -> Atom =
    let phantom_name = mk_simple("PhantomReduce")
    let ctor_name = str(phantom_name, "mk")
    let rec_name = name_append_core(phantom_name, mk_simple("rec"))
    let type_expr = Pi(mk_simple("A"), BinderDefault(), Sort(LevelSucc(LevelZero())), Sort(LevelSucc(LevelZero())))
    let ctor_type = Pi(mk_simple("A"), BinderDefault(), Sort(LevelSucc(LevelZero())), App(Const(phantom_name, []), BVar(0)))
    let decl = InductiveDecl([], 1, [InductiveType(phantom_name, type_expr, [Constructor(ctor_name, ctor_type)])], false)
    match environment_add(empty_environment(), decl, false)
      Ok(env) ->
        let param = Sort(LevelZero())
        let motive = Sort(LevelZero())
        let branch = Sort(LevelSucc(LevelZero()))
        let major = App(Const(ctor_name, []), param)
        let rec_app = App(App(App(App(Const(rec_name, [LevelZero()]), param), motive), branch), major)
        match whnf(mk_type_checker(env, empty_local_context(), DefinitionSafe()), rec_app)
          Ok(result) -> assert(expr_eq(result, branch))
          Error(_) -> assert(false)
      Error(_) -> assert(false)
  
  fn test_parameterized_field_recursor_type_checks() -> Atom =
    let box_name = mk_simple("ParamBoxTypeChecks")
    let ctor_name = str(box_name, "mk")
    let rec_name = name_append_core(box_name, mk_simple("rec"))
    let param_sort = Sort(LevelSucc(LevelZero()))
    let type_expr = Pi(mk_simple("A"), BinderDefault(), param_sort, param_sort)
    let ctor_type = Pi(mk_simple("A"), BinderDefault(), param_sort, Pi(mk_simple("value"), BinderDefault(), BVar(0), App(Const(box_name, []), BVar(1))))
    let decl = InductiveDecl([], 1, [InductiveType(box_name, type_expr, [Constructor(ctor_name, ctor_type)])], false)
    match environment_add(empty_environment(), decl, false)
      Ok(env) ->
        match environment_find(env, rec_name)
          Some(RecursorInfo(RecursorVal(ConstantVal(_, level_params, rec_type), _, _, _, _, _, _, _, _))) ->
            match rec_type
              Pi(_, _, _, Pi(_, _, _, Pi(_, _, minor_type, Pi(_, _, _, _)))) ->
                match minor_type
                  Pi(_, _, field_type, result_type) ->
                    assert(expr_eq(field_type, BVar(1)))
                    assert(expr_eq(result_type, App(BVar(1), App(App(Const(ctor_name, []), BVar(2)), BVar(0)))))
                  _ -> assert(false)
              _ -> assert(false)
            match check(mk_type_checker(env, empty_local_context(), DefinitionSafe()), rec_type, level_params)
              Ok(_) -> :ok
              Error(_) -> assert(false)
          _ -> assert(false)
      Error(_) -> assert(false)
  
  fn test_parameterized_field_recursor_iota_passes_field() -> Atom =
    let witness = mk_simple("boxWitness")
    let box_name = mk_simple("ParamBoxReduce")
    let ctor_name = str(box_name, "mk")
    let rec_name = name_append_core(box_name, mk_simple("rec"))
    let param_sort = Sort(LevelSucc(LevelZero()))
    let type_expr = Pi(mk_simple("A"), BinderDefault(), param_sort, param_sort)
    let ctor_type = Pi(mk_simple("A"), BinderDefault(), param_sort, Pi(mk_simple("value"), BinderDefault(), BVar(0), App(Const(box_name, []), BVar(1))))
    let axiom = AxiomDecl(AxiomVal(ConstantVal(witness, [], Sort(LevelZero())), false))
    let decl = InductiveDecl([], 1, [InductiveType(box_name, type_expr, [Constructor(ctor_name, ctor_type)])], false)
    match environment_add(empty_environment(), axiom, false)
      Ok(env_with_witness) ->
        match environment_add(env_with_witness, decl, false)
          Ok(env) ->
            let param = Sort(LevelZero())
            let motive = Sort(LevelZero())
            let minor = Lambda(mk_simple("value"), BinderDefault(), param, BVar(0))
            let field = Const(witness, [])
            let major = App(App(Const(ctor_name, []), param), field)
            let rec_app = App(App(App(App(Const(rec_name, [LevelZero()]), param), motive), minor), major)
            match whnf(mk_type_checker(env, empty_local_context(), DefinitionSafe()), rec_app)
              Ok(result) -> assert(expr_eq(result, field))
              Error(_) -> assert(false)
          Error(_) -> assert(false)
      Error(_) -> assert(false)
  
  fn test_simple_recursor_iota_passes_constructor_fields() -> Atom =
    let box_name = mk_simple("Boxish")
    let ctor_name = str(box_name, "mk")
    let rec_name = name_append_core(box_name, mk_simple("rec"))
    let field_type = Sort(LevelZero())
    let ctor_type = Pi(mk_simple("value"), BinderDefault(), field_type, Const(box_name, []))
    let decl = InductiveDecl([], 0, [InductiveType(box_name, Sort(LevelZero()), [Constructor(ctor_name, ctor_type)])], false)
    match environment_add(empty_environment(), decl, false)
      Ok(env) ->
        let motive = Sort(LevelZero())
        let minor = Lambda(mk_simple("value"), BinderDefault(), field_type, BVar(0))
        let field = Sort(LevelSucc(LevelZero()))
        let major = App(Const(ctor_name, []), field)
        let rec_app = App(App(App(Const(rec_name, [LevelZero()]), motive), minor), major)
        match whnf(mk_type_checker(env, empty_local_context(), DefinitionSafe()), rec_app)
          Ok(result) -> assert(expr_eq(result, field))
          Error(_) -> assert(false)
      Error(_) -> assert(false)

  fn test_indexed_recursor_type_checks() -> Atom =
    let bool_name = mk_simple("IdxBool")
    let true_name = str(bool_name, "true")
    let family_name = mk_simple("IsTrue")
    let ctor_name = str(family_name, "intro")
    let rec_name = name_append_core(family_name, mk_simple("rec"))
    let env0 = empty_environment()
    let bool_decl = AxiomDecl(AxiomVal(ConstantVal(bool_name, [], Sort(LevelSucc(LevelZero()))), false))
    let true_decl = AxiomDecl(AxiomVal(ConstantVal(true_name, [], Const(bool_name, [])), false))
    let family_type = Pi(mk_simple("b"), BinderDefault(), Const(bool_name, []), Sort(LevelZero()))
    let ctor_type = App(Const(family_name, []), Const(true_name, []))
    let family_decl = InductiveDecl([], 0, [InductiveType(family_name, family_type, [Constructor(ctor_name, ctor_type)])], false)
    match environment_add(env0, bool_decl, false)
      Ok(env1) ->
        match environment_add(env1, true_decl, false)
          Ok(env2) ->
            match environment_add(env2, family_decl, false)
              Ok(env3) ->
                match environment_find(env3, rec_name)
                  Some(RecursorInfo(RecursorVal(ConstantVal(_, level_params, type_expr), _, _, num_indices, _, _, _, _, _))) ->
                    assert(num_indices == 1)
                    match check(mk_type_checker(env3, empty_local_context(), DefinitionSafe()), type_expr, level_params)
                      Ok(_) -> :ok
                      Error(_) -> assert(false)
                  _ -> assert(false)
              Error(_) -> assert(false)
          Error(_) -> assert(false)
      Error(_) -> assert(false)

  fn test_indexed_recursor_iota_reduces() -> Atom =
    let bool_name = mk_simple("IdxBoolIota")
    let true_name = str(bool_name, "true")
    let family_name = mk_simple("IsTrueIota")
    let ctor_name = str(family_name, "intro")
    let rec_name = name_append_core(family_name, mk_simple("rec"))
    let bool_decl = AxiomDecl(AxiomVal(ConstantVal(bool_name, [], Sort(LevelSucc(LevelZero()))), false))
    let true_decl = AxiomDecl(AxiomVal(ConstantVal(true_name, [], Const(bool_name, [])), false))
    let family_type = Pi(mk_simple("b"), BinderDefault(), Const(bool_name, []), Sort(LevelZero()))
    let ctor_type = App(Const(family_name, []), Const(true_name, []))
    let family_decl = InductiveDecl([], 0, [InductiveType(family_name, family_type, [Constructor(ctor_name, ctor_type)])], false)
    match environment_add(empty_environment(), bool_decl, false)
      Ok(env1) ->
        match environment_add(env1, true_decl, false)
          Ok(env2) ->
            match environment_add(env2, family_decl, false)
              Ok(env3) ->
                let motive = Lambda(mk_simple("b"), BinderDefault(), Const(bool_name, []), Lambda(mk_simple("h"), BinderDefault(), App(Const(family_name, []), BVar(0)), Sort(LevelZero())))
                let branch = Sort(LevelSucc(LevelZero()))
                let major = Const(ctor_name, [])
                let rec_app = App(App(App(App(Const(rec_name, [LevelZero()]), motive), branch), Const(true_name, [])), major)
                match whnf(mk_type_checker(env3, empty_local_context(), DefinitionSafe()), rec_app)
                  Ok(result) -> assert(expr_eq(result, branch))
                  Error(_) -> assert(false)
              Error(_) -> assert(false)
          Error(_) -> assert(false)
      Error(_) -> assert(false)
  
  fn test_recursive_recursor_iota_passes_induction_hypothesis() -> Atom =
    let nat_name = mk_simple("Natish")
    let zero_name = str(nat_name, "zero")
    let succ_name = str(nat_name, "succ")
    let rec_name = name_append_core(nat_name, mk_simple("rec"))
    let succ_type = Pi(mk_simple("n"), BinderDefault(), Const(nat_name, []), Const(nat_name, []))
    let decl = InductiveDecl([], 0, [InductiveType(nat_name, Sort(LevelZero()), [Constructor(zero_name, Const(nat_name, [])), Constructor(succ_name, succ_type)])], false)
    match environment_add(empty_environment(), decl, false)
      Ok(env) ->
        let motive = Sort(LevelZero())
        let zero_branch = Sort(LevelSucc(LevelZero()))
        let succ_branch = Lambda(mk_simple("n"), BinderDefault(), Const(nat_name, []), Lambda(mk_simple("ih"), BinderDefault(), Sort(LevelZero()), BVar(0)))
        let major = App(Const(succ_name, []), Const(zero_name, []))
        let rec_app = App(App(App(App(Const(rec_name, []), motive), zero_branch), succ_branch), major)
        match whnf(mk_type_checker(env, empty_local_context(), DefinitionSafe()), rec_app)
          Ok(result) -> assert(expr_eq(result, zero_branch))
          Error(_) -> assert(false)
      Error(_) -> assert(false)
  
  fn test_recursive_recursor_type_has_induction_hypothesis_minor() -> Atom =
    let nat_name = mk_simple("NatishTy")
    let zero_name = str(nat_name, "zero")
    let succ_name = str(nat_name, "succ")
    let rec_name = name_append_core(nat_name, mk_simple("rec"))
    let succ_type = Pi(mk_simple("n"), BinderDefault(), Const(nat_name, []), Const(nat_name, []))
    let decl = InductiveDecl([], 0, [InductiveType(nat_name, Sort(LevelZero()), [Constructor(zero_name, Const(nat_name, [])), Constructor(succ_name, succ_type)])], false)
    match environment_add(empty_environment(), decl, false)
      Ok(env) ->
        match environment_find(env, rec_name)
          Some(RecursorInfo(RecursorVal(ConstantVal(_, _, type_expr), _, _, _, _, _, _, _, _))) ->
            match type_expr
              Pi(_, _, _, Pi(_, _, _, Pi(_, _, succ_minor_type, Pi(_, _, _, _)))) ->
                match succ_minor_type
                  Pi(_, _, field_type, Pi(_, _, ih_type, result_type)) ->
                    assert(expr_eq(field_type, Const(nat_name, [])))
                    assert(expr_eq(ih_type, App(BVar(2), BVar(0))))
                    assert(expr_eq(result_type, App(BVar(3), App(Const(succ_name, []), BVar(1)))))
                  _ -> assert(false)
              _ -> assert(false)
          _ -> assert(false)
      Error(_) -> assert(false)
  
  fn test_recursive_recursor_type_checks() -> Atom =
    let nat_name = mk_simple("NatishTypeChecks")
    let zero_name = str(nat_name, "zero")
    let succ_name = str(nat_name, "succ")
    let rec_name = name_append_core(nat_name, mk_simple("rec"))
    let succ_type = Pi(mk_simple("n"), BinderDefault(), Const(nat_name, []), Const(nat_name, []))
    let decl = InductiveDecl([], 0, [InductiveType(nat_name, Sort(LevelZero()), [Constructor(zero_name, Const(nat_name, [])), Constructor(succ_name, succ_type)])], false)
    match environment_add(empty_environment(), decl, false)
      Ok(env) ->
        match environment_find(env, rec_name)
          Some(RecursorInfo(RecursorVal(ConstantVal(_, level_params, type_expr), _, _, _, _, _, _, _, _))) ->
            match check(mk_type_checker(env, empty_local_context(), DefinitionSafe()), type_expr, level_params)
              Ok(_) -> :ok
