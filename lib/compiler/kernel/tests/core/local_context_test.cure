mod Compiler.Kernel.Tests.Core.LocalContextTest
  use Std.Test
  use Compiler.Kernel.Core.Name
  use Compiler.Kernel.Core.Level
  use Compiler.Kernel.Core.Expr
  use Compiler.Kernel.Core.LocalContext
  
  fn test_local_decl_ref_and_type() -> Atom =
    let ctx = empty_local_context()
    let x = mk_simple("x")
    let decl = mk_local_const_decl(ctx, x, x, Sort(LevelZero()), BinderDefault())
    let ctx2 = LocalContext([decl])
    assert(expr_eq(local_context_get_type(ctx2, FVar(x)), Sort(LevelZero())))
