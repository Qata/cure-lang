mod Compiler.Kernel.Core.Environment
  use Compiler.Kernel.Core.Name
  use Compiler.Kernel.Core.Level
  use Compiler.Kernel.Core.Expr
  use Compiler.Kernel.Core.Declaration
  use Compiler.Kernel.Core.Exception
  use Compiler.Kernel.Core.LocalContext

  type Diagnostics
    = Diagnostics(Bool, List(DiagnosticUnfold))

  type DiagnosticUnfold
    = DiagnosticUnfold(Name, Int)

  type Environment
    = Environment(List(ConstantInfo), Bool, Diagnostics)

  @extern(:erlang, :error, 1)
  local fn raise_environment_error(reason: Atom) -> ConstantInfo

  fn empty_environment() -> Environment
    = Environment([], false, Diagnostics(false, []))

  fn environment_get_diagnostics(env: Environment) -> Diagnostics
    = match env
        Environment(_, _, diagnostics) -> diagnostics

  fn environment_set_diagnostics(env: Environment, diagnostics: Diagnostics) -> Environment
    = match env
        Environment(constants, quot_init, _) -> Environment(constants, quot_init, diagnostics)

  fn environment_is_quot_initialized(env: Environment) -> Bool
    = match env
        Environment(_, quot_init, _) -> quot_init

  fn environment_find(env: Environment, name: Name) -> Option(ConstantInfo)
    = match env
        Environment(constants, _, _) -> environment_find_in(constants, name)

  fn environment_get(env: Environment, name: Name) -> ConstantInfo
    = match environment_find(env, name)
        Some(info) -> info
        None() -> raise_environment_error(:unknown_constant)

  fn environment_add(env: Environment, decl: Declaration, check: Bool) -> Result(Environment, KernelException)
    = match first_declared_name(env, declaration_names(decl))
        Some(name) -> Error(AlreadyDeclared(env, name))
        None() ->
          pickup
            check -> environment_add_checked(env, decl)
            else -> Ok(environment_add_unchecked(env, decl, check))

  fn environment_for_each_constant(env: Environment) -> List(ConstantInfo)
    = match env
        Environment(constants, _, _) -> constants

  fn environment_is_structure_like(env: Environment, name: Name) -> Bool
    = match environment_find(env, name)
        Some(InductiveInfo(InductiveVal(_, _, num_indices, _, ctors, _, is_rec, _, _))) ->
          pickup
            is_rec -> false
            num_indices == 0 -> Std.List.length(ctors) == 1
            else -> false
        _ -> false

  local fn environment_find_in(constants: List(ConstantInfo), name: Name) -> Option(ConstantInfo)
    = match constants
        [] -> None()
        [info | rest] ->
          pickup
            name_eq(constant_info_name(info), name) -> Some(info)
            else -> environment_find_in(rest, name)

  local fn first_declared_name(env: Environment, names: List(Name)) -> Option(Name)
    = match names
        [] -> None()
        [name | rest] ->
          match environment_find(env, name)
            Some(_) -> Some(name)
            None() -> first_declared_name(env, rest)

  local fn environment_add_unchecked(env: Environment, decl: Declaration, check: Bool) -> Environment
    = match env
        Environment(constants, quot_init, diagnostics) ->
          match decl
            QuotDecl() -> Environment(Std.List.append(declaration_constant_infos(decl), constants), true, diagnostics)
            _ -> Environment(Std.List.append(declaration_constant_infos(decl), constants), quot_init, diagnostics)

  local fn declaration_constant_infos(decl: Declaration) -> List(ConstantInfo)
    = match decl
        MutualDefinitionDecl(defs) -> definition_infos(defs)
        InductiveDecl(level_params, num_params, types, is_unsafe) ->
          let all_names = inductive_type_names(types)
          let is_rec = inductive_block_is_recursive(all_names, types)
          let is_reflexive = inductive_block_is_reflexive(all_names, types)
          let k = inductive_block_is_k_target(num_params, types)
          let elim_level = inductive_elim_level(level_params, num_params, types)
          inductive_infos(level_params, elim_level, num_params, types, types, all_names, constructor_count_for_all(types), 0, 0, is_rec, is_reflexive, k, is_unsafe)
        QuotDecl() -> quot_infos()
        _ -> [declaration_to_constant_info(decl)]

  local fn definition_infos(defs: List(DefinitionVal)) -> List(ConstantInfo)
    = match defs
        [] -> []
        [definition | rest] -> [DefinitionInfo(definition) | definition_infos(rest)]

  local fn inductive_infos(level_params: List(Name), elim_level: Level, num_params: Int, all_types: List(InductiveType), types: List(InductiveType), all_names: List(Name), num_minors: Int, minor_offset: Int, type_index: Int, is_rec: Bool, is_reflexive: Bool, k: Bool, is_unsafe: Bool) -> List(ConstantInfo)
    = match types
        [] -> []
        [InductiveType(name, type_expr, ctors) | rest] ->
          let num_indices = inductive_num_indices(type_expr, num_params)
          let info = InductiveInfo(InductiveVal(ConstantVal(name, level_params, type_expr), num_params, num_indices, all_names, constructor_names(ctors), 0, is_rec, is_unsafe, is_reflexive))
          let ctor_infos = constructor_infos(level_params, name, 0, num_params, ctors, is_unsafe)
          let rec_infos = recursor_info(level_params, elim_level, name, type_expr, num_params, num_indices, all_types, all_names, num_minors, minor_offset, type_index, ctors, is_rec, is_reflexive, k, is_unsafe, rest)
          [info | Std.List.append(ctor_infos, rec_infos)]

  local fn constructor_infos(level_params: List(Name), inductive_name: Name, cidx: Int, num_params: Int, ctors: List(Constructor), is_unsafe: Bool) -> List(ConstantInfo)
    = match ctors
        [] -> []
        [Constructor(name, type_expr) | rest] ->
          [ConstructorInfo(ConstructorVal(ConstantVal(name, level_params, type_expr), inductive_name, cidx, num_params, constructor_num_fields(type_expr, num_params), is_unsafe)) | constructor_infos(level_params, inductive_name, cidx + 1, num_params, rest, is_unsafe)]

  local fn recursor_info(level_params: List(Name), elim_level: Level, name: Name, type_expr: Expr, num_params: Int, num_indices: Int, all_types: List(InductiveType), all_names: List(Name), num_minors: Int, minor_offset: Int, type_index: Int, ctors: List(Constructor), is_rec: Bool, is_reflexive: Bool, k: Bool, is_unsafe: Bool, rest: List(InductiveType)) -> List(ConstantInfo)
    = let num_motives = Std.List.length(all_names)
      let rec_level_params = recursor_level_params(level_params, elim_level)
      let rules = recursor_rules_for_simple_inductive(elim_level, num_params, num_indices, num_motives, num_minors, minor_offset, is_rec, all_names, ctors)
      let rec_type = recursor_type_for_simple_inductive(elim_level, name, type_expr, num_params, num_indices, num_motives, num_minors, type_index, all_types, ctors, is_rec)
      [RecursorInfo(RecursorVal(ConstantVal(name_append_core(name, mk_simple("rec")), rec_level_params, rec_type), all_names, num_params, num_indices, num_motives, num_minors, rules, k, is_unsafe)) | inductive_infos(level_params, elim_level, num_params, all_types, rest, all_names, num_minors, minor_offset + Std.List.length(ctors), type_index + 1, is_rec, is_reflexive, k, is_unsafe)]

  local fn recursor_type_for_simple_inductive(elim_level: Level, name: Name, type_expr: Expr, num_params: Int, num_indices: Int, num_motives: Int, num_minors: Int, type_index: Int, all_types: List(InductiveType), ctors: List(Constructor), is_rec: Bool) -> Expr
    = pickup
        num_indices != 0 -> recursor_type_for_indexed_inductive(elim_level, name, type_expr, num_params, num_indices, num_motives, num_minors, ctors, is_rec)
        num_motives != 1 -> recursor_type_for_mutual_inductive(elim_level, name, type_expr, num_params, num_indices, num_motives, num_minors, type_index, all_types, is_rec)
        num_minors != Std.List.length(ctors) -> type_expr
        else ->
          let param_domains = first_pi_domains(type_expr, num_params)
          let motive_type = Pi(mk_simple("_motive_arg"), BinderDefault(), inductive_app_for_bvars(name, 0, num_params), Sort(elim_level))
          let minor_types = recursor_minor_types_for_simple_inductive(name, num_params, num_motives, ctors, is_rec, 0)
          let major_type = inductive_app_for_bvars(name, num_motives + num_minors, num_params)
          let body = App(BVar(num_minors + 1), BVar(0))
          wrap_pi_domains(Std.List.append(param_domains, Std.List.append([motive_type], Std.List.append(minor_types, [major_type]))), body, mk_simple("_rec_arg"))

  local fn recursor_type_for_mutual_inductive(elim_level: Level, name: Name, type_expr: Expr, num_params: Int, num_indices: Int, num_motives: Int, num_minors: Int, type_index: Int, all_types: List(InductiveType), is_rec: Bool) -> Expr
    = pickup
        is_rec -> type_expr
        num_indices != 0 -> type_expr
        num_minors != constructor_count_for_all(all_types) -> type_expr
        else ->
          let param_domains = first_pi_domains(type_expr, num_params)
          let motive_types = mutual_motive_types(elim_level, all_types, num_params)
          let minor_types = mutual_recursor_minor_types(num_params, num_motives, all_types, 0, 0)
          let major_type = inductive_app_for_bvars(name, num_motives + num_minors, num_params)
          let body = App(BVar(num_minors + 1 + num_motives - 1 - type_index), BVar(0))
          wrap_pi_domains(Std.List.append(param_domains, Std.List.append(motive_types, Std.List.append(minor_types, [major_type]))), body, mk_simple("_rec_arg"))

  local fn mutual_motive_types(elim_level: Level, types: List(InductiveType), num_params: Int) -> List(Expr)
    = match types
        [] -> []
        [InductiveType(name, _, _) | rest] ->
          let motive_type = Pi(mk_simple("_motive_arg"), BinderDefault(), inductive_app_for_bvars(name, 0, num_params), Sort(elim_level))
          [motive_type | mutual_motive_types(elim_level, rest, num_params)]

  local fn mutual_recursor_minor_types(num_params: Int, num_motives: Int, types: List(InductiveType), type_index: Int, minor_offset: Int) -> List(Expr)
    = match types
        [] -> []
        [InductiveType(_, _, ctors) | rest] ->
          Std.List.append(mutual_recursor_minor_types_for_ctors(num_params, num_motives, type_index, minor_offset, ctors, 0), mutual_recursor_minor_types(num_params, num_motives, rest, type_index + 1, minor_offset + Std.List.length(ctors)))

  local fn mutual_recursor_minor_types_for_ctors(num_params: Int, num_motives: Int, type_index: Int, minor_offset: Int, ctors: List(Constructor), ctor_index: Int) -> List(Expr)
    = match ctors
        [] -> []
        [Constructor(ctor_name, type_expr) | rest] ->
          let nfields = constructor_num_fields(type_expr, num_params)
          let domains = constructor_field_domains_for_recursor(type_expr, num_params, num_motives + minor_offset + ctor_index)
          let minor_type = mutual_recursor_minor_type(ctor_name, num_params, num_motives, type_index, minor_offset + ctor_index, nfields, domains)
          [minor_type | mutual_recursor_minor_types_for_ctors(num_params, num_motives, type_index, minor_offset, rest, ctor_index + 1)]

  local fn mutual_recursor_minor_type(ctor_name: Name, num_params: Int, num_motives: Int, type_index: Int, minor_index: Int, nfields: Int, domains: List(Expr)) -> Expr
    = let body = mutual_recursor_minor_body(ctor_name, num_params, num_motives, type_index, minor_index, nfields)
      wrap_pi_domains(domains, body, mk_simple("_field"))

  local fn mutual_recursor_minor_body(ctor_name: Name, num_params: Int, num_motives: Int, type_index: Int, minor_index: Int, nfields: Int) -> Expr
    = let motive = BVar(nfields + minor_index + num_motives - 1 - type_index)
      let params = bvar_refs_from(nfields + minor_index + num_motives, num_params)
      let ctor = mk_apps(Const(ctor_name, []), Std.List.append(params, bvar_refs_from(0, nfields)))
      App(motive, ctor)

  local fn recursor_type_for_indexed_inductive(elim_level: Level, name: Name, type_expr: Expr, num_params: Int, num_indices: Int, num_motives: Int, num_minors: Int, ctors: List(Constructor), is_rec: Bool) -> Expr
    = pickup
        is_rec -> type_expr
        num_motives != 1 -> type_expr
        num_minors != Std.List.length(ctors) -> type_expr
        else ->
          let param_domains = first_pi_domains(type_expr, num_params)
          let index_domains = pi_domains_after(type_expr, num_params, num_indices)
          let shifted_index_domains = shift_constructor_domains(index_domains, num_motives + num_minors, 0)
          let motive_type = indexed_motive_type(elim_level, name, type_expr, num_params, num_indices)
          let minor_types = indexed_recursor_minor_types(name, num_params, num_indices, num_motives, ctors, 0)
          let major_type = inductive_app_for_params_and_indices(name, num_indices + num_minors + num_motives, 0, num_params, num_indices)
          let body = mk_apps(BVar(num_indices + num_minors + 1), Std.List.append(bvar_refs_from(1, num_indices), [BVar(0)]))
          wrap_pi_domains(Std.List.append(param_domains, Std.List.append([motive_type], Std.List.append(minor_types, Std.List.append(shifted_index_domains, [major_type])))), body, mk_simple("_rec_arg"))

  local fn indexed_motive_type(elim_level: Level, name: Name, type_expr: Expr, num_params: Int, num_indices: Int) -> Expr
    = let index_domains = pi_domains_after(type_expr, num_params, num_indices)
      let major_type = inductive_app_for_params_and_indices(name, num_indices, 0, num_params, num_indices)
      wrap_pi_domains(Std.List.append(index_domains, [major_type]), Sort(elim_level), mk_simple("_motive_arg"))

  local fn indexed_recursor_minor_types(inductive_name: Name, num_params: Int, num_indices: Int, num_motives: Int, ctors: List(Constructor), minor_index: Int) -> List(Expr)
    = match ctors
        [] -> []
        [Constructor(ctor_name, type_expr) | rest] ->
          let nfields = constructor_num_fields(type_expr, num_params)
          let domains = constructor_field_domains_for_recursor(type_expr, num_params, num_motives + minor_index)
          let idx_args = constructor_result_indices_for_recursor(type_expr, num_params, nfields, num_motives + minor_index)
          let minor_type = indexed_recursor_minor_type(ctor_name, num_params, num_indices, num_motives, minor_index, nfields, domains, idx_args)
          [minor_type | indexed_recursor_minor_types(inductive_name, num_params, num_indices, num_motives, rest, minor_index + 1)]

  local fn indexed_recursor_minor_type(ctor_name: Name, num_params: Int, num_indices: Int, num_motives: Int, minor_index: Int, nfields: Int, domains: List(Expr), idx_args: List(Expr)) -> Expr
    = let body = indexed_recursor_minor_body(ctor_name, num_params, num_indices, num_motives, minor_index, nfields, idx_args)
      wrap_pi_domains(domains, body, mk_simple("_field"))

  local fn indexed_recursor_minor_body(ctor_name: Name, num_params: Int, num_indices: Int, num_motives: Int, minor_index: Int, nfields: Int, idx_args: List(Expr)) -> Expr
    = let motive = BVar(nfields + minor_index + num_motives - 1)
      let params = bvar_refs_from(nfields + minor_index + num_motives, num_params)
      let ctor = mk_apps(Const(ctor_name, []), Std.List.append(params, bvar_refs_from(0, nfields)))
      mk_apps(motive, Std.List.append(take_args(idx_args, num_indices), [ctor]))

  local fn recursor_minor_types_for_simple_inductive(inductive_name: Name, num_params: Int, num_motives: Int, ctors: List(Constructor), is_rec: Bool, minor_index: Int) -> List(Expr)
    = match ctors
        [] -> []
        [Constructor(ctor_name, type_expr) | rest] ->
          let nfields = constructor_num_fields(type_expr, num_params)
          let domains = constructor_field_domains_for_recursor(type_expr, num_params, num_motives + minor_index)
          let minor_type = recursor_minor_type(inductive_name, ctor_name, num_params, num_motives, minor_index, nfields, domains, is_rec)
          [minor_type | recursor_minor_types_for_simple_inductive(inductive_name, num_params, num_motives, rest, is_rec, minor_index + 1)]

  local fn recursor_minor_type(inductive_name: Name, ctor_name: Name, num_params: Int, num_motives: Int, minor_index: Int, nfields: Int, domains: List(Expr), is_rec: Bool) -> Expr
    = let with_ihs = recursor_minor_ih_domains(inductive_name, ctor_name, num_params, num_motives, minor_index, nfields, domains, is_rec, 0, 0)
      wrap_pi_domains(domains, with_ihs, mk_simple("_field"))

  local fn recursor_minor_ih_domains(inductive_name: Name, ctor_name: Name, num_params: Int, num_motives: Int, minor_index: Int, nfields: Int, domains: List(Expr), is_rec: Bool, field_index: Int, ih_count: Int) -> Expr
    = match domains
        [] -> recursor_minor_body(ctor_name, num_params, num_motives, minor_index, nfields, ih_count)
        [domain | rest] ->
          pickup
            recursor_should_add_ih(inductive_name, domain, is_rec) ->
              let ih_domain = recursor_minor_ih_domain(num_motives, minor_index, nfields, field_index, ih_count)
              Pi(mk_simple("_ih"), BinderDefault(), ih_domain, recursor_minor_ih_domains(inductive_name, ctor_name, num_params, num_motives, minor_index, nfields, rest, is_rec, field_index + 1, ih_count + 1))
            else -> recursor_minor_ih_domains(inductive_name, ctor_name, num_params, num_motives, minor_index, nfields, rest, is_rec, field_index + 1, ih_count)

  local fn recursor_minor_ih_domain(num_motives: Int, minor_index: Int, nfields: Int, field_index: Int, ih_count: Int) -> Expr
    = App(BVar(ih_count + nfields + minor_index + num_motives - 1), BVar(ih_count + nfields - 1 - field_index))

  local fn recursor_minor_body(ctor_name: Name, num_params: Int, num_motives: Int, minor_index: Int, nfields: Int, ih_count: Int) -> Expr
    = let motive = BVar(ih_count + nfields + minor_index + num_motives - 1)
      let params = bvar_refs_from(ih_count + nfields + minor_index + num_motives, num_params)
      let ctor = mk_apps(Const(ctor_name, []), Std.List.append(params, bvar_refs_from(ih_count, nfields)))
      App(motive, ctor)

  local fn recursor_should_add_ih(inductive_name: Name, domain: Expr, is_rec: Bool) -> Bool
    = pickup
        is_rec -> simple_recursive_domain_matches(inductive_name, domain)
        else -> false

  local fn simple_recursive_domain_matches(inductive_name: Name, domain: Expr) -> Bool
    = match app_head_expr(domain)
        Const(name, _) -> name_eq(name, inductive_name)
        _ -> false

  local fn wrap_pi_domains(domains: List(Expr), body: Expr, base_name: Name) -> Expr
    = match domains
        [] -> body
        [domain | rest] -> Pi(base_name, BinderDefault(), domain, wrap_pi_domains(rest, body, str(base_name, "x")))

  local fn inductive_app_for_bvars(name: Name, offset: Int, num_params: Int) -> Expr
    = mk_apps(Const(name, []), bvar_refs_from(offset, num_params))

  local fn inductive_app_for_params_and_indices(name: Name, param_start: Int, index_start: Int, num_params: Int, num_indices: Int) -> Expr
    = mk_apps(Const(name, []), Std.List.append(bvar_refs_from(param_start, num_params), bvar_refs_from(index_start, num_indices)))

  local fn constructor_field_domains_for_recursor(type_expr: Expr, num_params: Int, shift: Int) -> List(Expr)
    = shift_constructor_domains(constructor_field_domains(type_expr, num_params), shift, 0)

  local fn constructor_result_indices_for_recursor(type_expr: Expr, num_params: Int, nfields: Int, shift: Int) -> List(Expr)
    = shift_exprs_at_cutoff(drop_args(app_args(constructor_result_type(type_expr)), num_params), shift, nfields)

  local fn shift_exprs_at_cutoff(exprs: List(Expr), shift: Int, cutoff: Int) -> List(Expr)
    = match exprs
        [] -> []
        [expr | rest] -> [expr_lift_at_cutoff(expr, shift, cutoff) | shift_exprs_at_cutoff(rest, shift, cutoff)]

  local fn shift_constructor_domains(domains: List(Expr), shift: Int, field_index: Int) -> List(Expr)
    = match domains
        [] -> []
        [domain | rest] -> [expr_lift_at_cutoff(domain, shift, field_index) | shift_constructor_domains(rest, shift, field_index + 1)]

  local fn expr_lift_at_cutoff(expr: Expr, amount: Int, cutoff: Int) -> Expr
    = match expr
        BVar(index) ->
          pickup
            index >= cutoff -> BVar(index + amount)
            else -> expr
        App(fn_expr, arg) -> App(expr_lift_at_cutoff(fn_expr, amount, cutoff), expr_lift_at_cutoff(arg, amount, cutoff))
        Lambda(name, binder_info, domain, body) -> Lambda(name, binder_info, expr_lift_at_cutoff(domain, amount, cutoff), expr_lift_at_cutoff(body, amount, cutoff + 1))
        Pi(name, binder_info, domain, body) -> Pi(name, binder_info, expr_lift_at_cutoff(domain, amount, cutoff), expr_lift_at_cutoff(body, amount, cutoff + 1))
        Let(name, type_expr, value, body, nondep) -> Let(name, expr_lift_at_cutoff(type_expr, amount, cutoff), expr_lift_at_cutoff(value, amount, cutoff), expr_lift_at_cutoff(body, amount, cutoff + 1), nondep)
        MData(data, inner) -> MData(data, expr_lift_at_cutoff(inner, amount, cutoff))
        Proj(struct_name, index, inner) -> Proj(struct_name, index, expr_lift_at_cutoff(inner, amount, cutoff))
        _ -> expr

  local fn recursor_rules_for_simple_inductive(elim_level: Level, num_params: Int, num_indices: Int, num_motives: Int, num_minors: Int, minor_offset: Int, is_rec: Bool, all_names: List(Name), ctors: List(Constructor)) -> List(RecursorRule)
    = pickup
        num_indices != 0 ->
          pickup
            is_rec -> []
            else -> recursor_rules_for_simple_ctors(num_params, num_motives, num_minors, minor_offset, ctors, 0)
        is_rec -> recursor_rules_for_simple_recursive_ctors(elim_level, num_params, num_motives, num_minors, minor_offset, all_names, ctors, 0)
        else -> recursor_rules_for_simple_ctors(num_params, num_motives, num_minors, minor_offset, ctors, 0)

  local fn recursor_rules_for_simple_ctors(num_params: Int, num_motives: Int, num_minors: Int, minor_offset: Int, ctors: List(Constructor), index: Int) -> List(RecursorRule)
    = match ctors
        [] -> []
        [Constructor(name, type_expr) | rest] ->
          let nfields = constructor_num_fields(type_expr, num_params)
          let rhs = simple_recursor_rule_rhs(num_params, num_motives, num_minors, nfields, minor_offset + index)
          [RecursorRule(name, nfields, rhs) | recursor_rules_for_simple_ctors(num_params, num_motives, num_minors, minor_offset, rest, index + 1)]

  local fn recursor_rules_for_simple_recursive_ctors(elim_level: Level, num_params: Int, num_motives: Int, num_minors: Int, minor_offset: Int, all_names: List(Name), ctors: List(Constructor), index: Int) -> List(RecursorRule)
    = match ctors
        [] -> []
        [Constructor(name, type_expr) | rest] ->
          let nfields = constructor_num_fields(type_expr, num_params)
          let domains = constructor_field_domains(type_expr, num_params)
          let rhs = simple_recursive_recursor_rule_rhs(elim_level, num_params, num_motives, num_minors, nfields, minor_offset + index, all_names, domains)
          [RecursorRule(name, nfields, rhs) | recursor_rules_for_simple_recursive_ctors(elim_level, num_params, num_motives, num_minors, minor_offset, all_names, rest, index + 1)]

  local fn simple_recursor_rule_rhs(num_params: Int, num_motives: Int, num_minors: Int, nfields: Int, minor_index: Int) -> Expr
    = wrap_default_lambdas(num_params + num_motives + num_minors + nfields, mk_apps(simple_recursor_minor_ref(num_minors, nfields, minor_index), simple_recursor_field_refs(nfields)))

  local fn simple_recursive_recursor_rule_rhs(elim_level: Level, num_params: Int, num_motives: Int, num_minors: Int, nfields: Int, minor_index: Int, all_names: List(Name), domains: List(Expr)) -> Expr
    = let field_refs = simple_recursor_field_refs(nfields)
      let ih_refs = simple_recursive_ih_refs(elim_level, num_params, num_motives, num_minors, nfields, all_names, domains, field_refs)
      wrap_default_lambdas(num_params + num_motives + num_minors + nfields, mk_apps(simple_recursor_minor_ref(num_minors, nfields, minor_index), Std.List.append(field_refs, ih_refs)))

  local fn simple_recursor_minor_ref(num_minors: Int, nfields: Int, minor_index: Int) -> Expr
    = BVar(nfields + subtract_nonnegative(num_minors - 1, minor_index))

  local fn simple_recursor_param_refs(num_params: Int, num_motives: Int, num_minors: Int, nfields: Int) -> List(Expr)
    = bvar_refs_from(nfields + num_minors + num_motives, num_params)

  local fn simple_recursor_motive_refs(num_motives: Int, num_minors: Int, nfields: Int) -> List(Expr)
    = bvar_refs_from(nfields + num_minors, num_motives)

  local fn simple_recursor_minor_refs(num_minors: Int, nfields: Int) -> List(Expr)
    = bvar_refs_from(nfields, num_minors)

  local fn simple_recursor_field_refs(nfields: Int) -> List(Expr)
    = simple_recursor_field_refs_from(nfields - 1)

  local fn simple_recursor_field_refs_from(index: Int) -> List(Expr)
    = pickup
        index < 0 -> []
        else -> [BVar(index) | simple_recursor_field_refs_from(index - 1)]

  local fn bvar_refs_from(start: Int, count: Int) -> List(Expr)
    = pickup
        count <= 0 -> []
        else -> [BVar(start + count - 1) | bvar_refs_from(start, count - 1)]

  local fn simple_recursive_ih_refs(elim_level: Level, num_params: Int, num_motives: Int, num_minors: Int, nfields: Int, all_names: List(Name), domains: List(Expr), fields: List(Expr)) -> List(Expr)
    = match domains
        [] -> []
        [domain | rest_domains] ->
          match fields
            [] -> []
            [field | rest_fields] ->
              match simple_recursive_domain_index(all_names, domain)
                Some(index) ->
                  let inductive_name = name_at_or_anonymous(all_names, index)
                  let rec_name = name_append_core(inductive_name, mk_simple("rec"))
                  let rec_args = Std.List.append(simple_recursor_param_refs(num_params, num_motives, num_minors, nfields), Std.List.append(simple_recursor_motive_refs(num_motives, num_minors, nfields), simple_recursor_minor_refs(num_minors, nfields)))
                  [mk_apps(mk_apps(Const(rec_name, recursor_levels(elim_level)), rec_args), [field]) | simple_recursive_ih_refs(elim_level, num_params, num_motives, num_minors, nfields, all_names, rest_domains, rest_fields)]
                None() -> simple_recursive_ih_refs(elim_level, num_params, num_motives, num_minors, nfields, all_names, rest_domains, rest_fields)

  local fn simple_recursive_domain_index(all_names: List(Name), domain: Expr) -> Option(Int)
    = match app_head_expr(domain)
        Const(name, _) -> name_index(all_names, name, 0)
        _ -> None()

  local fn app_head_expr(expr: Expr) -> Expr
    = match expr
        App(fn_expr, _) -> app_head_expr(fn_expr)
        _ -> expr

  local fn name_index(names: List(Name), target: Name, index: Int) -> Option(Int)
    = match names
        [] -> None()
        [name | rest] ->
          pickup
            name_eq(name, target) -> Some(index)
            else -> name_index(rest, target, index + 1)

  local fn name_at_or_anonymous(names: List(Name), index: Int) -> Name
    = match names
        [] -> Anonymous()
        [name | rest] ->
          pickup
            index == 0 -> name
            else -> name_at_or_anonymous(rest, index - 1)

  local fn wrap_default_lambdas(count: Int, body: Expr) -> Expr
    = pickup
        count <= 0 -> body
        else -> Lambda(mk_simple("_x"), BinderDefault(), Sort(LevelZero()), wrap_default_lambdas(count - 1, body))

  local fn mk_apps(fn_expr: Expr, args: List(Expr)) -> Expr
    = match args
        [] -> fn_expr
        [arg | rest] -> mk_apps(App(fn_expr, arg), rest)

  local fn constructor_num_fields(type_expr: Expr, num_params: Int) -> Int
    = subtract_nonnegative(pi_arity(type_expr), num_params)

  local fn constructor_field_domains(type_expr: Expr, num_params: Int) -> List(Expr)
    = constructor_field_domains_loop(type_expr, num_params)

  local fn constructor_field_domains_loop(type_expr: Expr, params_left: Int) -> List(Expr)
    = match type_expr
        Pi(_, _, domain, body) ->
          pickup
            params_left > 0 -> constructor_field_domains_loop(body, params_left - 1)
            else -> [domain | constructor_field_domains_loop(body, 0)]
        _ -> []

  local fn inductive_num_indices(type_expr: Expr, num_params: Int) -> Int
    = subtract_nonnegative(pi_arity(type_expr), num_params)

  local fn pi_arity(expr: Expr) -> Int
    = match expr
        Pi(_, _, _, body) -> 1 + pi_arity(body)
        _ -> 0

  local fn subtract_nonnegative(lhs: Int, rhs: Int) -> Int
    = pickup
        lhs >= rhs -> lhs - rhs
        else -> 0

  local fn constructor_count_for_all(types: List(InductiveType)) -> Int
    = match types
        [] -> 0
        [InductiveType(_, _, ctors) | rest] -> Std.List.length(ctors) + constructor_count_for_all(rest)

  local fn inductive_block_is_recursive(all_names: List(Name), types: List(InductiveType)) -> Bool
    = match types
        [] -> false
        [InductiveType(_, _, ctors) | rest] ->
          pickup
            inductive_is_recursive(all_names, ctors) -> true
            else -> inductive_block_is_recursive(all_names, rest)

  local fn inductive_is_recursive(all_names: List(Name), ctors: List(Constructor)) -> Bool
    = match ctors
        [] -> false
        [Constructor(_, type_expr) | rest] ->
          pickup
            constructor_has_recursive_domain(all_names, type_expr) -> true
            else -> inductive_is_recursive(all_names, rest)

  local fn constructor_has_recursive_domain(all_names: List(Name), type_expr: Expr) -> Bool
    = match type_expr
        Pi(_, _, domain, body) ->
          pickup
            expr_mentions_any_const(domain, all_names) -> true
            else -> constructor_has_recursive_domain(all_names, body)
        _ -> false

  local fn inductive_block_is_reflexive(all_names: List(Name), types: List(InductiveType)) -> Bool
    = match types
        [] -> false
        [InductiveType(_, _, ctors) | rest] ->
          pickup
            inductive_is_reflexive(all_names, ctors) -> true
            else -> inductive_block_is_reflexive(all_names, rest)

  local fn inductive_is_reflexive(all_names: List(Name), ctors: List(Constructor)) -> Bool
    = match ctors
        [] -> false
        [Constructor(_, type_expr) | rest] ->
          pickup
            constructor_has_reflexive_domain(all_names, type_expr) -> true
            else -> inductive_is_reflexive(all_names, rest)

  local fn constructor_has_reflexive_domain(all_names: List(Name), type_expr: Expr) -> Bool
    = match type_expr
        Pi(_, _, domain, body) ->
          pickup
            expr_is_pi(domain) -> expr_mentions_any_const(domain, all_names)
            else -> constructor_has_reflexive_domain(all_names, body)
        _ -> false

  local fn expr_is_pi(expr: Expr) -> Bool
    = match expr
        Pi(_, _, _, _) -> true
        _ -> false

  local fn inductive_block_is_k_target(num_params: Int, types: List(InductiveType)) -> Bool
    = match types
        [InductiveType(_, type_expr, ctors)] ->
          pickup
            inductive_result_is_prop(type_expr) ->
              match ctors
                [Constructor(_, ctor_type)] -> pi_arity(ctor_type) == num_params
                _ -> false
            else -> false
        _ -> false

  local fn inductive_result_is_prop(type_expr: Expr) -> Bool
    = match type_expr
        Pi(_, _, _, body) -> inductive_result_is_prop(body)
        Sort(level) -> level_eq(level, LevelZero())
        _ -> false

  local fn inductive_elim_level(level_params: List(Name), num_params: Int, types: List(InductiveType)) -> Level
    = pickup
        inductive_is_large_eliminator(num_params, types) -> LevelParam(fresh_elim_level_name(level_params, 1))
        else -> LevelZero()

  local fn inductive_is_large_eliminator(num_params: Int, types: List(InductiveType)) -> Bool
    = match types
        [InductiveType(_, type_expr, ctors)] ->
          pickup
            inductive_result_is_prop(type_expr) -> prop_inductive_is_large_eliminator(num_params, ctors)
            else -> true
        [InductiveType(_, type_expr, _) | _] ->
          pickup
            inductive_result_is_prop(type_expr) -> false
            else -> true
        _ -> false

  local fn prop_inductive_is_large_eliminator(num_params: Int, ctors: List(Constructor)) -> Bool
    = match ctors
        [] -> true
        [Constructor(_, type_expr)] -> singleton_prop_ctor_is_large_eliminator(num_params, type_expr)
        _ -> false

  local fn singleton_prop_ctor_is_large_eliminator(num_params: Int, type_expr: Expr) -> Bool
    = singleton_prop_ctor_loop(num_params, type_expr, 0, [])

  local fn singleton_prop_ctor_loop(num_params: Int, type_expr: Expr, index: Int, to_check: List(Expr)) -> Bool
    = match type_expr
        Pi(name, _, domain, body) ->
          let arg = FVar(num(name, index))
          let instantiated_body = expr_instantiate(body, arg)
          pickup
            index < num_params -> singleton_prop_ctor_loop(num_params, instantiated_body, index + 1, to_check)
            expr_sort_level_is_not_prop(domain) -> singleton_prop_ctor_loop(num_params, instantiated_body, index + 1, [arg | to_check])
            else -> singleton_prop_ctor_loop(num_params, instantiated_body, index + 1, to_check)
        _ -> singleton_prop_ctor_fields_are_forced(type_expr, to_check)

  local fn singleton_prop_ctor_fields_are_forced(type_expr: Expr, fields: List(Expr)) -> Bool
    = match fields
        [] -> true
        [field | rest] ->
          pickup
            expr_in_list(field, app_args(type_expr)) -> singleton_prop_ctor_fields_are_forced(type_expr, rest)
            else -> false

  local fn expr_sort_level_is_not_prop(expr: Expr) -> Bool
    = match expr
        Sort(level) ->
          pickup
            level_eq(level, LevelZero()) -> false
            else -> true
        _ -> false

  local fn fresh_elim_level_name(level_params: List(Name), index: Int) -> Name
    = let candidate = elim_level_name(index)
      pickup
        name_in_list(candidate, level_params) -> fresh_elim_level_name(level_params, index + 1)
        else -> candidate

  local fn elim_level_name(index: Int) -> Name
    = pickup
        index == 1 -> mk_simple("u")
        else -> num(mk_simple("u"), index)

  local fn recursor_level_params(level_params: List(Name), elim_level: Level) -> List(Name)
    = match elim_level
        LevelParam(name) -> [name | level_params]
        _ -> level_params

  local fn recursor_levels(elim_level: Level) -> List(Level)
    = match elim_level
        LevelParam(_) -> [elim_level]
        _ -> []

  local fn expr_instantiate(expr: Expr, value: Expr) -> Expr
    = expr_instantiate_at(expr, value, 0)

  local fn expr_instantiate_at(expr: Expr, value: Expr, depth: Int) -> Expr
    = match expr
        BVar(index) ->
          pickup
            index == depth -> expr_lift_at_cutoff(value, depth, 0)
            index > depth -> BVar(index - 1)
            else -> expr
        App(fn_expr, arg) -> App(expr_instantiate_at(fn_expr, value, depth), expr_instantiate_at(arg, value, depth))
        Lambda(name, binder_info, domain, body) -> Lambda(name, binder_info, expr_instantiate_at(domain, value, depth), expr_instantiate_at(body, value, depth + 1))
        Pi(name, binder_info, domain, body) -> Pi(name, binder_info, expr_instantiate_at(domain, value, depth), expr_instantiate_at(body, value, depth + 1))
        Let(name, type_expr, let_value, body, nondep) -> Let(name, expr_instantiate_at(type_expr, value, depth), expr_instantiate_at(let_value, value, depth), expr_instantiate_at(body, value, depth + 1), nondep)
        MData(data, inner) -> MData(data, expr_instantiate_at(inner, value, depth))
        Proj(struct_name, index, inner) -> Proj(struct_name, index, expr_instantiate_at(inner, value, depth))
        _ -> expr

  local fn expr_mentions_any_const(expr: Expr, names: List(Name)) -> Bool
    = match expr
        Const(name, _) -> name_in_list(name, names)
        App(fn_expr, arg) ->
          pickup
            expr_mentions_any_const(fn_expr, names) -> true
            else -> expr_mentions_any_const(arg, names)
        Lambda(_, _, domain, body) ->
          pickup
            expr_mentions_any_const(domain, names) -> true
            else -> expr_mentions_any_const(body, names)
        Pi(_, _, domain, body) ->
          pickup
            expr_mentions_any_const(domain, names) -> true
            else -> expr_mentions_any_const(body, names)
        Let(_, type_expr, value, body, _) ->
          pickup
            expr_mentions_any_const(type_expr, names) -> true
            expr_mentions_any_const(value, names) -> true
            else -> expr_mentions_any_const(body, names)
        MData(_, inner) -> expr_mentions_any_const(inner, names)
        Proj(_, _, inner) -> expr_mentions_any_const(inner, names)
        _ -> false

  local fn inductive_type_names(types: List(InductiveType)) -> List(Name)
    = match types
        [] -> []
        [InductiveType(name, _, _) | rest] -> [name | inductive_type_names(rest)]

  local fn constructor_names(ctors: List(Constructor)) -> List(Name)
    = match ctors
        [] -> []
        [Constructor(name, _) | rest] -> [name | constructor_names(rest)]

  local fn quot_infos() -> List(ConstantInfo)
    = let quot = QuotInfo(QuotVal(ConstantVal(mk_simple("Quot"), [], Sort(LevelZero())), QuotType()))
      let quot_mk = QuotInfo(QuotVal(ConstantVal(str(mk_simple("Quot"), "mk"), [], Sort(LevelZero())), QuotCtor()))
      let quot_lift = QuotInfo(QuotVal(ConstantVal(str(mk_simple("Quot"), "lift"), [], Sort(LevelZero())), QuotLift()))
      let quot_ind = QuotInfo(QuotVal(ConstantVal(str(mk_simple("Quot"), "ind"), [], Sort(LevelZero())), QuotInd()))
      [quot | [quot_mk | [quot_lift | [quot_ind]]]]

  local fn environment_add_checked(env: Environment, decl: Declaration) -> Result(Environment, KernelException)
    = match decl
        AxiomDecl(AxiomVal(value, _)) -> check_constant_header(env, value, decl)
        DefinitionDecl(DefinitionVal(value, body, _, safety, _)) -> check_definition_decl(env, value, body, safety, decl)
        TheoremDecl(TheoremVal(value, body, _)) ->
          match check_value_decl(env, value, body, DefinitionSafe(), decl)
            Error(error) -> Error(error)
            Ok(new_env) ->
              match is_decl_prop(env, value)
                Ok(true) -> Ok(new_env)
                Ok(false) -> Error(TheoremTypeIsNotProp(env, constant_val_name(value), constant_val_type(value)))
                Error(error) -> Error(error)
        OpaqueDecl(OpaqueVal(value, body, is_unsafe, _)) ->
          pickup
            is_unsafe -> check_value_decl(env, value, body, DefinitionUnsafe(), decl)
            else -> check_value_decl(env, value, body, DefinitionSafe(), decl)
        QuotDecl() -> check_quot_decl(env, decl)
        InductiveDecl(level_params, num_params, types, is_unsafe) -> check_inductive_decl(env, level_params, num_params, types, is_unsafe, decl)
        _ -> Error(OtherKernelException("checked environment_add for this declaration form requires the Lean kernel declaration checker"))

  local fn check_inductive_decl(env: Environment, level_params: List(Name), num_params: Int, types: List(InductiveType), is_unsafe: Bool, decl: Declaration) -> Result(Environment, KernelException)
    = match check_duplicated_universe_params(level_params)
        Error(error) -> Error(error)
        Ok(_) ->
          match check_nonnegative_num_params(num_params)
            Error(error) -> Error(error)
            Ok(_) ->
              match check_nonempty_inductive_types(types)
                Error(error) -> Error(error)
                Ok(_) ->
                  match check_inductive_param_prefixes(num_params, types)
                    Error(error) -> Error(error)
                    Ok(_) ->
                      match check_inductive_result_universes(num_params, types)
                        Error(error) -> Error(error)
                        Ok(_) ->
                          match check_unique_decl_names(declaration_names(decl))
                            Error(error) -> Error(error)
                            Ok(_) ->
                              match check_inductive_type_headers(env, level_params, types)
                                Error(error) -> Error(error)
                                Ok(_) ->
                                  let env_with_decl = environment_add_unchecked(env, decl, false)
                                  match check_constructor_type_headers(env_with_decl, level_params, types)
                                    Error(error) -> Error(error)
                                    Ok(_) ->
                                      match check_constructor_param_prefixes(num_params, types)
                                        Error(error) -> Error(error)
                                        Ok(_) ->
                                          match check_constructor_return_shapes(num_params, types)
                                            Error(error) -> Error(error)
                                            Ok(_) ->
                                              match check_constructor_positivity(num_params, types, is_unsafe)
                                                Error(error) -> Error(error)
                                                Ok(_) -> Ok(env_with_decl)

  local fn check_nonnegative_num_params(num_params: Int) -> Result(Atom, KernelException)
    = pickup
        num_params < 0 -> Error(OtherKernelException("inductive declaration has negative parameter count"))
        else -> Ok(:ok)

  local fn check_nonempty_inductive_types(types: List(InductiveType)) -> Result(Atom, KernelException)
    = match types
        [] -> Error(OtherKernelException("invalid empty mutual inductive datatype declaration"))
        _ -> Ok(:ok)

  local fn check_inductive_param_prefixes(num_params: Int, types: List(InductiveType)) -> Result(Atom, KernelException)
    = match types
        [] -> Ok(:ok)
        [InductiveType(_, type_expr, _) | rest] ->
          check_inductive_param_prefixes_against(num_params, first_pi_domains(type_expr, num_params), rest)

  local fn check_inductive_param_prefixes_against(num_params: Int, params: List(Expr), types: List(InductiveType)) -> Result(Atom, KernelException)
    = match types
        [] -> Ok(:ok)
        [InductiveType(_, type_expr, _) | rest] ->
          pickup
            expr_list_eq(params, first_pi_domains(type_expr, num_params)) -> check_inductive_param_prefixes_against(num_params, params, rest)
            else -> Error(OtherKernelException("parameters of all inductive datatypes must match"))

  local fn check_inductive_result_universes(num_params: Int, types: List(InductiveType)) -> Result(Atom, KernelException)
    = match types
        [] -> Ok(:ok)
        [InductiveType(_, type_expr, _) | rest] ->
          match inductive_result_sort_level(num_params, type_expr)
            Some(level) -> check_inductive_result_universes_against(num_params, level, rest)
            None() -> Error(OtherKernelException("number of parameters mismatch in inductive datatype declaration"))

  local fn check_inductive_result_universes_against(num_params: Int, level: Level, types: List(InductiveType)) -> Result(Atom, KernelException)
    = match types
        [] -> Ok(:ok)
        [InductiveType(_, type_expr, _) | rest] ->
          match inductive_result_sort_level(num_params, type_expr)
            Some(next_level) ->
              pickup
                level_is_equivalent(level, next_level) -> check_inductive_result_universes_against(num_params, level, rest)
                else -> Error(OtherKernelException("mutually inductive types must live in the same universe"))
            None() -> Error(OtherKernelException("number of parameters mismatch in inductive datatype declaration"))

  local fn inductive_result_sort_level(num_params: Int, type_expr: Expr) -> Option(Level)
    = match drop_pi_domains(type_expr, num_params)
        Some(result_type) ->
          match final_pi_result(result_type)
            Sort(level) -> Some(level)
            _ -> None()
        None() -> None()

  local fn drop_pi_domains(type_expr: Expr, count: Int) -> Option(Expr)
    = pickup
        count <= 0 -> Some(type_expr)
        else ->
          match type_expr
            Pi(_, _, _, body) -> drop_pi_domains(body, count - 1)
            _ -> None()

  local fn final_pi_result(type_expr: Expr) -> Expr
    = match type_expr
        Pi(_, _, _, body) -> final_pi_result(body)
        _ -> type_expr

  local fn check_inductive_type_headers(env: Environment, level_params: List(Name), types: List(InductiveType)) -> Result(Atom, KernelException)
    = match types
        [] -> Ok(:ok)
        [InductiveType(name, type_expr, _) | rest] ->
          match check_constant_header_only(env, ConstantVal(name, level_params, type_expr))
            Error(error) -> Error(error)
            Ok(_) -> check_inductive_type_headers(env, level_params, rest)

  local fn check_constructor_type_headers(env: Environment, level_params: List(Name), types: List(InductiveType)) -> Result(Atom, KernelException)
    = match types
        [] -> Ok(:ok)
        [InductiveType(_, _, ctors) | rest] ->
          match check_constructor_list_headers(env, level_params, ctors)
            Error(error) -> Error(error)
            Ok(_) -> check_constructor_type_headers(env, level_params, rest)

  local fn check_constructor_list_headers(env: Environment, level_params: List(Name), ctors: List(Constructor)) -> Result(Atom, KernelException)
    = match ctors
        [] -> Ok(:ok)
        [Constructor(name, type_expr) | rest] ->
          match check_constant_header_only(env, ConstantVal(name, level_params, type_expr))
            Error(error) -> Error(error)
            Ok(_) -> check_constructor_list_headers(env, level_params, rest)

  local fn check_constructor_param_prefixes(num_params: Int, types: List(InductiveType)) -> Result(Atom, KernelException)
    = match types
        [] -> Ok(:ok)
        [InductiveType(_, type_expr, ctors) | rest] ->
          match check_constructor_param_prefixes_for_type(num_params, first_pi_domains(type_expr, num_params), ctors)
            Error(error) -> Error(error)
            Ok(_) -> check_constructor_param_prefixes(num_params, rest)

  local fn check_constructor_param_prefixes_for_type(num_params: Int, params: List(Expr), ctors: List(Constructor)) -> Result(Atom, KernelException)
    = match ctors
        [] -> Ok(:ok)
        [Constructor(_, type_expr) | rest] ->
          pickup
            expr_list_eq(params, first_pi_domains(type_expr, num_params)) -> check_constructor_param_prefixes_for_type(num_params, params, rest)
            else -> Error(OtherKernelException("constructor parameters do not match inductive datatype parameters"))

  local fn check_constructor_return_shapes(num_params: Int, types: List(InductiveType)) -> Result(Atom, KernelException)
    = match types
        [] -> Ok(:ok)
        [InductiveType(name, type_expr, ctors) | rest] ->
          match check_constructor_return_shapes_for_type(name, num_params, inductive_num_indices(type_expr, num_params), ctors)
            Error(error) -> Error(error)
            Ok(_) -> check_constructor_return_shapes(num_params, rest)

  local fn check_constructor_return_shapes_for_type(inductive_name: Name, num_params: Int, num_indices: Int, ctors: List(Constructor)) -> Result(Atom, KernelException)
    = match ctors
        [] -> Ok(:ok)
        [Constructor(_, type_expr) | rest] ->
          pickup
            constructor_returns_inductive(type_expr, inductive_name, num_params + num_indices) ->
              check_constructor_return_shapes_for_type(inductive_name, num_params, num_indices, rest)
            else -> Error(OtherKernelException("invalid constructor return type"))

  local fn check_constructor_positivity(num_params: Int, types: List(InductiveType), is_unsafe: Bool) -> Result(Atom, KernelException)
    = pickup
        is_unsafe -> Ok(:ok)
        else -> check_constructor_positivity_types(num_params, types, inductive_type_names(types), types)

  local fn check_constructor_positivity_types(num_params: Int, all_types: List(InductiveType), all_names: List(Name), types: List(InductiveType)) -> Result(Atom, KernelException)
    = match types
        [] -> Ok(:ok)
        [InductiveType(_, _, ctors) | rest] ->
          match check_constructor_positivity_ctors(num_params, all_types, all_names, ctors)
            Error(error) -> Error(error)
            Ok(_) -> check_constructor_positivity_types(num_params, all_types, all_names, rest)

  local fn check_constructor_positivity_ctors(num_params: Int, all_types: List(InductiveType), all_names: List(Name), ctors: List(Constructor)) -> Result(Atom, KernelException)
    = match ctors
        [] -> Ok(:ok)
        [Constructor(_, type_expr) | rest] ->
          match check_constructor_positivity_type(num_params, all_types, all_names, type_expr, 0)
            Error(error) -> Error(error)
            Ok(_) -> check_constructor_positivity_ctors(num_params, all_types, all_names, rest)

  local fn check_constructor_positivity_type(num_params: Int, all_types: List(InductiveType), all_names: List(Name), type_expr: Expr, index: Int) -> Result(Atom, KernelException)
    = match type_expr
        Pi(_, _, domain, body) ->
          pickup
            index < num_params -> check_constructor_positivity_type(num_params, all_types, all_names, body, index + 1)
            else ->
              match check_positive_occurrences(num_params, all_types, all_names, domain)
                Error(error) -> Error(error)
                Ok(_) -> check_constructor_positivity_type(num_params, all_types, all_names, body, index + 1)
        _ -> Ok(:ok)

  local fn check_positive_occurrences(num_params: Int, all_types: List(InductiveType), all_names: List(Name), expr: Expr) -> Result(Atom, KernelException)
    = pickup
        expr_mentions_any_const(expr, all_names) ->
          match expr
            Pi(_, _, domain, body) ->
              pickup
                expr_mentions_any_const(domain, all_names) -> Error(OtherKernelException("constructor argument has a non-positive occurrence of the datatypes being declared"))
                else -> check_positive_occurrences(num_params, all_types, all_names, body)
            _ ->
              pickup
                valid_inductive_app(num_params, all_types, all_names, expr) -> Ok(:ok)
                else -> Error(OtherKernelException("constructor argument has a non-valid occurrence of the datatypes being declared"))
        else -> Ok(:ok)

  local fn valid_inductive_app(num_params: Int, all_types: List(InductiveType), all_names: List(Name), expr: Expr) -> Bool
    = match app_head(expr)
        Const(name, _) ->
          pickup
            name_in_list(name, all_names) ->
              match find_inductive_type(name, all_types)
                Some(InductiveType(_, type_expr, _)) ->
                  pickup
                    Std.List.length(app_args(expr)) == num_params + inductive_num_indices(type_expr, num_params) ->
                      no_inductive_occurrences(app_args_after_params(expr, num_params), all_names)
                    else -> false
                None() -> false
            else -> false
        _ -> false

  local fn find_inductive_type(name: Name, types: List(InductiveType)) -> Option(InductiveType)
    = match types
        [] -> None()
        [type_info | rest] ->
          match type_info
            InductiveType(type_name, _, _) ->
              pickup
                name_eq(name, type_name) -> Some(type_info)
                else -> find_inductive_type(name, rest)

  local fn app_args_after_params(expr: Expr, num_params: Int) -> List(Expr)
    = drop_args(app_args(expr), num_params)

  local fn drop_args(args: List(Expr), count: Int) -> List(Expr)
    = match args
        [] -> []
        [_ | rest] ->
          pickup
            count <= 0 -> args
            else -> drop_args(rest, count - 1)

  local fn no_inductive_occurrences(exprs: List(Expr), all_names: List(Name)) -> Bool
    = match exprs
        [] -> true
        [expr | rest] ->
          pickup
            expr_mentions_any_const(expr, all_names) -> false
            else -> no_inductive_occurrences(rest, all_names)

  local fn constructor_returns_inductive(type_expr: Expr, inductive_name: Name, arity: Int) -> Bool
    = match constructor_result_type(type_expr)
        Const(name, _) ->
          pickup
            name_eq(name, inductive_name) -> arity == 0
            else -> false
        App(_, _) ->
          match app_head(constructor_result_type(type_expr))
            Const(name, _) ->
              pickup
                name_eq(name, inductive_name) -> Std.List.length(app_args(constructor_result_type(type_expr))) == arity
                else -> false
            _ -> false
        _ -> false

  local fn constructor_result_type(type_expr: Expr) -> Expr
    = match type_expr
        Pi(_, _, _, body) -> constructor_result_type(body)
        _ -> type_expr

  local fn app_head(expr: Expr) -> Expr
    = match expr
        App(fn_expr, _) -> app_head(fn_expr)
        _ -> expr

  local fn app_args(expr: Expr) -> List(Expr)
    = match expr
        App(fn_expr, arg) -> Std.List.append(app_args(fn_expr), [arg])
        _ -> []

  local fn first_pi_domains(type_expr: Expr, count: Int) -> List(Expr)
    = pickup
        count <= 0 -> []
        else ->
          match type_expr
            Pi(_, _, domain, body) -> [domain | first_pi_domains(body, count - 1)]
            _ -> []

  local fn pi_domains_after(type_expr: Expr, skip: Int, count: Int) -> List(Expr)
    = pickup
        skip <= 0 -> first_pi_domains(type_expr, count)
        else ->
          match type_expr
            Pi(_, _, _, body) -> pi_domains_after(body, skip - 1, count)
            _ -> []

  local fn take_args(args: List(Expr), count: Int) -> List(Expr)
    = pickup
        count <= 0 -> []
        else ->
          match args
            [] -> []
            [arg | rest] -> [arg | take_args(rest, count - 1)]

  local fn expr_list_eq(lhs: List(Expr), rhs: List(Expr)) -> Bool
    = match lhs
        [] ->
          match rhs
            [] -> true
            _ -> false
        [lhs_expr | lhs_rest] ->
          match rhs
            [rhs_expr | rhs_rest] ->
              pickup
                expr_eq(lhs_expr, rhs_expr) -> expr_list_eq(lhs_rest, rhs_rest)
                else -> false
            _ -> false

  local fn expr_in_list(expr: Expr, exprs: List(Expr)) -> Bool
    = match exprs
        [] -> false
        [candidate | rest] ->
          pickup
            expr_eq(expr, candidate) -> true
            else -> expr_in_list(expr, rest)

  local fn check_constant_header_only(env: Environment, value: ConstantVal) -> Result(Atom, KernelException)
    = match check_constant_name(env, value)
        Error(error) -> Error(error)
        Ok(_) ->
          match check_constant_type(env, value)
            Error(error) -> Error(error)
            Ok(_) -> Ok(:ok)

  local fn check_unique_decl_names(names: List(Name)) -> Result(Atom, KernelException)
    = match names
        [] -> Ok(:ok)
        [name | rest] ->
          pickup
            name_in_list(name, rest) -> Error(OtherKernelException("declaration contains duplicate names"))
            else -> check_unique_decl_names(rest)

  local fn check_constant_header(env: Environment, value: ConstantVal, decl: Declaration) -> Result(Environment, KernelException)
    = match check_constant_name(env, value)
        Error(error) -> Error(error)
        Ok(_) -> check_constant_header_named(env, value, decl)

  local fn check_constant_header_named(env: Environment, value: ConstantVal, decl: Declaration) -> Result(Environment, KernelException)
    = match check_constant_type(env, value)
        Error(error) -> Error(error)
        Ok(_) -> Ok(environment_add_unchecked(env, decl, false))

  local fn check_value_decl(env: Environment, value: ConstantVal, body: Expr, safety: DefinitionSafety, decl: Declaration) -> Result(Environment, KernelException)
    = match check_constant_name(env, value)
        Error(error) -> Error(error)
        Ok(_) -> check_value_decl_named(env, value, body, safety, decl)

  local fn check_value_decl_named(env: Environment, value: ConstantVal, body: Expr, safety: DefinitionSafety, decl: Declaration) -> Result(Environment, KernelException)
    = match check_constant_type(env, value)
        Error(error) -> Error(error)
        Ok(_) ->
          match check_no_mvars_or_fvars(env, constant_val_name(value), body)
            Error(error) -> Error(error)
            Ok(_) ->
              let type_checker = Compiler.Kernel.Core.TypeChecker.mk_type_checker_with_level_params(env, empty_local_context(), safety, constant_val_level_params(value))
              match Compiler.Kernel.Core.TypeChecker.check(type_checker, body, constant_val_level_params(value))
                Error(error) -> Error(error)
                Ok(body_type) ->
                  match Compiler.Kernel.Core.TypeChecker.is_def_eq(type_checker, body_type, constant_val_type(value))
                    Error(error) -> Error(error)
                    Ok(true) -> Ok(environment_add_unchecked(env, decl, false))
                    Ok(false) -> Error(DeclarationTypeMismatch(env, decl, body_type))

  local fn check_definition_decl(env: Environment, value: ConstantVal, body: Expr, safety: DefinitionSafety, decl: Declaration) -> Result(Environment, KernelException)
    = pickup
        safety == DefinitionUnsafe() -> check_unsafe_definition_decl(env, value, body, safety, decl)
        else -> check_value_decl(env, value, body, safety, decl)

  local fn check_unsafe_definition_decl(env: Environment, value: ConstantVal, body: Expr, safety: DefinitionSafety, decl: Declaration) -> Result(Environment, KernelException)
    = match check_constant_name(env, value)
        Error(error) -> Error(error)
        Ok(_) -> check_unsafe_definition_decl_named(env, value, body, safety, decl)

  local fn check_unsafe_definition_decl_named(env: Environment, value: ConstantVal, body: Expr, safety: DefinitionSafety, decl: Declaration) -> Result(Environment, KernelException)
    = match check_constant_type(env, value)
        Error(error) -> Error(error)
        Ok(_) ->
          let env_with_decl = environment_add_unchecked(env, decl, false)
          match check_no_mvars_or_fvars(env_with_decl, constant_val_name(value), body)
            Error(error) -> Error(error)
            Ok(_) ->
              let type_checker = Compiler.Kernel.Core.TypeChecker.mk_type_checker_with_level_params(env_with_decl, empty_local_context(), safety, constant_val_level_params(value))
              match Compiler.Kernel.Core.TypeChecker.check(type_checker, body, constant_val_level_params(value))
                Error(error) -> Error(error)
                Ok(body_type) ->
                  match Compiler.Kernel.Core.TypeChecker.is_def_eq(type_checker, body_type, constant_val_type(value))
                    Error(error) -> Error(error)
                    Ok(true) -> Ok(env_with_decl)
                    Ok(false) -> Error(DeclarationTypeMismatch(env_with_decl, decl, body_type))

  local fn check_quot_decl(env: Environment, decl: Declaration) -> Result(Environment, KernelException)
    = match environment_find(env, mk_simple("Eq"))
        Some(InductiveInfo(InductiveVal(ConstantVal(_, level_params, _), _, _, _, ctors, _, _, _, _))) ->
          pickup
            Std.List.length(level_params) == 1 ->
              pickup
                Std.List.length(ctors) == 1 -> Ok(environment_add_unchecked(env, decl, false))
                else -> Error(OtherKernelException("failed to initialize quotient module, unexpected number of constructors for Eq"))
            else -> Error(OtherKernelException("failed to initialize quotient module, unexpected number of universe params at Eq"))
        _ -> Error(OtherKernelException("failed to initialize quotient module, environment does not have Eq type"))

  local fn check_constant_type(env: Environment, value: ConstantVal) -> Result(Expr, KernelException)
    = match check_duplicated_universe_params(constant_val_level_params(value))
        Error(error) -> Error(error)
        Ok(_) -> check_constant_type_no_duplicate(env, value)

  local fn check_constant_name(env: Environment, value: ConstantVal) -> Result(Atom, KernelException)
    = pickup
        primitive_name(constant_val_name(value)) -> Error(OtherKernelException("unexpected use of primitive name"))
        else -> Ok(:ok)

  local fn primitive_name(name: Name) -> Bool
    = pickup
        name_eq(name, mk_simple("Bool")) -> true
        name_eq(name, str(mk_simple("Bool"), "false")) -> true
        name_eq(name, str(mk_simple("Bool"), "true")) -> true
        name_eq(name, mk_simple("Nat")) -> true
        name_eq(name, str(mk_simple("Nat"), "zero")) -> true
        name_eq(name, str(mk_simple("Nat"), "succ")) -> true
        name_eq(name, str(mk_simple("Nat"), "add")) -> true
        name_eq(name, str(mk_simple("Nat"), "pred")) -> true
        name_eq(name, str(mk_simple("Nat"), "sub")) -> true
        name_eq(name, str(mk_simple("Nat"), "mul")) -> true
        name_eq(name, str(mk_simple("Nat"), "pow")) -> true
        name_eq(name, str(mk_simple("Nat"), "gcd")) -> true
        name_eq(name, str(mk_simple("Nat"), "mod")) -> true
        name_eq(name, str(mk_simple("Nat"), "div")) -> true
        name_eq(name, str(mk_simple("Nat"), "beq")) -> true
        name_eq(name, str(mk_simple("Nat"), "ble")) -> true
        name_eq(name, str(mk_simple("Nat"), "bitwise")) -> true
        name_eq(name, str(mk_simple("Nat"), "land")) -> true
        name_eq(name, str(mk_simple("Nat"), "lor")) -> true
        name_eq(name, str(mk_simple("Nat"), "xor")) -> true
        name_eq(name, str(mk_simple("Nat"), "shiftLeft")) -> true
        name_eq(name, str(mk_simple("Nat"), "shiftRight")) -> true
        name_eq(name, str(mk_simple("String"), "ofList")) -> true
        name_eq(name, str(mk_simple("Char"), "ofNat")) -> true
        else -> false

  local fn check_constant_type_no_duplicate(env: Environment, value: ConstantVal) -> Result(Expr, KernelException)
    = match check_no_mvars_or_fvars(env, constant_val_name(value), constant_val_type(value))
        Error(error) -> Error(error)
        Ok(_) -> Compiler.Kernel.Core.TypeChecker.check(Compiler.Kernel.Core.TypeChecker.mk_type_checker_with_level_params(env, empty_local_context(), DefinitionSafe(), constant_val_level_params(value)), constant_val_type(value), constant_val_level_params(value))

  local fn check_no_mvars_or_fvars(env: Environment, name: Name, expr: Expr) -> Result(Atom, KernelException)
    = pickup
        expr_has_mvar(expr) -> Error(DeclarationHasMVars(env, name, expr))
        expr_has_fvar(expr) -> Error(DeclarationHasFVars(env, name, expr))
        else -> Ok(:ok)

  local fn is_decl_prop(env: Environment, value: ConstantVal) -> Result(Bool, KernelException)
    = Compiler.Kernel.Core.TypeChecker.is_prop(Compiler.Kernel.Core.TypeChecker.mk_type_checker_with_level_params(env, empty_local_context(), DefinitionSafe(), constant_val_level_params(value)), constant_val_type(value))

  local fn constant_val_name(value: ConstantVal) -> Name
    = match value
        ConstantVal(name, _, _) -> name

  local fn constant_val_level_params(value: ConstantVal) -> List(Name)
    = match value
        ConstantVal(_, level_params, _) -> level_params

  local fn constant_val_type(value: ConstantVal) -> Expr
    = match value
        ConstantVal(_, _, type_expr) -> type_expr

  local fn check_duplicated_universe_params(params: List(Name)) -> Result(Atom, KernelException)
    = match params
        [] -> Ok(:ok)
        [param | rest] ->
          pickup
            name_in_list(param, rest) -> Error(OtherKernelException("duplicated universe level parameter"))
            else -> check_duplicated_universe_params(rest)

  local fn name_in_list(name: Name, names: List(Name)) -> Bool
    = match names
        [] -> false
        [head | rest] ->
          pickup
            name_eq(name, head) -> true
            else -> name_in_list(name, rest)
