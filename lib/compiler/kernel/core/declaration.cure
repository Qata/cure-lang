mod Compiler.Kernel.Core.Declaration
  use Compiler.Kernel.Core.Name
  use Compiler.Kernel.Core.Expr
  
  type ReducibilityHints
    = ReducibilityOpaque
    | ReducibilityAbbreviation
    | ReducibilityRegular(Int)
  
  type DefinitionSafety
    = DefinitionUnsafe
    | DefinitionSafe
    | DefinitionPartial
  
  type ConstantVal
    = ConstantVal(Name, List(Name), Expr)
  
  type AxiomVal
    = AxiomVal(ConstantVal, Bool)
  
  type DefinitionVal
    = DefinitionVal(ConstantVal, Expr, ReducibilityHints, DefinitionSafety, List(Name))
  
  type TheoremVal
    = TheoremVal(ConstantVal, Expr, List(Name))
  
  type OpaqueVal
    = OpaqueVal(ConstantVal, Expr, Bool, List(Name))
  
  type Constructor
    = Constructor(Name, Expr)
  
  type InductiveType
    = InductiveType(Name, Expr, List(Constructor))
  
  type Declaration
    = AxiomDecl(AxiomVal)
    | DefinitionDecl(DefinitionVal)
    | TheoremDecl(TheoremVal)
    | OpaqueDecl(OpaqueVal)
    | QuotDecl
    | MutualDefinitionDecl(List(DefinitionVal))
    | InductiveDecl(List(Name), Int, List(InductiveType), Bool)
  
  ## Positional encodings of Lean's declaration records:
  ## InductiveVal(ConstantVal, numParams, numIndices, all, ctors, numNested, isRec, isUnsafe, isReflexive)
  ## ConstructorVal(ConstantVal, induct, cidx, numParams, numFields, isUnsafe)
  ## RecursorVal(ConstantVal, all, numParams, numIndices, numMotives, numMinors, rules, k, isUnsafe)
  
  type InductiveVal
    = InductiveVal(ConstantVal, Int, Int, List(Name), List(Name), Int, Bool, Bool, Bool)
  
  type ConstructorVal
    = ConstructorVal(ConstantVal, Name, Int, Int, Int, Bool)
  
  type RecursorRule
    = RecursorRule(Name, Int, Expr)
  
  type RecursorVal
    = RecursorVal(ConstantVal, List(Name), Int, Int, Int, Int, List(RecursorRule), Bool, Bool)
  
  type QuotKind
    = QuotType
    | QuotCtor
    | QuotLift
    | QuotInd
  
  type QuotVal
    = QuotVal(ConstantVal, QuotKind)
  
  type ConstantInfo
    = AxiomInfo(AxiomVal)
    | DefinitionInfo(DefinitionVal)
    | TheoremInfo(TheoremVal)
    | OpaqueInfo(OpaqueVal)
    | QuotInfo(QuotVal)
    | InductiveInfo(InductiveVal)
    | ConstructorInfo(ConstructorVal)
    | RecursorInfo(RecursorVal)
  
  fn declaration_name(decl: Declaration) -> Name
    = constant_info_name(declaration_to_constant_info(decl))
  
  fn declaration_top_level_names(decl: Declaration) -> List(Name)
    = match decl
        MutualDefinitionDecl(defs) -> definition_names(defs)
        InductiveDecl(_, _, types, _) -> inductive_type_names(types)
        QuotDecl() -> [mk_simple("Quot")]
        _ -> [declaration_name(decl)]
  
  fn declaration_names(decl: Declaration) -> List(Name)
    = match decl
        MutualDefinitionDecl(defs) -> definition_names(defs)
        InductiveDecl(_, _, types, _) -> inductive_decl_names(types)
        QuotDecl() -> quot_names()
        _ -> [declaration_name(decl)]
  
  fn declaration_type(decl: Declaration) -> Expr
    = constant_info_type(declaration_to_constant_info(decl))
  
  fn declaration_is_unsafe(decl: Declaration) -> Bool
    = constant_info_is_unsafe(declaration_to_constant_info(decl))
  
  fn declaration_has_value(decl: Declaration) -> Bool
    = constant_info_has_value(declaration_to_constant_info(decl), true)
  
  fn constant_info_name(info: ConstantInfo) -> Name
    = constant_val_name(constant_info_val(info))
  
  fn constant_info_level_params(info: ConstantInfo) -> List(Name)
    = constant_val_level_params(constant_info_val(info))
  
  fn constant_info_type(info: ConstantInfo) -> Expr
    = constant_val_type(constant_info_val(info))
  
  fn constant_info_is_unsafe(info: ConstantInfo) -> Bool
    = match info
        AxiomInfo(AxiomVal(_, is_unsafe)) -> is_unsafe
        DefinitionInfo(DefinitionVal(_, _, _, safety, _)) -> safety == DefinitionUnsafe()
        OpaqueInfo(OpaqueVal(_, _, is_unsafe, _)) -> is_unsafe
        InductiveInfo(InductiveVal(_, _, _, _, _, _, _, is_unsafe, _)) -> is_unsafe
        ConstructorInfo(ConstructorVal(_, _, _, _, _, is_unsafe)) -> is_unsafe
        RecursorInfo(RecursorVal(_, _, _, _, _, _, _, _, is_unsafe)) -> is_unsafe
        _ -> false
  
  fn constant_info_has_value(info: ConstantInfo, allow_opaque: Bool) -> Bool
    = match constant_info_value_option(info, allow_opaque)
        Some(_) -> true
        None() -> false
  
  fn constant_info_value_option(info: ConstantInfo, allow_opaque: Bool) -> Option(Expr)
    = match info
        DefinitionInfo(DefinitionVal(_, value, _, _, _)) -> Some(value)
        TheoremInfo(TheoremVal(_, value, _)) ->
          pickup
            allow_opaque -> Some(value)
            else -> None()
        OpaqueInfo(OpaqueVal(_, value, _, _)) ->
          pickup
            allow_opaque -> Some(value)
            else -> None()
        _ -> None()
  
  fn constant_info_value(info: ConstantInfo, allow_opaque: Bool) -> Expr
    = match constant_info_value_option(info, allow_opaque)
        Some(value) -> value
        None() -> constant_info_type(info)
  
  fn constant_info_hints(info: ConstantInfo) -> ReducibilityHints
    = match info
        DefinitionInfo(DefinitionVal(_, _, hints, _, _)) -> hints
        _ -> ReducibilityOpaque()
  
  fn constant_info_is_partial(info: ConstantInfo) -> Bool
    = match info
        DefinitionInfo(DefinitionVal(_, _, _, safety, _)) -> safety == DefinitionPartial()
        _ -> false
  
  fn constant_info_all(info: ConstantInfo) -> List(Name)
    = match info
        DefinitionInfo(DefinitionVal(_, _, _, _, all)) -> all
        TheoremInfo(TheoremVal(_, _, all)) -> all
        OpaqueInfo(OpaqueVal(_, _, _, all)) -> all
        _ -> [constant_info_name(info)]
  
  fn declaration_to_constant_info(decl: Declaration) -> ConstantInfo
    = match decl
        AxiomDecl(value) -> AxiomInfo(value)
        DefinitionDecl(value) -> DefinitionInfo(value)
        TheoremDecl(value) -> TheoremInfo(value)
        OpaqueDecl(value) -> OpaqueInfo(value)
        QuotDecl() -> QuotInfo(QuotVal(ConstantVal(mk_simple("Quot"), [], Sort(LevelZero())), QuotType()))
        MutualDefinitionDecl(defs) ->
          match defs
            [definition | _] -> DefinitionInfo(definition)
            [] -> AxiomInfo(AxiomVal(ConstantVal(anonymous(), [], Sort(LevelZero())), false))
        InductiveDecl(level_params, num_params, types, is_unsafe) ->
          match types
            [InductiveType(name, type_expr, _) | _] ->
              InductiveInfo(InductiveVal(ConstantVal(name, level_params, type_expr), num_params, 0, inductive_type_names(types), inductive_constructor_names(types), 0, false, is_unsafe, false))
            [] -> InductiveInfo(InductiveVal(ConstantVal(anonymous(), level_params, Sort(LevelZero())), num_params, 0, [], [], 0, false, is_unsafe, false))
  
  local fn constant_info_val(info: ConstantInfo) -> ConstantVal
    = match info
        AxiomInfo(AxiomVal(value, _)) -> value
        DefinitionInfo(DefinitionVal(value, _, _, _, _)) -> value
        TheoremInfo(TheoremVal(value, _, _)) -> value
        OpaqueInfo(OpaqueVal(value, _, _, _)) -> value
        QuotInfo(QuotVal(value, _)) -> value
        InductiveInfo(InductiveVal(value, _, _, _, _, _, _, _, _)) -> value
        ConstructorInfo(ConstructorVal(value, _, _, _, _, _)) -> value
        RecursorInfo(RecursorVal(value, _, _, _, _, _, _, _, _)) -> value
  
  local fn constant_val_name(value: ConstantVal) -> Name
    = match value
        ConstantVal(name, _, _) -> name
  
  local fn constant_val_level_params(value: ConstantVal) -> List(Name)
    = match value
        ConstantVal(_, level_params, _) -> level_params
  
  local fn constant_val_type(value: ConstantVal) -> Expr
    = match value
        ConstantVal(_, _, type_expr) -> type_expr
  
  local fn definition_names(defs: List(DefinitionVal)) -> List(Name)
    = match defs
        [] -> []
        [DefinitionVal(value, _, _, _, _) | rest] -> [constant_val_name(value) | definition_names(rest)]
  
  local fn inductive_constructor_names(types: List(InductiveType)) -> List(Name)
    = match types
        [] -> []
        [InductiveType(_, _, ctors) | rest] -> Std.List.append(constructor_names(ctors), inductive_constructor_names(rest))
  
  local fn constructor_names(ctors: List(Constructor)) -> List(Name)
    = match ctors
        [] -> []
        [Constructor(name, _) | rest] -> [name | constructor_names(rest)]
  
  local fn inductive_type_names(types: List(InductiveType)) -> List(Name)
    = match types
        [] -> []
        [InductiveType(name, _, _) | rest] -> [name | inductive_type_names(rest)]
  
  local fn inductive_decl_names(types: List(InductiveType)) -> List(Name)
    = match types
        [] -> []
        [InductiveType(name, _, ctors) | rest] ->
          [name | [name_append_core(name, mk_simple("rec")) | Std.List.append(constructor_names(ctors), inductive_decl_names(rest))]]
  
  local fn quot_names() -> List(Name)
    = [mk_simple("Quot"), str(mk_simple("Quot"), "mk"), str(mk_simple("Quot"), "lift"), str(mk_simple("Quot"), "ind")]
