mod Compiler.Kernel.Core.Literal
  use Std.String
  
  ## Lean Expr literal values.
  
  type Literal
    = LitNat(Int)
    | LitString(String)
  
  fn literal_eq(lhs: Literal, rhs: Literal) -> Bool
    = match lhs
        LitNat(lhs_value) ->
          match rhs
            LitNat(rhs_value) -> lhs_value == rhs_value
            _ -> false
        LitString(lhs_value) ->
          match rhs
            LitString(rhs_value) -> lhs_value == rhs_value
            _ -> false
  
  fn literal_to_string(literal: Literal) -> String
    = match literal
        LitNat(value) -> Std.String.from_int(value)
        LitString(value) -> "\"" <> value <> "\""
