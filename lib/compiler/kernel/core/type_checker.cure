mod Compiler.Kernel.Core.TypeChecker
  use Compiler.Kernel.Core.Name
  use Compiler.Kernel.Core.Expr
  use Compiler.Kernel.Core.Level
  use Compiler.Kernel.Core.Declaration
  use Compiler.Kernel.Core.Environment
  use Compiler.Kernel.Core.LocalContext
  use Compiler.Kernel.Core.Exception
  
  type TypeChecker
    = TypeChecker(Environment, LocalContext, DefinitionSafety, List(Name))
  
  type AppPair
    = AppPair(Expr, Expr)
  
  fn mk_type_checker(env: Environment, context: LocalContext, safety: DefinitionSafety) -> TypeChecker
    = TypeChecker(env, context, safety, [])
  
  fn mk_type_checker_with_level_params(env: Environment, context: LocalContext, safety: DefinitionSafety, level_params: List(Name)) -> TypeChecker
    = TypeChecker(env, context, safety, level_params)
  
  fn type_checker_environment(type_checker: TypeChecker) -> Environment
    = match type_checker
        TypeChecker(env, _, _, _) -> env
  
  fn type_checker_with_level_params(type_checker: TypeChecker, level_params: List(Name)) -> TypeChecker
    = match type_checker
        TypeChecker(env, context, safety, _) -> TypeChecker(env, context, safety, level_params)
  
  fn infer(type_checker: TypeChecker, expr: Expr) -> Result(Expr, KernelException)
    = match type_checker
        TypeChecker(env, context, safety, level_params) ->
          match expr
            BVar(_) -> Error(OtherKernelException("unexpected loose bound variable"))
            FVar(_) -> Ok(local_context_get_type(context, expr))
            MVar(_) -> Error(OtherKernelException("unexpected expression metavariable"))
            Sort(level) ->
              match check_level_universe_params(level, level_params)
                Error(error) -> Error(error)
                Ok(_) -> Ok(Sort(LevelSucc(level)))
            Const(name, levels) ->
              match environment_find(env, name)
                Some(info) ->
                  match check_constant_safety(env, info, safety)
                    Error(error) -> Error(error)
                    Ok(_) ->
                      match check_levels_universe_params(levels, level_params)
                        Error(error) -> Error(error)
                        Ok(_) ->
                          pickup
                            Std.List.length(constant_info_level_params(info)) == Std.List.length(levels) ->
                              Ok(expr_instantiate_levels(constant_info_type(info), constant_info_level_params(info), levels))
                            else -> Error(OtherKernelException("incorrect number of universe level parameters"))
                None() -> Error(UnknownConstant(env, name))
            App(fn_expr, arg) ->
              match infer(type_checker, fn_expr)
                Error(error) -> Error(error)
                Ok(fn_type) ->
                  match ensure_pi(type_checker, fn_type, fn_expr)
                    Error(error) -> Error(error)
                    Ok(pi_type) ->
                      match pi_type
                        Pi(_, _, domain, body) ->
                          match infer(type_checker, arg)
                            Error(error) -> Error(error)
                            Ok(arg_type) ->
                              match is_def_eq(type_checker, arg_type, domain)
                                Error(error) -> Error(error)
                                Ok(true) -> Ok(expr_instantiate(body, arg))
                                Ok(false) -> Error(AppTypeMismatch(env, context, fn_expr, domain, arg_type))
                        _ -> Error(FunctionExpected(env, context, fn_expr))
            Lambda(name, binder_info, domain, body) ->
              match ensure_type(type_checker, domain)
                Error(error) -> Error(error)
                Ok(_) ->
                  match infer(type_checker_extend_const(type_checker, name, domain, binder_info), expr_instantiate(body, FVar(name)))
                    Error(error) -> Error(error)
                    Ok(body_type) -> Ok(Pi(name, binder_info, domain, expr_abstract(body_type, name)))
            Pi(name, binder_info, domain, body) ->
              match infer(type_checker, domain)
                Error(error) -> Error(error)
                Ok(domain_type) ->
                  match ensure_sort(type_checker, domain_type, domain)
                    Error(error) -> Error(error)
                    Ok(Sort(domain_level)) ->
                      match infer(type_checker_extend_const(type_checker, name, domain, binder_info), expr_instantiate(body, FVar(name)))
                        Error(error) -> Error(error)
                        Ok(body_type) ->
                          match ensure_sort(type_checker, body_type, body)
                            Error(error) -> Error(error)
                            Ok(Sort(body_level)) -> Ok(Sort(mk_imax(domain_level, body_level)))
                            Ok(_) -> Error(TypeExpected(env, context, body))
                    Ok(_) -> Error(TypeExpected(env, context, domain))
            Let(name, type_expr, value, body, _) ->
              match ensure_type(type_checker, type_expr)
                Error(error) -> Error(error)
                Ok(_) ->
                  match infer(type_checker, value)
                    Error(error) -> Error(error)
                    Ok(value_type) ->
                      match is_def_eq(type_checker, value_type, type_expr)
                        Error(error) -> Error(error)
                        Ok(true) -> infer(type_checker, expr_instantiate(body, value))
                        Ok(false) -> Error(LetTypeMismatch(env, context, name, type_expr, value_type))
            Lit(lit) -> infer_literal(env, lit)
            MData(_, inner) -> infer(type_checker, inner)
            Proj(struct_name, index, inner) -> infer_projection(type_checker, struct_name, index, inner)
  
  fn check(type_checker: TypeChecker, expr: Expr, level_params: List(Name)) -> Result(Expr, KernelException)
    = match check_expr_universe_params(expr, level_params)
        Error(error) -> Error(error)
        Ok(_) -> check_ignore_undefined_universes(type_checker_with_level_params(type_checker, level_params), expr)
  
  fn check_ignore_undefined_universes(type_checker: TypeChecker, expr: Expr) -> Result(Expr, KernelException)
    = infer(type_checker, expr)
  
  fn is_def_eq(type_checker: TypeChecker, lhs: Expr, rhs: Expr) -> Result(Bool, KernelException)
    = match whnf(type_checker, lhs)
        Error(error) -> Error(error)
        Ok(lhs_whnf) ->
          match whnf(type_checker, rhs)
            Error(error) -> Error(error)
            Ok(rhs_whnf) ->
              match expr_def_eq(type_checker, lhs_whnf, rhs_whnf)
                Error(error) -> Error(error)
                Ok(true) -> Ok(true)
                Ok(false) -> expr_def_eq_fallback(type_checker, lhs_whnf, rhs_whnf)
  
  fn is_prop(type_checker: TypeChecker, expr: Expr) -> Result(Bool, KernelException)
    = match infer(type_checker, expr)
        Error(error) -> Error(error)
        Ok(type_expr) ->
          match whnf(type_checker, type_expr)
            Error(error) -> Error(error)
            Ok(Sort(level)) -> Ok(level_eq(level, LevelZero()))
            Ok(_) -> Ok(false)
  
  fn whnf(type_checker: TypeChecker, expr: Expr) -> Result(Expr, KernelException)
    = whnf_core(type_checker, expr, false, false)
  
  fn whnf_core(type_checker: TypeChecker, expr: Expr, cheap_rec: Bool, cheap_proj: Bool) -> Result(Expr, KernelException)
    = match expr
        MData(_, inner) -> whnf_core(type_checker, inner, cheap_rec, cheap_proj)
        Let(_, _, value, body, _) -> whnf_core(type_checker, expr_instantiate(body, value), cheap_rec, cheap_proj)
        App(_, _) -> whnf_app(type_checker, expr, cheap_rec, cheap_proj)
        Const(_, _) ->
          match unfold_definition(type_checker, expr)
            Error(error) -> Error(error)
            Ok(Some(value)) -> whnf_core(type_checker, value, cheap_rec, cheap_proj)
            Ok(None()) -> Ok(expr)
        Proj(_, _, _) -> whnf_projection(type_checker, expr, cheap_rec, cheap_proj)
        _ -> Ok(expr)
  
  fn ensure_pi(type_checker: TypeChecker, expr: Expr, source: Expr) -> Result(Expr, KernelException)
    = match type_checker
        TypeChecker(env, context, _, _) ->
          match whnf(type_checker, expr)
            Error(error) -> Error(error)
            Ok(whnf_expr) ->
              match whnf_expr
                Pi(_, _, _, _) -> Ok(whnf_expr)
                _ -> Error(FunctionExpected(env, context, source))
  
  fn ensure_sort(type_checker: TypeChecker, expr: Expr, source: Expr) -> Result(Expr, KernelException)
    = match type_checker
        TypeChecker(env, context, _, _) ->
          match whnf(type_checker, expr)
            Error(error) -> Error(error)
            Ok(whnf_expr) ->
              match whnf_expr
                Sort(_) -> Ok(whnf_expr)
                _ -> Error(TypeExpected(env, context, source))
  
  fn ensure_fun(type_checker: TypeChecker, expr: Expr) -> Result(Expr, KernelException)
    = ensure_pi(type_checker, expr, expr)
  
  fn ensure_type(type_checker: TypeChecker, expr: Expr) -> Result(Expr, KernelException)
    = match infer(type_checker, expr)
        Error(error) -> Error(error)
        Ok(type_expr) -> ensure_sort(type_checker, type_expr, expr)
  
  fn eta_expand(type_checker: TypeChecker, expr: Expr) -> Result(Expr, KernelException)
    = match infer(type_checker, expr)
        Error(_) -> Ok(expr)
        Ok(expr_type) ->
          match whnf(type_checker, expr_type)
            Error(_) -> Ok(expr)
            Ok(type_whnf) ->
              match expand_structure_eta_by_type(type_checker, type_whnf, expr)
                Some(expanded) -> Ok(expanded)
                None() -> Ok(expr)
  
  fn unfold_definition(type_checker: TypeChecker, expr: Expr) -> Result(Option(Expr), KernelException)
    = match type_checker
        TypeChecker(env, _, _, _) ->
          match expr
            Const(name, levels) ->
              match environment_find(env, name)
                Some(info) ->
                  match constant_info_value_option(info, false)
                    Some(value) ->
                      pickup
                        Std.List.length(constant_info_level_params(info)) == Std.List.length(levels) ->
                          Ok(Some(expr_instantiate_levels(value, constant_info_level_params(info), levels)))
                        else -> Error(OtherKernelException("incorrect number of universe level parameters"))
                    None() -> Ok(None())
                None() -> Error(UnknownConstant(env, name))
            App(_, _) -> unfold_app_definition(type_checker, expr)
            _ -> Ok(None())
  
  local fn infer_literal(env: Environment, lit: Literal) -> Result(Expr, KernelException)
    = match lit
        LitNat(_) -> infer_named_literal(env, mk_simple("Nat"))
        LitString(_) -> infer_named_literal(env, mk_simple("String"))
  
  local fn infer_named_literal(env: Environment, name: Name) -> Result(Expr, KernelException)
    = match environment_find(env, name)
        Some(_) -> Ok(Const(name, []))
        None() -> Error(UnknownConstant(env, name))
  
  local fn whnf_app(type_checker: TypeChecker, expr: Expr, cheap_rec: Bool, cheap_proj: Bool) -> Result(Expr, KernelException)
    = match app_fn_arg(expr)
        Some(AppPair(fn_expr, arg)) ->
          match whnf_core(type_checker, fn_expr, cheap_rec, cheap_proj)
            Error(error) -> Error(error)
            Ok(Lambda(_, _, _, body)) -> whnf_core(type_checker, expr_instantiate(body, arg), cheap_rec, cheap_proj)
            Ok(fn_whnf) ->
              let rebuilt = App(fn_whnf, arg)
              match nat_reduce(type_checker, rebuilt)
                Error(error) -> Error(error)
                Ok(Some(value)) -> whnf_core(type_checker, value, cheap_rec, cheap_proj)
                Ok(None()) ->
                  match quot_reduce(type_checker, rebuilt, cheap_rec, cheap_proj)
                    Error(error) -> Error(error)
                    Ok(Some(value)) -> whnf_core(type_checker, value, cheap_rec, cheap_proj)
                    Ok(None()) ->
                      match recursor_reduce(type_checker, rebuilt, cheap_rec, cheap_proj)
                        Error(error) -> Error(error)
                        Ok(Some(value)) -> whnf_core(type_checker, value, cheap_rec, cheap_proj)
                        Ok(None()) ->
                          match unfold_definition(type_checker, rebuilt)
                            Error(error) -> Error(error)
                            Ok(Some(value)) -> whnf_core(type_checker, value, cheap_rec, cheap_proj)
                            Ok(None()) -> Ok(rebuilt)
        None() -> Ok(expr)
  
  local fn whnf_projection(type_checker: TypeChecker, expr: Expr, cheap_rec: Bool, cheap_proj: Bool) -> Result(Expr, KernelException)
    = match expr
        Proj(struct_name, index, inner) ->
          match whnf_core(type_checker, inner, cheap_rec, cheap_proj)
            Error(error) -> Error(error)
            Ok(inner_whnf) ->
              match reduce_projection(type_checker, index, inner_whnf)
                Some(value) -> whnf_core(type_checker, value, cheap_rec, cheap_proj)
                None() -> Ok(Proj(struct_name, index, inner_whnf))
        _ -> Ok(expr)
  
  local fn unfold_app_definition(type_checker: TypeChecker, expr: Expr) -> Result(Option(Expr), KernelException)
    = match unfold_definition(type_checker, app_head(expr))
        Error(error) -> Error(error)
        Ok(Some(value)) -> Ok(Some(mk_apps(value, app_args(expr))))
        Ok(None()) -> Ok(None())
  
  local fn quot_reduce(type_checker: TypeChecker, expr: Expr, cheap_rec: Bool, cheap_proj: Bool) -> Result(Option(Expr), KernelException)
    = match type_checker
        TypeChecker(env, _, _, _) ->
          pickup
            environment_is_quot_initialized(env) -> quot_reduce_initialized(type_checker, expr, cheap_rec, cheap_proj)
            else -> Ok(None())
  
  local fn quot_reduce_initialized(type_checker: TypeChecker, expr: Expr, cheap_rec: Bool, cheap_proj: Bool) -> Result(Option(Expr), KernelException)
    = match app_head(expr)
        Const(name, _) ->
          pickup
            name_eq(name, str(mk_simple("Quot"), "lift")) -> quot_reduce_core(type_checker, expr, 5, 3, cheap_rec, cheap_proj)
            name_eq(name, str(mk_simple("Quot"), "ind")) -> quot_reduce_core(type_checker, expr, 4, 3, cheap_rec, cheap_proj)
            else -> Ok(None())
        _ -> Ok(None())
  
  local fn quot_reduce_core(type_checker: TypeChecker, expr: Expr, mk_pos: Int, arg_pos: Int, cheap_rec: Bool, cheap_proj: Bool) -> Result(Option(Expr), KernelException)
    = match expr_arg_at(expr, mk_pos)
        Some(mk_expr) ->
          match whnf_core(type_checker, mk_expr, cheap_rec, cheap_proj)
            Error(error) -> Error(error)
            Ok(mk_whnf) ->
              pickup
                expr_is_app_of(mk_whnf, str(mk_simple("Quot"), "mk"), 3) ->
                  match expr_arg_at(mk_whnf, 2)
                    Some(quot_value) ->
                      match expr_arg_at(expr, arg_pos)
                        Some(fn_expr) -> Ok(Some(mk_apps(App(fn_expr, quot_value), drop_args(app_args(expr), mk_pos + 1))))
                        None() -> Ok(None())
                    None() -> Ok(None())
                else -> Ok(None())
        None() -> Ok(None())
  
  local fn reduce_projection(type_checker: TypeChecker, index: Int, struct_expr: Expr) -> Option(Expr)
    = match type_checker
        TypeChecker(env, _, _, _) ->
          match app_head(struct_expr)
            Const(name, _) ->
              match environment_find(env, name)
                Some(ConstructorInfo(ConstructorVal(_, _, _, num_params, _, _))) ->
                  expr_arg_at(struct_expr, num_params + index)
                _ -> None()
            _ -> None()
  
  local fn recursor_reduce(type_checker: TypeChecker, expr: Expr, cheap_rec: Bool, cheap_proj: Bool) -> Result(Option(Expr), KernelException)
    = match type_checker
        TypeChecker(env, _, _, _) ->
          match app_head(expr)
            Const(name, levels) ->
              match environment_find(env, name)
                Some(RecursorInfo(value)) -> recursor_reduce_value(type_checker, expr, levels, value, cheap_rec, cheap_proj)
                _ -> Ok(None())
            _ -> Ok(None())
  
  local fn recursor_reduce_value(type_checker: TypeChecker, expr: Expr, levels: List(Level), value: RecursorVal, cheap_rec: Bool, cheap_proj: Bool) -> Result(Option(Expr), KernelException)
    = match value
        RecursorVal(ConstantVal(_, level_params, _), _, num_params, num_indices, num_motives, num_minors, rules, _, _) ->
          let major_index = num_params + num_motives + num_minors + num_indices
          match expr_arg_at(expr, major_index)
            Some(major) ->
              match recursor_major_for_reduction(type_checker, value, major, cheap_rec, cheap_proj)
                Error(error) -> Error(error)
                Ok(normalized_major) ->
                  match recursor_rule_for(rules, normalized_major)
                    Some(RecursorRule(_, nfields, rhs)) ->
                      pickup
                        Std.List.length(level_params) == Std.List.length(levels) ->
                          let rec_args = app_args(expr)
                          let major_args = app_args(normalized_major)
                          let instantiated_rhs = expr_instantiate_levels(rhs, level_params, levels)
                          let with_params_indices = mk_apps(instantiated_rhs, take_args(rec_args, major_index - num_indices))
                          let with_fields = mk_apps(with_params_indices, drop_args(major_args, Std.List.length(major_args) - nfields))
                          Ok(Some(mk_apps(with_fields, drop_args(rec_args, major_index + 1))))
                        else -> Ok(None())
                    None() -> Ok(None())
            None() -> Ok(None())
  
  local fn recursor_major_for_reduction(type_checker: TypeChecker, value: RecursorVal, major: Expr, cheap_rec: Bool, cheap_proj: Bool) -> Result(Expr, KernelException)
    = match recursor_major_when_k(type_checker, value, major)
        Error(error) -> Error(error)
        Ok(k_major) ->
          match whnf_core(type_checker, k_major, cheap_rec, cheap_proj)
            Error(error) -> Error(error)
            Ok(major_whnf) ->
              let normalized_major = normalize_major_constructor(major_whnf)
              Ok(recursor_major_when_structure(type_checker, value, normalized_major))
  
  local fn recursor_major_when_k(type_checker: TypeChecker, value: RecursorVal, major: Expr) -> Result(Expr, KernelException)
    = match value
        RecursorVal(_, _, num_params, _, _, _, _, k, _) ->
          pickup
            k -> recursor_major_to_nullary_ctor(type_checker, value, major, num_params)
            else -> Ok(major)
  
  local fn recursor_major_to_nullary_ctor(type_checker: TypeChecker, value: RecursorVal, major: Expr, num_params: Int) -> Result(Expr, KernelException)
    = match infer(type_checker, major)
        Error(error) -> Error(error)
        Ok(major_type) ->
          match whnf(type_checker, major_type)
            Error(error) -> Error(error)
            Ok(major_type_whnf) ->
              match app_head(major_type_whnf)
                Const(type_name, _) ->
                  match recursor_major_induct(value)
                    Some(major_induct) ->
                      pickup
                        name_eq(type_name, major_induct) ->
                          pickup
                            exprs_have_mvar(drop_args(app_args(major_type_whnf), num_params)) -> Ok(major)
                            else -> recursor_major_to_nullary_ctor_checked(type_checker, major, major_type_whnf, num_params)
                        else -> Ok(major)
                    None() -> Ok(major)
                _ -> Ok(major)
  
  local fn recursor_major_to_nullary_ctor_checked(type_checker: TypeChecker, major: Expr, major_type: Expr, num_params: Int) -> Result(Expr, KernelException)
    = match mk_nullary_ctor(type_checker, major_type, num_params)
        Some(ctor_expr) ->
          match infer(type_checker, ctor_expr)
            Error(_) -> Ok(major)
            Ok(ctor_type) ->
              match is_def_eq(type_checker, major_type, ctor_type)
                Error(_) -> Ok(major)
                Ok(true) -> Ok(ctor_expr)
                Ok(false) -> Ok(major)
        None() -> Ok(major)
  
  local fn mk_nullary_ctor(type_checker: TypeChecker, type_expr: Expr, num_params: Int) -> Option(Expr)
    = match type_checker
        TypeChecker(env, _, _, _) ->
          match app_head(type_expr)
            Const(type_name, levels) ->
              match environment_find(env, type_name)
                Some(InductiveInfo(InductiveVal(_, _, _, _, ctors, _, _, _, _))) ->
                  match ctors
                    [ctor_name | _] -> Some(mk_apps(Const(ctor_name, levels), take_args(app_args(type_expr), num_params)))
                    [] -> None()
                _ -> None()
            _ -> None()
  
  local fn recursor_major_when_structure(type_checker: TypeChecker, value: RecursorVal, major: Expr) -> Expr
    = pickup
        expr_is_constructor_app(type_checker, major) -> major
        else ->
          match recursor_major_induct(value)
            Some(induct_name) ->
              match infer(type_checker, major)
                Error(_) -> major
                Ok(major_type) ->
                  match whnf(type_checker, major_type)
                    Error(_) -> major
                    Ok(major_type_whnf) ->
                      match app_head(major_type_whnf)
                        Const(type_name, _) ->
                          pickup
                            name_eq(type_name, induct_name) ->
                              match expand_structure_eta_by_type(type_checker, major_type_whnf, major)
                                Some(expanded) -> expanded
                                None() -> major
                            else -> major
                        _ -> major
            None() -> major
  
  local fn recursor_major_induct(value: RecursorVal) -> Option(Name)
    = match value
        RecursorVal(ConstantVal(rec_name, _, _), all, _, _, _, _, _, _, _) -> recursor_major_induct_named(rec_name, all)
  
  local fn recursor_major_induct_named(rec_name: Name, names: List(Name)) -> Option(Name)
    = match names
        [] -> None()
        [name | rest] ->
          pickup
            name_eq(name_append_core(name, mk_simple("rec")), rec_name) -> Some(name)
            else -> recursor_major_induct_named(rec_name, rest)
  
  local fn expr_is_constructor_app(type_checker: TypeChecker, expr: Expr) -> Bool
    = match type_checker
        TypeChecker(env, _, _, _) ->
          match app_head(expr)
            Const(name, _) ->
              match environment_find(env, name)
                Some(ConstructorInfo(_)) -> true
                _ -> false
            _ -> false
  
  local fn exprs_have_mvar(exprs: List(Expr)) -> Bool
    = match exprs
        [] -> false
        [expr | rest] ->
          pickup
            expr_has_mvar(expr) -> true
            else -> exprs_have_mvar(rest)
  
  local fn normalize_major_constructor(expr: Expr) -> Expr
    = match expr
        Lit(LitNat(value)) -> nat_literal_constructor(value)
        _ -> expr
  
  local fn nat_literal_constructor(value: Int) -> Expr
    = pickup
        value <= 0 -> Const(str(mk_simple("Nat"), "zero"), [])
        else -> App(Const(str(mk_simple("Nat"), "succ"), []), nat_literal_constructor(value - 1))
  
  local fn recursor_rule_for(rules: List(RecursorRule), major: Expr) -> Option(RecursorRule)
    = match app_head(major)
        Const(ctor_name, _) -> recursor_rule_named(rules, ctor_name)
        _ -> None()
  
  local fn recursor_rule_named(rules: List(RecursorRule), ctor_name: Name) -> Option(RecursorRule)
    = match rules
        [] -> None()
        [rule | rest] ->
          match rule
            RecursorRule(name, _, _) ->
              pickup
                name_eq(name, ctor_name) -> Some(rule)
                else -> recursor_rule_named(rest, ctor_name)
  
  local fn nat_reduce(type_checker: TypeChecker, expr: Expr) -> Result(Option(Expr), KernelException)
    = match type_checker
        TypeChecker(_, _, _, _) ->
          match app_head(expr)
            Const(name, _) ->
              pickup
                name_eq(name, str(mk_simple("Nat"), "succ")) -> reduce_nat_succ(expr)
                name_eq(name, str(mk_simple("Nat"), "pred")) -> reduce_nat_pred(expr)
                name_eq(name, str(mk_simple("Nat"), "add")) -> reduce_nat_bin(expr, :add)
                name_eq(name, str(mk_simple("Nat"), "sub")) -> reduce_nat_bin(expr, :sub)
                name_eq(name, str(mk_simple("Nat"), "mul")) -> reduce_nat_bin(expr, :mul)
                name_eq(name, str(mk_simple("Nat"), "beq")) -> reduce_nat_predicate(expr, :beq)
                name_eq(name, str(mk_simple("Nat"), "ble")) -> reduce_nat_predicate(expr, :ble)
                else -> Ok(None())
            _ -> Ok(None())
  
  local fn reduce_nat_succ(expr: Expr) -> Result(Option(Expr), KernelException)
    = match expr_arg_at(expr, 0)
        Some(Lit(LitNat(value))) ->
          pickup
            Std.List.length(app_args(expr)) == 1 -> Ok(Some(Lit(LitNat(value + 1))))
            else -> Ok(None())
        _ -> Ok(None())
  
  local fn reduce_nat_pred(expr: Expr) -> Result(Option(Expr), KernelException)
    = match expr_arg_at(expr, 0)
        Some(Lit(LitNat(value))) ->
          pickup
            Std.List.length(app_args(expr)) == 1 -> Ok(Some(Lit(LitNat(nat_sub(value, 1)))))
            else -> Ok(None())
        _ -> Ok(None())
  
  local fn reduce_nat_bin(expr: Expr, op: Atom) -> Result(Option(Expr), KernelException)
    = match expr_arg_at(expr, 0)
        Some(Lit(LitNat(lhs))) ->
          match expr_arg_at(expr, 1)
            Some(Lit(LitNat(rhs))) ->
              pickup
                Std.List.length(app_args(expr)) == 2 -> Ok(Some(Lit(LitNat(apply_nat_bin(op, lhs, rhs)))))
                else -> Ok(None())
            _ -> Ok(None())
        _ -> Ok(None())
  
  local fn reduce_nat_predicate(expr: Expr, op: Atom) -> Result(Option(Expr), KernelException)
    = match expr_arg_at(expr, 0)
        Some(Lit(LitNat(lhs))) ->
          match expr_arg_at(expr, 1)
            Some(Lit(LitNat(rhs))) ->
              pickup
                Std.List.length(app_args(expr)) == 2 -> Ok(Some(bool_expr(apply_nat_predicate(op, lhs, rhs))))
                else -> Ok(None())
            _ -> Ok(None())
        _ -> Ok(None())
  
  local fn apply_nat_bin(op: Atom, lhs: Int, rhs: Int) -> Int
    = pickup
        op == :add -> lhs + rhs
        op == :sub -> nat_sub(lhs, rhs)
        op == :mul -> lhs * rhs
        else -> lhs
  
  local fn nat_sub(lhs: Int, rhs: Int) -> Int
    = pickup
        lhs >= rhs -> lhs - rhs
        else -> 0
  
  local fn apply_nat_predicate(op: Atom, lhs: Int, rhs: Int) -> Bool
    = pickup
        op == :beq -> lhs == rhs
        op == :ble -> lhs <= rhs
        else -> false
  
  local fn bool_expr(value: Bool) -> Expr
    = pickup
        value -> Const(str(mk_simple("Bool"), "true"), [])
        else -> Const(str(mk_simple("Bool"), "false"), [])
  
  local fn check_constant_safety(env: Environment, info: ConstantInfo, safety: DefinitionSafety) -> Result(Atom, KernelException)
    = pickup
        constant_info_is_unsafe(info) ->
          pickup
            safety == DefinitionUnsafe() -> Ok(:ok)
            else -> Error(OtherKernelException("invalid declaration, it uses an unsafe declaration"))
        constant_info_is_partial(info) ->
          pickup
            safety == DefinitionSafe() -> Error(OtherKernelException("invalid declaration, safe declaration uses partial declaration"))
            else -> Ok(:ok)
        else -> Ok(:ok)
  
  local fn infer_projection(type_checker: TypeChecker, struct_name: Name, index: Int, inner: Expr) -> Result(Expr, KernelException)
    = match infer(type_checker, inner)
        Error(error) -> Error(error)
        Ok(inner_type) ->
          match whnf(type_checker, inner_type)
            Error(error) -> Error(error)
            Ok(type_whnf) ->
              match projection_field_type(type_checker, struct_name, index, inner, type_whnf)
                Some(field_type) -> Ok(field_type)
                None() -> Error(InvalidProj(type_checker_environment(type_checker), empty_local_context(), inner))
  
  local fn projection_field_type(type_checker: TypeChecker, struct_name: Name, index: Int, inner: Expr, type_whnf: Expr) -> Option(Expr)
    = match type_checker
        TypeChecker(env, _, _, _) ->
          match app_head(type_whnf)
            Const(type_name, levels) ->
              pickup
                name_eq(type_name, struct_name) ->
                  match environment_find(env, struct_name)
                    Some(InductiveInfo(InductiveVal(_, _, _, _, ctors, _, _, _, _))) ->
                      match ctors
                        [ctor_name] ->
                          match environment_find(env, ctor_name)
                            Some(ConstructorInfo(ConstructorVal(ConstantVal(_, level_params, ctor_type), _, _, num_params, _, _))) ->
                              let ctor_type_with_levels = expr_instantiate_levels(ctor_type, level_params, levels)
                              match skip_constructor_params(ctor_type_with_levels, app_args(type_whnf), num_params)
                                Some(field_types) -> projection_field_from_constructor(field_types, struct_name, index, inner, 0)
                                None() -> None()
                            _ -> None()
                        _ -> None()
                    _ -> None()
                else -> None()
            _ -> None()
  
  local fn skip_constructor_params(type_expr: Expr, args: List(Expr), count: Int) -> Option(Expr)
    = pickup
        count <= 0 -> Some(type_expr)
        else ->
          match type_expr
            Pi(_, _, _, body) ->
              match args
                [arg | rest] -> skip_constructor_params(expr_instantiate(body, arg), rest, count - 1)
                [] -> None()
            _ -> None()
  
  local fn projection_field_from_constructor(type_expr: Expr, struct_name: Name, target: Int, inner: Expr, index: Int) -> Option(Expr)
    = match type_expr
        Pi(_, _, domain, body) ->
          pickup
            index == target -> Some(domain)
            else -> projection_field_from_constructor(expr_instantiate(body, Proj(struct_name, index, inner)), struct_name, target, inner, index + 1)
        _ -> None()
  
  local fn app_head(expr: Expr) -> Expr
    = match expr
        App(fn_expr, _) -> app_head(fn_expr)
        _ -> expr
  
  local fn app_fn_arg(expr: Expr) -> Option(AppPair)
    = match expr
        App(fn_expr, arg) -> Some(AppPair(fn_expr, arg))
        _ -> None()
  
  local fn app_args(expr: Expr) -> List(Expr)
    = match expr
        App(fn_expr, arg) -> Std.List.append(app_args(fn_expr), [arg])
        _ -> []
  
  local fn mk_apps(fn_expr: Expr, args: List(Expr)) -> Expr
    = match args
        [] -> fn_expr
        [arg | rest] -> mk_apps(App(fn_expr, arg), rest)
  
  local fn expr_arg_at(expr: Expr, index: Int) -> Option(Expr)
    = arg_at(app_args(expr), index)
  
  local fn arg_at(args: List(Expr), index: Int) -> Option(Expr)
    = match args
        [] -> None()
        [arg | rest] ->
          pickup
            index == 0 -> Some(arg)
            else -> arg_at(rest, index - 1)
  
  local fn drop_args(args: List(Expr), count: Int) -> List(Expr)
    = match args
        [] -> []
        [_ | rest] ->
          pickup
            count <= 0 -> args
            else -> drop_args(rest, count - 1)
  
  local fn take_args(args: List(Expr), count: Int) -> List(Expr)
    = match args
        [] -> []
        [arg | rest] ->
          pickup
            count <= 0 -> []
            else -> [arg | take_args(rest, count - 1)]
  
  local fn expr_is_app_of(expr: Expr, name: Name, arity: Int) -> Bool
    = match app_head(expr)
        Const(head_name, _) ->
          pickup
            name_eq(head_name, name) -> Std.List.length(app_args(expr)) == arity
            else -> false
        _ -> false
  
  local fn type_checker_extend_const(type_checker: TypeChecker, name: Name, type_expr: Expr, binder_info: BinderInfo) -> TypeChecker
    = match type_checker
        TypeChecker(env, context, safety, level_params) ->
          TypeChecker(env, local_context_cons(context, mk_local_const_decl(context, name, name, type_expr, binder_info)), safety, level_params)
  
  local fn local_context_cons(context: LocalContext, decl: LocalDecl) -> LocalContext
    = match context
        LocalContext(decls) -> LocalContext([decl | decls])
  
  local fn expr_eq_or_level_eq(lhs: Expr, rhs: Expr) -> Bool
    = match lhs
        Sort(lhs_level) ->
          match rhs
            Sort(rhs_level) -> level_is_equivalent(lhs_level, rhs_level)
            _ -> false
        _ -> expr_eq(lhs, rhs)
  
  local fn expr_def_eq(type_checker: TypeChecker, lhs: Expr, rhs: Expr) -> Result(Bool, KernelException)
    = match lhs
        Sort(lhs_level) ->
          match rhs
            Sort(rhs_level) -> Ok(level_is_equivalent(lhs_level, rhs_level))
            _ -> Ok(false)
        Const(lhs_name, lhs_levels) ->
          match rhs
            Const(rhs_name, rhs_levels) ->
              pickup
                name_eq(lhs_name, rhs_name) -> Ok(levels_def_eq(lhs_levels, rhs_levels))
                else -> Ok(false)
            _ -> Ok(false)
        App(lhs_fn, lhs_arg) ->
          match rhs
            App(rhs_fn, rhs_arg) ->
              match is_def_eq(type_checker, lhs_fn, rhs_fn)
                Error(error) -> Error(error)
                Ok(true) -> is_def_eq(type_checker, lhs_arg, rhs_arg)
                Ok(false) -> Ok(false)
            _ -> Ok(false)
        Lambda(lhs_name, lhs_binder, lhs_domain, lhs_body) ->
          match rhs
            Lambda(rhs_name, rhs_binder, rhs_domain, rhs_body) ->
              binding_def_eq(type_checker, lhs_name, lhs_binder, lhs_domain, lhs_body, rhs_name, rhs_binder, rhs_domain, rhs_body)
            _ -> Ok(false)
        Pi(lhs_name, lhs_binder, lhs_domain, lhs_body) ->
          match rhs
            Pi(rhs_name, rhs_binder, rhs_domain, rhs_body) ->
              binding_def_eq(type_checker, lhs_name, lhs_binder, lhs_domain, lhs_body, rhs_name, rhs_binder, rhs_domain, rhs_body)
            _ -> Ok(false)
        Let(_, _, lhs_value, lhs_body, _) -> is_def_eq(type_checker, expr_instantiate(lhs_body, lhs_value), rhs)
        MData(_, lhs_inner) -> is_def_eq(type_checker, lhs_inner, rhs)
        Proj(lhs_struct, lhs_index, lhs_inner) ->
          match rhs
            Proj(rhs_struct, rhs_index, rhs_inner) ->
              pickup
                name_eq(lhs_struct, rhs_struct) ->
                  pickup
                    lhs_index == rhs_index -> is_def_eq(type_checker, lhs_inner, rhs_inner)
                    else -> Ok(false)
                else -> Ok(false)
            _ -> Ok(false)
        _ -> Ok(expr_eq_or_level_eq(lhs, rhs))
  
  local fn expr_def_eq_fallback(type_checker: TypeChecker, lhs: Expr, rhs: Expr) -> Result(Bool, KernelException)
    = match try_proof_irrelevance(type_checker, lhs, rhs)
        Error(error) -> Error(error)
        Ok(true) -> Ok(true)
        Ok(false) ->
          match try_eta_expansion(type_checker, lhs, rhs)
            Error(error) -> Error(error)
            Ok(true) -> Ok(true)
            Ok(false) -> try_structure_eta(type_checker, lhs, rhs)
  
  local fn try_proof_irrelevance(type_checker: TypeChecker, lhs: Expr, rhs: Expr) -> Result(Bool, KernelException)
    = match infer(type_checker, lhs)
        Error(_) -> Ok(false)
        Ok(lhs_type) ->
          match is_prop(type_checker, lhs_type)
            Error(_) -> Ok(false)
            Ok(false) -> Ok(false)
            Ok(true) ->
              match infer(type_checker, rhs)
                Error(_) -> Ok(false)
                Ok(rhs_type) -> is_def_eq(type_checker, lhs_type, rhs_type)
  
  local fn try_eta_expansion(type_checker: TypeChecker, lhs: Expr, rhs: Expr) -> Result(Bool, KernelException)
    = match lhs
        Lambda(_, _, _, _) ->
          match rhs
            Lambda(_, _, _, _) -> Ok(false)
            _ -> try_eta_expand_rhs(type_checker, lhs, rhs)
        _ ->
          match rhs
            Lambda(_, _, _, _) -> try_eta_expand_rhs(type_checker, rhs, lhs)
            _ -> Ok(false)
  
  local fn try_eta_expand_rhs(type_checker: TypeChecker, lambda_expr: Expr, fn_expr: Expr) -> Result(Bool, KernelException)
    = match infer(type_checker, fn_expr)
        Error(_) -> Ok(false)
        Ok(fn_type) ->
          match whnf(type_checker, fn_type)
            Error(_) -> Ok(false)
            Ok(Pi(name, binder_info, domain, _)) ->
              is_def_eq(type_checker, lambda_expr, Lambda(name, binder_info, domain, App(fn_expr, BVar(0))))
            Ok(_) -> Ok(false)
  
  local fn try_structure_eta(type_checker: TypeChecker, lhs: Expr, rhs: Expr) -> Result(Bool, KernelException)
    = match structure_ctor_info(type_checker, rhs)
        Some(ConstructorVal(_, induct_name, _, num_params, num_fields, _)) ->
          match expand_structure_eta(type_checker, induct_name, num_params, num_fields, lhs)
            Some(expanded_lhs) -> is_def_eq(type_checker, expanded_lhs, rhs)
            None() -> Ok(false)
        None() ->
          match structure_ctor_info(type_checker, lhs)
            Some(ConstructorVal(_, induct_name, _, num_params, num_fields, _)) ->
              match expand_structure_eta(type_checker, induct_name, num_params, num_fields, rhs)
                Some(expanded_rhs) -> is_def_eq(type_checker, lhs, expanded_rhs)
                None() -> Ok(false)
            None() -> Ok(false)
  
  local fn structure_ctor_info(type_checker: TypeChecker, expr: Expr) -> Option(ConstructorVal)
    = match type_checker
        TypeChecker(env, _, _, _) ->
          match app_head(expr)
            Const(name, _) ->
              match environment_find(env, name)
                Some(ConstructorInfo(info)) ->
                  match info
                    ConstructorVal(_, induct_name, _, _, _, _) ->
                      pickup
                        environment_is_structure_like(env, induct_name) -> Some(info)
                        else -> None()
                _ -> None()
            _ -> None()
  
  local fn expand_structure_eta(type_checker: TypeChecker, induct_name: Name, num_params: Int, num_fields: Int, expr: Expr) -> Option(Expr)
    = match infer(type_checker, expr)
        Error(_) -> None()
        Ok(expr_type) ->
          match whnf(type_checker, expr_type)
            Error(_) -> None()
            Ok(type_whnf) -> expand_structure_eta_by_type_with_shape(type_checker, type_whnf, expr, induct_name, num_params, num_fields)
  
  local fn expand_structure_eta_by_type(type_checker: TypeChecker, type_whnf: Expr, expr: Expr) -> Option(Expr)
    = match app_head(type_whnf)
        Const(induct_name, _) ->
          match first_constructor_info(type_checker, induct_name)
            Some(ConstructorVal(_, _, _, num_params, num_fields, _)) ->
              expand_structure_eta_by_type_with_shape(type_checker, type_whnf, expr, induct_name, num_params, num_fields)
            None() -> None()
        _ -> None()
  
  local fn expand_structure_eta_by_type_with_shape(type_checker: TypeChecker, type_whnf: Expr, expr: Expr, induct_name: Name, num_params: Int, num_fields: Int) -> Option(Expr)
    = match app_head(type_whnf)
        Const(type_name, levels) ->
          pickup
            name_eq(type_name, induct_name) ->
              match first_constructor_name(type_checker, induct_name)
                Some(ctor_name) ->
                  let ctor = mk_apps(Const(ctor_name, levels), take_args(app_args(type_whnf), num_params))
                  Some(add_structure_projections(ctor, induct_name, expr, 0, num_fields))
                None() -> None()
            else -> None()
        _ -> None()
  
  local fn first_constructor_name(type_checker: TypeChecker, induct_name: Name) -> Option(Name)
    = match type_checker
        TypeChecker(env, _, _, _) ->
          match environment_find(env, induct_name)
            Some(InductiveInfo(InductiveVal(_, _, _, _, ctors, _, _, _, _))) ->
              match ctors
                [ctor | _] -> Some(ctor)
                [] -> None()
            _ -> None()
  
  local fn first_constructor_info(type_checker: TypeChecker, induct_name: Name) -> Option(ConstructorVal)
    = match type_checker
        TypeChecker(env, _, _, _) ->
          match first_constructor_name(type_checker, induct_name)
            Some(ctor_name) ->
              match environment_find(env, ctor_name)
                Some(ConstructorInfo(info)) ->
                  pickup
                    environment_is_structure_like(env, induct_name) -> Some(info)
                    else -> None()
                _ -> None()
            None() -> None()
  
  local fn add_structure_projections(ctor: Expr, induct_name: Name, expr: Expr, index: Int, num_fields: Int) -> Expr
    = pickup
        index >= num_fields -> ctor
        else -> add_structure_projections(App(ctor, Proj(induct_name, index, expr)), induct_name, expr, index + 1, num_fields)
  
  local fn levels_def_eq(lhs: List(Level), rhs: List(Level)) -> Bool
    = match lhs
        [] ->
          match rhs
            [] -> true
            _ -> false
        [lhs_level | lhs_rest] ->
          match rhs
            [rhs_level | rhs_rest] ->
              pickup
                level_is_equivalent(lhs_level, rhs_level) -> levels_def_eq(lhs_rest, rhs_rest)
                else -> false
            _ -> false
  
  local fn binding_def_eq(
    type_checker: TypeChecker,
    lhs_name: Name,
    lhs_binder: BinderInfo,
    lhs_domain: Expr,
    lhs_body: Expr,
    rhs_name: Name,
    rhs_binder: BinderInfo,
    rhs_domain: Expr,
    rhs_body: Expr
  ) -> Result(Bool, KernelException)
    = pickup
        lhs_binder == rhs_binder ->
          match is_def_eq(type_checker, lhs_domain, rhs_domain)
            Error(error) -> Error(error)
            Ok(true) ->
              match is_def_eq(type_checker, expr_instantiate(lhs_body, FVar(lhs_name)), expr_instantiate(rhs_body, FVar(lhs_name)))
                Error(error) -> Error(error)
                Ok(result) -> Ok(result)
            Ok(false) -> Ok(false)
        else -> Ok(false)
  
  local fn expr_instantiate(expr: Expr, value: Expr) -> Expr
    = expr_instantiate_at(expr, value, 0)
  
  local fn expr_instantiate_at(expr: Expr, value: Expr, depth: Int) -> Expr
    = match expr
        BVar(index) ->
          pickup
            index == depth -> expr_lift(value, depth)
            index > depth -> BVar(index - 1)
            else -> expr
        App(fn_expr, arg) -> App(expr_instantiate_at(fn_expr, value, depth), expr_instantiate_at(arg, value, depth))
        Lambda(name, binder_info, domain, body) -> Lambda(name, binder_info, expr_instantiate_at(domain, value, depth), expr_instantiate_at(body, value, depth + 1))
        Pi(name, binder_info, domain, body) -> Pi(name, binder_info, expr_instantiate_at(domain, value, depth), expr_instantiate_at(body, value, depth + 1))
        Let(name, type_expr, let_value, body, nondep) -> Let(name, expr_instantiate_at(type_expr, value, depth), expr_instantiate_at(let_value, value, depth), expr_instantiate_at(body, value, depth + 1), nondep)
        MData(data, inner) -> MData(data, expr_instantiate_at(inner, value, depth))
        Proj(struct_name, index, inner) -> Proj(struct_name, index, expr_instantiate_at(inner, value, depth))
        _ -> expr
  
  local fn expr_lift(expr: Expr, amount: Int) -> Expr
    = expr_lift_at(expr, amount, 0)
  
  local fn expr_lift_at(expr: Expr, amount: Int, cutoff: Int) -> Expr
    = match expr
        BVar(index) ->
          pickup
            index >= cutoff -> BVar(index + amount)
            else -> expr
        App(fn_expr, arg) -> App(expr_lift_at(fn_expr, amount, cutoff), expr_lift_at(arg, amount, cutoff))
        Lambda(name, binder_info, domain, body) -> Lambda(name, binder_info, expr_lift_at(domain, amount, cutoff), expr_lift_at(body, amount, cutoff + 1))
        Pi(name, binder_info, domain, body) -> Pi(name, binder_info, expr_lift_at(domain, amount, cutoff), expr_lift_at(body, amount, cutoff + 1))
        Let(name, type_expr, value, body, nondep) -> Let(name, expr_lift_at(type_expr, amount, cutoff), expr_lift_at(value, amount, cutoff), expr_lift_at(body, amount, cutoff + 1), nondep)
        MData(data, inner) -> MData(data, expr_lift_at(inner, amount, cutoff))
        Proj(struct_name, index, inner) -> Proj(struct_name, index, expr_lift_at(inner, amount, cutoff))
        _ -> expr
  
  local fn expr_abstract(expr: Expr, name: Name) -> Expr
    = expr_abstract_at(expr, name, 0)
  
  local fn expr_abstract_at(expr: Expr, name: Name, depth: Int) -> Expr
    = match expr
        FVar(fvar_name) ->
          pickup
            name_eq(fvar_name, name) -> BVar(depth)
            else -> expr
        App(fn_expr, arg) -> App(expr_abstract_at(fn_expr, name, depth), expr_abstract_at(arg, name, depth))
        Lambda(binder_name, binder_info, domain, body) -> Lambda(binder_name, binder_info, expr_abstract_at(domain, name, depth), expr_abstract_at(body, name, depth + 1))
        Pi(binder_name, binder_info, domain, body) -> Pi(binder_name, binder_info, expr_abstract_at(domain, name, depth), expr_abstract_at(body, name, depth + 1))
        Let(let_name, type_expr, value, body, nondep) -> Let(let_name, expr_abstract_at(type_expr, name, depth), expr_abstract_at(value, name, depth), expr_abstract_at(body, name, depth + 1), nondep)
        MData(data, inner) -> MData(data, expr_abstract_at(inner, name, depth))
        Proj(struct_name, index, inner) -> Proj(struct_name, index, expr_abstract_at(inner, name, depth))
        _ -> expr
  
  local fn expr_instantiate_levels(expr: Expr, params: List(Name), levels: List(Level)) -> Expr
    = match expr
        Sort(level) -> Sort(instantiate_level(level, params, levels))
        Const(name, const_levels) -> Const(name, instantiate_levels(const_levels, params, levels))
        App(fn_expr, arg) -> App(expr_instantiate_levels(fn_expr, params, levels), expr_instantiate_levels(arg, params, levels))
        Lambda(name, binder_info, domain, body) -> Lambda(name, binder_info, expr_instantiate_levels(domain, params, levels), expr_instantiate_levels(body, params, levels))
        Pi(name, binder_info, domain, body) -> Pi(name, binder_info, expr_instantiate_levels(domain, params, levels), expr_instantiate_levels(body, params, levels))
        Let(name, type_expr, value, body, nondep) -> Let(name, expr_instantiate_levels(type_expr, params, levels), expr_instantiate_levels(value, params, levels), expr_instantiate_levels(body, params, levels), nondep)
        MData(data, inner) -> MData(data, expr_instantiate_levels(inner, params, levels))
        Proj(struct_name, index, inner) -> Proj(struct_name, index, expr_instantiate_levels(inner, params, levels))
        _ -> expr
  
  local fn instantiate_levels(input: List(Level), params: List(Name), levels: List(Level)) -> List(Level)
    = match input
        [] -> []
        [level | rest] -> [instantiate_level(level, params, levels) | instantiate_levels(rest, params, levels)]
  
  local fn check_expr_universe_params(expr: Expr, params: List(Name)) -> Result(Atom, KernelException)
    = pickup
        expr_has_undefined_level_param(expr, params) -> Error(OtherKernelException("undefined universe level parameter"))
        else -> Ok(:ok)
  
  local fn check_level_universe_params(level: Level, params: List(Name)) -> Result(Atom, KernelException)
    = pickup
        level_has_undefined_param(level, params) -> Error(OtherKernelException("undefined universe level parameter"))
        else -> Ok(:ok)
  
  local fn check_levels_universe_params(levels: List(Level), params: List(Name)) -> Result(Atom, KernelException)
    = pickup
        levels_have_undefined_param(levels, params) -> Error(OtherKernelException("undefined universe level parameter"))
        else -> Ok(:ok)
  
  local fn expr_has_undefined_level_param(expr: Expr, params: List(Name)) -> Bool
    = match expr
        Sort(level) -> level_has_undefined_param(level, params)
        Const(_, levels) -> levels_have_undefined_param(levels, params)
        App(fn_expr, arg) ->
          pickup
            expr_has_undefined_level_param(fn_expr, params) -> true
            else -> expr_has_undefined_level_param(arg, params)
        Lambda(_, _, domain, body) ->
          pickup
            expr_has_undefined_level_param(domain, params) -> true
            else -> expr_has_undefined_level_param(body, params)
        Pi(_, _, domain, body) ->
          pickup
            expr_has_undefined_level_param(domain, params) -> true
            else -> expr_has_undefined_level_param(body, params)
        Let(_, type_expr, value, body, _) ->
          pickup
            expr_has_undefined_level_param(type_expr, params) -> true
            expr_has_undefined_level_param(value, params) -> true
            else -> expr_has_undefined_level_param(body, params)
        MData(_, inner) -> expr_has_undefined_level_param(inner, params)
        Proj(_, _, inner) -> expr_has_undefined_level_param(inner, params)
        _ -> false
  
  local fn levels_have_undefined_param(levels: List(Level), params: List(Name)) -> Bool
    = match levels
        [] -> false
        [level | rest] ->
          pickup
            level_has_undefined_param(level, params) -> true
            else -> levels_have_undefined_param(rest, params)
  
  local fn level_has_undefined_param(level: Level, params: List(Name)) -> Bool
    = match level
        LevelZero() -> false
        LevelSucc(arg) -> level_has_undefined_param(arg, params)
        LevelMax(lhs, rhs) ->
          pickup
            level_has_undefined_param(lhs, params) -> true
            else -> level_has_undefined_param(rhs, params)
        LevelIMax(lhs, rhs) ->
          pickup
            level_has_undefined_param(lhs, params) -> true
            else -> level_has_undefined_param(rhs, params)
        LevelParam(name) ->
          pickup
            name_in_list(name, params) -> false
            else -> true
        LevelMVar(_) -> false
  
  local fn name_in_list(name: Name, names: List(Name)) -> Bool
    = match names
        [] -> false
        [head | rest] ->
          pickup
            name_eq(name, head) -> true
            else -> name_in_list(name, rest)
