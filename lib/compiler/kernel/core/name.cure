mod Compiler.Kernel.Core.Name
  ## Lean Name:
  ## anonymous | str(parent, string) | num(parent, nat)
  
  type Name
    = Anonymous
    | Str(Name, String)
    | Num(Name, Int)
  
  fn anonymous() -> Name
    = Anonymous()
  
  fn str(parent: Name, component: String) -> Name
    = Str(parent, component)
  
  fn num(parent: Name, component: Int) -> Name
    = Num(parent, component)
  
  fn mk_simple(component: String) -> Name
    = Str(Anonymous(), component)
  
  fn name_eq(a: Name, b: Name) -> Bool
    = match a
        Anonymous() ->
          match b
            Anonymous() -> true
            _ -> false
        Str(a_parent, a_component) ->
          match b
            Str(b_parent, b_component) ->
              pickup
                a_component == b_component -> name_eq(a_parent, b_parent)
                else -> false
            _ -> false
        Num(a_parent, a_component) ->
          match b
            Num(b_parent, b_component) ->
              pickup
                a_component == b_component -> name_eq(a_parent, b_parent)
                else -> false
            _ -> false
  
  fn name_to_string(name: Name) -> String
    = join_name_components(name_components(name))
  
  fn name_components(name: Name) -> List(String)
    = match name
        Anonymous() -> []
        Str(parent, component) ->
          Std.List.append(name_components(parent), [component])
        Num(parent, component) ->
          Std.List.append(name_components(parent), [Std.String.from_int(component)])
  
  fn name_append_core(prefix: Name, suffix: Name) -> Name
    = match suffix
        Anonymous() -> prefix
        Str(parent, component) -> Str(name_append_core(prefix, parent), component)
        Num(parent, component) -> Num(name_append_core(prefix, parent), component)
  
  local fn join_name_components(parts: List(String)) -> String
    = match parts
        [] -> ""
        [part] -> part
        [part | rest] -> part <> "." <> join_name_components(rest)
