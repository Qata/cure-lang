mod JsonDerive
  use Std.Json

  ###
  `@derive(ToJSON)` generates a normal `ToJSON` implementation whose method
  constructs a structured `Value.Object`. Field names and values are escaped
  only by `Std.Json.encode`; derivation never concatenates JSON source text.
  ###

  @derive(ToJSON)
  rec Empty

  fn main() -> String = to_json(Empty{})
