mod DependentTypes
  # Aliases naming domain invariants. The invariants are unchecked pending
  # SMTCoq-style refinement support; each is a plain Int for now.
  type NonZero = Int      # invariant: x != 0 (unchecked)
  type Positive = Int     # invariant: x > 0 (unchecked)
  type Percentage = Int   # invariant: 0 <= p <= 100 (unchecked)

  # Functions with guard constraints are verified at call sites
  fn safe_divide(a: Int, b: Int) -> Int when b != 0 = a / b

  fn positive_double(x: Int) -> Int when x > 0 = x * 2

  # Multi-clause with guards
  fn abs(x: Int) -> Int
    | x when x >= 0 -> x
    | x -> 0 - x

  fn main() -> Int = safe_divide(42, 7)
