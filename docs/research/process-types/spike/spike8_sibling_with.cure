mod SiblingRefineWith
  # Roadblock #2 via the EXISTING `with` construct (elaborate_with_value): sibling
  # `w : ReplyOf(r)` should refine to Reply0 in the GetCount branch by Eq transport.
  type Reply0 = R0
  type Reply1 = R1a | R1b
  type Req = GetCount | Ping
  fn ReplyOf(r: Req) -> Type = match r
    GetCount() -> Reply0
    Ping()     -> Reply1
  fn use_it(r: Req, w: ReplyOf(r)) -> Reply0 = with r
    GetCount() -> w
    Ping()     -> R0
end
