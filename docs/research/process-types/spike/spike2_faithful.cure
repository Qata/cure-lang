mod OtpAlgebraSpike2
  # §6 spike, FAITHFUL: exact sketch from the handoff brief, with the stdlib base
  # types (Int / Atom / String). Confirms probe (a)+(b) survive real reply types,
  # not just locally-defined ADTs. Differential vs spike1: if spike1 accepts and
  # this rejects, the fault is stdlib-type scope, not the dependent-return machinery.

  # request vocabulary — three constructors with distinct reply types
  type Req = GetCount | SetName(String) | Ping

  # per-constructor reply type: LARGE ELIMINATION (cf. optic.cure:86, le01).
  fn ReplyOf(r: Req) -> Type = match r
    GetCount()  -> Int
    SetName(_)  -> Atom      # :ok
    Ping()      -> Atom      # :pong

  # a handler must produce EXACTLY ReplyOf(req) — dependent return indexed by the
  # scrutinee (cf. sigma.cure:37 `-> b(sigma_first(p))`).
  fn handle(r: Req) -> ReplyOf(r) = match r
    GetCount()  -> 0
    SetName(_)  -> :ok
    Ping()      -> :pong
end
