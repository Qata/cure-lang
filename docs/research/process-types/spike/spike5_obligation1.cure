mod ReplyLinear
  # FULL OBLIGATION (1): per-constructor dependent ReplyOf(req) + a LINEAR reply
  # capability consumed exactly once on every path. This is the whole claim of the
  # handoff brief §5 obligation (1). It combines:
  #   - large elimination `ReplyOf : Req -> Type` (spike1/2, ACCEPT)
  #   - linear surface grade on a fn binder (spike3, ACCEPT+neg-controls)
  #   - usage joined across match branches (spike4, ACCEPT+neg-control)
  #   - the NEW intersection: a non-scrutinee binder `cap : ReplyCap(r)` whose type
  #     must REFINE when `r` refines in the match, so `reply` sees `v : ReplyOf(ctor)`.

  type Reply0 = R0
  type Reply1 = R1a | R1b
  type Req = GetCount | SetName(Reply0) | Ping

  fn ReplyOf(r: Req) -> Type = match r
    GetCount()  -> Reply0
    SetName(_)  -> Reply1
    Ping()      -> Reply1

  # reply capability indexed by the request it serves
  type ReplyCap(r: Req) indices ()
    MkCap : ReplyCap(r)

  type Replied = Done

  # the reply eliminator: LINEARLY consume the capability, requiring v : ReplyOf(r).
  fn reply({r: Req}, @linear cap : ReplyCap(r), v: ReplyOf(r)) -> Replied =
    match cap
      MkCap() -> Done

  # well-typed handler: reply exactly once per path, each with the right reply type.
  fn handle(r: Req, @linear cap : ReplyCap(r)) -> Replied = match r
    GetCount()  -> reply(cap, R0)
    SetName(_)  -> reply(cap, R1a)
    Ping()      -> reply(cap, R1b)
end
