mod SendSafetyStrong
  # Obligation (2), STRONG operational form: the pid CARRIES its handler (a
  # higher-order constructor field), so its message index m is literally the stored
  # handler's DOMAIN, and `post` DISPATCHES the message through that handler. A
  # well-typed post therefore delivers to a total handler — no unhandled message.
  type Reply0 = R0
  type Msg = Inc | Dec | Query(Reply0)
  type Response = Ack | Count(Reply0)

  type Pid(m: Type) indices ()
    MkPid : ((m) -> Response) -> Pid(m)

  # spawn DERIVES the pid's message index from the handler's domain (no annotation).
  fn spawn_actor({m: Type}, handler: (m) -> Response) -> Pid(m) = MkPid(handler)

  # post requires msg : the pid's derived message type AND dispatches it.
  fn post({m: Type}, p: Pid(m), msg: m) -> Response = match p
    MkPid(h) -> h(msg)

  # The handler "clauses" — total over Msg (kernel-certified exhaustive).
  fn handle(m: Msg) -> Response = match m
    Inc()     -> Ack
    Dec()     -> Ack
    Query(x)  -> Count(x)

  # A well-typed client: post a Msg to the derived-index pid; post dispatches it
  # through the total handler. Send-safe: msg is forced to Msg and always handled.
  fn client(msg: Msg) -> Response = post(spawn_actor(handle), msg)
end
