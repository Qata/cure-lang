mod SiblingRefine
  # Isolate roadblock #2: matching on `r` must refine the type of a SIBLING binder
  # `w : ReplyOf(r)` (not just the return/motive). No linearity, no implicits.
  type Reply0 = R0
  type Reply1 = R1a | R1b
  type Req = GetCount | Ping
  fn ReplyOf(r: Req) -> Type = match r
    GetCount() -> Reply0
    Ping()     -> Reply1
  fn use_it(r: Req, w: ReplyOf(r)) -> Reply0 = match r
    GetCount() -> w
    Ping()     -> R0
end
