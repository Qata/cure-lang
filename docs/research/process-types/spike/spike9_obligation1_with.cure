mod ReplyLinearWith
  # Full obligation (1) authored with `with r` so the sibling `cap : ReplyCap(r)`
  # refines per branch, pinning reply's {r} to the constructor.
  type Reply0 = R0
  type Reply1 = R1a | R1b
  type Req = GetCount | SetName(Reply0) | Ping

  fn ReplyOf(r: Req) -> Type = match r
    GetCount()  -> Reply0
    SetName(_)  -> Reply1
    Ping()      -> Reply1

  type ReplyCap(r: Req) indices ()
    MkCap : ReplyCap(r)

  type Replied = Done

  fn reply({r: Req}, @linear cap : ReplyCap(r), v: ReplyOf(r)) -> Replied =
    match cap
      MkCap() -> Done

  fn handle(r: Req, @linear cap : ReplyCap(r)) -> Replied = with r
    GetCount()  -> reply(cap, R0)
    SetName(_)  -> reply(cap, R1a)
    Ping()      -> reply(cap, R1b)
end
