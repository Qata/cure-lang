mod SendNegWrong
  type Reply0 = R0
  type Msg = Inc | Dec | Query(Reply0)
  type Other = OtherMsg
  type Response = Ack | Count(Reply0)
  type Pid(m: Type) indices ()
    MkPid : ((m) -> Response) -> Pid(m)
  fn spawn_actor({m: Type}, handler: (m) -> Response) -> Pid(m) = MkPid(handler)
  fn post({m: Type}, p: Pid(m), msg: m) -> Response = match p
    MkPid(h) -> h(msg)
  fn handle(m: Msg) -> Response = match m
    Inc() -> Ack
    Dec() -> Ack
    Query(x) -> Count(x)
  fn client(bad: Other) -> Response = post(spawn_actor(handle), bad)
end
