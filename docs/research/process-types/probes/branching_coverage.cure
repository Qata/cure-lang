## Branching (BSeq) coverage for mailbox-inference adequacy — VALIDATED probe.
##
## Extends the sequential `coverage` (proved in metatheory/otp/src/otp_inference_adequacy.cure) to the
## BRANCHING behaviour `BSeq(l, r)`. The theorem: every tag a behaviour SENDS is a member of
## its inferred interface `infer(b)` — `SendsIn(b, t) -> Member(t, infer(b))`.
##
## The proof term is the `coverage` FUNCTION below: a total, exhaustive match whose type IS the
## theorem (Curry-Howard). The technique for BSeq is the ergonomics catalog's E1 workaround —
## match the DATA `b` before the EVIDENCE `s`, so the sub-behaviours l/r/k are bound by name and
## the impossible evidence constructors are pruned. Validated 2026-07-17; to be promoted into
## metatheory/otp/src/otp_inference_adequacy.cure with an Idris oracle pair.

mod BranchingCoverage
  type Tag = TA | TB
  type TagList = TNil | TCons(Tag, TagList)

  type Member indices (t: Tag, iface: TagList)
    MemHere  : Member(t, TCons(t, rest))
    MemThere : Member(t, rest) -> Member(t, TCons(y, rest))

  type Behaviour = BNil | BSend(Tag, Behaviour) | BRecv(Tag, Behaviour) | BSeq(Behaviour, Behaviour)

  fn append(a: TagList, b: TagList) -> TagList = match a
    TNil()         -> b
    TCons(t, rest) -> TCons(t, append(rest, b))

  fn infer(b: Behaviour) -> TagList = match b
    BNil()      -> TNil
    BSend(t, k) -> TCons(t, infer(k))
    BRecv(t, k) -> TCons(t, infer(k))
    BSeq(l, r)  -> append(infer(l), infer(r))

  ## Membership is preserved under append, on both sides. These two lemmas ARE the proofs
  ## (total recursive functions inhabiting the membership type).
  fn member_append_left({t: Tag}, {xs: TagList}, {ys: TagList}, m: Member(t, xs)) -> Member(t, append(xs, ys)) = match m
    MemHere()    -> MemHere()
    MemThere(m2) -> MemThere(member_append_left(m2))

  fn member_append_right(xs: TagList, {t: Tag}, {ys: TagList}, m: Member(t, ys)) -> Member(t, append(xs, ys)) = match xs
    TNil()         -> m
    TCons(y, rest) -> MemThere(member_append_right(rest, m))

  type SendsIn indices (b: Behaviour, t: Tag)
    SendHere  : SendsIn(BSend(t, k), t)
    SendSendK : SendsIn(k, t) -> SendsIn(BSend(y, k), t)
    SendRecvK : SendsIn(k, t) -> SendsIn(BRecv(y, k), t)
    SendSeqL  : SendsIn(l, t) -> SendsIn(BSeq(l, r), t)
    SendSeqR  : SendsIn(r, t) -> SendsIn(BSeq(l, r), t)

  ## THE PROOF: coverage over branching behaviours. Match `b` first (binds l/r/k), then the
  ## evidence `s` against a concrete `b`. `match s` on BNil is EMPTY — SendsIn(BNil,t) is
  ## uninhabited — which is itself the proof that BNil sends nothing.
  fn coverage(b: Behaviour, {t: Tag}, s: SendsIn(b, t)) -> Member(t, infer(b)) = match b
    BNil()      -> match s
    BSend(y, k) -> match s
      SendHere()    -> MemHere()
      SendSendK(s2) -> MemThere(coverage(k, s2))
    BRecv(y, k) -> match s
      SendRecvK(s2) -> MemThere(coverage(k, s2))
    BSeq(l, r)  -> match s
      SendSeqL(s2) -> member_append_left(coverage(l, s2))
      SendSeqR(s2) -> member_append_right(infer(l), coverage(r, s2))
end
