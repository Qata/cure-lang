mod InferenceAdequacy
  ## STATUS (2026-07-17): the SEQUENTIAL and BRANCHING (`BSeq`) fragment is now PROVED, no
  ## holes, in the shipped `metatheory/otp/src/otp_inference_adequacy.cure` (Idris rel=same). The `BSeq`
  ## coverage that this scaffold's `?coverage`/`?adequacy` notes call erasure-blocked was
  ## resolved by matching the DATA before the EVIDENCE (E1 structure), no TCB change. What this
  ## scaffold still stands for is the RECURSION (`BRec`) frontier, which genuinely needs the
  ## `lfp` machinery (see `inference_fixpoint.cure`). The notes below predate the branching
  ## proof; read them as the recursion-frontier design, not the current gap list.
  ##
  ## ADEQUACY — tying `infer(behaviour)` back to the operational metatheory: the one piece
  ## of G9 with no single external match, here decomposed into three parts that DO each
  ## have a matching shape (see 2026-07-17-adequacy-shape.md).
  ##
  ## Adequacy = the fundamental theorem of type soundness, PARAMETERIZED by inference: the
  ## inferred interface is preserved by the operational reduction of the behaviour it was
  ## inferred from. Below, the OPERATIONAL HALF (`preservation_at`) is PROVED — this is the
  ## part the state-of-the-art mechanization (Proof of Delivery, Rocq) explicitly LEFT OPEN
  ## for mailbox types — and only the syntactic BRIDGE (`?adequacy`) is a hole.

  type Tag = TA | TB | TC
  type TagList = TNil | TCons(Tag, TagList)

  ## Membership and `AllMember` = the `config ⊨ interface` relation (tag-set fragment). In
  ## the full theory this is the commutative-regex-pattern relation, order-insensitive via
  ## permutations (Proof of Delivery's mechanization shape).
  type Member indices (t: Tag, iface: TagList)
    MemHere  : Member(t, TCons(t, rest))
    MemThere : Member(t, rest) -> Member(t, TCons(y, rest))
  type AllMember indices (ts: TagList, iface: TagList)
    AMNil  : AllMember(TNil, iface)
    AMCons : Member(t, iface) -> AllMember(rest, iface) -> AllMember(TCons(t, rest), iface)

  type Config = MkConfig(TagList, TagList)

  ## `WTat(c, I)` — config `c` is well-typed at interface `I`: every in-flight and mailboxed
  ## message is a member of `I`. This is `config ⊨ I`.
  type WTat indices (c: Config, iface: TagList)
    MkWTat : AllMember(e, iface) -> AllMember(m, iface) -> WTat(MkConfig(e, m), iface)

  ## The reduction TYPED at interface `I`: a send may only send an `I`-message. This is the
  ## coverage the constraint generator guarantees — `infer`'s sends land in `infer`.
  type StepAt indices (i: TagList, before: Config, after: Config)
    SSendAt   : Member(t, i) -> StepAt(i, MkConfig(e, m), MkConfig(TCons(t, e), m))
    SArriveAt : StepAt(i, MkConfig(TCons(t, e), m), MkConfig(e, TCons(t, m)))
    SRecvAt   : StepAt(i, MkConfig(e, TCons(t, m)), MkConfig(e, m))

  ## **PRESERVATION AT THE INFERRED INTERFACE (the operational half — PROVED).** A typed
  ## step preserves `config ⊨ I`. This is `Std.Otp.Preservation` generalized from a fixed
  ## accepted-set to an arbitrary interface `I` — exactly the operational preservation
  ## theorem Proof of Delivery deferred as future work.
  fn preservation_at({i: TagList}, {b: Config}, {a: Config}, wt: WTat(b, i), s: StepAt(i, b, a)) -> WTat(a, i) = match s
    SSendAt(mem) -> match wt
      MkWTat(ae, am) -> MkWTat(AMCons(mem, ae), am)
    SArriveAt() -> match wt
      MkWTat(ae, am) -> match ae
        AMCons(at, ae2) -> MkWTat(ae2, AMCons(at, am))
    SRecvAt() -> match wt
      MkWTat(ae, am) -> match am
        AMCons(rat, am2) -> MkWTat(ae, am2)

  ## ── The bridge to inference (the hole) ──
  ##
  ## A BEHAVIOUR and its inferred interface (the frontier scaffold). `infer` and the
  ## behaviour's RUN both use the transfer/lfp machinery that is itself holed elsewhere; the
  ## adequacy hole is the FUNDAMENTAL THEOREM connecting them.
  type Behaviour = BNil | BRecv(Tag, Behaviour) | BSend(Tag, Behaviour) | BSeq(Behaviour, Behaviour)

  ## `infer(b)` — the inferred interface of a behaviour (constant-fold fragment; the general
  ## version is the frontier's `lfp(transfer)`).
  fn infer(b: Behaviour) -> TagList = match b
    BNil()        -> TNil
    BRecv(t, k)   -> TCons(t, infer(k))
    BSend(t, k)   -> TCons(t, infer(k))
    BSeq(l, r)    -> append(infer(l), infer(r))

  fn append(a: TagList, b: TagList) -> TagList = match a
    TNil()         -> b
    TCons(t, rest) -> TCons(t, append(rest, b))

  ## `Runs(b, c)` — config `c` is reachable by executing behaviour `b`. (The operational
  ## semantics of behaviours; a relation whose rules mirror `StepAt`.)
  type Runs indices (b: Behaviour, c: Config)
    RStart : Runs(b, MkConfig(TNil, TNil))
    RStep  : Runs(b, before) -> StepAt(infer(b), before, after) -> Runs(b, after)

  ## **ADEQUACY over typed runs — HOLE ?adequacy.** Every config reachable by a run of `b`
  ## whose steps are typed at `infer(b)` is well-typed at `infer(b)`. The proof is `RStart ↦
  ## MkWTat(AMNil, AMNil)`, `RStep(prev, step) ↦ preservation_at(adequacy(prev), step)` —
  ## PLFA's `preserve` composed over a run. It is BLOCKED in Cure today by a concrete
  ## elaborator gap, NOT by conceptual difficulty: the recursive call needs the intermediate
  ## config `before` from `prev : Runs(b, before)`, but matching `RStep` does not expose that
  ## index existential by name (the same sibling-refinement / index-existential-extraction
  ## limitation hit in `Std.Otp.ReplyConservation`'s drain — the workaround there was to make
  ## the step CARRY its counts as explicit fields; the analogous fix here is for `Runs`/`StepAt`
  ## to carry the intermediate config). So `?adequacy` is a hole with a KNOWN fill blocked by a
  ## KNOWN gap, not open research.
  fn adequacy(b: Behaviour, c: Config, run: Runs(b, c)) -> WTat(c, infer(b)) = ?adequacy

  ## The GENUINE remaining gap is COVERAGE: that `b`'s UNTYPED operational step (a raw send
  ## of tag `t`) is a `StepAt(infer(b))` step, i.e. `Member(t, infer(b))`. For the first-order
  ## fold this is immediate (`BSend(t, k)` puts `t` at the head of `infer`); with recursion it
  ## needs the frontier `lfp`. `?coverage` marks it — the one honest hole, and the fold-case
  ## fill (`send_covered` below) shows it is dischargeable in the first-order fragment.
  fn coverage(b: Behaviour, t: Tag, sends: SendsIn(b, t)) -> Member(t, infer(b)) = ?coverage

  ## `SendsIn(b, t)` — behaviour `b` has a send site for tag `t` (a syntactic relation).
  type SendsIn indices (b: Behaviour, t: Tag)
    SendHere  : SendsIn(BSend(t, k), t)
    SendRecvK : SendsIn(k, t) -> SendsIn(BRecv(y, k), t)
    SendSendK : SendsIn(k, t) -> SendsIn(BSend(y, k), t)
    SendSeqL  : SendsIn(l, t) -> SendsIn(BSeq(l, r), t)
    SendSeqR  : SendsIn(r, t) -> SendsIn(BSeq(l, r), t)
end
