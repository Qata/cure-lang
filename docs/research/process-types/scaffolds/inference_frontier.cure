mod InferenceFrontier
  ## THE FRONTIER: deriving the monotone transfer function from a process BEHAVIOUR.
  ## `inference_fixpoint.cure` took the transfer `f` as given; this file sketches where `f`
  ## COMES FROM — a fold (catamorphism) over a behaviour syntax — and the obligation that
  ## makes the fold a valid transfer (continuity/monotonicity). Type holes mark the parts
  ## with no closed shape yet; see 2026-07-17-mailbox-inference-fixpoint-shape.md for which
  ## have a mathlib equivalent (ωCPO fixpoints; F-algebras) and which are genuinely open
  ## (semantic adequacy of the fold).

  type Tag = TA | TB | TC
  type TagList = TNil | TCons(Tag, TagList)
  type Handles indices (t: Tag, iface: TagList)
    HHere  : Handles(t, TCons(t, rest))
    HThere : Handles(t, rest) -> Handles(t, TCons(y, rest))
  type AllHandled indices (s: TagList, iface: TagList)
    AHNil  : AllHandled(TNil, iface)
    AHCons : Handles(t, iface) -> AllHandled(rest, iface) -> AllHandled(TCons(t, rest), iface)

  ## Interface union (constructive; interfaces are sets so duplicates are harmless).
  fn union(a: TagList, b: TagList) -> TagList = match a
    TNil()        -> b
    TCons(t, rest) -> TCons(t, union(rest, b))

  ## A process BEHAVIOUR — the session grammar the transfer folds over. `BRec`/`BVar` are
  ## the recursive binder (de Bruijn: `BVar` refers to the nearest `BRec`), which is WHY the
  ## transfer needs a fixpoint.
  type Behaviour =
    | BNil
    | BRecv(Tag, Behaviour)
    | BSend(Tag, Behaviour)
    | BChoice(Behaviour, Behaviour)
    | BVar
    | BRec(Behaviour)

  ## `lfp` — the least fixed point of a monotone transfer (the outer shape, held in
  ## `inference_fixpoint.cure`; a hole here too). FILL: mathlib
  ## `OmegaCompletePartialOrder.ωSup_iterate_mem_fixedPoint` (continuous) / `OrderHom.lfp`
  ## (the finite specialization).
  fn lfp(f: (TagList) -> TagList) -> TagList = ?lfp

  ## **CONSTRAINT GENERATION** — the transfer as a fold over the behaviour, with `env` the
  ## interpretation of the recursion variable `BVar`. This is the catamorphism; its SHAPE is
  ## a mathlib F-algebra (`CategoryTheory/Endofunctor/Algebra`). Most cases are constructive;
  ## `BRec` closes the recursion with `lfp`.
  fn transfer(b: Behaviour, env: TagList) -> TagList = match b
    BNil()          -> TNil
    BRecv(t, k)     -> TCons(t, transfer(k, env))
    BSend(t, k)     -> TCons(t, transfer(k, env))
    BChoice(l, r)   -> union(transfer(l, env), transfer(r, env))
    BVar()          -> env
    BRec(body)      -> lfp(fn(i) -> transfer_step(body, i))

  ## One recursion-body unfolding at interface `i` — the function `lfp` iterates. (Split out
  ## so the lambda in `BRec` is a plain call.)
  fn transfer_step(body: Behaviour, i: TagList) -> TagList = transfer(body, i)

  ## **SEMANTIC ADEQUACY (the genuinely open obligation).** The transfer is MONOTONE in the
  ## environment — bigger recursion-interface ⟹ bigger result — which is what lets the
  ## `BRec` `lfp` exist and be principal. Provable by induction on `b`, EXCEPT the `BRec`
  ## case needs monotonicity of `lfp` in the body (mathlib `OrderHom.lfp` is itself an
  ## `OrderHom`, i.e. monotone — that part ports). The domain-specific continuity of each
  ## behaviour former is the part with NO mathlib theorem; hole ?transfer_mono.
  fn transfer_mono(b: Behaviour, e1: TagList, e2: TagList, sub: AllHandled(e1, e2)) -> AllHandled(transfer(b, e1), transfer(b, e2)) = ?transfer_mono

  ## The inferred mailbox type of a (top-level, recursion-closed) behaviour: fold with the
  ## empty environment; the `BRec` inside supplies its own fixpoint.
  fn infer(b: Behaviour) -> TagList = transfer(b, TNil)
end
