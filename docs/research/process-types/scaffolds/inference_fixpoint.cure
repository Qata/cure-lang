mod InferenceFixpoint
  ## OUTER SHAPE of evolving-protocol mailbox-type inference as a LEAST FIXED POINT.
  ## Type holes (`?name`) mark the inner parts intractable today; each hole's fill is a
  ## named theorem in Lean mathlib (`~/Develop/mathlib4`, Order/FixedPoints.lean +
  ## Order/Iterate.lean) — see 2026-07-17-mailbox-inference-fixpoint-shape.md.
  ##
  ## This file is a design artifact: it TYPE-CHECKS (the outer shape is well-formed and the
  ## holes stand in for the inner proofs); it is not compiled into the runtime.

  type Tag = TA | TB | TC
  type TagList = TNil | TCons(Tag, TagList)

  ## Membership and the interface SUBTYPING order `AllHandled(a, b)` = a ⊆ b (proved out in
  ## `Std.Otp.InferenceLaws`: reflexive/transitive/monotone).
  type Handles indices (t: Tag, iface: TagList)
    HHere  : Handles(t, TCons(t, rest))
    HThere : Handles(t, rest) -> Handles(t, TCons(y, rest))
  type AllHandled indices (s: TagList, iface: TagList)
    AHNil  : AllHandled(TNil, iface)
    AHCons : Handles(t, iface) -> AllHandled(rest, iface) -> AllHandled(TCons(t, rest), iface)

  type Nat = Z | S(Nat)

  ## Constructive KLEENE ITERATION f^n(x) — this part is NOT a hole.
  fn iterate(f: (TagList) -> TagList, x: TagList, n: Nat) -> TagList = match n
    Z()  -> x
    S(k) -> f(iterate(f, x, k))

  ## ── The outer shape: least fixed point of a monotone transfer (Knaster–Tarski) ──
  ##
  ## A behaviour's constraint-TRANSFER is a monotone `f : Interface -> Interface`. The
  ## inferred interface is `lfp(f)`. Deriving `f` from a behaviour is the open problem
  ## ABOVE this shape; here `f` is a parameter with a monotonicity hypothesis, so that
  ## everything about the fixpoint is fillable while `f` itself stays abstract.

  ## `lfp(f)` — the inferred interface (least fixed point).
  ## HOLE ?lfp_construction. FILL: `iterate(f, TNil, height)` with height = |Tag|; the
  ## ascending chain ⊥ ⊆ f(⊥) ⊆ … stabilizes on the finite lattice.
  ## [mathlib: OrderHom.lfp ; Order/Iterate.monotone_iterate_of_le_map]
  fn lfp(f: (TagList) -> TagList) -> TagList = ?lfp_construction

  ## `lfp_le` — a PRE-fixed point bounds the lfp: f(a) ⊆ a ⟹ lfp(f) ⊆ a.
  ## HOLE ?lfp_le. FILL: every iterate ⊆ a by induction (⊥ ⊆ a; f preserves ⊆ a).
  ## [mathlib: OrderHom.lfp_le (sInf_le) ; Order/Iterate.iterate_le_of_le]
  fn lfp_le(f: (TagList) -> TagList, a: TagList, pre: AllHandled(f(a), a)) -> AllHandled(lfp(f), a) = ?lfp_le

  ## `le_lfp` — the lfp is below anything that bounds all pre-fixed points.
  ## HOLE ?le_lfp. [mathlib: OrderHom.le_lfp (le_sInf)]
  fn le_lfp(f: (TagList) -> TagList, a: TagList, dom: (b: TagList) -> (AllHandled(f(b), b)) -> AllHandled(a, b)) -> AllHandled(a, lfp(f)) = ?le_lfp

  ## `map_lfp` (⟶) — SOUNDNESS half: f(lfp(f)) ⊆ lfp(f). Needs f monotone.
  ## HOLE ?map_lfp_le. [mathlib: OrderHom.map_le_lfp]
  fn map_lfp_le(f: (TagList) -> TagList, mono: (a: TagList) -> (b: TagList) -> (AllHandled(a, b)) -> AllHandled(f(a), f(b))) -> AllHandled(f(lfp(f)), lfp(f)) = ?map_lfp_le

  ## `map_lfp` (⟵) — the other half: lfp(f) ⊆ f(lfp(f)). Together: lfp is a FIXED point.
  ## HOLE ?lfp_le_map. [mathlib: OrderHom.lfp_le_map ; map_lfp]
  fn lfp_le_map(f: (TagList) -> TagList, mono: (a: TagList) -> (b: TagList) -> (AllHandled(a, b)) -> AllHandled(f(a), f(b))) -> AllHandled(lfp(f), f(lfp(f))) = ?lfp_le_map

  ## `is_least` — PRINCIPALITY: `lfp(f)` is the LEAST fixed point, so the inferred interface
  ## is contained in every self-consistent interface. This is the property that makes
  ## inference PRINCIPAL. HOLE ?is_least (composes map_lfp + lfp_le).
  ## [mathlib: OrderHom.isLeast_lfp]
  fn is_least(f: (TagList) -> TagList, a: TagList, fixed: AllHandled(f(a), a)) -> AllHandled(lfp(f), a) = ?is_least
end
